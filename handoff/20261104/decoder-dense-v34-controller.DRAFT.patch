+def retrieve_decoder_dense_hardware_v34_result(sandbox, destination: Path, payload: dict, *, recovery=False) -> dict:
+    """Read a capped diagnostic checkpoint while the sandbox still exists."""
+    import decoder_dense_hardware_v34 as dense
+    if sha(Path(dense.__file__).read_text()) != payload["file_sha256"]["dense_v34.py"]:
+        raise ValueError("Local V34 worker changed after upload")
+    process = sandbox.exec("python3", "-c", FINALIZER_READ_RESULT, timeout=10, text=False)
+    content = process.stdout.read()
+    process.stderr.read()
+    process.wait()
+    if process.returncode != 0:
+        raise RuntimeError(f"V34 result read exited {process.returncode}")
+    if type(content) is not bytes or len(content) > 1024 * 1024:
+        raise ValueError("V34 result exceeds local byte/type bound")
+    result = json.loads(content)
+    dense.validate_result(result, payload)
+    local = ("result.json" if not recovery and result["status"] == "dense_profile_complete"
+             else "result-checkpoint.json")
+    save(destination / local, result)
+    return result
 
 
