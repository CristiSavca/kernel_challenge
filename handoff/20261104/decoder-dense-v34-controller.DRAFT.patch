+def run_decoder_dense_hardware_v34_worker(payload: dict) -> None:
+    """Run only the fixed, separately reviewed dense counter diagnostic."""
+    import importlib.util
+    expected = {"decoder.py", "hardware_metrics.py", "dense_v34.py"}
+    if set(payload.get("files", {})) != expected or set(payload.get("file_sha256", {})) != expected:
+        raise ValueError("Unexpected V34 dense diagnostic files")
+    folder = Path("/tmp/okc-input")
+    folder.mkdir(exist_ok=True)
+    for name, source in payload["files"].items():
+        if not isinstance(source, str) or sha(source) != payload["file_sha256"][name]:
+            raise ValueError(f"V34 payload hash mismatch: {name}")
+        (folder / name).write_text(source)
+    spec = importlib.util.spec_from_file_location("dense_v34", folder / "dense_v34.py")
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    module.validate_payload(payload)
+    module.run(payload)
+
