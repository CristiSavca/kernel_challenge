+def verified_additional_reconciliation(root: Path, grant, records, journal: Path, billing,
+                                      observed: Decimal, overlap, overlap_pin,
+                                      estimate_correction, estimate_pin):
+    """One fixed nine-run addition; never discover or recycle completed runs."""
+    pin = REVIEWED_ADDITIONAL_SHA256
+    if pin is None:
+        return observed, Decimal(0), Decimal(0), None
+    try:
+        cert = _pinned_json(root, {"path": ADDITIONAL_CERTIFICATE, "sha256": pin})
+        if (cert.get("schema") != 1 or cert.get("policy") != "fixed-additional-overlap-and-finished-estimates-v1"
+                or cert.get("classification") != "conservative_estimate_not_provider_cap_or_final_settlement"):
+            raise CreditGuardError("Unsupported additional reconciliation certificate")
+        if (any(cert[k] != grant[k] for k in ("cycle", "workspace", "profile", "environment"))
+                or _pinned_json(root, cert["grant"]) != grant):
+            raise CreditGuardError("Additional reconciliation grant mismatch")
+        if (overlap_pin is None or estimate_pin is None
+                or cert["overlap_certificate"]["sha256"] != overlap_pin
+                or cert["estimate_certificate"]["sha256"] != estimate_pin
+                or overlap != Decimal("3.74") or estimate_correction != Decimal("9.51")):
+            raise CreditGuardError("Additional reconciliation requires both unchanged original corrections")
+        old_overlap = _pinned_json(root, cert["overlap_certificate"])
+        old_estimate = _pinned_json(root, cert["estimate_certificate"])
+        proposal = _pinned_json(root, cert["proposal"])
+        _pinned_bytes(root, cert["old_guard_snapshot"])
+        if (cert["old_guard_snapshot"]["sha256"] != proposal["guard_unchanged"]["sha256"]
+                or cert["provider_evidence"] != proposal["evidence"]
+                or cert["grant"] != proposal["grant"]
+                or cert["overlap_certificate"] != proposal["existing_overlap_certificate"]
+                or cert["estimate_certificate"] != proposal["existing_estimate_certificate"]
+                or cert["highwater_evidence"] != proposal["provider_highwater_evidence"]
+                or cert["runs"] != proposal["runs"]):
+            raise CreditGuardError("Additional reconciliation proposal binding changed")
+        scope = {"additional_overlap_indices": list(range(9, 18)),
+                 "estimate_revision_indices": [9, 12, 13, 14, 15, 16],
+                 "full_reservations_retained_indices": [10, 11, 17],
+                 "old_indices_0_through_8_excluded": True,
+                 "old_corrections_counted_once": {"overlap_usd": "3.74", "estimate_usd": "9.51"}}
+        if cert["scope"] != scope or proposal["scope"] != scope or len(cert["runs"]) != 9:
+            raise CreditGuardError("Additional reconciliation fixed scope changed")
+        prefix = cert["journal_prefix"]
+        if (type(prefix["records"]) is not int or prefix["records"] != 18 or len(records) < 18
+                or prefix != proposal["journal_prefix"]
+                or (root / prefix["path"]).resolve() != journal.resolve()):
+            raise CreditGuardError("Additional reconciliation requires the exact eighteen-record prefix")
+        lines = journal.read_bytes().splitlines(keepends=True)
+        if hashlib.sha256(b"".join(lines[:18])).hexdigest() != prefix["sha256"]:
+            raise CreditGuardError("Additional reconciliation journal prefix changed")
+        for record in records[18:]:
+            if record.get("additional_certificate_sha256") != pin:
+                raise CreditGuardError("Conflicting or missing additional certificate in later journal entry")
+        parameters = {"gpu_hourly_usd": "5.00", "cpu_hourly_usd": "0.15", "cpu_count": 4,
+                      "memory_hourly_per_gib_usd": "0.025", "memory_gib": 32, "rate_margin": "1.20",
+                      "build_allowance_usd": "0.50", "termination_allowance_seconds": 60}
+        if cert["parameters"] != parameters:
+            raise CreditGuardError("Additional reconciliation rates or allowances changed")
+        evidence = _pinned_json(root, cert["provider_evidence"])
+        active = [p for p in evidence["profile"] if p.get("active") is True]
+        if (len(active) != 1 or active[0].get("name") != grant["profile"]
+                or active[0].get("workspace") != grant["workspace"]):
+            raise CreditGuardError("Additional reconciliation provider profile mismatch")
+        start = datetime.fromisoformat(cert["report_start"]).replace(tzinfo=timezone.utc)
+        minimum_end = datetime.fromisoformat(cert["minimum_report_end"]).replace(tzinfo=timezone.utc)
+        end = datetime.now(timezone.utc).replace(minute=0, second=0, microsecond=0)
+        if (cert["report_start"] != old_overlap["report_start"]
+                or evidence["report_start"] != cert["report_start"]
+                or evidence["report_end"] != cert["minimum_report_end"]
+                or not start < minimum_end <= end):
+            raise CreditGuardError("Additional reconciliation full-cycle interval invalid")
+        saved = _cost_rows(evidence["report"], start, minimum_end)
+        component = money(evidence["summary"]["metered_cost_breakdown"]["ephemeral_apps"], "saved compute cost")
+        if abs(sum(saved.values(), Decimal(0)) - component) > Decimal(".00000001") * (len(saved) + 1):
+            raise CreditGuardError("Additional reconciliation saved report does not reconcile")
+        metadata = {s["id"]: s for s in evidence["metadata"]}
+        if len(metadata) != len(evidence["metadata"]):
+            raise CreditGuardError("Additional reconciliation duplicate sandbox metadata")
+        used_apps = {x["app_id"] for x in old_overlap["runs"]}
+        used_sandboxes = {x["sandbox_id"] for x in old_estimate["runs"]}
+        used_tasks = {x["task_id"] for x in old_estimate["runs"]}
+        old_saved = _pinned_json(root, old_overlap["provider_evidence"])
+        old_end = datetime.fromisoformat(old_overlap["report_end"]).replace(tzinfo=timezone.utc)
+        used_rows = set(_cost_rows(old_saved["report"], start, old_end))
+        amounts, estimates = Decimal(0), {}
+        original_total, revised_total = Decimal(0), Decimal(0)
+        for index, entry in enumerate(cert["runs"], 9):
+            record = records[index]
+            if (type(entry["record_index"]) is not int or entry["record_index"] != index
+                    or entry["run_id"] != record["run_id"]
+                    or entry["resource_kind"] != record.get("resource_kind", RESOURCE_H200)):
+                raise CreditGuardError("Additional reconciliation reservation identity changed")
+            manifest = _pinned_json(root, entry["manifest"])
+            folder = root / "experiments" / "modal" / record["run_id"]
+            if ((root / entry["manifest"]["path"]).resolve() != (folder / "manifest.json").resolve()
+                    or manifest["credit_guard"] != record or manifest.get("sandbox_terminated") is not True
+                    or manifest["mode"] != entry["mode"]):
+                raise CreditGuardError("Additional reconciliation manifest or termination mismatch")
+            sandbox = metadata[manifest["sandbox_id"]]
+            task = sandbox["task_info"]
+            app = entry["app_id"]
+            if (entry["sandbox_id"] != manifest["sandbox_id"] or sandbox["app_id"] != app
+                    or entry["task_id"] != task["id"] or task["result"]["status"] != "GENERIC_STATUS_TERMINATED"
+                    or app in used_apps or sandbox["id"] in used_sandboxes or task["id"] in used_tasks):
+                raise CreditGuardError("Additional reconciliation reused or unterminated provider identity")
+            used_apps.add(app); used_sandboxes.add(sandbox["id"]); used_tasks.add(task["id"])
+            kind = entry["resource_kind"]
+            if kind not in (RESOURCE_H200, RESOURCE_CPU):
+                raise CreditGuardError("Additional reconciliation resource kind invalid")
+            resources = sandbox["resource_info"]
+            if (resources["memory_mb"]["value"] != 32768 or resources["memory_mb_max"] != 32768
+                    or resources["milli_cpu"]["value"] != 4000 or resources["milli_cpu_max"] != 4000
+                    or resources.get("gpu_type", "") != ("H200" if kind == RESOURCE_H200 else "")
+                    or sandbox["timeout_secs"] != manifest["timeout_seconds"]):
+                raise CreditGuardError("Additional reconciliation provider resource caps changed")
+            created = money(sandbox["created_at"], "sandbox creation")
+            started = money(task["started_at"], "sandbox start")
+            finished = money(task["finished_at"], "sandbox finish")
+            if (not 0 < created <= started < finished
+                    or created != money(entry["provider_created_at"], "bound creation")
+                    or finished != money(entry["provider_finished_at"], "bound finish")):
+                raise CreditGuardError("Additional reconciliation lifetime binding changed")
+            seconds = int((finished - created).to_integral_value(rounding=ROUND_CEILING)) + 60
+            if type(entry["lifetime_plus_60s"]) is not int or entry["lifetime_plus_60s"] != seconds:
+                raise CreditGuardError("Additional reconciliation lifetime allowance changed")
+            worker = _pinned_bytes(root, entry["worker"])
+            if ((root / entry["worker"]["path"]).resolve() != (folder / "worker.py").resolve()
+                    or entry["worker"]["sha256"] != manifest["worker_sha256"]
+                    or hashlib.sha256((folder / "credit_guard.py").read_bytes()).hexdigest() != manifest["credit_guard_sha256"]):
+                raise CreditGuardError("Additional reconciliation frozen worker or guard changed")
+            for name, expected in manifest["file_sha256"].items():
+                if Path(name).name != name or hashlib.sha256((folder / name).read_bytes()).hexdigest() != expected:
+                    raise CreditGuardError("Additional reconciliation frozen uploaded source changed")
+            tree = ast.parse(worker)
+            calls = [n for n in ast.walk(tree) if isinstance(n, ast.Call)
+                     and isinstance(n.func, ast.Attribute) and n.func.attr == "create"
+                     and isinstance(n.func.value, ast.Attribute) and n.func.value.attr == "Sandbox"]
+            if len(calls) != 1 or any(k.arg is None for k in calls[0].keywords):
+                raise CreditGuardError("Additional reconciliation host allocation count changed")
+            args = {k.arg: k.value for k in calls[0].keywords}
+            limits = {k: ast.literal_eval(args[k]) for k in ("cpu", "memory", "block_network")}
+            if limits != {"cpu": (4, 4), "memory": (32768, 32768), "block_network": True}:
+                raise CreditGuardError("Additional reconciliation host resource limits changed")
+            gpu = args["gpu"]
+            if isinstance(gpu, ast.IfExp):
+                expected = ast.parse("None if compile_mode else 'H200'", mode="eval").body
+                assignments = [n for n in ast.walk(tree) if isinstance(n, ast.Assign)
+                               and any(isinstance(t, ast.Name) and t.id == "compile_mode" for t in n.targets)]
+                condition = ast.parse("args.mode == 'compile-sass'", mode="eval").body
+                if (ast.dump(gpu) != ast.dump(expected) or len(assignments) != 1
+                        or ast.dump(assignments[0].value) != ast.dump(condition)):
+                    raise CreditGuardError("Additional reconciliation CPU/GPU selector changed")
+                selected_gpu = None if manifest["mode"] == "compile-sass" else "H200"
+            else:
+                selected_gpu = ast.literal_eval(gpu)
+            if selected_gpu != ("H200" if kind == RESOURCE_H200 else None):
+                raise CreditGuardError("Additional reconciliation host GPU and reservation disagree")
+            original = money(record["reservation_usd"], "original reservation")
+            if original != reservation_usd(manifest["timeout_seconds"], kind):
+                raise CreditGuardError("Additional reconciliation original resource reservation changed")
+            revised = original
+            if index in scope["estimate_revision_indices"]:
+                if kind != RESOURCE_H200:
+                    raise CreditGuardError("Additional reconciliation revision is H200-only")
+                revised = min(original, (Decimal("7.68") * seconds / 3600 + Decimal(".50")).quantize(
+                    Decimal(".01"), rounding=ROUND_CEILING))
+            selected = {k: v for k, v in saved.items() if k[0] == app}
+            if not selected or any(k[1] != grant["environment"] for k in selected) or used_rows.intersection(selected):
+                raise CreditGuardError("Additional reconciliation reused or missing billing rows")
+            used_rows.update(selected)
+            cost = sum(selected.values(), Decimal(0))
+            amount = cost.quantize(Decimal(".01"), rounding=ROUND_FLOOR)
+            if (cost > revised or original != money(entry["original_reservation_usd"], "bound original")
+                    or revised != money(entry["proposed_revised_reservation_usd"], "bound revised")
+                    or original - revised != money(entry["additional_estimate_correction_usd"], "bound correction")
+                    or cost != money(entry["posted_cost_usd"], "bound posted cost")
+                    or amount != money(entry["additional_overlap_usd"], "bound overlap")):
+                raise CreditGuardError("Additional reconciliation amount or per-app cap changed")
+            amounts += amount; estimates[app] = revised
+            original_total += original; revised_total += revised
+        correction = original_total - revised_total
+        if (amounts != Decimal(".83") or correction != Decimal("5.48")
+                or original_total != Decimal("12.74") or revised_total != Decimal("7.26")
+                or amounts != money(cert["total_additional_overlap_usd"], "additional overlap")
+                or correction != money(cert["total_additional_estimate_correction_usd"], "additional correction")
+                or original_total != money(cert["total_original_reservations_usd"], "additional original total")
+                or revised_total != money(cert["total_revised_estimates_usd"], "additional revised total")):
+            raise CreditGuardError("Additional reconciliation totals changed")
+        history = _pinned_json(root, cert["highwater_evidence"])
+        highwater = money(cert["provider_highwater_floor_usd"], "additional high-water")
+        if highwater != Decimal("4.83274092") or provider_spend(history["billing"]) != highwater:
+            raise CreditGuardError("Additional reconciliation high-water binding changed")
+        fresh = _cost_rows(modal_json("billing", "report", "--start", cert["report_start"],
+            "--end", end.replace(tzinfo=None).isoformat(), "--resolution", "h", "--show-resources",
+            "--json", "--profile", grant["profile"]), start, end)
+        if any(k not in fresh or fresh[k] < value for k, value in saved.items()):
+            raise CreditGuardError("Additional billing attribution missing or revised downward")
+        for app, cap in estimates.items():
+            selected = {k: v for k, v in fresh.items() if k[0] == app}
+            if not selected or any(k[1] != grant["environment"] for k in selected):
+                raise CreditGuardError("Additional billing App ID/environment missing or changed")
+            if sum(selected.values(), Decimal(0)) > cap:
+                raise CreditGuardError("Provider cost exceeds additional revised/full reservation")
+        component = money(billing["metered_cost_breakdown"]["ephemeral_apps"], "fresh compute cost")
+        if sum(fresh.values(), Decimal(0)) > component + Decimal(".00000001") * (len(fresh) + 1):
+            raise CreditGuardError("Additional full report is not included in current summary")
+        return max(observed, highwater), amounts, correction, pin
+    except (OSError, KeyError, TypeError, ValueError, InvalidOperation, SyntaxError) as exc:
+        raise CreditGuardError("Invalid or missing additional reconciliation evidence") from exc
