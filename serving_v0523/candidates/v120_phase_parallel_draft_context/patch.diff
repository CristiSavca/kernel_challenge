--- /dev/null
+++ b/python/sglang/kernels/ops/attention/verify_fp8_cache.py
@@ -0,0 +1,69 @@
+"""Encode a target verification query and scatter its current keys and values."""
+
+import torch
+import triton
+import triton.language as tl
+
+
+def bf16_e4m3_encodings(device):
+    # Use this installation's torch cast, including signed NaNs and overflow.
+    bits = torch.arange(65536, dtype=torch.int32, device=device).to(torch.int16)
+    return bits.view(torch.bfloat16).to(torch.float8_e4m3fn).view(torch.uint8)
+
+
+@triton.jit
+def _encode_and_scatter(
+    Q, K, V, OUT, KC, VC, LOC, TABLE,
+    q_pitch, k_pitch, v_pitch, kc_pitch, vc_pitch, loc_pitch, capacity,
+    Q_WIDTH: tl.constexpr, KV_WIDTH: tl.constexpr, BLOCK: tl.constexpr,
+):
+    row = tl.program_id(0).to(tl.int64)
+    start = tl.program_id(1) * BLOCK
+    cols = start + tl.arange(0, BLOCK)
+    q_bits = tl.load(Q + row * q_pitch + cols, cols < Q_WIDTH, other=0).to(tl.uint32)
+    q8 = tl.load(TABLE + q_bits)
+    tl.store(OUT + row * Q_WIDTH + cols, q8, cols < Q_WIDTH)
+    if start < KV_WIDTH:
+        slot = tl.load(LOC + row * loc_pitch).to(tl.int64)
+        tl.device_assert((slot >= 0) & (slot < capacity), "KV cache slot out of range")
+        if (slot > 0) & (slot < capacity):
+            live = cols < KV_WIDTH
+            k_bits = tl.load(K + row * k_pitch + cols, live, other=0).to(tl.uint32)
+            v_bits = tl.load(V + row * v_pitch + cols, live, other=0).to(tl.uint32)
+            tl.store(KC + slot * kc_pitch + cols, tl.load(TABLE + k_bits), live)
+            tl.store(VC + slot * vc_pitch + cols, tl.load(TABLE + v_bits), live)
+
+
+def encode_verify_qkv(q, k, v, k_cache, v_cache, slots, capacity, table):
+    rows = q.shape[0]
+    if (
+        q.ndim != 2 or not rows or q.stride(1) != 1
+        or k.ndim != 3 or k.shape[0] != rows or v.shape != k.shape
+        or k.stride()[1:] != (k.shape[2], 1) or v.stride()[1:] != k.stride()[1:]
+        or any(t.dtype != torch.bfloat16 for t in (q, k, v))
+        or slots.ndim != 1 or slots.numel() != rows
+        or slots.dtype not in (torch.int32, torch.int64)
+        or any(t.device != q.device for t in (k, v, k_cache, v_cache, slots, table))
+    ):
+        return None
+    q_width, kv_width = q.shape[1], k.shape[1] * k.shape[2]
+    if not (0 < kv_width <= q_width and 0 < capacity):
+        return None
+    for cache in (k_cache, v_cache):
+        if (
+            cache.ndim != 3 or cache.shape[1:] != k.shape[1:]
+            or cache.shape[0] < capacity or cache.stride(0) < kv_width
+            or cache.stride()[1:] != k.stride()[1:]
+            or cache.dtype != torch.float8_e4m3fn
+        ):
+            return None
+    out = torch.empty(q.shape, device=q.device, dtype=torch.float8_e4m3fn)
+    block = min(256, triton.next_power_of_2(q_width))
+    _encode_and_scatter[(rows, triton.cdiv(q_width, block))](
+        q.view(torch.uint16), k.view(torch.uint16), v.view(torch.uint16),
+        out.view(torch.uint8), k_cache.view(torch.uint8), v_cache.view(torch.uint8),
+        slots, table, q.stride(0), k.stride(0), v.stride(0),
+        k_cache.stride(0), v_cache.stride(0), slots.stride(0), capacity,
+        Q_WIDTH=q_width, KV_WIDTH=kv_width, BLOCK=block, num_warps=4, debug=True,
+    )
+    return out
