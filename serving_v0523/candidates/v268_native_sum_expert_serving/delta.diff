+"""Overlap a half-batch QKV projection with the exchange of the other half."""
+
+import torch
+
+from sglang.srt.runtime_context import get_exec, get_lora, get_parallel
+from sglang.srt.utils.custom_op import register_custom_op
+
+
+def half_qkv_eligible(rows, channels, size):
+    # Both GEMMs should have enough rows to amortize a second weight read and launch.
+    return rows >= 512 and (size // 2) * rows >= channels
+
+
+def _exchange_half(comm, rank, base, local, cohort):
+    """Gather all token shards within this half of the tensor-parallel group."""
+    cohort[rank - base].copy_(local)
+    comm.group_start()
+    try:
+        for offset in range(cohort.shape[0]):
+            peer = base + offset
+            if peer != rank:
+                comm.send(local, peer)
+                comm.recv(cohort[offset], peer)
+    finally:
+        comm.group_end()
+
+
+def _exchange_peer(comm, buddy, owned, remote):
+    comm.group_start()
+    try:
+        comm.send(owned, buddy)
+        comm.recv(remote, buddy)
+    finally:
+        comm.group_end()
+
+
+def enable_half_qkv(linears, group):
+    from sglang.srt.batch_invariant_ops import is_batch_invariant_mode_enabled
+    from sglang.srt.environ import envs
+    from sglang.srt.layers.quantization.unquant import UnquantizedLinearMethod
+
+    size = group.world_size
+    if size < 4 or size % 2 or torch.distributed.get_backend(group.cpu_group) != "gloo":
+        return
+    comm = group.pynccl_comm
+    ready = (
+        comm is not None and comm.available and not get_lora().enable_lora
+        and get_parallel().attn_tp_group.ranks == group.ranks
+        and torch.cuda.get_device_capability(comm.device)[0] == 9
+        and not get_exec().deterministic.enable_deterministic_inference
+        and not envs.SGLANG_ENABLE_DETERMINISTIC_INFERENCE.get()
+        and not is_batch_invariant_mode_enabled() and not torch.is_autocast_enabled()
+        and not torch.are_deterministic_algorithms_enabled()
+        and all(
+            type(fc.quant_method) is UnquantizedLinearMethod and "apply" not in vars(fc.quant_method)
+            and fc.bias is None and not fc.gather_output and fc.weight.device == comm.device
+            and fc.weight.dtype == torch.bfloat16 and not fc.weight.requires_grad
+            and fc.weight.ndim == 2 and fc.weight.is_contiguous()
+            for fc in linears
+        )
+    )
+    vote = torch.tensor(int(ready), dtype=torch.int32, device="cpu")
+    torch.distributed.all_reduce(vote, op=torch.distributed.ReduceOp.MIN, group=group.cpu_group)
+    if not vote.item():
+        return
+    # Establish these peer connections before the first graph capture.
+    half, rank = size // 2, group.rank_in_group
+    probe = torch.zeros(1, dtype=torch.bfloat16, device=comm.device)
+    owned = probe.new_empty((half, 1))
+    remote = torch.empty_like(owned)
+    with comm.change_state(enable=True):
+        _exchange_half(comm, rank, (rank // half) * half, probe, owned)
+        _exchange_peer(comm, (rank + half) % size, owned, remote)
+    group.sp_qkv_cohort_stream = torch.cuda.Stream(device=comm.device)
+    for fc in linears:
+        fc._sp_half_qkv = fc.quant_method
+
+
+def _half_qkv_shape(local: torch.Tensor, weight: torch.Tensor, size: int, dispatch: bool):
+    return local.new_empty((local.shape[0] * size, weight.shape[0]))
+
+
+def _project(rows, weight, dest, dispatch):
+    if dispatch:
+        from sglang.srt.layers.quantization.unquant import bf16_gemm_dispatch
+
+        dest.copy_(bf16_gemm_dispatch(rows, weight, None))
+    else:
+        # This is the same out-parameter path used by UnquantizedLinearMethod.apply_into.
+        torch.mm(rows, weight.t(), out=dest)
+
+
+@register_custom_op(fake_impl=_half_qkv_shape)
+def half_qkv(local: torch.Tensor, weight: torch.Tensor, size: int, dispatch: bool) -> torch.Tensor:
+    group = get_parallel().tp_group
+    rank, half = group.rank_in_group, size // 2
+    base = (rank // half) * half
+    rows, hidden = local.shape
+    owned = local.new_empty((half, rows, hidden))
+    remote = torch.empty_like(owned)
+    output = local.new_empty((size * rows, weight.shape[0]))
+    compute = torch.cuda.current_stream(local.device)
+    transfer = group.sp_qkv_cohort_stream
+    comm = group.pynccl_comm
+    with comm.change_state(enable=True):
+        _exchange_half(comm, rank, base, local, owned)
+        transfer.wait_stream(compute)
+        try:
+            with torch.cuda.stream(transfer):
+                _exchange_peer(comm, (rank + half) % size, owned, remote)
+            _project(owned.flatten(0, 1), weight, output.narrow(0, base * rows, half * rows), dispatch)
+        finally:
+            # Join even if projection fails. Both buffers were allocated on the caller stream.
+            compute.wait_stream(transfer)
+        _project(remote.flatten(0, 1), weight, output.narrow(0, (half - base) * rows, half * rows), dispatch)
+    return output
