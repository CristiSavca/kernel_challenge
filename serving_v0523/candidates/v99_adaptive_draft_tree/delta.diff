+@triton.jit
+def _select_chain_or_tree(
+    Original, Chain, Advantage, Selected, PLANE, WIDTH: tl.constexpr, BLOCK: tl.constexpr
+):
+    request = tl.program_id(0)
+    nodes = tl.arange(0, BLOCK)
+    offsets = request * WIDTH + nodes
+    active = nodes < WIDTH
+    chain = tl.load(Advantage + request) > 0
+    tokens = tl.load(Original + offsets, active, other=0)
+    depths = tl.load(Original + PLANE + offsets, active, other=0)
+    parents = tl.load(Original + 2 * PLANE + offsets, active, other=-1)
+    ancestors = tl.load(Original + 3 * PLANE + offsets, active, other=0)
+    native_tokens = tl.load(Chain + offsets, active, other=0)
+    tl.store(Selected + offsets, tl.where(chain, native_tokens, tokens), active)
+    tl.store(Selected + PLANE + offsets, tl.where(chain, nodes, depths), active)
+    tl.store(Selected + 2 * PLANE + offsets, tl.where(chain, nodes - 1, parents), active)
+    chain_ancestors = (1 << (nodes + 1)) - 1
+    tl.store(Selected + 3 * PLANE + offsets, tl.where(chain, chain_ancestors, ancestors), active)
+
+
+def select_dflash_tree(original, chain, advantage):
+    batch, width = chain.shape
+    selected = torch.empty_like(original.data)
+    _select_chain_or_tree[(batch,)](
+        original.data, chain, advantage, selected, batch * width, width,
+        triton.next_power_of_2(width), num_warps=1,
+    )
+    return DFlashTree(selected)
+
+
+@triton.jit
+def _update_tree_advantage(
+    TreeTokens, Parents, Chain, Committed, Lengths, Advantage, Next,
+    WIDTH: tl.constexpr, BLOCK: tl.constexpr,
+):
+    request = tl.program_id(0)
+    nodes = tl.arange(0, BLOCK)
+    offset = request * WIDTH
+    observed = tl.load(Lengths + request)
+    targets = tl.load(Committed + offset + nodes, nodes < observed, other=0)
+    chain = tl.load(Chain + offset + nodes + 1, nodes < WIDTH - 1, other=0)
+    mismatch = (nodes < observed) & (nodes < WIDTH - 1) & (targets != chain)
+    chain_matches = tl.minimum(observed, tl.min(tl.where(mismatch, nodes, WIDTH - 1)))
+
+    tokens = tl.load(TreeTokens + offset + nodes, nodes < WIDTH, other=0)
+    parents = tl.load(Parents + offset + nodes, nodes < WIDTH, other=-2)
+    leader = tl.full((), 0, tl.int32)
+    tree_matches = tl.full((), 0, tl.int32)
+    for i in range(WIDTH - 1):
+        target = tl.load(Committed + offset + i, i < observed, other=0)
+        child = tl.min(tl.where((parents == leader) & (tokens == target), nodes, WIDTH))
+        matched = (i < observed) & (leader >= 0) & (child < WIDTH)
+        tree_matches += matched.to(tl.int32)
+        leader = tl.where(matched, child, -1)
+
+    # Include the bonus and cap both alternatives at the physical row budget.
+    # Matching every observed token certifies a win when a slot remains. The
+    # unobserved suffix can change the margin, so use only the comparison.
+    chain_reward = tl.minimum(WIDTH, chain_matches + 1)
+    tree_reward = tl.minimum(WIDTH, tree_matches + 1)
+    vote = (chain_reward > tree_reward).to(tl.int32) - (chain_reward < tree_reward).to(tl.int32)
+    prior = tl.load(Advantage + request)
+    decay = (prior > 0).to(tl.int32) - (prior < 0).to(tl.int32)
+    tl.store(Next + request, tl.maximum(-WIDTH, tl.minimum(WIDTH, prior - decay + 2 * vote)))
+
+
+def update_dflash_tree_advantage(original, chain, committed, lengths, advantage):
+    batch, width = chain.shape
+    updated = torch.empty_like(advantage)
+    _update_tree_advantage[(batch,)](
+        original.tokens, original.parents, chain, committed, lengths, advantage,
+        updated, width, triton.next_power_of_2(width), num_warps=1,
+    )
+    return updated
+
+
