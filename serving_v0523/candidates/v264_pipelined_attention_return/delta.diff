--- a/python/sglang/srt/layers/layernorm_sp.py
+++ b/python/sglang/srt/layers/layernorm_sp.py
@@ -296,6 +296,20 @@ def row_parallel_gbar_matmul(linear, input_: torch.Tensor, bias) -> torch.Tensor
     x = input_.contiguous()
     if getattr(linear, "_sp_unfused_collective", False):
         group = linear.tp_group
+        stream = getattr(linear, "_sp_return_stream", None)
+        if (
+            stream is not None and bias is None and not torch.compiler.is_compiling()
+            and linear.quant_method is linear._sp_return_method and "apply" not in vars(linear.quant_method)
+            and x.ndim == 2 and x.dtype == torch.bfloat16 and not x.requires_grad
+            and not torch.is_autocast_enabled() and not torch.are_deterministic_algorithms_enabled()
+            and not group.is_symmetric_memory_enabled()
+        ):
+            from sglang.srt.layers.communication.sp_attention_return import striped_attention_return, striped_return_eligible
+
+            if striped_return_eligible(x.shape[0], linear.weight.shape[0]):
+                shard = striped_attention_return(x, linear.weight, group, stream)
+                if shard is not None:
+                    return shard
         with group.use_symmetric_memory(group):
             full = linear.quant_method.apply(linear, x, bias)
         return reduce_scatter_token_rows(full, group)
