+++ b/python/sglang/kernels/ops/speculative/dflash_committed_projection.py
@@ -0,0 +1,82 @@
+"""BF16 target-context projection over the rows retained by tree verification."""
+
+import torch
+import triton
+import triton.language as tl
+
+
+@triton.jit
+def _plan_rows(Order, Lengths, Plan, n_rows, WIDTH: tl.constexpr, BLOCK: tl.constexpr):
+    rows = tl.arange(0, BLOCK)
+    request = rows // WIDTH
+    live = (rows < n_rows) & (rows % WIDTH < tl.load(Lengths + request, rows < n_rows, other=0))
+    source = request * WIDTH + tl.load(Order + rows, live, other=0).to(tl.int32)
+    compact = tl.cumsum(live.to(tl.int32)) - 1
+    tl.store(Plan + compact, source, live)
+    tl.store(Plan + n_rows + compact, rows, live)
+    tl.store(Plan + 2 * n_rows, tl.sum(live.to(tl.int32)))
+
+
+@triton.jit
+def _project(
+    Hidden, Weight, Plan, Output,
+    n_rows, N: tl.constexpr, K: tl.constexpr,
+    BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr,
+):
+    first = tl.program_id(0) * BM
+    count = tl.load(Plan + 2 * n_rows)
+    if first >= count:
+        return
+    row = first + tl.arange(0, BM)
+    source = tl.load(Plan + row, row < count, other=0).to(tl.int64)
+    dest = tl.load(Plan + n_rows + row, row < count, other=0).to(tl.int64)
+    col = tl.program_id(1) * BN + tl.arange(0, BN)
+    inner = tl.arange(0, BK)
+    x = Hidden + source[:, None] * K + inner[None, :]
+    w = Weight + col[:, None].to(tl.int64) * K + inner[None, :]
+    acc = tl.full((BM, BN), 0, tl.float32)
+    for _ in range(K // BK):
+        a = tl.load(x, row[:, None] < count, other=0)
+        b = tl.load(w)
+        acc = tl.dot(a, tl.trans(b), acc)
+        x += BK
+        w += BK
+    tl.store(Output + dest[:, None] * N + col[None, :], acc, row[:, None] < count)
+
+
+def project_committed_rows(hidden, weight, order, lengths):
+    rows, k = hidden.shape
+    n, weight_k = weight.shape
+    batch, width = order.shape
+    # Below four row tiles there is little work to eliminate. Bound the
+    # single-CTA prefix scan by its own capacity, independently of batch size.
+    if (
+        not hidden.is_cuda
+        or hidden.dtype != torch.bfloat16
+        or weight.dtype != hidden.dtype
+        or weight.device != hidden.device
+        or order.device != hidden.device
+        or lengths.device != hidden.device
+        or order.dtype != torch.int64
+        or lengths.dtype != torch.int32
+        or lengths.shape != (batch,)
+        or rows != batch * width
+        or not 64 <= rows <= 2048
+        or width < 2
+        or k != weight_k
+        or k % 64 or n % 32
+        or not all(t.is_contiguous() for t in (hidden, weight, order, lengths))
+        or torch.cuda.get_device_capability(hidden.device) != (9, 0)
+        or torch.are_deterministic_algorithms_enabled()
+    ):
+        return None
+    plan = torch.empty(2 * rows + 1, dtype=torch.int32, device=hidden.device)
+    # Inactive rows have defined zero values. The prefix-valid KV writer
+    # only publishes live rows from each request.
+    local = hidden.new_zeros((rows, n))
+    scan_block = max(256, triton.next_power_of_2(rows))
+    _plan_rows[(1,)](order, lengths, plan, rows, width, scan_block)
+    _project[(triton.cdiv(rows, 16), n // 32)](
+        hidden, weight, plan, local, rows, n, k, 16, 32, 64,
+    )
+    return local
