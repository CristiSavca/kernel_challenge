+@torch.compile(dynamic=True, backend=get_compiler_backend(), disable=_is_npu)
+def _candidate_word_ids(words, slots, starts):
+    k = words.shape[2]
+    owners = slots // k
+    rows = torch.arange(words.shape[1], device=words.device)[:, None]
+    return (words[owners, rows, slots % k] & 65535).long() + starts[owners]
+
