+@torch.compile(dynamic=True, backend=get_compiler_backend(), disable=_is_npu)
+def _rank_ordered_candidate_bits(words):
+    # Match the native contiguous [row, rank * k + local_slot] score matrix.
+    bits = (words >> 16).to(torch.int16)
+    return bits.transpose(0, 1).reshape(words.shape[1], -1).contiguous()
+
+
+def _candidate_word_scores(words, dtype):
+    return _rank_ordered_candidate_bits(words).view(dtype).float()
+
