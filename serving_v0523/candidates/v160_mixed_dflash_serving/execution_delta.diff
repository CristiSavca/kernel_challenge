+    def _run_mixed_dflash_roles(self, roles, *, on_publish, grammar_barrier=None):
+        from sglang.srt.speculative.dflash_mixed_forward import (
+            start_mixed_prefix_readback,
+            try_forward_proposed_mixed,
+        )
+        from sglang.srt.speculative.draft_worker_common import make_draft_input_v2
+
+        prompt, decode = roles
+        worker = self.model_worker
+        with (
+            self._forward_isolation(prompt, overlap=False),
+            self._forward_isolation(decode, overlap=False),
+        ):
+            # Both forwards use this outer iteration's ring entry. Opening a
+            # second overlap iteration here would retire the previous entry.
+            keep_alive = self.batch_record_buf[self.batch_record_ct]
+            for role in roles:
+                keep_alive.append([getattr(role, f.name) for f in dataclasses.fields(role)])
+
+            prefix_readback = start_mixed_prefix_readback(decode)
+            proposal = worker.propose_decode_block(decode)
+            result = try_forward_proposed_mixed(
+                worker, prompt, decode, proposal, on_publish=on_publish, prefix_readback=prefix_readback
+            )
+            if result is not None:
+                return result
+
+            # A rank declined before target execution. The proposal still owns
+            # the worker scratch. Consume it before running any further forward.
+            tail_result = worker.verify_proposed_decode_block(
+                decode, proposal, grammar_barrier=grammar_barrier
+            )
+            # Release the consumed full-vocabulary verifier rows before prompt allocation.
+            tail_result.logits_output.next_token_logits = None
+            prompt_result = worker.forward_batch_generation(prompt)
+            prompt_result.logits_output.next_token_logits = None
+        # Native verification temporarily turns its input batch into TARGET_VERIFY.
+        # The isolation scopes above restore the original role snapshots for the host.
+        relay = make_draft_input_v2(
+            bonus_tokens=torch.cat((
+                prompt_result.next_draft_input.bonus_tokens,
+                tail_result.next_draft_input.bonus_tokens,
+            )),
+            new_seq_lens=torch.cat((
+                prompt_result.new_seq_lens,
+                tail_result.new_seq_lens,
+            )),
+        )
+        result = MixedDFlashResult.from_role_results(
+            prompt, decode, prompt_result, tail_result, relay, shared_target=False
+        )
+        on_publish(relay.new_seq_lens)
+        return result
+
