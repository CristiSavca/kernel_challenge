+def start_mixed_prefix_readback(decode_batch):
+    """Queue a bounded copy of resolved lengths before drafting on the same stream."""
+    base = decode_batch.seq_lens
+    if (decode_batch.seq_lens_cpu is not None or base is None or not base.is_cuda
+            or base.dtype != torch.int64 or base.shape != (len(decode_batch.reqs),)
+            or not decode_batch.reqs):
+        return None
+    stream = torch.cuda.current_stream(base.device)
+    host = torch.empty(base.shape, dtype=base.dtype, device="cpu", pin_memory=True)
+    # Retain any cross-stream source allocation through the copy. ATen's
+    # nonblocking copy records the host allocation on this stream as well.
+    base.record_stream(stream)
+    host.copy_(base, non_blocking=True)
+    ready = torch.cuda.Event()
+    ready.record(stream)
+    return base, host, ready
+
