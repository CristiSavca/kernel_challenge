+    if not all(prefill.can_run_graph(view) for view in (prompt, mixed)) or not decode.can_run_graph(verify):
+        return None
+    prompt_rows = prefill._pad_to_bucket(q, prefill.capture_num_tokens)
+    mixed_rows = prefill._pad_to_bucket(q + b * width, prefill.capture_num_tokens)
+    verify_bs = decode._pad_to_bucket(b, decode.capture_bs)
+    verify_rows = verify_bs * width
+    if mixed_rows > prompt_rows + verify_rows:
+        return None
+    # The native eligibility checks can admit a padded size before consulting the
+    # backend. Check the installed graph keys, including its real attention variant.
+    verify_key = decode._make_graph_key(
+        decode._capture_graph_size(bs=verify_bs, num_tokens=verify_rows),
+        variant_label=decode._resolve_lora_variant(verify),
+        attention_variant=decode._resolve_attention_variant(verify, verify_bs),
+    )
+    if not decode.backend.can_run(verify, verify_key) or not all(
+        prefill.backend.can_run(view, prefill._shape_key(n, view))
+        for view, n in ((prompt, prompt_rows), (mixed, mixed_rows))
+    ):
+        return None
+    return DFlashMixedGraphPlan(prompt_rows, verify_rows, mixed_rows)
+
+
+def agree_mixed_dflash_target(local_plan, *, cohort_signature=None):
+    """All TP ranks call at the same scheduling point, including on a local decline."""
+    group = get_parallel().tp_group
+    if group.world_size == 1:
+        return local_plan
+    if local_plan is None:
+        values = [-1, -1, -1]
+    else:
+        values = [local_plan.prompt_rows, local_plan.verify_rows, local_plan.mixed_rows]
+    if cohort_signature is not None:
+        values.extend(cohort_signature)
+    vote = torch.tensor(values + [-v for v in values], dtype=torch.int64, device="cpu")
+    dist.all_reduce(vote, op=dist.ReduceOp.MIN, group=group.cpu_group)
+    result = vote.tolist()
+    minima, neg_maxima = result[:len(values)], result[len(values):]
+    if any(lo < 0 or lo != -neg_hi for lo, neg_hi in zip(minima, neg_maxima)):
+        return None
+    return DFlashMixedGraphPlan(*minima[:3])
