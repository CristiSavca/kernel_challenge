index 0000000..f71dc09
--- /dev/null
+++ b/python/sglang/srt/layers/attention/prefill_kv_span.py
@@ -0,0 +1,292 @@
+"""Prove that a page-one cache can be viewed in place by native FA3 prefill."""
+from dataclasses import dataclass
+
+import torch
+import triton
+import triton.language as tl
+
+_PAGE = 160
+
+
+@triton.jit
+def _check_span_tiles(
+    Table, Lengths, Pages, Flags, Highest, row_stride, width, ntiles,
+    SINGLE: tl.constexpr,
+):
+    tile = tl.program_id(0)
+    batch = tl.program_id(1)
+    first = tl.load(Table).to(tl.int64)
+    length0 = tl.load(Lengths).to(tl.int64)
+    stride = length0
+    if not SINGLE:
+        stride = tl.load(Table + row_stride).to(tl.int64) - first
+    base = Table + batch.to(tl.int64) * row_stride
+    length = tl.load(Lengths + batch)
+    start = tl.load(base).to(tl.int64)
+    begin = tile * 160
+    page = tl.load(base + begin).to(tl.int64)
+    lanes = tl.arange(0, 256)
+    cols = begin + lanes
+    live = (lanes < 160) & (cols < length) & (cols < width)
+    ids = tl.load(base + cols, mask=live, other=0).to(tl.int64)
+    bad_id = live & ((ids <= 0) | (ids >= 2147483648))
+    invalid = (length <= 0) | (length > width) | (tl.max(bad_id.to(tl.int32), 0) != 0)
+    dense_bad = (
+        invalid | (length != length0) | (stride < length0)
+        | (start != first + batch.to(tl.int64) * stride)
+        | (tl.max((live & (ids != start + cols)).to(tl.int32), 0) != 0)
+    )
+    residue = first % 160
+    coarse_bad = (
+        invalid | (length % 160 != 0) | ((begin < length) & (page % 160 != residue))
+        | (tl.max((live & (ids != page + lanes)).to(tl.int32), 0) != 0)
+    )
+    slot = batch * ntiles + tile
+    tl.store(Pages + slot, tl.where(begin < length, (page - residue) // 160, 0))
+    tl.store(Flags + slot, dense_bad.to(tl.int32) | (coarse_bad.to(tl.int32) << 1))
+    tl.store(Highest + slot, tl.max(tl.where(live, ids, 0), 0))
+
+
+@triton.jit
+def _finish_span_check(
+    Table, Lengths, Flags, Highest, Status, row_stride, tiles,
+    SINGLE: tl.constexpr, BLOCK: tl.constexpr,
+):
+    offsets = tl.arange(0, BLOCK)
+    flags = tl.load(Flags + offsets, offsets < tiles, 0)
+    first = tl.load(Table).to(tl.int64)
+    length = tl.load(Lengths).to(tl.int64)
+    stride = length
+    if not SINGLE:
+        stride = tl.load(Table + row_stride).to(tl.int64) - first
+    tl.store(Status, tl.max(flags & 1, 0) == 0)
+    tl.store(Status + 1, tl.max(flags & 2, 0) == 0)
+    tl.store(Status + 2, first)
+    tl.store(Status + 3, stride)
+    tl.store(Status + 4, length)
+    tl.store(Status + 5, tl.max(tl.load(Highest + offsets, offsets < tiles, 0), 0))
+
+
+def _inspect_slots(table, lengths):
+    batch, width = table.shape
+    ntiles = triton.cdiv(width, _PAGE)
+    total = batch * ntiles
+    pages, flags, highest = torch.empty((3, batch, ntiles), device=table.device, dtype=torch.int32).unbind()
+    status = torch.empty(6, device=table.device, dtype=torch.int64)
+    _check_span_tiles[(ntiles, batch)](
+        table, lengths, pages, flags, highest, table.stride(0), width, ntiles, SINGLE=batch == 1,
+    )
+    _finish_span_check[(1,)](
+        table, lengths, flags, highest, status, table.stride(0), total,
+        SINGLE=batch == 1, BLOCK=triton.next_power_of_2(total),
+    )
+    return status, pages
+
+
+@dataclass
+class PrefillKVSpan:
+    table: torch.Tensor
+    lengths: torch.Tensor
+    query_rows: int
+    pages: torch.Tensor | None
+    host: torch.Tensor
+    ready: object
+    outcome: object = None
+
+    def __post_init__(self):
+        # Ordinary EXTEND owns a new advanced-indexed physical table each pass.
+        # Versioned tensors can additionally detect an in-place metadata change.
+        self.table_version = None if torch.is_inference(self.table) else self.table._version
+        self.length_version = None if torch.is_inference(self.lengths) else self.lengths._version
+
+    def view(self, key, value, table, lengths, query_rows):
+        if (
+            table is not self.table or lengths is not self.lengths or query_rows != self.query_rows
+            or (self.table_version is not None and table._version != self.table_version)
+            or (self.length_version is not None and lengths._version != self.length_version)
+            or key.ndim != 4 or value.shape != key.shape or key.shape[1] != 1
+            or key.dtype != torch.float8_e4m3fn or value.dtype != key.dtype
+            or key.device != table.device or value.device != key.device
+            or key.shape[-1] != 64 or key.shape[-2] < 1
+            or any(
+                t.stride(-1) != 1 or t.stride(-2) < 64 or t.stride(-2) % 16
+                or t.stride(0) < t.shape[-2] * t.stride(-2) or t.stride(0) % 16
+                or t.data_ptr() % 16 for t in (key, value)
+            )
+        ):
+            return key, value, table
+        if self.outcome is None:
+            if not self.ready.query():
+                return key, value, table
+            self.outcome = tuple(self.host.tolist())
+        dense, coarse, first, stride, length, highest = self.outcome
+        if highest >= key.shape[0] or highest >= 2**31:
+            return key, value, table
+        if dense:
+            batch = table.shape[0]
+
+            def as_dense(tensor):
+                rows = tensor.narrow(0, first, (batch - 1) * stride + length)[:, 0]
+                return rows.as_strided(
+                    (batch, length, *rows.shape[1:]),
+                    (stride * rows.stride(0), *rows.stride()),
+                )
+
+            return as_dense(key), as_dense(value), None
+        if coarse:
+            residue = first % _PAGE
+            count = (highest - residue + 1) // _PAGE
+
+            def as_pages(tensor):
+                rows = tensor.narrow(0, residue, count * _PAGE)[:, 0]
+                return rows.unflatten(0, (count, _PAGE))
+
+            # The eager attention break may consume metadata on another stream.
+            if self.pages.is_cuda:
+                self.pages.record_stream(torch.cuda.current_stream(self.pages.device))
+            return as_pages(key), as_pages(value), self.pages
+        return key, value, table
+
+
+def _can_inspect(table, lengths):
+    from sglang.srt.batch_invariant_ops import is_batch_invariant_mode_enabled
+
+    if (
+        table is None or table.ndim != 2 or table.device.type != "cuda"
+        or table.shape[0] == 0 or table.shape[1] < 512 or table.stride(1) != 1
+        or table.dtype not in (torch.int32, torch.int64) or lengths is None
+        or lengths.shape != (table.shape[0],) or lengths.dtype != torch.int32
+        or lengths.device != table.device or not lengths.is_contiguous()
+        or torch.compiler.is_compiling() or torch.cuda.current_device() != table.device.index
+        or torch.cuda.is_current_stream_capturing() or is_batch_invariant_mode_enabled()
+    ):
+        return False
+    return True
+
+
+def _publish_span(table, lengths, query_rows, status, pages):
+    host = torch.empty_like(status, device="cpu", pin_memory=True)
+    host.copy_(status, non_blocking=True)
+    ready = torch.cuda.Event()
+    ready.record(torch.cuda.current_stream(table.device))
+    return PrefillKVSpan(table, lengths, query_rows, pages, host, ready)
+
+
+def prepare_prefill_kv_span(table, lengths, query_rows):
+    if not _can_inspect(table, lengths) or table.numel() > 262144:
+        return None
+    status, pages = _inspect_slots(table, lengths)
+    return _publish_span(table, lengths, query_rows, status, pages)
+
+
+@triton.jit
+def _check_window_rows(
+    Table, Lengths, CuQ, First, Visible, Valid,
+    pitch, source_width, span_width, batch_size, num_tiles, query_rows, left,
+    BLOCK: tl.constexpr,
+):
+    tile, row = tl.program_id(0), tl.program_id(1)
+    q0 = tl.load(CuQ + row).to(tl.int64)
+    q1 = tl.load(CuQ + row + 1).to(tl.int64)
+    q = q1 - q0
+    k = tl.load(Lengths + row).to(tl.int64)
+    # Bottom-right causal attention aligns this chunk's first query at K-Q.
+    # No query in the chunk can read keys before the inclusive left boundary.
+    skip = tl.maximum(0, k - q - left)
+    length = k - skip
+    legal = (
+        (q0 >= 0) & (q1 <= query_rows) & (q > 0) & (k >= q) & (k <= source_width)
+        & (length > 0) & (length <= span_width)
+        & ((row != 0) | (q0 == 0)) & ((row != batch_size - 1) | (q1 == query_rows))
+    )
+    start_ptr = Table + row.to(tl.int64) * pitch + skip
+    first = tl.load(start_ptr, mask=legal, other=0).to(tl.int64)
+    col = tile * BLOCK + tl.arange(0, BLOCK)
+    active = legal & (col < length)
+    physical = tl.load(start_ptr + col, mask=active, other=0).to(tl.int64)
+    different = tl.max((active & (physical != first + col)).to(tl.int32), 0)
+    valid = legal & (first > 0) & (first <= 2147483648 - length) & (different == 0)
+    tl.store(Valid + row * num_tiles + tile, valid)
+    if tile == 0:
+        tl.store(First + row, first)
+        tl.store(Visible + row, tl.where(legal, length, 0))
+
+
+@triton.jit
+def _finish_window_rows(
+    First, Visible, Valid, Status, batch, tiles, SINGLE: tl.constexpr,
+    ROW_BLOCK: tl.constexpr, TILE_BLOCK: tl.constexpr,
+):
+    rows = tl.arange(0, ROW_BLOCK)
+    offsets = tl.arange(0, TILE_BLOCK)
+    first = tl.load(First)
+    length = tl.load(Visible).to(tl.int64)
+    stride = length
+    if not SINGLE:
+        stride = tl.load(First + 1) - first
+    starts = tl.load(First + rows, rows < batch, 0)
+    sizes = tl.load(Visible + rows, rows < batch, 0)
+    wrong_shape = (sizes != length) | (starts != first + rows.to(tl.int64) * stride)
+    dense = (
+        (stride >= length) & (tl.max(((rows < batch) & wrong_shape).to(tl.int32), 0) == 0)
+        & (tl.min(tl.load(Valid + offsets, offsets < tiles, 1), 0) != 0)
+    )
+    tl.store(Status, dense)
+    tl.store(Status + 1, 0)  # Local Hopper FA3 needs a dense descriptor for TMA.
+    tl.store(Status + 2, first)
+    tl.store(Status + 3, stride)
+    tl.store(Status + 4, length)
+    tl.store(Status + 5, first + (batch - 1) * stride + length - 1)
+
+
+@dataclass
+class WindowKVSpan:
+    layout: PrefillKVSpan
+    cu_q: torch.Tensor
+    visible: torch.Tensor
+    left: int
+
+    def __post_init__(self):
+        self.query_version = None if torch.is_inference(self.cu_q) else self.cu_q._version
+
+    def view(self, key, value, table, lengths, query_rows, cu_q, window):
+        if (
+            cu_q is not self.cu_q or window != (self.left, 0)
+            or (self.query_version is not None and cu_q._version != self.query_version)
+        ):
+            return key, value, table, lengths
+        new_key, new_value, pages = self.layout.view(key, value, table, lengths, query_rows)
+        if pages is not None or table is None:
+            return key, value, table, lengths
+        if self.visible.is_cuda:
+            self.visible.record_stream(torch.cuda.current_stream(self.visible.device))
+        return new_key, new_value, None, self.visible
+
+
+def prepare_window_kv_span(table, lengths, cu_q, query_rows, max_q, left):
+    if (
+        not _can_inspect(table, lengths) or left < 0 or max_q <= 0 or query_rows <= 0
+        or cu_q is None or cu_q.device != table.device or cu_q.dtype != torch.int32
+        or cu_q.shape != (table.shape[0] + 1,) or not cu_q.is_contiguous()
+    ):
+        return None
+    batch, source_width = table.shape
+    width = min(source_width, max_q + left)
+    if batch * width > 262144:
+        return None
+    block = 256
+    tiles = triton.cdiv(width, block)
+    first = torch.empty(batch, device=table.device, dtype=torch.int64)
+    visible = torch.empty_like(lengths)
+    valid = torch.empty((batch, tiles), device=table.device, dtype=torch.int32)
+    status = torch.empty(6, device=table.device, dtype=torch.int64)
+    _check_window_rows[(tiles, batch)](
+        table, lengths, cu_q, first, visible, valid, table.stride(0), source_width, width,
+        batch, tiles, query_rows, left, BLOCK=block,
+    )
+    _finish_window_rows[(1,)](
+        first, visible, valid, status, batch, batch * tiles, SINGLE=batch == 1,
+        ROW_BLOCK=triton.next_power_of_2(batch), TILE_BLOCK=triton.next_power_of_2(batch * tiles),
+    )
+    layout = _publish_span(table, lengths, query_rows, status, None)
+    return WindowKVSpan(layout, cu_q, visible, left)
