+struct MuseRoutePair {
+  static void run(tvm::ffi::TensorView inputs, tvm::ffi::TensorView local_ids,
+                  tvm::ffi::TensorView gate, tvm::ffi::TensorView gs, tvm::ffi::TensorView gscale,
+                  tvm::ffi::TensorView down, tvm::ffi::TensorView ds, tvm::ffi::TensorView dscale,
+                  tvm::ffi::TensorView active, tvm::ffi::TensorView outputs, tvm::ffi::TensorView plan, int64_t groups) {
+    using namespace host;
+    using namespace muse_route_pair;
+    auto m = SymbolicSize{"tokens"}, h = SymbolicSize{"hidden"}, top = SymbolicSize{"top_k"};
+    auto e = SymbolicSize{"experts"}, n = SymbolicSize{"inner"}, s = SymbolicSize{"slots"};
+    auto kg = SymbolicSize{"gate groups"}, wg = SymbolicSize{"gate words"}, ng = SymbolicSize{"gate channels"};
+    auto kd = SymbolicSize{"down groups"}, wd = SymbolicSize{"down words"}, cells = SymbolicSize{"plan"};
+    auto dev = SymbolicDevice{};
+    dev.set_options<kDLCUDA>();
+    TensorMatcher({m, h}).with_dtype<bf16_t>().with_device(dev).verify(inputs);
+    TensorMatcher({m, top}).with_dtype<int32_t>().with_device(dev).verify(local_ids);
+    TensorMatcher({e, kg, wg}).with_dtype<int32_t>().with_device(dev).verify(gate);
+    TensorMatcher({e, kg, ng}).with_dtype<uint8_t>().with_device(dev).verify(gs);
+    TensorMatcher({e, kd, wd}).with_dtype<int32_t>().with_device(dev).verify(down);
+    TensorMatcher({e, kd, h}).with_dtype<uint8_t>().with_device(dev).verify(ds);
+    TensorMatcher({e}).with_dtype<bf16_t>().with_device(dev).verify(gscale);
+    TensorMatcher({e}).with_dtype<bf16_t>().with_device(dev).verify(dscale);
+    TensorMatcher({s, n}).with_dtype<bf16_t>().with_device(dev).verify(active);
+    TensorMatcher({s, h}).with_dtype<bf16_t>().with_device(dev).verify(outputs);
+    TensorMatcher({cells}).with_dtype<int32_t>().with_device(dev).verify(plan);
+    const auto slots = s.unwrap(), experts = e.unwrap(), inner = n.unwrap(), hidden = h.unwrap();
+    const auto used = std::min(slots, experts), bound = used + (slots - used) / kRows;
+    RuntimeCheck(slots > 0 && slots <= 1024 && experts > 0 && experts <= 64 && slots == m.unwrap() * top.unwrap()
+                 && groups > 0 && groups <= used && cells.unwrap() == 1 + (kRows + 1) * bound, "invalid route plan dimensions");
+    RuntimeCheck(hidden > 0 && inner > 0 && hidden % (64 * kWarps) == 0 && inner % (64 * kWarps) == 0
+                 && kg.unwrap() * 16 == hidden && kd.unwrap() * 16 == inner && ng.unwrap() == 2 * inner
+                 && wg.unwrap() == 4 * inner && wd.unwrap() == 2 * hidden, "incompatible expert banks");
+    auto* work = static_cast<int32_t*>(plan.data_ptr());
+    const auto smem = kPlannerWarps * slots * sizeof(int32_t);
+    LaunchKernel(1, 32 * kPlannerWarps, dev.unwrap(), smem)(
+        plan_routes, static_cast<const int32_t*>(local_ids.data_ptr()), work, uint32_t(slots), uint32_t(experts));
+    const Projection up{
+        static_cast<const bf16_t*>(inputs.data_ptr()), static_cast<bf16_t*>(active.data_ptr()),
+        {static_cast<const uint32_t*>(gate.data_ptr()), static_cast<const uint8_t*>(gs.data_ptr())},
+        static_cast<const bf16_t*>(gscale.data_ptr()), work, uint32_t(hidden), uint32_t(inner), uint32_t(top.unwrap())};
+    const Projection out{
+        static_cast<const bf16_t*>(active.data_ptr()), static_cast<bf16_t*>(outputs.data_ptr()),
+        {static_cast<const uint32_t*>(down.data_ptr()), static_cast<const uint8_t*>(ds.data_ptr())},
+        static_cast<const bf16_t*>(dscale.data_ptr()), work, uint32_t(inner), uint32_t(hidden), 1};
+    LaunchKernel(dim3(inner / (64 * kWarps), groups), 32 * kWarps, dev.unwrap())(projection_kernel<true>, up);
+    LaunchKernel(dim3(hidden / (64 * kWarps), groups), 32 * kWarps, dev.unwrap())(projection_kernel<false>, out);
+  }
+};
+}  // namespace sglang
