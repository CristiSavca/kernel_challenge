+"""Humming W4A16 experts for Muse's per-route finalization."""
+
+from __future__ import annotations
+
+import json
+import logging
+import subprocess
+from typing import TYPE_CHECKING
+
+import torch
+import triton
+import triton.language as tl
+
+from sglang.kernels.jit.utils import cache_once, get_activation_cuda_cflags, load_jit
+from sglang.srt.environ import envs
+from sglang.srt.runtime_context import get_exec
+
+if TYPE_CHECKING:
+    from sglang.srt.layers.muse_spark.muse_spark_fp4_moe import MuseSpark1xFp4Experts
+
+
+_GROUPED_COMPUTE = json.dumps(
+    {"gemm_type": "grouped_contiguous", "use_f16_accum": False}
+)
+
+
+@cache_once
+def _route_pair_module():
+    try:
+        return load_jit(
+            "muse_route_pair",
+            cuda_files=["muse_spark/expert_route_pair.cuh"],
+            cuda_wrappers=[("run", "MuseRoutePair::run")],
+            extra_cuda_cflags=get_activation_cuda_cflags(),
+        )
+    except (OSError, RuntimeError, subprocess.SubprocessError) as exc:
+        logging.getLogger(__name__).warning("Using indexed Humming expert kernels after JIT failure: %s", exc)
+        return None
+
+
+@cache_once
+def _medium_route_pair_module():
+    try:
+        return load_jit(
+            "muse_medium_route_pair",
+            cuda_files=["muse_spark/expert_medium_route_pair.cuh"],
+            cuda_wrappers=[("run", "MuseMediumRoutePair::run")],
+            extra_cuda_cflags=get_activation_cuda_cflags(),
+        )
+    except (OSError, RuntimeError, subprocess.SubprocessError) as exc:
+        logging.getLogger(__name__).warning("Using indexed Humming for medium route batches after JIT failure: %s", exc)
+        return None
+
+
+@cache_once
+def _prefill_scaled_silu_module():
+    try:
+        return load_jit(
+            "muse_expert_prefill_scaled_silu",
+            cuda_files=["muse_spark/expert_prefill_scaled_silu.cuh"],
+            cuda_wrappers=[("run", "MuseExpertPrefillScaledSilu::run")],
+            extra_cuda_cflags=get_activation_cuda_cflags(),
+        )
+    except (OSError, RuntimeError, subprocess.SubprocessError) as exc:
+        logging.getLogger(__name__).warning(
+            "Using grouped Humming prefill after JIT failure: %s", exc
+        )
+        return None
+
+
+def prepare_humming_nvfp4(layer: MuseSpark1xFp4Experts) -> None:
+    """Replace the local checkpoint bank with packed Humming weights."""
+    from humming import dtypes
+    from humming.config import GemmType, MmaType
