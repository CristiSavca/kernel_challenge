+@dataclass(kw_only=True)
+class MixedDFlashResult(GenerationBatchResult):
+    """One target invocation with separate prefill and speculative result layouts."""
+
+    prompt_batch: ScheduleBatch
+    decode_batch: ScheduleBatch
+    prompt_result: GenerationBatchResult
+    decode_result: GenerationBatchResult
+
+    @classmethod
+    def from_role_results(
+        cls, prompt_batch, decode_batch, prompt_result, decode_result, next_draft_input,
+        *, shared_target: bool = True,
+    ):
+        # The next scheduling iteration can rebind both batches before the
+        # result drains. Preserve their row order but keep request state live.
+        prompts = prompt_batch.copy()
+        tails = decode_batch.copy()
+        prompt_count = len(prompts.reqs)
+        tail_count = len(tails.reqs)
+        all_reqs = prompts.reqs + tails.reqs
+        if (
+            not prompt_count
+            or not tail_count
+            or prompts.forward_mode != ForwardMode.EXTEND
+            or tails.forward_mode != ForwardMode.DECODE
+            or prompts.decoding_reqs
+            or not prompts.spec_algorithm.is_dflash()
+            or not tails.spec_algorithm.is_dflash()
+            or len({id(req) for req in all_reqs}) != len(all_reqs)
+        ):
+            raise ValueError("mixed DFLASH requires disjoint prompt and decode cohorts")
+
+        stride = decode_result.speculative_output_stride
+        if stride is None:
+            stride = decode_result.speculative_num_draft_tokens
+        if (
+            type(stride) is not int
+            or stride < 1
+            or not prompt_result.has_sampled_token_ids
+            or not decode_result.has_sampled_token_ids
+            or decode_result.accept_lens is None
+            or prompt_result.next_token_ids.shape != (prompt_count,)
+            or decode_result.next_token_ids.shape != (tail_count * stride,)
+            or decode_result.accept_lens.shape != (tail_count,)
+            or next_draft_input.new_seq_lens.shape != (len(all_reqs),)
+            or next_draft_input.bonus_tokens.shape != (len(all_reqs),)
+            or prompt_result.copy_done is not None
+            or decode_result.copy_done is not None
+            or (shared_target and prompt_result.can_run_cuda_graph != decode_result.can_run_cuda_graph)
+        ):
+            raise ValueError("inconsistent mixed DFLASH results or relay")
+        return cls(
+            prompt_batch=prompts,
+            decode_batch=tails,
+            prompt_result=prompt_result,
+            decode_result=decode_result,
+            next_draft_input=next_draft_input,
+            new_seq_lens=next_draft_input.new_seq_lens,
+            can_run_cuda_graph=prompt_result.can_run_cuda_graph and decode_result.can_run_cuda_graph,
+            extra_keep_alive_refs=(prompt_result.extra_keep_alive_refs or [])
+            + (decode_result.extra_keep_alive_refs or []),
+        )
+
+    @property
+    def has_sampled_token_ids(self) -> bool:
+        # The synchronous scheduler checks this before starting D2H.
+        return (
+            self.prompt_result.has_sampled_token_ids
+            and self.decode_result.has_sampled_token_ids
+        )
