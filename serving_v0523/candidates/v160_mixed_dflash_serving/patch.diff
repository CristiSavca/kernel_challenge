+            type(kv.req_pool_idx) is not int or req.is_retracted or req.finished() or kv.kv_committed_len < 0
+            or not kv.kv_committed_len <= prefix <= kv.kv_committed_len + width
+            or not kv.kv_committed_len + 2 * width <= kv.kv_allocated_len <= context_capacity
