diff --git a/python/sglang/srt/layers/muse_spark/sparse_prompt_exchange.py b/python/sglang/srt/layers/muse_spark/sparse_prompt_exchange.py
new file mode 100644
index 0000000..8a3cd79
--- /dev/null
+++ b/python/sglang/srt/layers/muse_spark/sparse_prompt_exchange.py
@@ -0,0 +1,120 @@
+"""Exchange sequence-parallel prompt rows needed by each local Humming expert bank."""
+
+import torch
+import torch.distributed as dist
+from torch import nn
+
+from sglang.srt.layers import layernorm_sp
+from sglang.srt.layers.muse_spark.muse_spark_humming_moe import local_humming_expert_ids
+from sglang.srt.model_executor.runner_backend_utils.breakable_cuda_graph import eager_on_graph
+
+
+def _group_width(counts, padded_rows):
+    """Choose the widest exchange whose activation buffers fit one dense gather."""
+    size = len(counts)
+    incoming = [sum(source[rank] for source in counts) for rank in range(size)]
+    remote = sum(incoming) - sum(counts[rank][rank] for rank in range(size))
+    if remote >= padded_rows * (size - 1):
+        return 0
+    width = size
+    while width:
+        fits = all(
+            incoming[src] + sum(counts[src][first:first + width]) <= padded_rows
+            for src in range(size) for first in range(0, size, width)
+        )
+        if fits:
+            return width
+        width //= 2
+    return 0
+
+
+def _exchange_inputs(shard, needs, counts, width, group):
+    size, rank = group.world_size, group.rank_in_group
+    shard_rows, hidden = shard.shape
+    first_row = rank * shard_rows
+    receive_splits = [source[rank] for source in counts]
+    received = shard.new_empty((sum(receive_splits), hidden))
+    empty = received[:0]
+    capacity = max(sum(counts[rank][i:i + width]) for i in range(0, size, width))
+    send_buffer = shard.new_empty((capacity, hidden))
+    for first in range(0, size, width):
+        last = min(first + width, size)
+        # Flatten destination first, then source-token order within each destination.
+        send_mask = needs[first:last, first_row:first_row + shard_rows].reshape(-1)
+        send_splits = [n if first <= i < last else 0 for i, n in enumerate(counts[rank])]
+        ends = torch.cumsum(send_mask, dim=0, dtype=torch.int32)
+        ordinals = torch.arange(1, 1 + sum(send_splits), dtype=torch.int32, device=shard.device)
+        positions = torch.searchsorted(ends, ordinals).remainder_(shard_rows)
+        packed = send_buffer[:positions.numel()]
+        torch.index_select(shard, 0, positions, out=packed)
+        active = first <= rank < last
+        dist.all_to_all_single(
+            received if active else empty, packed, receive_splits if active else [0] * size,
+            send_splits, group=group.device_group,
+        )
+        # The synchronous collective orders the next pack on the caller's stream.
+        # All destination groups reuse the same backing allocation.
+    # Inputs arrived in global token order with the remote-only rows removed.
+    return received, torch.cumsum(needs[rank], dim=0, dtype=torch.int32) - 1
+
+
+def _local_grouped_eligible(experts, shard):
+    from sglang.srt.layers.muse_spark.muse_spark_fp4_moe import MuseSpark1xFp4Experts
+
+    return (
+        type(experts) is MuseSpark1xFp4Experts
+        and experts.use_w4a16 and experts.use_humming
+        and experts._post_expert_norm_weight is not None
+        and experts._post_expert_norm is experts.post_expert_norm
+        and 0 < shard.shape[1] <= experts.intermediate_size_per_partition
+        and shard.dtype == torch.bfloat16 and shard.is_cuda
+        and torch.cuda.get_device_capability(shard.device)[0] == 9
+        and "forward" not in vars(experts)
+        and getattr(experts, "_compiled_call_impl", None) is None
+        and not (experts._forward_hooks or experts._forward_pre_hooks)
+        and not (nn.modules.module._global_forward_hooks or nn.modules.module._global_forward_pre_hooks)
+    )
+
+
+def _prompt_experts_into(experts, shard, scores, ids, group, output):
+    tokens = ids.shape[0]
+    padded_rows = shard.shape[0] * group.world_size
+    eligible = _local_grouped_eligible(experts, shard)
+    # Advertise actual local ownership, including remapped experts. A hook or
+    # unsupported local bank on any rank votes the entire exchange back to dense.
+    local = torch.zeros(padded_rows + 1, dtype=torch.uint8, device=shard.device)
+    local_routes = local.new_zeros((), dtype=torch.int32)
+    if eligible:
+        local_ids = local_humming_expert_ids(experts, ids)
+        owned_slots = local_ids >= 0
+        local[:tokens] = owned_slots.any(dim=1)
+        local[-1] = 1
+        local_routes = owned_slots.sum(dtype=torch.int32)
+    all_masks = local.new_empty((group.world_size, local.numel()))
+    group.all_gather_into_tensor(all_masks, local[None, :])
+    needs = all_masks[:, :padded_rows]
+    # One small device-to-host fence for the votes and every variable split.
+    counts = needs.reshape(group.world_size, group.world_size, shard.shape[0]).sum(-1, dtype=torch.int32).T
+    descriptor = torch.cat((counts.flatten(), all_masks[:, -1].int(), local_routes.view(1))).tolist()
+    size = group.world_size
+    counts = [descriptor[i * size:(i + 1) * size] for i in range(size)]
+    local_route_count = descriptor[-1]
+    width = _group_width(counts, padded_rows) if all(descriptor[size * size:-1]) else 0
+    if width:
+        inputs, row_map = _exchange_inputs(shard, needs, counts, width, group)
+        experts._grouped_humming_and_combine_impl(
+            inputs, local_ids, scores, output, input_row_map=row_map, local_route_count=local_route_count
+        )
+    else:
+        inputs = layernorm_sp.sp_exit_gather(shard, tokens)
+        if eligible:
+            experts._grouped_humming_and_combine_impl(inputs, local_ids, scores, output, local_route_count=local_route_count)
+        else:
+            output.copy_(experts(inputs, scores, ids, experts.post_expert_norm))
+
+
+def _capture_stub(experts, shard, scores, ids, group, output):
+    output.zero_()
+
+
+prompt_experts_into = eager_on_graph(True, capture_stub=_capture_stub)(_prompt_experts_into)
