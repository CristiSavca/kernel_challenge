+def _prompt_grid_ranges(experts, narrow, wide):
+    """Group Humming's local-row intervals by their estimated number of packed weight sweeps."""
+    from math import isqrt
+
+    small_m, large_m = 176, 256
+    # Once every considered count is past the intersection, a wide tile always
+    # needs fewer sweeps. The two endpoints sample a one-standard-deviation span.
+    intersection = (small_m * large_m + large_m - small_m - 1) // (large_m - small_m)
+    limit = intersection + 2 * isqrt(intersection) + 4
+    ranges = []
+    for mean in range(1, limit + 1):
+        radius = isqrt(mean)
+        samples = (max(1, mean - radius), mean + radius)
+        def sweeps(width):
+            return sum((rows + width - 1) // width for rows in samples)
+        choice = wide if sweeps(large_m) < sweeps(small_m) else narrow
+        end = experts * mean
+        if ranges and ranges[-1][2:] == choice:
+            ranges[-1][1] = end
+        else:
+            ranges.append([ranges[-1][1] if ranges else 0, end, *choice])
+    ranges[-1][1] = 1 << 30
+    return torch.tensor(ranges, dtype=torch.int64, device="cpu").flatten()
 
