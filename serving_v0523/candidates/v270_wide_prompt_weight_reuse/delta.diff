+def _cluster_grid(kernel, sms):
+    """Query the current context for this image's maximum resident two-CTA clusters."""
+    from cuda.bindings import driver
+    from humming import ops
+
+    def checked(result):
+        if result[0] != 0:
+            raise RuntimeError(f"grouped prompt occupancy query failed: {result[0]}")
+        return result[1] if len(result) == 2 else None
+
+    shared = ops.get_kernel_smem_size(kernel.kernel_id)
+    module = checked(driver.cuModuleLoad(kernel.kernel_filename.encode()))
+    try:
+        func = checked(driver.cuModuleGetFunction(module, kernel.kernel_name.encode()))
+        attr = driver.CUfunction_attribute.CU_FUNC_ATTRIBUTE_MAX_DYNAMIC_SHARED_SIZE_BYTES
+        checked(driver.cuFuncSetAttribute(func, attr, shared))
+        cluster = driver.CUlaunchAttribute()
+        cluster.id = driver.CUlaunchAttributeID.CU_LAUNCH_ATTRIBUTE_CLUSTER_DIMENSION
+        cluster.value.clusterDim.x, cluster.value.clusterDim.y, cluster.value.clusterDim.z = 2, 1, 1
+        config = driver.CUlaunchConfig()
+        config.gridDimX, config.gridDimY, config.gridDimZ = sms, 1, 1
+        config.blockDimX, config.blockDimY, config.blockDimZ = kernel.num_threads, 1, 1
+        config.sharedMemBytes = shared
+        config.attrs, config.numAttrs = [cluster], 1
+        active = checked(driver.cuOccupancyMaxActiveClusters(func, config))
+        if active < 1:
+            raise ValueError("no resident cluster for the prompt down projection")
+        return min(active, sms // 2) * 2
+    finally:
