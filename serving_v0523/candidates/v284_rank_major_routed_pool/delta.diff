@@ -265,2 +265,41 @@ def humming_decode_eligible(
 
+@cache_once
+def _ranked_pool_module():
+    try:
+        return load_jit(
+            "muse_ranked_pool_norm",
+            cuda_files=["muse_spark/ranked_pool_norm.cuh"],
+            cuda_wrappers=[("run", "MuseRankedPoolNorm::run")],
+            extra_cuda_cflags=["--ftz=false", "--prec-div=true", "--prec-sqrt=true"],
+        )
+    except (ImportError, OSError, RuntimeError):
+        return None
+
+
+def prepare_ranked_pool(layer, packed, topk_ids, norm):
+    from sglang.srt.layers.muse_spark.muse_spark_layers import MuseSpark1xRMSNorm
+
+    ranks, tokens, stripe = packed.shape
+    width = ranks * stripe
+    if (
+        type(norm) is not MuseSpark1xRMSNorm or ranks not in (4, 8) or stripe < 4 or stripe & (stripe - 1)
+        or tokens == 0 or norm.hidden_size != width or not packed.is_cuda or not packed.is_contiguous()
+        or packed.data_ptr() % 8 or "_get_effective_weight" in vars(norm)
+        or topk_ids.ndim != 2 or topk_ids.shape[0] != tokens or width > (1 << 24)
+        or topk_ids.numel() * width >= (1 << 31)
+        or not humming_decode_eligible(layer, packed.view(tokens, width), topk_ids)
+    ):
+        return None
+    # Same-dtype aligned BF16 selects ATen's 4-wide vectorized CUDA RMS kernel.
+    # An uncached gain may invoke user code or need an additional device operation.
+    gain = norm._frozen_weight if norm.zero_centered_gamma else norm.weight
+    if (
+        gain is None or gain.dtype != packed.dtype or gain.device != packed.device
+        or gain.shape != (width,) or not gain.is_contiguous() or gain.data_ptr() % 8
+    ):
+        return None
+    module = _ranked_pool_module()
+    return (module, packed, gain, norm.eps) if module is not None else None
+
