+@triton.jit
+def _merge_partitions(
+    Partial,
+    LSE,
+    Lengths,
+    CuQ,
+    VScale,
+    Out,
+    VS_ROW: tl.constexpr,
+    VS_HEAD: tl.constexpr,
+    B: tl.constexpr,
+    H_KV: tl.constexpr,
+    GQA: tl.constexpr,
+    D: tl.constexpr,
+    WINDOW_LEFT: tl.constexpr,
+    TILE_M: tl.constexpr,
+    TILE_N: tl.constexpr,
+    PARTITIONS: tl.constexpr,
+    BLOCK_B: tl.constexpr,
+    BLOCK_SPLITS: tl.constexpr,
