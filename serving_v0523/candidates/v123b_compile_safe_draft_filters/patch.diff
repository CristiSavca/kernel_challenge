diff --git a/python/sglang/kernels/ops/speculative/dflash_candidate_head.py b/python/sglang/kernels/ops/speculative/dflash_candidate_head.py
new file mode 100644
index 0000000..bafdeae
--- /dev/null
+++ b/python/sglang/kernels/ops/speculative/dflash_candidate_head.py
@@ -0,0 +1,106 @@
+"""Select draft candidates while projecting each vocabulary tile."""
+
+import torch
+import triton
+import triton.language as tl
+
+
+@triton.jit
+def _ordered_keys(logits, tokens):
+    # Retain the BF16 result of the original dense projection. Order NaNs
+    # ahead of finite scores and prefer the smaller local ID on equal bits.
+    bits = logits.to(tl.bfloat16).to(tl.uint16, bitcast=True).to(tl.uint32)
+    bits = tl.where((bits & 32767) > 32640, 32704, bits)
+    ordered = bits ^ tl.where((bits & 32768) != 0, 65535, 32768).to(tl.uint32)
+    return (ordered << 16) | (65535 - tokens.to(tl.uint32))
+
+
+@triton.jit
+def _project_tiles(
+    Hidden, Weight, Partial, M: tl.constexpr, N: tl.constexpr,
+    H: tl.constexpr, HS: tl.constexpr, WS: tl.constexpr, TOP: tl.constexpr,
+    BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr,
+):
+    tile = tl.program_id(0)
+    row = tl.program_id(1) * BM + tl.arange(0, BM)
+    # Shift the last tile back so all its weight rows are readable. Only the
+    # new suffix can contribute winners; overlapping rows belong to the prior tile.
+    start_col = tl.minimum(tile * BN, N - BN) if N % BN else tile * BN
+    col = start_col + tl.arange(0, BN)
+    inner = tl.arange(0, BK)
+    acc = tl.full((BM, BN), 0, tl.float32)
+    a_ptr = Hidden + row[:, None] * HS + inner[None, :]
+    b_ptr = Weight + col[:, None] * WS + inner[None, :]
+    for start in range(0, H, BK):
+        a = tl.load(a_ptr + start, row[:, None] < M, 0)
+        b = tl.load(b_ptr + start)
+        acc = tl.dot(a, tl.trans(b), acc)
+    keys = tl.where(col[None, :] >= tile * BN, _ordered_keys(acc, col[None, :]), 0)
+    best = tl.topk(keys, TOP, dim=1)
+    slots = (row[:, None] * tl.cdiv(N, BN) + tile) * TOP + tl.arange(0, TOP)[None, :]
+    tl.store(Partial + slots, best, row[:, None] < M)
+
+
+@triton.jit
+def _merge_tiles(
+    Partial, Pairs, OFFSET: tl.constexpr, COUNT: tl.constexpr,
+    TOP: tl.constexpr, BLOCK: tl.constexpr,
+):
+    row = tl.program_id(0)
+    index = tl.arange(0, BLOCK)
+    keys = tl.load(Partial + row * COUNT + index, index < COUNT, 0).to(tl.uint32)
+    best = tl.sort(tl.topk(keys, TOP), descending=True)
+    ordered = best >> 16
+    bits = ordered ^ tl.where((ordered & 32768) != 0, 32768, 65535).to(tl.uint32)
+    values = bits.to(tl.uint16).to(tl.bfloat16, bitcast=True).to(tl.float32)
+    ids = OFFSET + 65535 - (best & 65535).to(tl.int32)
+    dst = Pairs + 2 * (row * TOP + tl.arange(0, TOP))
+    tl.store(dst, values.to(tl.int32, bitcast=True))
+    tl.store(dst + 1, ids)
+
+
+def fused_local_candidate_pairs(hidden, weight, num_org, offset, k):
+    """Return contiguous (FP32 score bits, global id) pairs or request the dense path."""
+    if (
+        hidden.ndim != 2
+        or weight.ndim != 2
+        or hidden.device != weight.device
+        or hidden.dtype != torch.bfloat16
+        or weight.dtype != torch.bfloat16
+        or hidden.stride(1) != 1
+        or weight.stride(1) != 1
+        or hidden.shape[1] != weight.shape[1]
+        or hidden.shape[1] % 64 != 0
+        or hidden.shape[1] == 0
+        or hidden.shape[0] == 0
+        or k not in (4, 8, 16, 32)
+        or not 1024 <= num_org <= min(weight.shape[0], 65536)
+        or not hidden.is_cuda
+        or torch.are_deterministic_algorithms_enabled()
+        or torch.cuda.get_device_capability(hidden.device)[0] != 9
+    ):
+        return None
+    rows, width = hidden.shape
+    bm, bn, bk = 16, 128, 64
+    tiles = triton.cdiv(num_org, bn)
+    # Tensor-core tiles use signed 32-bit element offsets for the dot loads.
+    # Reject strided views or oversized workspaces outside that address range.
+    limit = 2**31 - 1
+    if (
+        triton.cdiv(rows, bm) > 65535
+        or (rows - 1) * hidden.stride(0) + width > limit
+        or (num_org - 1) * weight.stride(0) + width > limit
+        or rows * max(tiles * k, 2 * k) > limit
+    ):
+        return None
+    partial = torch.empty((rows, tiles, k), dtype=torch.int32, device=hidden.device)
+    pairs = torch.empty((rows, k * 2), dtype=torch.int32, device=hidden.device)
+    _project_tiles[(tiles, triton.cdiv(rows, bm))](
+        hidden, weight, partial, rows, num_org, width, hidden.stride(0),
+        weight.stride(0), k, bm, bn, bk, num_warps=4, num_stages=3,
+    )
+    _merge_tiles[(rows,)](
+        partial, pairs, offset, tiles * k, k, triton.next_power_of_2(tiles * k),
+        num_warps=8,
+    )
+    return pairs
diff --git a/python/sglang/kernels/ops/speculative/dflash_committed_projection.py b/python/sglang/kernels/ops/speculative/dflash_committed_projection.py
new file mode 100644
index 0000000..a95c6da
--- /dev/null
+++ b/python/sglang/kernels/ops/speculative/dflash_committed_projection.py
@@ -0,0 +1,82 @@
+"""BF16 target-context projection over the rows retained by tree verification."""
+
+import torch
+import triton
+import triton.language as tl
+
+
+@triton.jit
+def _plan_rows(Order, Lengths, Plan, n_rows, WIDTH: tl.constexpr, BLOCK: tl.constexpr):
+    rows = tl.arange(0, BLOCK)
+    request = rows // WIDTH
+    live = (rows < n_rows) & (rows % WIDTH < tl.load(Lengths + request, rows < n_rows, other=0))
+    source = request * WIDTH + tl.load(Order + rows, live, other=0).to(tl.int32)
+    compact = tl.cumsum(live.to(tl.int32)) - 1
+    tl.store(Plan + compact, source, live)
+    tl.store(Plan + n_rows + compact, rows, live)
+    tl.store(Plan + 2 * n_rows, tl.sum(live.to(tl.int32)))
+
+
+@triton.jit
+def _project(
+    Hidden, Weight, Plan, Output,
+    n_rows, N: tl.constexpr, K: tl.constexpr,
+    BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr,
+):
+    first = tl.program_id(0) * BM
+    count = tl.load(Plan + 2 * n_rows)
+    if first >= count:
+        return
+    row = first + tl.arange(0, BM)
+    source = tl.load(Plan + row, row < count, other=0).to(tl.int64)
+    dest = tl.load(Plan + n_rows + row, row < count, other=0).to(tl.int64)
+    col = tl.program_id(1) * BN + tl.arange(0, BN)
+    inner = tl.arange(0, BK)
+    x = Hidden + source[:, None] * K + inner[None, :]
+    w = Weight + col[:, None].to(tl.int64) * K + inner[None, :]
+    acc = tl.full((BM, BN), 0, tl.float32)
+    for _ in range(K // BK):
+        a = tl.load(x, row[:, None] < count, other=0)
+        b = tl.load(w)
+        acc = tl.dot(a, tl.trans(b), acc)
+        x += BK
+        w += BK
+    tl.store(Output + dest[:, None] * N + col[None, :], acc, row[:, None] < count)
+
+
+def project_committed_rows(hidden, weight, order, lengths):
+    rows, k = hidden.shape
+    n, weight_k = weight.shape
+    batch, width = order.shape
+    # Below four row tiles there is little work to eliminate. Bound the
+    # single-CTA prefix scan by its own capacity, independently of batch size.
+    if (
+        not hidden.is_cuda
+        or hidden.dtype != torch.bfloat16
+        or weight.dtype != hidden.dtype
+        or weight.device != hidden.device
+        or order.device != hidden.device
+        or lengths.device != hidden.device
+        or order.dtype != torch.int64
+        or lengths.dtype != torch.int32
+        or lengths.shape != (batch,)
+        or rows != batch * width
+        or not 64 <= rows <= 2048
+        or width < 2
+        or k != weight_k
+        or k % 64 or n % 32
+        or not all(t.is_contiguous() for t in (hidden, weight, order, lengths))
+        or torch.cuda.get_device_capability(hidden.device) != (9, 0)
+        or torch.are_deterministic_algorithms_enabled()
+    ):
+        return None
+    plan = torch.empty(2 * rows + 1, dtype=torch.int32, device=hidden.device)
+    # Inactive rows have defined zero values. The prefix-valid KV writer
+    # only publishes live rows from each request.
+    local = hidden.new_zeros((rows, n))
+    scan_block = max(256, triton.next_power_of_2(rows))
+    _plan_rows[(1,)](order, lengths, plan, rows, width, scan_block)
+    _project[(triton.cdiv(rows, 16), n // 32)](
+        hidden, weight, plan, local, rows, n, k, 16, 32, 64,
+    )
+    return local
diff --git a/python/sglang/kernels/ops/speculative/dflash_tree.py b/python/sglang/kernels/ops/speculative/dflash_tree.py
new file mode 100644
index 0000000..3a371e3
--- /dev/null
+++ b/python/sglang/kernels/ops/speculative/dflash_tree.py
@@ -0,0 +1,236 @@
+"""A fixed-budget tree from the DFLASH selector's conditional lattice."""
+
+from dataclasses import dataclass
+
+import torch
+import triton
+import triton.language as tl
+
+
+@dataclass
+class DFlashTree:
+    data: torch.Tensor
+
+    @property
+    def tokens(self):
+        return self.data[0]
+
+    @property
+    def depths(self):
+        return self.data[1]
+
+    @property
+    def parents(self):
+        return self.data[2]
+
+    @property
+    def ancestors(self):
+        return self.data[3]
+
+    def first_rows(self, batch_size):
+        return DFlashTree(self.data[:, :batch_size].contiguous())
+
+
+@triton.jit
+def _edge_probabilities(scores, active):
+    scores = tl.where(active & (scores == scores), scores.to(tl.float32), -float("inf"))
+    peak = tl.max(scores)
+    if -float("inf") < peak and peak < float("inf"):
+        weights = tl.exp(scores - peak)
+    else:
+        weights = (active & (scores == peak)).to(tl.float32)
+    return weights / tl.sum(weights)
+
+
+@triton.jit
+def _propose_tree(
+    CandidateIds,
+    Scores,
+    Anchors,
+    Tokens,
+    Depths,
+    Parents,
+    Ancestors,
+    ANCHOR_STRIDE: tl.constexpr,
+    WIDTH: tl.constexpr,
+    K: tl.constexpr,
+    BLOCK: tl.constexpr,
+):
+    request = tl.program_id(0)
+    edges = tl.arange(0, BLOCK)
+    parent_slot = edges // K
+    candidate = edges % K
+    lattice = Scores + request * (WIDTH - 1) * K * K
+    root_scores = tl.load(lattice + candidate, parent_slot == 0, other=-float("inf"))
+    root_prob = _edge_probabilities(root_scores, parent_slot == 0)
+    frontier = tl.where(parent_slot == 0, root_prob, -1.0)
+    depths = tl.full((BLOCK,), 0, tl.int32)
+    ancestors = tl.full((BLOCK,), 1, tl.int32)
+    out = request * WIDTH
+    tl.store(Tokens + out, tl.load(Anchors + request * ANCHOR_STRIDE))
+    tl.store(Depths + out, 0)
+    tl.store(Parents + out, -1)
+    tl.store(Ancestors + out, 1)
+    for slot in range(1, WIDTH):
+        edge = tl.argmax(frontier, axis=0, tie_break_left=True)
+        score = tl.max(frontier)
+        parent = edge // K
+        rank = edge % K
+        depth = 1 + tl.sum(tl.where(edges == edge, depths, 0))
+        ancestry = tl.sum(tl.where(edges == edge, ancestors, 0)) | (1 << slot)
+        token = tl.load(CandidateIds + (request * (WIDTH - 1) + depth - 1) * K + rank)
+        tl.store(Tokens + out + slot, token)
+        tl.store(Depths + out + slot, depth)
+        tl.store(Parents + out + slot, parent)
+        tl.store(Ancestors + out + slot, ancestry)
+        frontier = tl.where(edges == edge, -1.0, frontier)
+        if depth < WIDTH - 1 and slot < WIDTH - 1:
+            child_scores = tl.load(
+                lattice + (depth * K + rank) * K + candidate,
+                parent_slot == slot,
+                other=-float("inf"),
+            )
+            child_mass = score * _edge_probabilities(child_scores, parent_slot == slot)
+            frontier = tl.where(parent_slot == slot, child_mass, frontier)
+            depths = tl.where(parent_slot == slot, depth, depths)
+            ancestors = tl.where(parent_slot == slot, ancestry, ancestors)
+
+
+def make_dflash_tree_buffers(batch_size, width, device):
+    return DFlashTree(
+        data=torch.empty((4, batch_size, width), dtype=torch.int64, device=device)
+    )
+
+
+def propose_dflash_tree(candidate_ids, scores, anchor_ids, out):
+    batch, depth, k = candidate_ids.shape
+    _propose_tree[(batch,)](
+        candidate_ids.contiguous(),
+        scores.contiguous(),
+        anchor_ids,
+        out.tokens,
+        out.depths,
+        out.parents,
+        out.ancestors,
+        anchor_ids.stride(0),
+        depth + 1,
+        k,
+        triton.next_power_of_2((depth + 1) * k),
+        num_warps=4,
+    )
+
+
+@triton.jit
+def _accept_tree(
+    Tokens,
+    Parents,
+    Predictions,
+    PrefixLengths,
+    CommitLengths,
+    Bonus,
+    OutTokens,
+    NewLengths,
+    SlotOrder,
+    WIDTH: tl.constexpr,
+    BLOCK: tl.constexpr,
+):
+    request = tl.program_id(0)
+    offset = request * WIDTH
+    nodes = tl.arange(0, BLOCK)
+    tokens = tl.load(Tokens + offset + nodes, nodes < WIDTH, other=-1)
+    parents = tl.load(Parents + offset + nodes, nodes < WIDTH, other=-2)
+    predictions = tl.load(Predictions + offset + nodes, nodes < WIDTH, other=-1)
+    leader = tl.full((), 0, tl.int32)
+    visited = nodes == 0
+    commit = tl.full((), 1, tl.int32)
+    bonus = tl.sum(tl.where(visited, predictions, 0), 0)
+    tl.store(SlotOrder + offset, 0)
+    for i in range(1, WIDTH):
+        # The earliest equal child is sufficient even when a proposer
+        # supplies a repeated token under one parent.
+        child = tl.min(
+            tl.where(
+                (parents == leader) & (tokens == bonus) & (nodes < WIDTH), nodes, WIDTH
+            ),
+            0,
+        )
+        matched = (leader >= 0) & (child < WIDTH)
+        tl.store(SlotOrder + offset + i, child, matched)
+        tl.store(OutTokens + offset + i - 1, bonus, matched)
+        bonus = tl.where(
+            matched, tl.sum(tl.where(nodes == child, predictions, 0), 0), bonus
+        )
+        visited = visited | (matched & (nodes == child))
+        commit += matched.to(tl.int32)
+        leader = tl.where(matched, child, -1)
+    tl.store(OutTokens + offset + commit - 1, bonus)
+    tl.store(OutTokens + offset + nodes, 0, (nodes >= commit) & (nodes < WIDTH))
+    trailing_slot = commit + tl.cumsum((~visited).to(tl.int32)) - 1
+    tl.store(SlotOrder + offset + trailing_slot, nodes, (~visited) & (nodes < WIDTH))
+    prefix = tl.load(PrefixLengths + request)
+    tl.store(NewLengths + request, prefix + commit)
+    tl.store(CommitLengths + request, commit)
+    tl.store(Bonus + request, bonus)
+
+
+def accept_dflash_tree(tree, predictions, prefix_lengths, buffers):
+    _, commit, bonus, tokens, new_lengths = buffers
+    batch, width = tree.tokens.shape
+    order = torch.empty_like(tree.tokens, dtype=torch.int64)
+    _accept_tree[(batch,)](
+        tree.tokens,
+        tree.parents,
+        predictions.contiguous(),
+        prefix_lengths.contiguous(),
+        commit,
+        bonus,
+        tokens,
+        new_lengths,
+        order,
+        width,
+        triton.next_power_of_2(width),
+        num_warps=1,
+    )
+    return commit, bonus, tokens, new_lengths, order
+
+
+@triton.jit
+def _reorder_slots(
+    ReqTable,
+    ReqIndices,
+    PrefixLengths,
+    Slots,
+    Order,
+    Out,
+    ROW_STRIDE: tl.constexpr,
+    WIDTH: tl.constexpr,
+    BLOCK: tl.constexpr,
+):
+    request = tl.program_id(0)
+    nodes = tl.arange(0, BLOCK)
+    active = nodes < WIDTH
+    row = tl.load(ReqIndices + request).to(tl.int64)
+    prefix = tl.load(PrefixLengths + request)
+    source = tl.load(Order + request * WIDTH + nodes, active, other=0)
+    ids = tl.load(Slots + request * WIDTH + source, active, other=0)
+    tl.store(ReqTable + row * ROW_STRIDE + prefix + nodes, ids, active)
+    tl.store(Out + request * WIDTH + nodes, ids, active)
+
+
+def reorder_dflash_tree_slots(req_table, request_ids, prefix_lengths, slots, order):
+    """Permute the reserved page-one slots without moving any KV data."""
+    batch, width = slots.shape
+    out = torch.empty_like(slots)
+    _reorder_slots[(batch,)](
+        req_table,
+        request_ids.contiguous(),
+        prefix_lengths.contiguous(),
+        slots,
+        order,
+        out,
+        req_table.stride(0),
+        width,
+        triton.next_power_of_2(width),
+        num_warps=1,
+    )
+    return out
