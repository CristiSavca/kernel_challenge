+            and candidate.num_load_threads == 128
+            and 2 * candidate.num_threads
+            <= resident_device.max_threads_per_multi_processor
+            and 2 * shared_bytes
+            <= resident_device.shared_memory_per_multiprocessor
+            and resident_device.regs_per_multiprocessor >= 65536
+        ):
+            # The same output tiles keep their complete K accumulation.
+            # Humming's warp-specialized path budgets registers per CTA.
+            tuning["num_ctas_per_sm"] = 2
+    return json.dumps(tuning)
+
+
+def prepare_humming_nvfp4(layer: MuseSpark1xFp4Experts) -> None:
+    """Replace the local checkpoint bank with packed Humming weights."""
+    from humming import dtypes
+    from humming.config import GemmType, MmaType
+    from humming.kernel.humming import HummingKernel
+    from humming.layer import HummingMethod
+    from humming.schema.humming import HummingInputSchema, HummingWeightSchema
+    from humming.transform import transform_humming_tensors
+
+    if layer.quant_config.group_size != 16:
+        raise ValueError("Muse Humming NVFP4 requires groups of 16 weight elements")
+
+    input_schema = HummingInputSchema(a_dtype=dtypes.bfloat16)
+    weight_schema = HummingWeightSchema(
+        b_dtype=dtypes.float4e2m1,
+        bs_dtype=dtypes.float8e4m3,
+        weight_scale_group_size=16,
+    )
+    params = {}
+    tunings = {}
+    grouped_tunings = {}
+    decode_tunings = {}
+    prepare_grouped_decode = (
+        layer.num_local_experts <= _MAX_DECODE_EXPERTS
+        and envs.SGLANG_ENABLE_MUSE_SPARK_HUMMING_GROUPED_DECODE.get()
+        and not envs.SGLANG_ENABLE_DETERMINISTIC_INFERENCE.get()
+    )
+    multicast_a = False
+    resident_device = None
+    if (
+        prepare_grouped_decode
+        and (
+            envs.SGLANG_ENABLE_MUSE_SPARK_HUMMING_DECODE_A_MULTICAST.get()
+            or envs.SGLANG_ENABLE_MUSE_SPARK_HUMMING_DECODE_TWO_CTAS.get()
+        )
+    ):
+        device = torch.cuda.get_device_properties(layer.gate_up_proj.device)
+        multicast_a = (
+            (device.major, device.minor) == (9, 0)
+            and device.multi_processor_count >= 2
+            and device.multi_processor_count % 2 == 0
+            and envs.SGLANG_ENABLE_MUSE_SPARK_HUMMING_DECODE_A_MULTICAST.get()
+        )
+        if (
+            (device.major, device.minor) == (9, 0)
+            and envs.SGLANG_ENABLE_MUSE_SPARK_HUMMING_DECODE_TWO_CTAS.get()
+        ):
+            resident_device = device
+    for name, checkpoint_name in (("w13", "gate_up_proj"), ("w2", "down_proj")):
+        packed = getattr(layer, checkpoint_name)
+        scales = getattr(layer, f"{checkpoint_name}_weight_scale")
+        global_scale = getattr(layer, f"{checkpoint_name}_weight_scale_2")
+        experts, n, packed_k = packed.shape
+        k = packed_k * 2
+        if n % 256 or k % 128 or experts != layer.num_local_experts:
+            raise ValueError("Muse Humming requires aligned local expert matrices")
+        if packed.dtype != torch.uint8 or scales.dtype != torch.float8_e4m3fn:
+            raise ValueError("Muse Humming requires packed E2M1 and E4M3 scales")
+        if scales.shape != (experts, n, k // 16):
+            raise ValueError("Muse Humming received an incompatible scale shape")
+
+        # Reproduce Marlin's NVFP4 BF16 operand. Its E4M3 unpack maps all
+        # subnormal scales to zero and assumes non-negative finite scales.
+        scale_bytes = scales.view(torch.uint8)
+        if (scale_bytes > 0x7E).any().item():
+            raise ValueError("Muse Humming requires non-negative finite block scales")
+        scale_bytes = scale_bytes.masked_fill(scale_bytes < 8, 0)
+
+        meta = HummingMethod.prepare_layer_meta(
+            layer,
+            shape_n=n,
+            shape_k=k,
+            weight_schema=weight_schema,
+            input_schema=input_schema,
+            num_experts=experts,
+            torch_dtype=torch.bfloat16,
+            sublayer_name=name,
+        )
+        tensors = transform_humming_tensors(
+            meta,
+            {
+                "weight": packed.view(torch.int32),
+                "weight_scale": scale_bytes.view(torch.float8_e4m3fn),
+            },
+            already_padded=True,
+        )
+        if name == "w13":
+            layer.humming_skinny_gate_up = (
+                prepare_grouped_decode
+                and envs.SGLANG_ENABLE_MUSE_SPARK_HUMMING_SKINNY_GATE_UP.get()
+                and meta.mma_type == MmaType.WGMMA
+                and not meta.use_packed_k_layout
+                and not meta.use_fused_e8m0_scale
+                and not meta.should_apply_bs_on_c
+                and (n // 2) % 64 == 0
+                and tensors["weight"].shape == (experts, k // 16, n * 2)
+                and tensors["weight"].dtype == torch.int32
+                and tensors["weight_scale"].shape == (experts, k // 16, n)
+                and tensors["weight_scale"].dtype == torch.float8_e4m3fn
+                and tensors["weight"].is_contiguous()
+                and tensors["weight_scale"].is_contiguous()
+                # Build once during preparation, outside CUDA graph capture.
+                and _skinny_gate_up_module() is not None
+            )
+        params[meta.weight_name] = tensors["weight"]
+        params[meta.weight_scale_name] = tensors["weight_scale"]
+        # Stock Marlin collapses the gate/up global scales to the gate value
+        # and multiplies after the BF16 output cast. Preserve both boundaries.
+        if name == "w13" and global_scale.ndim == 2:
+            global_scale = global_scale[:, 0]
+        if global_scale.shape != (experts,):
+            raise ValueError("Muse Humming requires one global scale per expert")
+        params[f"{name}_global_scale"] = global_scale.to(torch.bfloat16).contiguous()
+
+        # Each Stream-K slice would be rounded to BF16 before its output
+        # reduction. Keep a complete FP32 accumulation in each output tile.
+        tunings[name] = tuple(
+            (maximum, config | {"use_stream_k": False})
+            for _, maximum, config in HummingMethod.get_default_tuning_configs(
+                layer, gemm_type=GemmType.INDEXED, sublayer_name=name
+            )
+        )
+
+        grouped = HummingMethod.get_default_tuning_configs(
+            layer, gemm_type=GemmType.GROUPED_CONTIGUOUS, sublayer_name=name
+        )
+        grouped_tunings[name] = json.dumps(
+            grouped[-1][2] | {"use_stream_k": False, "use_tma_c": False}
+        )
+        # Dummy graph routes can be empty or concentrated on one EP rank.
+        # Compile the large-batch kernels while the model loads on every rank.
+        HummingKernel.prepare_kernels(
+            meta.to_str(), _GROUPED_COMPUTE, grouped_tunings[name]
+        )
+        if prepare_grouped_decode:
+            max_local_routes = max(
+                1, _MAX_DECODE_SLOTS * experts // layer.global_num_experts
+            )
+            decode_tunings[name] = tuple(
+                (
+                    maximum,
+                    _decode_tuning_config(
+                        config,
+                        n,
+                        multicast_a,
+                        layer_meta=meta,
+                        resident_device=resident_device,
+                    ),
+                )
+                for minimum, maximum, config in grouped
+                if minimum < max_local_routes
+            )
+            for _, tuning in decode_tunings[name]:
+                HummingKernel.prepare_kernels(meta.to_str(), _GROUPED_COMPUTE, tuning)
+
+    for name, tensor in params.items():
+        setattr(layer, name, torch.nn.Parameter(tensor, requires_grad=False))
+    for name in ("gate_up_proj", "down_proj"):
+        delattr(layer, name)
+        delattr(layer, f"{name}_weight_scale")
+        delattr(layer, f"{name}_weight_scale_2")
+    layer.humming_indexed_tunings = tunings
+    layer.humming_grouped_tunings = grouped_tunings
+    layer.humming_decode_tunings = decode_tunings
+
+
+@triton.jit
+def _plan_grouped_decode(
+    global_ids,
+    expert_map,
+    local_ids,
+    offsets,
+    row_keys,
+    row_map,
+    slots,
+    EXPERTS: tl.constexpr,
+    GLOBAL_EXPERTS: tl.constexpr,
+    HAS_EXPERT_MAP: tl.constexpr,
+    SLOT_SPAN: tl.constexpr,
+    EXPERT_SPAN: tl.constexpr,
+):
+    slot = tl.arange(0, SLOT_SPAN)
+    expert = tl.load(global_ids + slot, mask=slot < slots, other=-1)
+    in_range = (expert >= 0) & (expert < GLOBAL_EXPERTS)
+    if HAS_EXPERT_MAP:
+        expert = tl.load(expert_map + expert, mask=in_range, other=-1)
+    else:
+        expert = tl.where(in_range, expert, -1)
+    expert = expert.to(tl.int32)
+    tl.store(local_ids + slot, expert, mask=slot < slots)
+    bucket = tl.where((expert >= 0) & (expert < EXPERTS), expert + 1, 0)
+    buckets = tl.arange(0, EXPERT_SPAN)
+    # Bucket zero contains remote routes and masked lanes. Put real routes at
+    # the end of the static arena so the last expert always ends at shape_m.
+    padding = SLOT_SPAN - slots
+    ends = tl.cumsum(tl.histogram(bucket, EXPERT_SPAN), 0) - padding
+    tl.store(offsets + buckets, ends, mask=buckets <= EXPERTS)
+    key = tl.sort(bucket * SLOT_SPAN + slot, descending=False)
+    row = slot - padding
+    tl.store(row_keys + row, key, mask=row >= 0)
+    original_slot = key % SLOT_SPAN
+    tl.store(
+        row_map + original_slot,
+        tl.where(key >= SLOT_SPAN, row, -1),
+        mask=original_slot < slots,
+    )
+
+
+@triton.jit
+def _gather_grouped_decode(
+    hidden_states,
+    row_keys,
+    offsets,
+    output,
+    slots,
+    TOPK: tl.constexpr,
+    HIDDEN: tl.constexpr,
+    SLOT_SPAN: tl.constexpr,
+    BLOCK: tl.constexpr,
+):
+    first = tl.load(offsets)
+    width = tl.arange(0, BLOCK)
+    for row in range(first + tl.program_id(0), slots, tl.num_programs(0)):
+        slot = tl.load(row_keys + row) % SLOT_SPAN
+        token = slot // TOPK
+        values = tl.load(
+            hidden_states + token * HIDDEN + width, mask=width < HIDDEN, other=0
+        )
+        tl.store(output + row * HIDDEN + width, values, mask=width < HIDDEN)
+
+
+@triton.jit
+def _stage_grouped_decode(
+    global_ids, expert_map, hidden_states, local_ids, offsets, row_keys, row_map, output,
+    slots, GLOBAL_EXPERTS: tl.constexpr, EXPERTS: tl.constexpr, HAS_MAP: tl.constexpr,
+    TOPK: tl.constexpr, HIDDEN: tl.constexpr, SLOT_SPAN: tl.constexpr,
+    TILE: tl.constexpr, ROWS: tl.constexpr, WIDTH: tl.constexpr,
+):
+    expert = tl.program_id(0)
+    tile_start = tl.program_id(1) * TILE
+    all_slots = tl.arange(0, SLOT_SPAN)
+    ids = tl.load(global_ids + all_slots, mask=all_slots < slots, other=-1)
+    valid = (ids >= 0) & (ids < GLOBAL_EXPERTS)
+    if HAS_MAP:
+        ids = tl.load(expert_map + ids, mask=valid, other=-1)
+    else:
+        ids = tl.where(valid, ids, -1)
+    ids = ids.to(tl.int32)
+    # Local routes occupy a suffix in expert order, then original slot order.
+    # Count all later experts and this expert's remaining slots to obtain
+    # this tile's absolute row. Each CTA works independently during replay.
+    later = (ids < EXPERTS) & ((ids > expert) | ((ids == expert) & (all_slots >= tile_start)))
+    first = slots - tl.sum(later.to(tl.int32), 0)
+    if tile_start == 0:
+        tl.store(offsets + expert, first)
+        if expert == 0:
+            tl.store(offsets + EXPERTS, slots)
+
+    lanes = tl.arange(0, TILE)
+    slot = tile_start + lanes
+    tile_ids = tl.gather(ids, tl.minimum(slot, SLOT_SPAN - 1), 0)
+    live = (slot < slots) & (tile_ids == expert)
+    rank = tl.cumsum(live.to(tl.int32), 0) - 1
+    row = first + rank
+    tl.store(row_map + slot, row, mask=live)
+    tl.store(row_keys + row, (expert + 1) * SLOT_SPAN + slot, mask=live)
+    if expert == 0:
+        tl.store(local_ids + slot, tile_ids, mask=slot < slots)
+        remote = (tile_ids < 0) | (tile_ids >= EXPERTS)
+        tl.store(row_map + slot, -1, mask=(slot < slots) & remote)
+
+    count = tl.sum(live.to(tl.int32), 0)
+    width = tl.arange(0, WIDTH)
+    for base in range(0, count, ROWS):
+        rows = base + tl.arange(0, ROWS)
+        # Recover the original slot for each of these consecutive live rows.
+        source = tl.max(tl.where(live[None, :] & (rank[None, :] == rows[:, None]),
+                                 slot[None, :], 0), 1)
+        mask = (rows[:, None] < count) & (width[None, :] < HIDDEN)
+        x = tl.load(hidden_states + (source // TOPK)[:, None] * HIDDEN + width[None, :],
+                    mask=mask, other=0)
+        tl.store(output + (first + rows)[:, None] * HIDDEN + width[None, :], x, mask=mask)
+
+
+@triton.jit
+def _stage_token_routes(
+    ids_ptr, map_ptr, x_ptr, weight_ptr, local_ptr, offsets_ptr, keys_ptr, rows_ptr,
+    out_ptr, eps, SLOTS: tl.constexpr, GLOBAL: tl.constexpr, EXPERTS: tl.constexpr,
+    HAS_MAP: tl.constexpr, TOPK: tl.constexpr, K_TILE: tl.constexpr, HIDDEN: tl.constexpr,
+    SPAN: tl.constexpr, BUCKETS: tl.constexpr, WIDTH: tl.constexpr,
+    WRITE_ACTIVE: tl.constexpr = False,
+):
+    token = tl.program_id(0)
+    all_slots = tl.arange(0, SPAN)
+    ids = tl.load(ids_ptr + all_slots, all_slots < SLOTS, other=-1)
+    valid = (ids >= 0) & (ids < GLOBAL)
+    if HAS_MAP:
+        ids = tl.load(map_ptr + ids, valid, other=-1)
+    else:
+        ids = tl.where(valid, ids, -1)
+    ids = ids.to(tl.int32)
+    # Bin zero contains all remote and padding rows. Subtract the padding to
+    # leave the same live suffix that the grouped GEMMs and finalizer consume.
+    bucket = tl.where((ids >= 0) & (ids < EXPERTS), ids + 1, 0)
+    counts = tl.histogram(bucket, BUCKETS)
+    starts = tl.cumsum(counts, 0) - (SPAN - SLOTS)
+    if token == 0:
+        bins = tl.arange(0, BUCKETS)
+        tl.store(offsets_ptr + bins, starts, bins <= EXPERTS)
+        if WRITE_ACTIVE:
+            # The second half of the layout holds a count and sorted live IDs.
+            nonempty = (bins > 0) & (bins <= EXPERTS) & (counts > 0)
+            ordinal = tl.cumsum(nonempty.to(tl.int32), 0)
+            plan = offsets_ptr + EXPERTS + 1
+            tl.store(plan + ordinal, bins - 1, nonempty)
+            tl.store(plan, tl.sum(nonempty.to(tl.int32), 0))
+    before = tl.histogram(tl.where(all_slots < token * TOPK, bucket, 0), BUCKETS)
+    lanes = tl.arange(0, K_TILE)
+    slot = token * TOPK + lanes
+    expert = tl.gather(ids, tl.minimum(slot, SPAN - 1), 0)
+    live = (lanes < TOPK) & (expert >= 0) & (expert < EXPERTS)
+    safe = tl.where(live, expert, 0)
+    # Preserve relative order even when a token routes twice to one expert.
+    duplicate = (expert[:, None] == expert[None, :]) & (lanes[:, None] > lanes[None, :])
+    row = tl.gather(starts, safe, 0) + tl.gather(before, safe + 1, 0)
+    row += tl.sum(duplicate.to(tl.int32), 1)
+    tl.store(local_ptr + slot, expert, lanes < TOPK)
+    tl.store(rows_ptr + slot, tl.where(live, row, -1), lanes < TOPK)
+    tl.store(keys_ptr + row, (expert + 1) * SPAN + slot, live)
+    if tl.sum(live.to(tl.int32), 0) > 0:
+        h = tl.arange(0, WIDTH)
+        x = tl.load(x_ptr + token * HIDDEN + h, h < HIDDEN, other=0).to(tl.float32)
+        gamma = tl.load(weight_ptr + h, h < HIDDEN, other=0).to(tl.float32)
+        inverse = tl.rsqrt(tl.sum(x * x, 0) / HIDDEN + eps)
+        normed = ((x * inverse) * gamma).to(out_ptr.dtype.element_ty)
+        for lane in tl.static_range(TOPK):
+            dst = tl.max(tl.where(live & (lanes == lane), row, -1), 0)
+            if dst >= 0:
+                tl.store(out_ptr + dst * HIDDEN + h, normed, h < HIDDEN)
+
+
+def routed_norm_weight(norm, hidden_states, topk_ids):
+    from sglang.srt.layers.muse_spark.muse_spark_layers import MuseSpark1xRMSNorm
+
+    if (
+        type(norm) is not MuseSpark1xRMSNorm
+        or norm._forward_hooks
+        or norm._forward_pre_hooks
+        or torch.nn.modules.module._global_forward_hooks
+        or torch.nn.modules.module._global_forward_pre_hooks
+        or not envs.SGLANG_ENABLE_MUSE_SPARK_HUMMING_ROUTED_NORM.get()
+        or not envs.SGLANG_ENABLE_MUSE_SPARK_HUMMING_FUSED_STAGE.get()
+        or not 1 <= topk_ids.shape[1] <= 8
+        or hidden_states.shape[0] != topk_ids.shape[0]
+        or hidden_states.shape[1] != norm.hidden_size
+        or not 1 <= norm.hidden_size <= 8192
+    ):
+        return None
+    weight = norm._get_effective_weight()
+    if (
+        weight is None
+        or weight.shape != (norm.hidden_size,)
+        or weight.device != hidden_states.device
+        or weight.dtype not in (torch.bfloat16, torch.float32)
+        or not weight.is_contiguous()
+    ):
+        return None
+    return weight
+
+
+def humming_decode_eligible(
+    layer: MuseSpark1xFp4Experts,
+    hidden_states: torch.Tensor,
+    topk_ids: torch.Tensor,
+) -> bool:
+    return (
+        bool(layer.humming_decode_tunings)
+        and hidden_states.dtype == torch.bfloat16
+        and hidden_states.is_contiguous()
+        and hidden_states.shape[1] <= layer.intermediate_size_per_partition
+        and topk_ids.is_contiguous()
+        and topk_ids.dtype in (torch.int32, torch.int64)
+        and 0 < topk_ids.numel() <= _MAX_DECODE_SLOTS
+        and not torch.compiler.is_compiling()
+    )
+
+
+def _active_expert_groups(tokens, topk, global_experts, local_experts):
+    # Distinct live experts for uniform top-k routing, with room for one
+    # standard deviation. Skew changes only the number of grid-stride iterations.
+    p = 1.0 - (1.0 - min(topk / global_experts, 1.0)) ** tokens
+    mean = local_experts * p
+    groups = max(1, math.ceil(mean + math.sqrt(mean * (1.0 - p))))
+    return groups if groups < local_experts else 0
+
+
+def humming_grouped_decode_outputs(
+    layer: MuseSpark1xFp4Experts,
+    hidden_states: torch.Tensor,
+    topk_ids: torch.Tensor,
+    norm_weight=None,
+    norm_eps=0.0,
+) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor]:
+    """Run local grouped GEMMs with a device-built suffix and static addresses."""
+    from humming.layer import HummingMethod
+
+    hidden_size = hidden_states.shape[1]
+    intermediate = layer.intermediate_size_per_partition
+    topk = topk_ids.shape[1]
+    slots = topk_ids.numel()
+    span = triton.next_power_of_2(slots)
+    experts = layer.num_local_experts
+    local_ids = torch.empty_like(topk_ids, dtype=torch.int32)
+    row_keys = local_ids.new_empty(slots)
+    row_map = torch.empty_like(local_ids)
+    expert_map = layer._expert_map
+    staging = hidden_states.new_empty(slots * intermediate)
+    # At sparse occupancy the warp kernel loads one packed weight tile for up
+    # to eight live routes and writes the activation directly into a second bank.
+    skinny_gate_up = layer.humming_skinny_gate_up and slots <= layer.global_num_experts
+    active_groups = 0
+    if skinny_gate_up and norm_weight is not None:
+        active_groups = _active_expert_groups(
+            hidden_states.shape[0], topk, layer.global_num_experts, experts
+        )
+    layout = local_ids.new_empty((2 if active_groups else 1) * (experts + 1))
+    offsets = layout[: experts + 1] if active_groups else layout
+    arena_width = intermediate if skinny_gate_up else 2 * intermediate
+    arena = hidden_states.new_empty(slots * max(arena_width, hidden_size))
+    inputs = staging[: slots * hidden_size].view(slots, hidden_size)
+    if skinny_gate_up:
+        activations = arena[: slots * intermediate].view(slots, intermediate)
+        outputs = staging[: slots * hidden_size].view(slots, hidden_size)
+    else:
+        gate_up = arena[: slots * 2 * intermediate].view(slots, 2 * intermediate)
+        activations = staging[: slots * intermediate].view(slots, intermediate)
+        outputs = arena[: slots * hidden_size].view(slots, hidden_size)
+    if norm_weight is not None:
+        _stage_token_routes[(hidden_states.shape[0],)](
+            topk_ids, expert_map if expert_map is not None else topk_ids,
+            hidden_states, norm_weight, local_ids, layout, row_keys, row_map,
+            inputs, norm_eps, slots, layer.global_num_experts, experts, expert_map is not None,
+            topk, triton.next_power_of_2(topk), hidden_size, span,
+            triton.next_power_of_2(experts + 1), triton.next_power_of_2(hidden_size),
+            WRITE_ACTIVE=bool(active_groups), num_warps=8,
+        )
+    elif hidden_size <= 8192 and envs.SGLANG_ENABLE_MUSE_SPARK_HUMMING_FUSED_STAGE.get():
+        tile = min(span, 128)
+        _stage_grouped_decode[(experts, triton.cdiv(slots, tile))](
+            topk_ids, expert_map if expert_map is not None else topk_ids,
+            hidden_states, local_ids, offsets, row_keys, row_map, inputs, slots,
+            GLOBAL_EXPERTS=layer.global_num_experts, EXPERTS=experts,
+            HAS_MAP=expert_map is not None, TOPK=topk, HIDDEN=hidden_size,
+            SLOT_SPAN=span, TILE=tile, ROWS=4, WIDTH=triton.next_power_of_2(hidden_size),
+            num_warps=8,
+        )
+    else:
+        _plan_grouped_decode[(1,)](
+            topk_ids,
+            expert_map if expert_map is not None else topk_ids,
+            local_ids,
+            offsets,
+            row_keys,
+            row_map,
+            slots,
+            EXPERTS=experts,
+            GLOBAL_EXPERTS=layer.global_num_experts,
+            HAS_EXPERT_MAP=expert_map is not None,
+            SLOT_SPAN=span,
+            EXPERT_SPAN=triton.next_power_of_2(experts + 1),
+            num_warps=4 if span <= 256 else 8,
+        )
+        _gather_grouped_decode[(min(slots, 128),)](
+            hidden_states,
+            row_keys,
+            offsets,
+            inputs,
