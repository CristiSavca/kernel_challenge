+"""Gather sharded BF16 expert inputs and FP32 router logits together."""
+
+import torch
+import triton
+import triton.language as tl
+
+
+@triton.jit
+def _unpack(
+    gathered, pooled, logits, rows, TP: tl.constexpr,
+    POOL_WORDS: tl.constexpr, EXPERTS: tl.constexpr, BLOCK: tl.constexpr,
+):
+    row = tl.program_id(0)
+    rank = tl.program_id(1)
+    cols = tl.program_id(2) * BLOCK + tl.arange(0, BLOCK)
+    width = POOL_WORDS + EXPERTS
+    words = tl.load(gathered + (rank * rows + row) * width + cols, cols < width, other=0)
+    # Match the existing multicast pooler's signed-zero representation.
+    # Router words are FP32 bit patterns and pass through unchanged.
+    bits = words.to(tl.uint32, bitcast=True)
+    bits |= tl.where((bits & 0xFFFF) == 0, 0x8000, 0).to(tl.uint32)
+    bits |= tl.where((bits >> 16) == 0, 0x80000000, 0).to(tl.uint32)
+    dst = row * TP + rank
+    tl.store(pooled + dst * POOL_WORDS + cols, bits.to(tl.int32, bitcast=True), cols < POOL_WORDS)
+    expert = cols - POOL_WORDS
+    tl.store(logits + dst * EXPERTS + expert, words, (expert >= 0) & (expert < EXPERTS))
+
+
+def gather_pooler_and_router(group, pool_slice, logit_slice):
+    rows, local_width = pool_slice.shape
+    local_experts = logit_slice.shape[1]
+    world = group.world_size
+    payload = torch.cat(
+        (pool_slice.contiguous().view(torch.int32), logit_slice.contiguous().view(torch.int32)), dim=1
+    )
+    gathered = group.all_gather(payload, dim=0)
+    pooled = pool_slice.new_empty((rows, local_width * world))
+    logits = logit_slice.new_empty((rows, local_experts * world))
+    pool_words = local_width // 2
+    _unpack[(rows, world, triton.cdiv(pool_words + local_experts, 128))](
+        gathered, pooled.view(torch.int32), logits.view(torch.int32), rows,
+        world, pool_words, local_experts, 128,
+    )
+    return pooled, logits
