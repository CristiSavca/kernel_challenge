+            prefix = length - q_length
+            q_positions = prefix + q_token
+            if TreeDepths is not None:
+                tree_base = request * MAX_Q
+                first_tree_tile = prefix // TILE_N
+                query_depth = tl.load(TreeDepths + tree_base + q_token, q_live, other=0)
+                q_positions = prefix + query_depth.to(tl.int32)
+                ancestors = tl.load(
+                    TreeAncestors + tree_base + q_token, q_live, other=0
