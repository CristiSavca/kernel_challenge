+def borrow_muse_reduce(group, inputs, width, *, linear=None):
+    """Return (communicator, output view), or None with no GPU side effects."""
+    parallel = get_parallel()
+    if (
+        not envs.SGLANG_ENABLE_MUSE_SPARK_WORKSPACE_REDUCE.get()
+        or envs.SGLANG_ENABLE_DETERMINISTIC_INFERENCE.get()
+        or torch.compiler.is_compiling()
+        or get_exec().overlap.enable_two_batch_overlap
+        or get_exec().overlap.enable_single_batch_overlap
