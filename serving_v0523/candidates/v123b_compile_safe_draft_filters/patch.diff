+            cuda_files=["muse_spark/expert_skinny_gate_up.cuh"],
+            cuda_wrappers=[("run", "MuseSkinnyGateUp::run")],
+            extra_cuda_cflags=get_activation_cuda_cflags(),
+        )
+    except (OSError, RuntimeError, subprocess.SubprocessError) as exc:
+        logging.getLogger(__name__).warning("Falling back to grouped Humming gate/up: %s", exc)
+        return None
+
+
+def _decode_tuning_config(
+    config: dict,
+    shape_n: int,
+    multicast_a: bool,
