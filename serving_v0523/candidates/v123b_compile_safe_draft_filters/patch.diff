+"""Output-sharded BF16/FP16 linear projections for tensor-parallel DFLASH."""
+
+from torch import nn
+from torch.nn import functional as F
+
+from sglang.srt.model_loader.weight_utils import sharded_weight_loader
+from sglang.srt.utils import set_weight_attrs
+
+
+class DFlashGatheredLinear(nn.Linear):
+    def __init__(self, input_size, output_size, tp_group):
+        super().__init__(input_size, output_size // tp_group.world_size, bias=False)
+        self.full_output_size = output_size
+        self.tp_group = tp_group
+        load_shard = sharded_weight_loader(0, parallel_group="tp")
+
+        def load_weight(param, checkpoint):
+            if tuple(checkpoint.shape) != (output_size, input_size):
+                raise ValueError(
+                    f"Expected DFLASH weight {(output_size, input_size)}, got {tuple(checkpoint.shape)}."
+                )
+            load_shard(param, checkpoint)
+
+        set_weight_attrs(self.weight, {"weight_loader": load_weight})
+
+    def forward(self, inputs, *, rank_major=False):
+        # Each output retains the original full-K dot product and output dtype.
+        # Restore complete output channels in checkpoint order.
+        projected = F.linear(inputs, self.weight)
+        if rank_major:
+            shape = (self.tp_group.world_size, *projected.shape)
+            if projected.shape[0] == 0:
+                return projected.new_empty(shape)
+            return self.tp_group.all_gather(projected, 0).view(shape)
+        if projected.shape[0] == 0:
+            return inputs.new_empty((0, self.full_output_size))
+        return self.tp_group.all_gather(projected, -1)
