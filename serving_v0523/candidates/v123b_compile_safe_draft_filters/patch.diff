+        or parallel.attn_dp_size != 1
+        or parallel.attn_dcp_size != 1
+        or parallel.attn_cp_size != 1
+        or parallel.pp_size != 1
+        or parallel.tp_size not in (4, 8)
+        or parallel.attn_tp_size != parallel.tp_size
