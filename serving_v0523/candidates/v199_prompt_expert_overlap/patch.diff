+"""Group two ordered BF16 WGMMA slices inside the pinned Hopper grouped decode pipeline."""
+
+import json
+import logging
+import subprocess
+from functools import lru_cache
+from importlib.metadata import PackageNotFoundError, version
+from pathlib import Path
+
+import torch
+
+
+def append_pair(kernel):
+    from sglang.kernels import jit
+
+    width = kernel.block_shape[0]
+    if (kernel.sm_version != 90 or tuple(kernel.block_shape[1:]) != (128, 256)
+            or tuple(kernel.warp_shape) != (width, 32, 64) or kernel.num_stages != 4
+            or kernel.num_threads != 640 or kernel.num_math_threads != 512
+            or not kernel.use_warp_spec or kernel.use_stream_k or kernel.use_tma_c):
+        raise ValueError("unsupported grouped matrix pipeline")
+    header = Path(jit.__file__).parent / "csrc/muse_spark/grouped_decode_mma_pair.cuh"
+    kernel.code += f"\n#define MUSE_OVERLAP_M {width}\n" + header.read_text()
+
+
+def check_pair_code(compiler, kernel):
+    tool = compiler._get_env()["binaries"].get("cuobjdump")
+    if not tool:
+        raise RuntimeError("CUDA disassembler unavailable for grouped matrix pipeline")
+    code = subprocess.check_output([tool, "-sass", kernel.kernel_filename], text=True)
+    opcode = f"HGMMA.64x{kernel.block_shape[0]}x16.F32.BF16"
+    if code.count(opcode) != 32 or code.count("WARPGROUP.DEPBAR.LE") != 12 or "UTMALDG.3D" not in code:
+        raise RuntimeError("grouped matrix pipeline compiled with unsupported instruction schedule")
+
+
+@lru_cache(maxsize=128)
+def _prepare_down(context, meta, compute, tuning):
+    from humming.jit.compiler import NVCCCompiler
+    from humming.jit.runtime import KernelRuntime
+    from humming.kernel.humming import HummingKernel
+
+    class GroupedDecodePairDownKernel(HummingKernel):
+        @staticmethod
+        def _get_compiler():
+            return NVCCCompiler
+
+        def prepare(self):
+            append_pair(self)
+            KernelRuntime.prepare(self)
+
+        def load_cubin(self):
+            if not self.cubin_loaded:
+                check_pair_code(NVCCCompiler, self)
+                HummingKernel.load_cubin(self)
+
+    config = json.loads(meta) | json.loads(compute) | json.loads(tuning)
+    config.pop("sublayer_name", None)
+    required = {
+        "gemm_type": "grouped_contiguous", "mma_type": "wgmma", "use_f16_accum": False,
+        "a_dtype": "bfloat16", "b_dtype": "float4e2m1", "c_dtype": "bfloat16", "bs_dtype": "float8e4m3",
+        "weight_scale_group_size": 16, "weight_scale_type": "group", "weight_scale_2_type": "none",
+    }
+    if (config.pop("num_sms", 0) or any(config.get(k) != v for k, v in required.items())
+            or any(config.get(k) for k in ("has_bias", "has_zero_point", "use_packed_k_layout",
+                                           "use_fused_e8m0_scale", "input_scale_group_size",
+                                           "weight_scale_group_size_n", "pad_shape_n", "pad_shape_k"))):
+        return None
+    try:
+        kernel = GroupedDecodePairDownKernel(**config)
+        kernel.check_context()
+        return torch.tensor([0, 1 << 30, kernel.kernel_id, 0], dtype=torch.int64, device="cpu")
+    except (AssertionError, ValueError, TypeError, ImportError, RuntimeError, OSError, subprocess.SubprocessError) as exc:
+        logging.getLogger(__name__).warning("Using ordinary grouped down projection: %s", exc)
+        return None
+
+
+def prepare_down(meta, compute, tunings):
+    from humming.kernel.humming import HummingKernel
+
+    try:
+        if version("humming-kernels") != "0.1.12":
+            return {}
+        context = HummingKernel.current_context()
+        return {tuning: _prepare_down(context, meta, compute, tuning) for _, tuning in tunings}
+    except (PackageNotFoundError, AssertionError, RuntimeError, OSError) as exc:
+        logging.getLogger(__name__).warning("Using ordinary grouped decode down projection: %s", exc)
+        return {}
+
+
+def run_down(config, layer, inputs, outputs, offsets):
+    from humming import ops
+
+    ops.launch_kernel(configs=config, inputs=inputs, outputs=outputs, expert_layout=offsets,
+                      weight=layer.w2_weight, weight_scale=layer.w2_weight_scale,
+                      locks=getattr(layer, "locks", None))
