@@ -0,0 +1,234 @@
+"""DFLASH context projection on sequence-parallel token rows."""
+
+from contextlib import contextmanager
+from contextvars import ContextVar
+from typing import NamedTuple
+
+import torch
+from torch import nn
+from torch.nn.modules import module as module_hooks
+
+
+class _PrefillContext(NamedTuple):
+    draft: nn.Module
+    fc: nn.Linear
+    norm: nn.Module
+    project_target_hidden: object
+    group: object
+    target: nn.Module
+    logits_processor: nn.Module
+
+
+_draft_kv_helper = ContextVar("dflash_prefill_kv_helper", default=None)
+_prefill_context = ContextVar("dflash_sp_prefill_context", default=None)
+
+
+def _agree(ready, group):
+    # Keep device collective shapes uniform even for rank-local instrumentation.
+    status = torch.tensor(int(ready), device="cpu", dtype=torch.int32)
+    torch.distributed.all_reduce(
+        status, op=torch.distributed.ReduceOp.MIN, group=group.cpu_group
+    )
+    return bool(status.item())
+
+
+def _supports_shard_norm(norm, fc):
+    # RMSNorm resolves its platform dispatch lazily on the first input.
+    from sglang.srt.layers.layernorm import RMSNorm
+
+    if type(norm) is not RMSNorm:
+        return False
+    if any(name in vars(norm) for name in ("forward_cuda", "forward_native", "_resolve_forward_method")):
+        return False
+    method = norm._forward_method
+    if method is None:
+        method = norm._resolve_forward_method()
+    return (
+        getattr(method, "__self__", None) is norm
+        and getattr(method, "__func__", None) in (RMSNorm.forward_cuda, RMSNorm.forward_native)
+        and norm._quant_linear is None
+        and norm.override_orig_dtype in (None, torch.bfloat16)
+        and norm.weight.device == fc.weight.device
+        and norm.weight.shape == (fc.out_features,)
+    )
+
+
+def prepare_dflash_sp_prefill(draft, target, logits_processor, group):
+    from sglang.srt.layers.logits_processor import LogitsProcessor
+    from sglang.srt.models.muse_spark import MuseSpark1xLogitsProcessor
+    from sglang.srt.models.dflash import DFlashDraftModel
+
+    fc = getattr(draft, "fc", None)
+    norm = getattr(draft, "hidden_norm", None)
+    compatible = (
+        getattr(type(draft), "project_target_hidden", None)
+        is DFlashDraftModel.project_target_hidden
+        and "project_target_hidden" not in vars(draft)
+        and not draft.quantizable
+        and type(fc) is nn.Linear
+        and fc.bias is None
+        and fc.in_features > fc.out_features
+        and fc.weight.shape == (fc.out_features, fc.in_features)
+        and fc.weight.is_cuda
+        and fc.weight.dtype == torch.bfloat16
+        and fc.weight.is_contiguous()
+        and torch.cuda.get_device_capability(fc.weight.device)[0] == 9
+        and type(logits_processor) in (LogitsProcessor, MuseSpark1xLogitsProcessor)
+        and _supports_shard_norm(norm, fc)
+    )
+    if _agree(compatible, group):
+        return _PrefillContext(
+            draft, fc, norm, draft.project_target_hidden, group, target, logits_processor
+        )
+    return None
+
+
+@contextmanager
+def dflash_sp_prefill_scope(context, kv_helper=None):
+    token = _prefill_context.set(context)
+    kv_token = _draft_kv_helper.set(kv_helper)
+    try:
+        yield
+    finally:
+        _draft_kv_helper.reset(kv_token)
+        _prefill_context.reset(token)
+
+
+def project_dflash_prefill_shard(inputs, num_tokens, group, logits_processor, full_capture):
+    """Assign each replicated full-K projection row to its SP owner."""
+    context = _prefill_context.get()
+    # Small shards do not amortize the GEMM and host capability agreement.
+    if context is None or num_tokens < 128 * group.world_size:
+        return None
+    if inputs.is_cuda and torch.cuda.is_current_stream_capturing():
+        return None
+    draft, fc, norm, projector, expected_group, target, expected_logits = context
+    compatible = (
+        group is expected_group
+        and full_capture
+        and logits_processor is expected_logits
+        and not logits_processor.keep_last_hidden_states
+        and logits_processor.expected_aux_hidden_states is None
+        and not draft.quantizable
+        and draft.hidden_norm is norm
+        and not any(name in vars(logits_processor) for name in (
+            "_get_pruned_states", "_get_hidden_states_to_store", "_get_last_hidden_states_to_store",
+        ))
+        and _supports_shard_norm(norm, fc)
+        and draft.fc is fc
+        and draft.project_target_hidden == projector
+        and fc.bias is None
+        and not torch.is_autocast_enabled()
+        and not torch.are_deterministic_algorithms_enabled()
+        and not module_hooks._global_forward_hooks
+        and not module_hooks._global_forward_pre_hooks
+        and all(
+            not mod._forward_hooks
+            and not mod._forward_pre_hooks
+            and getattr(mod, "_compiled_call_impl", None) is None
+            and "forward" not in vars(mod)
+            for mod in (fc, norm, target, logits_processor)
+        )
+        and inputs.ndim == 2
+        and inputs.shape[0] * group.world_size >= num_tokens
+        and inputs.shape[1] == fc.in_features
+        and fc.weight.shape == (fc.out_features, fc.in_features)
+        and fc.weight.is_contiguous()
+        and inputs.device == fc.weight.device
+        and inputs.dtype == fc.weight.dtype == torch.bfloat16
+    )
+    if _agree(compatible, group):
+        return norm(fc(inputs))
+    return None
+
+
+def project_paired_draft_kv(shard, num_tokens, group):
+    """Gather token cohorts and exchange each rank's projected draft K/V rows."""
+    from sglang.srt.batch_invariant_ops import is_batch_invariant_mode_enabled
+
+    size = group.world_size
+    if size not in (4, 8):
+        return None
+    helper = _draft_kv_helper.get()
+    comm = getattr(group, "pynccl_comm", None)
+    rows, hidden = shard.shape
+    weight = getattr(helper, "flat_kv_weight_t", None)
+    channels = 0 if weight is None or weight.ndim != 2 else weight.shape[1]
+    # Minimize the per-rank wire volume. A token cohort shares its inputs.
+    # Every other cohort exchanges one weight bank and one projected block.
+    def volume(width):
+        peers = size // width - 1
+        return (width - 1) * rows * hidden + peers * (hidden * channels + width * rows * channels)
+
+    width = min((n for n in (2, 4) if n < size), key=volume)
+    full = (size - 1) * rows * hidden
+    ready = (
+        comm is not None and comm.available and weight is not None
+        and rows > 0 and (rows - 1) * size < num_tokens <= rows * size
+        and shard.is_contiguous() and shard.dtype == torch.bfloat16
+        and weight.is_contiguous() and weight.shape == (hidden, channels) and channels > 0
+        and weight.device == shard.device == comm.device and weight.dtype == shard.dtype
+        and channels == helper.n_layers * helper.layer_out_dim
+        and not shard.requires_grad and not weight.requires_grad and not is_batch_invariant_mode_enabled()
+        and 8 * volume(width) <= 7 * full
+    )
+    cohort, lane = divmod(group.rank_in_group, width)
+    cohorts = size // width
+    base = cohort * width
+    peers = [c for c in range(cohorts) if c != cohort]
+    if ready:
+        try:
+            gathered = shard.new_empty((width, rows, hidden))
+            remote_weights = weight.new_empty((len(peers), hidden, channels))
+            projected = shard.new_empty((cohorts, width * rows, channels))
+            outgoing = shard.new_empty((len(peers), width * rows, channels))
+        except torch.OutOfMemoryError:
+            ready = False
+
+    # The signatures cover both capability and preallocation. A rank may have
+    # retired its fused helper or failed to reserve staging storage.
+    # Gloo may finish CPU tensor copies on a thread outside inference mode.
+    with torch.inference_mode(False):
+        signature = torch.tensor([int(ready), rows, hidden, channels, num_tokens], dtype=torch.int64, device="cpu")
+        signatures = [torch.empty_like(signature) for _ in range(size)]
+        torch.distributed.all_gather(signatures, signature, group=group.cpu_group)
+    if not ready or any(not torch.equal(s, signature) for s in signatures):
+        return None
+
+    gathered[lane].copy_(shard)
+    with comm.change_state(enable=True):
+        comm.group_start()
+        try:
+            for other in range(width):
+                if other != lane:
+                    comm.send(shard, base + other)
+                    comm.recv(gathered[other], base + other)
+            for idx, other in enumerate(peers):
+                peer = other * width + lane
+                comm.send(weight, peer)
+                comm.recv(remote_weights[idx], peer)
+        finally:
+            comm.group_end()
+
+        x = gathered.view(-1, hidden)
+        try:
+            torch.mm(x, weight, out=projected[cohort])
+            for idx in range(len(peers)):
+                torch.mm(x, remote_weights[idx], out=outgoing[idx])
+        except torch.OutOfMemoryError:
+            computed = False
+        else:
+            computed = True
+        # No cache has been written. If one GEMM could not obtain workspace,
+        # the existing feature gather is still valid on every rank.
+        if not _agree(computed, group):
+            return None
+        comm.group_start()
+        try:
+            for idx, other in enumerate(peers):
+                peer = other * width + lane
+                comm.send(outgoing[idx], peer)
+                comm.recv(projected[other], peer)
+        finally:
+            comm.group_end()
+    return projected.view(-1, channels)[:num_tokens]
