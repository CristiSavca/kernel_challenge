+def reduce_scatter_token_rows(full: torch.Tensor, group) -> torch.Tensor:
+    """Shard a replicated SUM while retaining accelerated all-reduce precision."""
+    num_tokens = full.shape[0]
+    padded = ceil_align(num_tokens, group.world_size)
+    # Preserve the original dispatcher on accelerator paths that may accumulate
+    # in FP32. Check unpadded metadata so tails keep the original algorithm.
+    use_all_reduce = (
+        torch.compiler.is_compiling()
+        or group.is_symmetric_memory_enabled()
+        or os.environ.get("NCCL_NVLS_ENABLE", "1") != "0"
+        or group._can_use_flashinfer_allreduce(full)
+        or group._resolve_outplace_all_reduce_method(full) not in (None, "pynccl")
+    )
+    if use_all_reduce:
+        full = group.all_reduce(full)
+    if padded != num_tokens:
+        full = torch.nn.functional.pad(full, (0, 0, 0, padded - num_tokens))
+    if use_all_reduce:
+        rows = padded // group.world_size
