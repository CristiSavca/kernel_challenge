diff --git a/python/sglang/srt/layers/muse_spark/prompt_weight_pipeline.py b/python/sglang/srt/layers/muse_spark/prompt_weight_pipeline.py
new file mode 100644
index 0000000..36f623f
--- /dev/null
+++ b/python/sglang/srt/layers/muse_spark/prompt_weight_pipeline.py
@@ -0,0 +1,134 @@
+"""Decode packed Hopper W2 weight fragments on Humming's loader warps."""
+import hashlib
+import json
+import logging
+import subprocess
+from functools import lru_cache
+from importlib.metadata import PackageNotFoundError, version
+from pathlib import Path
+
+import torch
+
+
+def adapt_prompt_weights(kernel):
+    import humming
+    from sglang.kernels import jit
+
+    source = Path(humming.__path__[0]) / "include/humming/kernel/humming_ws.cuh"
+    src = source.read_text()
+    if hashlib.sha256(src.encode()).hexdigest() != "6a148cc29b81d4009066667c347d9091a8a138009f7884226e9969a6936e2899":
+        raise ValueError("unsupported grouped Humming loop")
+    header = Path(jit.__file__).parent / "csrc/muse_spark/prompt_weight_pipeline.cuh"
+    pipeline = source.parents[1] / "memory/g2s_pipeline.cuh"
+    transfers = pipeline.read_text()
+    if hashlib.sha256(transfers.encode()).hexdigest() != "479ff827ecf40b82d4685b3a104d796ef41bb643a1d9cc398feabcc77ccbd43b":
+        raise ValueError("unsupported grouped Humming transfer pipeline")
+    transfers = transfers.replace("#pragma once", "", 1)
+    transfer = "loader_bs.template load<kShouldAdvance>(smem.stages[stage_id].bs, mbar_ptr);"
+    transfers = transfers.replace(transfer, "muse_load_scales<kShouldAdvance>(ctx, loader_bs, stage_id);")
+    marker = "#include <humming/memory/g2s_pipeline.cuh>"
+    for name, replacement in (("Mma", "MusePromptMma"), ("S2RMemoryPipeline", "MusePromptReader")):
+        src = src.replace("= " + name + "<Ctx", "= " + replacement + "<Ctx")
+    # The loader now converts contiguous E4M3 words while the two TMA transfers run.
+    src = src.replace("? 40 : 24;", "? 32 : 32;")
+    src = src.replace("extern __shared__ int4 shared_memory[];", "extern __shared__ __align__(128) int4 shared_memory[];")
+    prefetch = "s2r_pipe.load_stage_iter(stage_id, warp_iter_id + 1);"
+    if src.count(prefetch) != 1:
+        raise ValueError("unsupported grouped Humming prefetch")
+    # The second pair still addresses the current shared A tile. Publish reuse
+    # only after its final K16 operation drains, and keep the next-stage wait
+    # before that next stage supplies the following iteration's first fragment.
+    src = src.replace("              consumer.arrive(stage_id);\n", "")
+    src = src.replace("            mma.transform_b(\n",
+                      "            if (warp_iter_id + 1 == Ctx::kWarpIters) consumer.arrive(stage_id);\n"
+                      "            mma.transform_b(\n")
+    src = src.replace(prefetch, "if (warp_iter_id + 1 < Ctx::kWarpIters || slice_iters > 1) " + prefetch)
+    common = "#include <humming/mma/all.cuh>\n#include <humming/memory/s2r_pipeline.cuh>\n"
+    src = src.replace(marker, common + header.read_text() + "\n" + transfers)
+    src = src.replace("#pragma once", "", 1)
+    kernel.code = kernel.code.replace("#include <humming/kernel/humming_ws.cuh>", src)
+    kernel.code = kernel.code.replace("SMEM_SIZE = sizeof(SharedStorageType);",
+        "SMEM_SIZE = ((sizeof(SharedStorageType) + 127) / 128 * 128) + 2048 * TuningConfig::kNumStages;")
+
+
+@lru_cache(maxsize=64)
+def _prepare(context, meta, compute, tuning):
+    from humming.jit.compiler import NVCCCompiler
+    from humming.jit.runtime import KernelRuntime
+    from humming.kernel.humming import HummingKernel
+
+    class PromptWeightPipeline(HummingKernel):
+        @staticmethod
+        def _get_compiler():
+            return NVCCCompiler
+
+        def prepare(self):
+            adapt_prompt_weights(self)
+            KernelRuntime.prepare(self)
+
+        def load_cubin(self):
+            if not self.cubin_loaded:
+                tool = NVCCCompiler._get_env()["binaries"].get("cuobjdump")
+                if not tool:
+                    raise RuntimeError("CUDA disassembler unavailable")
+                isa = subprocess.check_output([tool, "-sass", self.kernel_filename], text=True)
+                if (isa.count("HGMMA.64x176x16.F32.BF16") != 32 or isa.count("WARPGROUP.DEPBAR.LE") != 8
+                        or "UTMALDG.2D" not in isa or "UTMALDG.3D" not in isa):
+                    raise RuntimeError("grouped prompt Hopper instructions unavailable")
+                HummingKernel.load_cubin(self)
+
+    cfg = json.loads(meta) | json.loads(compute) | json.loads(tuning)
+    cfg.pop("sublayer_name", None)
+    required = {"gemm_type": "grouped_contiguous", "mma_type": "wgmma", "use_f16_accum": False,
+                "a_dtype": "bfloat16", "b_dtype": "float4e2m1", "c_dtype": "bfloat16", "bs_dtype": "float8e4m3",
+                "weight_scale_group_size": 16, "weight_scale_type": "group", "weight_scale_2_type": "none",
+                "block_shape": [176, 256, 64], "warp_shape": [176, 32, 64],
+                "num_stages": 4, "use_warp_spec": True, "use_tma": True, "use_mbarrier": True,
+                "use_tma_c": False, "use_stream_k": False}
+    if (cfg.pop("num_sms", 0) or any(cfg.get(k) != v for k, v in required.items())
+            or any(cfg.get(k) for k in ("has_bias", "has_zero_point", "use_packed_k_layout",
+                                        "use_fused_e8m0_scale", "input_scale_group_size",
+                                        "weight_scale_group_size_n", "pad_shape_n", "pad_shape_k"))
+            or any(cfg.get(k, 1) != 1 for k in ("multi_cast_size_a", "multi_cast_size_b"))):
+        return None
+    try:
+        cfg.update(use_tma_bs=False, use_cp_async=False)
+        kernel = PromptWeightPipeline(**cfg)
+        kernel.check_context()
+        return torch.tensor([0, 1 << 30, kernel.kernel_id, 0], dtype=torch.int64, device="cpu")
+    except (AssertionError, ValueError, TypeError, ImportError, RuntimeError, OSError, subprocess.SubprocessError) as exc:
+        logging.getLogger(__name__).warning("Using ordinary grouped prompt down projection: %s", exc)
+        return None
+
+
+def _binding(tensor):
+    return tensor.device, tensor.dtype, tensor.shape, tensor.stride(), tensor.data_ptr()
+
+
+def prepare_prompt_down(layer, meta, compute, tuning):
+    from humming.kernel.humming import HummingKernel
+
+    try:
+        if version("humming-kernels") == "0.1.12":
+            config = _prepare(HummingKernel.current_context(), meta, compute, tuning)
+            if config is not None:
+                bank = _binding(layer.w2_weight), _binding(layer.w2_weight_scale)
+                return config, meta, compute, tuning, bank
+    except (PackageNotFoundError, AssertionError, ImportError, RuntimeError, OSError):
+        pass
+    return None
+
+def run_prompt_down(layer, inputs, outputs, offsets, compute, tuning):
+    from sglang.srt.layers.muse_spark.decode_mma_pair import run_down
+
+    config, meta, expected_compute, expected_tuning, bank = layer.humming_prompt_down
+    if (compute != expected_compute or tuning != expected_tuning or layer.humming_metas["w2"].to_str() != meta
+            or bank != (_binding(layer.w2_weight), _binding(layer.w2_weight_scale))
+            or inputs.device != bank[0][0] or outputs.device != inputs.device
+            or inputs.dtype != torch.bfloat16 or outputs.dtype != inputs.dtype
+            or not inputs.is_contiguous() or not outputs.is_contiguous()
+            or inputs.shape != (outputs.shape[0], layer.intermediate_size_per_partition)
+            or outputs.shape[1] != layer.hidden_size):
+        return False
+    run_down(config, layer, inputs, outputs, offsets)
+    return True
