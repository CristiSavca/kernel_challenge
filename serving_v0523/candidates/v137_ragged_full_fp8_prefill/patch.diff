+"""Pack page-one FP8 KV rows for dense Hopper prefill attention."""
+
+import torch
+import triton
+import triton.language as tl
+
+
+@triton.jit
+def _pack_prefill_kv(
+    K, V, Table, Lengths, DenseK, DenseV,
+    k_stride, v_stride, table_stride, width,
+    ROW_BYTES: tl.constexpr, BLOCK_ROWS: tl.constexpr,
+):
+    batch = tl.program_id(1)
+    row = tl.program_id(0) * BLOCK_ROWS + tl.arange(0, BLOCK_ROWS)
+    length = tl.load(Lengths + batch)
+    # The allocation can cover a capture-time upper bound. Zero the last
+    # partial FA tile too, so no unwritten FP8 NaNs enter its PV product.
+    if tl.program_id(0) * BLOCK_ROWS < length + 256:
+        live = row < length
+        page = tl.load(Table + batch * table_stride + row, live, other=0).to(tl.int64)
+        col = tl.arange(0, ROW_BYTES)
+        key = tl.load(K + page[:, None] * k_stride + col[None, :], live[:, None], 0)
+        val = tl.load(V + page[:, None] * v_stride + col[None, :], live[:, None], 0)
+        dst = (batch.to(tl.int64) * width + row)[:, None] * ROW_BYTES + col[None, :]
+        tl.store(DenseK + dst, key, row[:, None] < width)
+        tl.store(DenseV + dst, val, row[:, None] < width)
+
+
+def dense_prefill_kv(key, value, table, lengths):
+    """Return packed cache views and a null page table, or the original layout."""
+    batch, width = table.shape
+    _, page_size, heads, dim = key.shape
+    row_bytes = heads * dim
+    if (
+        page_size != 1
+        or value.shape != key.shape
+        or key.dtype != torch.float8_e4m3fn
+        or value.dtype != key.dtype
+        or row_bytes < 16
+        or row_bytes > 1024
+        or row_bytes & (row_bytes - 1)
+        or not batch
+        or not width
+        or 2 * batch * width * row_bytes > 32 * 1024 * 1024
+        or key.stride()[-2:] != (dim, 1)
+        or value.stride()[-2:] != (dim, 1)
+        or table.stride(1) != 1
+        or lengths.shape != (batch,)
+        or lengths.stride(0) != 1
+    ):
+        return key, value, table
+
+    packed = torch.empty((2, batch, width, heads, dim), dtype=key.dtype, device=key.device)
+    dense_key, dense_value = packed.unbind()
+    block_rows = min(32, 4096 // row_bytes)
+    _pack_prefill_kv[(triton.cdiv(width, block_rows), batch)](
+        key.view(torch.uint8), value.view(torch.uint8), table, lengths,
+        dense_key.view(torch.uint8), dense_value.view(torch.uint8),
+        key.stride(0), value.stride(0), table.stride(0), width,
+        ROW_BYTES=row_bytes, BLOCK_ROWS=block_rows,
+    )
+    return dense_key, dense_value, None
+
+
+@triton.jit
+def _pack_ragged_prefill_kv(
+    K, V, Table, CuK, PackedCuK, DenseK, DenseV, k_stride, v_stride,
+    table_stride, batch, ROW_BYTES: tl.constexpr, BLOCK_ROWS: tl.constexpr,
+):
+    seq = tl.program_id(1)
+    block = tl.program_id(0)
+    begin = tl.load(CuK + seq)
+    end = tl.load(CuK + seq + 1)
+    length = end - begin
+    # Each sequence owns a whole zero guard after its final live row.
+    # FA3 still uses its original seqused_k for causal alignment.
+    guard: tl.constexpr = 256
+    dst_begin = begin.to(tl.int64) + seq.to(tl.int64) * guard
+    if block == 0:
+        tl.store(PackedCuK + seq, dst_begin)
+        if seq == batch - 1:
+            tl.store(PackedCuK + batch, end + batch * guard)
+    cols = tl.arange(0, ROW_BYTES)
+    for tile in range(block, tl.cdiv(length + guard, BLOCK_ROWS), tl.num_programs(0)):
+        rows = tile * BLOCK_ROWS + tl.arange(0, BLOCK_ROWS)
+        live = rows < length
+        slots = tl.load(Table + seq.to(tl.int64) * table_stride + rows, live, 0).to(tl.int64)
+        dst = (dst_begin + rows)[:, None] * ROW_BYTES + cols[None, :]
+        keys = tl.load(K + slots[:, None] * k_stride + cols[None, :], live[:, None], 0)
+        tl.store(DenseK + dst, keys, mask=rows[:, None] < length + guard)
+        vals = tl.load(V + slots[:, None] * v_stride + cols[None, :], live[:, None], 0)
+        tl.store(DenseV + dst, vals, mask=rows[:, None] < length + guard)
+
+
+def pack_ragged_prefill_kv(key, value, table, lengths, cu_k, cu_q, live_k, q_rows, live_q):
+    """Bound a full-causal gather by published live lengths on eager or Breakable replay."""
+    if table is None or table.ndim != 2 or key.ndim != 4 or cu_k is None or cu_q is None:
+        return None
+    batch, width = table.shape
+    _, page_size, heads, dim = key.shape
+    row_bytes = heads * dim
+    capacity = live_k + 256 * batch
+    limit = 32 * 1024 * 1024
+    if (
+        batch < 2 or width <= 0 or page_size != 1 or value.shape != key.shape
+        or q_rows != live_q or live_k < 1 or live_k > batch * width
+        or key.dtype != torch.float8_e4m3fn or value.dtype != key.dtype
+        or not 16 <= row_bytes <= 1024 or row_bytes & (row_bytes - 1)
+        or 2 * batch * width * row_bytes <= limit or 2 * capacity * row_bytes > limit
+        or table.dtype not in (torch.int32, torch.int64) or table.stride(1) != 1
+        or key.stride()[-2:] != (dim, 1) or value.stride()[-2:] != (dim, 1)
+        or lengths.shape != (batch,) or cu_k.shape != (batch + 1,) or cu_q.shape != cu_k.shape
+        or not all(t.is_contiguous() and t.dtype == torch.int32 for t in (lengths, cu_k, cu_q))
+        or any(t.device != key.device for t in (value, table, lengths, cu_k, cu_q))
+    ):
+        return None
+    packed = key.new_empty((2, capacity, heads, dim))
+    dense_key, dense_value = packed.unbind()
+    packed_cu_k = torch.empty_like(cu_k)
+    block_rows = min(32, 4096 // row_bytes)
+    blocks = min(triton.cdiv(width + 256, block_rows), triton.cdiv(1024, batch))
+    _pack_ragged_prefill_kv[(blocks, batch)](
+        key.view(torch.uint8), value.view(torch.uint8), table, cu_k, packed_cu_k,
+        dense_key.view(torch.uint8), dense_value.view(torch.uint8),
+        key.stride(0), value.stride(0), table.stride(0), batch,
+        ROW_BYTES=row_bytes, BLOCK_ROWS=block_rows,
+    )
+    return dense_key, dense_value, packed_cu_k
