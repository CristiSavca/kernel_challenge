+def _prepare_decode_tuning(prepare, meta, config, name, allow_wide):
+    native = config | {"use_stream_k": False, "use_tma_c": False}
+    m, n, k = native["block_shape"]
+    expected = (256, 128) if name == "w13" else (128, 256)
+    if (allow_wide and m in (16, 24) and (n, k) == expected
