+            and native.get("num_stages") == 4 and native.get("use_warp_spec")
+            and native.get("multi_cast_size_a", 1) == native.get("multi_cast_size_b", 1) == 1
+            and native.get("num_ctas_per_sm", 1) == 1):
+        wide = native | {"block_shape": (m, 2 * n, k), "warp_shape": (m, 64, 64),
+                         "num_stages": 4 if name == "w13" else 3}
+        tuning = json.dumps(wide)
+        try:
+            prepare(meta, _GROUPED_COMPUTE, tuning)
+            return tuning
+        except (AssertionError, ValueError, RuntimeError, OSError, subprocess.SubprocessError) as exc:
+            logging.getLogger(__name__).warning("Using native grouped decode tile after wide tile failed: %s", exc)
+    tuning = json.dumps(native)
+    prepare(meta, _GROUPED_COMPUTE, tuning)
+    return tuning
