+def project_paired_draft_kv(shard, num_tokens, group):
+    """Gather token cohorts and exchange each rank's projected draft K/V rows."""
+    from sglang.srt.batch_invariant_ops import is_batch_invariant_mode_enabled
+
+    size = group.world_size
+    if size not in (4, 8):
+        return None
+    helper = _draft_kv_helper.get()
+    comm = getattr(group, "pynccl_comm", None)
+    rows, hidden = shard.shape
+    weight = getattr(helper, "flat_kv_weight_t", None)
+    channels = 0 if weight is None or weight.ndim != 2 else weight.shape[1]
+    # Minimize the per-rank wire volume. A token cohort shares its inputs.
+    # Every other cohort exchanges one weight bank and one projected block.
+    def volume(width):
+        peers = size // width - 1
+        return (width - 1) * rows * hidden + peers * (hidden * channels + width * rows * channels)
+
+    width = min((n for n in (2, 4) if n < size), key=volume)
+    full = (size - 1) * rows * hidden
+    ready = (
+        comm is not None and comm.available and weight is not None
+        and rows > 0 and (rows - 1) * size < num_tokens <= rows * size
+        and shard.is_contiguous() and shard.dtype == torch.bfloat16
+        and weight.is_contiguous() and weight.shape == (hidden, channels) and channels > 0
+        and weight.device == shard.device == comm.device and weight.dtype == shard.dtype
+        and channels == helper.n_layers * helper.layer_out_dim
+        and not shard.requires_grad and not weight.requires_grad and not is_batch_invariant_mode_enabled()
+        and 8 * volume(width) <= 7 * full
+    )
+    cohort, lane = divmod(group.rank_in_group, width)
+    cohorts = size // width
+    base = cohort * width
+    peers = [c for c in range(cohorts) if c != cohort]
+    if ready:
+        try:
+            gathered = shard.new_empty((width, rows, hidden))
+            remote_weights = weight.new_empty((len(peers), hidden, channels))
+            projected = shard.new_empty((cohorts, width * rows, channels))
+            outgoing = shard.new_empty((len(peers), width * rows, channels))
+        except torch.OutOfMemoryError:
+            ready = False
+
+    # The signatures cover both capability and preallocation. A rank may have
+    # retired its fused helper or failed to reserve staging storage.
+    # Gloo may finish CPU tensor copies on a thread outside inference mode.
+    with torch.inference_mode(False):
+        signature = torch.tensor([int(ready), rows, hidden, channels, num_tokens], dtype=torch.int64, device="cpu")
+        signatures = [torch.empty_like(signature) for _ in range(size)]
+        torch.distributed.all_gather(signatures, signature, group=group.cpu_group)
+    if not ready or any(not torch.equal(s, signature) for s in signatures):
+        return None
+
+    gathered[lane].copy_(shard)
+    with comm.change_state(enable=True):
+        comm.group_start()
+        try:
+            for other in range(width):
+                if other != lane:
+                    comm.send(shard, base + other)
+                    comm.recv(gathered[other], base + other)
+            for idx, other in enumerate(peers):
+                peer = other * width + lane
+                comm.send(weight, peer)
+                comm.recv(remote_weights[idx], peer)
+        finally:
+            comm.group_end()
+
+        x = gathered.view(-1, hidden)
+        try:
+            torch.mm(x, weight, out=projected[cohort])
+            for idx in range(len(peers)):
+                torch.mm(x, remote_weights[idx], out=outgoing[idx])
+        except torch.OutOfMemoryError:
+            computed = False
+        else:
+            computed = True
+        # No cache has been written. If one GEMM could not obtain workspace,
+        # the existing feature gather is still valid on every rank.
+        if not _agree(computed, group):
+            return None
+        comm.group_start()
+        try:
+            for idx, other in enumerate(peers):
+                peer = other * width + lane
+                comm.send(outgoing[idx], peer)
+                comm.recv(projected[other], peer)
+        finally:
+            comm.group_end()
