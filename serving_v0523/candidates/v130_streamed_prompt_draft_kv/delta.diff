+            or torch.cuda.is_current_stream_capturing() or hooks._global_forward_hooks or hooks._global_forward_pre_hooks
+            or any(
+                module._forward_hooks or module._forward_pre_hooks or "forward" in vars(module)
+                or getattr(module, "_compiled_call_impl", None) is not None
+                for module in (fc, norm)
+            )
+        ):
