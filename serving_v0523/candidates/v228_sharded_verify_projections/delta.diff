+def can_capture_decode_columns(target, runner):
+    """Agree once per capture epoch on the loaded weights, hooks and replicated input layout."""
+    from torch.nn.modules import module as hooks
+    from sglang.srt.batch_invariant_ops import is_batch_invariant_mode_enabled
+    from sglang.srt.environ import envs
+    from sglang.srt.model_executor.runner_backend.full_cuda_graph_backend import FullCudaGraphBackend
+    from sglang.srt.runtime_context import get_exec, get_parallel
+
+    parallel = get_parallel()
+    if parallel.tp_size not in (4, 8):
+        return False
+    group = parallel.tp_group
+    if group is None or not torch.distributed.is_initialized() or torch.distributed.get_backend(group.cpu_group) != "gloo":
+        return False
+    body = getattr(getattr(target, "model", None), "language_model", None)
+    layers = [layer.mlp for layer in getattr(body, "layers", ()) if getattr(layer, "is_moe_layer", False)]
+    def has_forward_override(module):
+        if "forward" not in vars(module):
+            return False
+        method = module.forward
+        return getattr(method, "__self__", None) is not module or getattr(method, "__func__", None) is not type(module).forward
+
+    eligible = (
+        envs.SGLANG_ENABLE_MUSE_SPARK_DECODE_COLUMN_GATHER.get()
+        and torch.cuda.is_available() and torch.cuda.get_device_capability()[0] == 9
+        and type(runner.backend) is FullCudaGraphBackend
+        and (runner.capture_forward_mode.is_decode() or runner.capture_forward_mode.is_target_verify())
+        and not runner.enable_pdmux and not runner.enable_two_batch_overlap and not runner.ragged_verify_mode
+        and not runner.enable_torch_compile and not runner.model_runner.is_draft_worker
+        and runner.model_runner.lora_manager is None
+        and not runner.model_runner.capture_head_hooks and not runner.model_runner.capture_tail_hooks
+        and parallel.tp_size == parallel.moe_ep_size == parallel.attn_tp_size == group.world_size
+        and parallel.moe_tp_size == parallel.attn_cp_size == parallel.attn_dcp_size == 1
+        and not parallel.attn_dp_enabled and group.ranks == parallel.attn_tp_group.ranks
+        and not envs.SGLANG_ENABLE_DETERMINISTIC_INFERENCE.get()
+        and not get_exec().deterministic.enable_deterministic_inference
+        and not is_batch_invariant_mode_enabled() and not torch.are_deterministic_algorithms_enabled()
+        and not torch.is_autocast_enabled("cuda") and not target.training
+        and not hooks._global_forward_hooks and not hooks._global_forward_pre_hooks
+        and not any(m._forward_hooks or m._forward_pre_hooks or has_forward_override(m)
+                    or getattr(m, "_compiled_call_impl", None) is not None for m in target.modules())
+        and bool(layers) and all(
+            layer.nvfp4_checkpoint and type(linear) is torch.nn.Linear and linear.bias is None
+            and linear.weight.is_cuda and linear.weight.dtype == torch.bfloat16
+            and linear.weight.is_contiguous() and not linear.weight.requires_grad
+            and linear.weight.shape == (linear.out_features, linear.in_features)
+            and linear.out_features % (128 * group.world_size) == 0
+            for layer in layers for linear in (layer.pre_expert_proj, layer.post_expert_proj)
+        )
+    )
+    vote = torch.tensor(int(eligible), dtype=torch.int32, device="cpu")
+    torch.distributed.all_reduce(vote, op=torch.distributed.ReduceOp.MIN, group=group.cpu_group)
+    return bool(vote.item())
+
+
+def try_decode_column_gather(group, x, weight):
+    """Project full K over disjoint output columns, then concatenate in TP rank order."""
+    from sglang.srt.layers.quantization.unquant import bf16_gemm_dispatch
+
+    rows, features = x.shape
+    # The saved weight reads trade K elements for M replicated output elements.
+    # Leave bandwidth margin for NVLink and the rank-major to row-major copy.
+    if rows == 0 or 16 * rows > features:
+        return None
+    columns = weight.shape[0] // group.world_size
+    local_weight = weight.narrow(0, group.rank_in_group * columns, columns)
+    local = bf16_gemm_dispatch(x, local_weight, None)
+    return group.all_gather(local.contiguous(), dim=-1)
