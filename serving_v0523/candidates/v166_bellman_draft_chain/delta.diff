+@triton.jit
+def _prefix_value_plan(scores_ptr, row, slots: tl.constexpr, top_k: tl.constexpr):
+    """Choose the linear path with the greatest sum of conditional prefix masses."""
+    ranks = tl.arange(0, top_k)
+    values = tl.full((top_k,), 0.0, tl.float32)
+    paths = tl.full((top_k,), 0, tl.uint32)
+    valid = True
+    for step in tl.static_range(slots):
+        depth = slots - step - 1
+        base = (row * slots + depth) * top_k * top_k
+        scores = tl.load(scores_ptr + base + ranks[:, None] * top_k + ranks[None, :]).to(tl.float32)
+        finite = (scores > -float("inf")) & (scores < float("inf"))
+        clean = tl.where(finite, scores, -float("inf"))
+        maxima = tl.max(clean, 1)
+        usable = (maxima > -float("inf")) & (tl.min((finite | (scores == -float("inf"))).to(tl.int32), 1) != 0)
+        # Only parent zero represents the verified anchor at the first slot.
+        valid = valid & (tl.min((usable | ((depth == 0) & (ranks != 0))).to(tl.int32), 0) != 0)
+        weights = tl.exp(clean - tl.where(usable, maxima, 0.0)[:, None])
+        mass = tl.sum(weights, 1)
+        utility = weights * (1.0 + values[None, :])
+        best = tl.max(utility, 1)
+        # On a utility tie prefer the larger native score, then the first rank.
+        tie_scores = tl.where(utility == best[:, None], clean, -float("inf"))
+        choice = tl.argmax(tie_scores, 1, tie_break_left=True)
+        paths = choice.to(tl.uint32) + top_k * tl.gather(paths, choice, 0)
+        values = tl.where(usable, best / tl.maximum(mass, 1.0), 0.0)
+    return tl.sum(tl.where(ranks == 0, paths, 0), 0), valid
+
