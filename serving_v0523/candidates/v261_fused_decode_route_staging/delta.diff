+def _decode_route_expert(global_ids, expert_map, slot, slots, GLOBAL_EXPERTS: tl.constexpr, HAS_EXPERT_MAP: tl.constexpr):
+    expert = tl.load(global_ids + slot, mask=slot < slots, other=-1)
+    in_range = (expert >= 0) & (expert < GLOBAL_EXPERTS)
+    if HAS_EXPERT_MAP:
+        expert = tl.load(expert_map + expert, mask=in_range, other=-1)
+    else:
+        expert = tl.where(in_range, expert, -1)
+    return expert.to(tl.int32)
+
