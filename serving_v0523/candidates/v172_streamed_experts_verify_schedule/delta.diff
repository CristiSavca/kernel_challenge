+            or getattr(forward_batch.spec_info, "ragged_verify_layout", None) is not None
+            or layer.head_dim != 64 or layer.v_head_dim != 64 or layer.logit_cap != 0
+            or kv_heads <= 0 or q_heads < kv_heads or q_heads % kv_heads
+            or q.dtype != torch.float8_e4m3fn or not q.is_cuda
+            or q.device.index != torch.cuda.current_device()
+            or len(key_cache.shape) != 4 or key_cache.shape != value_cache.shape
+            or key_cache.shape[1:] != (self.page_size, kv_heads, 64)
+            or key_cache.dtype != q.dtype or value_cache.dtype != q.dtype
+            or lengths.shape != (batch,) or cu_q.shape != (batch + 1,)
+            or lengths.dtype != torch.int32 or cu_q.dtype != torch.int32
