index 0000000..61b45bd
--- /dev/null
+++ b/python/sglang/srt/layers/muse_spark/live_decode_reduce.py
@@ -0,0 +1,33 @@
+"""Bind the live-row K-partial reduction only to the version-pinned paired decode loop."""
+import hashlib
+from pathlib import Path
+
+
+def bind_live_decode_reduce(kernel):
+    import humming
+    from sglang.kernels import jit
+
+    include = Path(humming.__path__[0]) / "include/humming/epilogue/pipeline.cuh"
+    if hashlib.sha256(include.read_bytes()).hexdigest() != "730493c5a7a92176bf3a5d47d54596a663d734018ac02c2b26ebb2da3e292ed3":
+        raise ValueError("unsupported grouped expert epilogue")
+    if kernel.reduce_overlap_last_stage_only or kernel.multi_cast_size_a != 1 or kernel.multi_cast_size_b != 1:
+        raise ValueError("grouped decode staging is shared with another producer")
+    marker = "#include <humming/epilogue/pipeline.cuh>"
+    alias = "using Epilogue = EpiloguePipeline<Ctx, MMA, EpilogueArithmetic>;"
+    if kernel.code.count(marker) != 1 or kernel.code.count(alias) != 1:
+        raise ValueError("unsupported grouped decode source")
+    header = Path(jit.__file__).parent / "csrc/muse_spark/live_decode_reduce.cuh"
+    kernel.code = kernel.code.replace(marker, marker + "\n" + header.read_text()).replace(
+        alias, "using Epilogue = MuseLiveDecodeEpilogue<Ctx, MMA, EpilogueArithmetic>;"
+    )
+
+    if kernel.block_shape[0] > 8:
+        from sglang.srt.layers.muse_spark.residual_prompt_mma import adapt_residual_tiles
+
+        adapt_residual_tiles(kernel, paired=True, decode_width=kernel.block_shape[0])
+
+
+def has_live_decode_isa(assembly, width):
+    widths = range(8, width + 1, 8)
+    return (all(assembly.count(f"HGMMA.64x{w}x16.F32.BF16") == 32 for w in widths)
+            and assembly.count("WARPGROUP.DEPBAR.LE") == 8 * len(widths))
