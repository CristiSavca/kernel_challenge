@@ -0,0 +1,29 @@
+struct MuseFullWidth {};
+template <class Op, bool Paired, class Ctx, class MMA>
+CUDA_INLINE void muse_residual_mma(MMA& mma, uint32_t stage, uint32_t iter) {
+  using Storage = typename Ctx::SharedStorage;
+  static_assert(Ctx::kIsGroupedContiguousGemm && Ctx::kNumMathThreads == 256 && Ctx::kWarpIters == 4);
+  static_assert(Ctx::BlockShape::M == 176 && Ctx::BlockShape::N == 256 && Ctx::BlockShape::K == 64);
+  static_assert(Ctx::WarpShape::M == 176 && Ctx::WarpShape::N == 32 && Ctx::WarpShape::K == 64);
+  static_assert(MMA::kSwizzleBytes == 128 && !MMA::kUsePackedKLayout && MMA::kPackedKFactor == 1);
+  static_assert(MMA::final_regs_c_index() == 0 && sizeof(mma.regs_b[0]) == 2 * sizeof(uint4));
+  uint32_t addr = cast_smem_ptr_to_uint(&mma.ctx.smem) + offsetof(Storage, stages) +
+      stage * sizeof(typename Storage::StageStorage) + iter * 2 * sizeof(int4) + mma.smem_offset;
+  uint64_t desc = make_wgmma_smem_desc<128>(addr);
+  wgmma_fence();
+  PRAGMA_UNROLL
+  for (uint32_t j = 0; j < 2; ++j)
+    Op::fma(desc, mma.regs_b[iter % 2][j][0], mma.regs_c[0][j][0], true);
+  if (!Paired || iter % 2) {
+    wgmma_commit();
+    wgmma_wait<0>();
+    if constexpr (Paired) {
+      PRAGMA_UNROLL
+      for (uint32_t b = 0; b < 2; ++b) {
+        auto* values = reinterpret_cast<uint32_t*>(&mma.regs_b[b]);
+        PRAGMA_UNROLL
+        for (uint32_t j = 0; j < 8; ++j) warpgroup_fence_operand(values[j]);
+      }
+    }
+  }
+}
