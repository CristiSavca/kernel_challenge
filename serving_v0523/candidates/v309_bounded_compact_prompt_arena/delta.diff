+def wave_workspace_elements(slots, topk, experts, global_experts, hidden, intermediate, rows):
+    from math import isqrt
+
+    # Size the common case from ownership. The planner still routes every slot,
+    # even if all experts selected by every token are on one rank.
+    local_share = (slots * experts + global_experts - 1) // global_experts
+    slack = 4 * (1 + isqrt(local_share - 1))
+    compact_rows = min(slots, local_share + slack + topk - 1)
+    # If the fused tensor-map binding declines, the same storage must also
+    # fit an ordinary wave. Keep the existing upper bound of 16 waves.
+    ordinary_width = max(hidden, intermediate) + max(hidden, 2 * intermediate)
+    minimum_rows = min(slots, (slots + 15) // 16 + topk - 1)
+    return min(rows * ordinary_width, max(
+        compact_rows * (hidden + intermediate), minimum_rows * ordinary_width,
+    ))
