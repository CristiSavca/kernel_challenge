+++ b/python/sglang/srt/layers/muse_spark/projection.py
@@ -0,0 +1,74 @@
+"""Dense Muse expert projections with tensor-parallel checkpoint ownership."""
+
+import torch
+
+from sglang.srt.layers.linear import ColumnParallelLinear
+from sglang.srt.layers.quantization.unquant import bf16_gemm_dispatch
+from sglang.srt.runtime_context import get_exec, get_forward, get_model, get_parallel
+
+
+def use_sharded_expert_projections(in_features, out_features):
+    from sglang.srt.batch_invariant_ops import is_batch_invariant_mode_enabled
+    from sglang.srt.environ import envs
+
+    parallel = get_parallel()
+    if not parallel.muse_shard_expert_projections or parallel.tp_size == 1:
+        return False
+    group = parallel.tp_group
+    if group is None or torch.distributed.get_backend(group.cpu_group) != "gloo":
+        return False
+    ready = (
+        parallel.tp_size == parallel.moe_ep_size == parallel.attn_tp_size
+        and parallel.attn_tp_group.ranks == parallel.tp_group.ranks
+        and in_features % parallel.tp_size == 0
+        and out_features % parallel.tp_size == 0
+        and get_model().load_format in ("auto", "safetensors", "pt")
+        and torch.get_default_dtype() == torch.bfloat16
+        and torch.cuda.is_available()
+        and torch.cuda.get_device_capability()[0] == 9
+        and not get_exec().deterministic.enable_deterministic_inference
+        and not envs.SGLANG_ENABLE_DETERMINISTIC_INFERENCE.get()
+        and not torch.are_deterministic_algorithms_enabled()
+        and not is_batch_invariant_mode_enabled()
+    )
+    # Vote once, before any rank commits to a different checkpoint layout.
+    status = torch.tensor(int(ready), dtype=torch.int32, device="cpu")
+    torch.distributed.all_reduce(status, op=torch.distributed.ReduceOp.MIN, group=group.cpu_group)
+    return bool(status.item())
+
+
+class MuseShardedExpertProjection(ColumnParallelLinear):
+    """Each rank owns output rows and computes every dot over the full K dimension."""
+
+    def __init__(self, in_features, out_features, prefix):
+        super().__init__(
+            in_features, out_features, bias=False, quant_config=None, prefix=prefix,
+            parallel_group="tp",
+        )
+
+    def forward(self, x):
+        group = self.tp_group
+        ranks = group.world_size
+        rows, features = x.shape
+        width = self.weight.shape[0]
+        if rows == 0:
+            return x.new_empty((0, width * ranks))
+        if not get_forward().sp_active:
+            # The input is replicated. Send only the finished output columns,
+            # unless copying the frozen weights moves fewer elements per rank.
+            if rows < features:
+                local = bf16_gemm_dispatch(x, self.weight, None)
+                return group.all_gather(local, dim=1)
+        elif rows * (features + width) < width * features:
+            # Each source owns different tokens. Project all gathered token shards
+            # against our columns, then return each completed block to its owner.
+            whole = group.all_gather(x.contiguous(), dim=0)
+            projected = bf16_gemm_dispatch(whole, self.weight, None).contiguous()
+            received = torch.empty_like(projected)
+            # The graph-safe PyNccl wrapper splits dimension zero in flat elements.
+            group.all_to_all_single(received.view(-1), projected.view(-1))
+            return received.view(ranks, rows, width).transpose(0, 1).reshape(rows, ranks * width)
+        # Long sequence-parallel shards can move fewer bytes by gathering the
+        # weights and leaving every activation on its original token owner.
+        weight = group.all_gather(self.weight, dim=0)
+        return bf16_gemm_dispatch(x, weight, None)
