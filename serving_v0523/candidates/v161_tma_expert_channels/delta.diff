@@ -0,0 +1,148 @@
+#include "expert_route_pair.cuh"
+#include <cuda.h>
+#include <cudaTypedefs.h>
+#include <cstring>
+#include <limits>
+
+namespace sglang {
+namespace muse_tma_route {
+
+using namespace muse_route_pair;
+
+struct alignas(64) BankMaps {
+  CUtensorMap weight, scale;
+};
+static_assert(sizeof(BankMaps) == 256);
+
+SGL_DEVICE void issue_tensor(void* dest, const CUtensorMap* map, uint32_t x, uint32_t y, uint32_t bar) {
+  const auto dst = static_cast<uint32_t>(__cvta_generic_to_shared(dest));
+  asm volatile("cp.async.bulk.tensor.2d.shared::cluster.global.mbarrier::complete_tx::bytes "
+               "[%0], [%1, {%2, %3}], [%4];"
+               :: "r"(dst), "l"(map), "r"(x), "r"(y), "r"(bar) : "memory");
+}
+
+struct TensorStage {
+  const BankMaps* maps;
+  uint32_t barrier;
+  uint32_t* phase;
+  bool pending = false;
+
+  template <bool Gate>
+  SGL_DEVICE void issue(const Projection& p, size_t, uint32_t, uint32_t expert, uint32_t column, uint32_t first,
+                        const bf16_t* input, uint32_t valid_bytes, PackedTile<Gate>& dest) {
+    if (threadIdx.x == 0) {
+      const uint32_t bytes = sizeof(dest.weights) + sizeof(dest.scales);
+      asm volatile("mbarrier.arrive.expect_tx.shared::cta.b64 _, [%0], %1;" :: "r"(barrier), "r"(bytes) : "memory");
+      const uint32_t y = expert * (p.input_width / 16) + first;
+#pragma unroll
+      for (uint32_t i = 0; i < (Gate ? 2u : 1u); ++i) {
+        const uint32_t x = column + i * p.output_width;
+        issue_tensor(&dest.weights[i][0][0], &maps->weight, 2 * x, y, barrier);
+        issue_tensor(&dest.scales[i][0][0], &maps->scale, x / 2, y, barrier);
+      }
+    }
+    pending = true;
+    stage_inputs(input, valid_bytes, dest);
+  }
+
+  SGL_DEVICE void publish() {
+    if (pending) {
+      if (threadIdx.x == 0) {
+        uint32_t complete;
+        do {
+          asm volatile("{ .reg .pred p; mbarrier.try_wait.parity.shared::cta.b64 p,[%1],%2; "
+                       "selp.b32 %0,1,0,p; }" : "=r"(complete) : "r"(barrier), "r"(*phase) : "memory");
+        } while (!complete);
+      }
+      *phase ^= 1;
+      pending = false;
+    }
+    publish_packed();
+  }
+};
+
+template <bool Gate>
+__global__ __launch_bounds__(32 * kChannelWarps) void tensor_projection(
+    const __grid_constant__ Projection p, const __grid_constant__ BankMaps maps) {
+  __shared__ alignas(128) PackedTile<Gate> buffers[2];
+  __shared__ uint64_t barrier;
+  static_assert(sizeof(PackedTile<Gate>) % 128 == 0);
+  static_assert(offsetof(PackedTile<Gate>, scales) % 128 == 0);
+  const auto bar = static_cast<uint32_t>(__cvta_generic_to_shared(&barrier));
+  if (threadIdx.x == 0) {
+    asm volatile("mbarrier.init.shared::cta.b64 [%0], 1;\n"
+                 "fence.proxy.async.shared::cta;" :: "r"(bar) : "memory");
+  }
+  __syncthreads();
+  uint32_t phase = 0;
+  for (uint32_t j = blockIdx.y; j < static_cast<uint32_t>(p.plan[0]); j += gridDim.y) {
+    project_channels<Gate>(p, p.plan + 1 + j * (kRows + 1), 128 * blockIdx.x, buffers,
+                           TensorStage{&maps, bar, &phase});
+  }
+}
+
+inline auto encoder() {
+  static const auto fn = [] {
+    void* ptr = nullptr;
+    cudaDriverEntryPointQueryResult status{};
+    const auto result = cudaGetDriverEntryPointByVersion("cuTensorMapEncodeTiled", &ptr, 12000, cudaEnableDefault, &status);
+    return result == cudaSuccess && status == cudaDriverEntryPointSuccess
+        ? reinterpret_cast<PFN_cuTensorMapEncodeTiled_v12000>(ptr) : nullptr;
+  }();
+  return fn;
+}
+
+inline bool encode(tvm::ffi::TensorView bank, bool weight, CUtensorMap* output) {
+  if (!encoder() || !bank.IsContiguous() || bank.ndim() != 3 || (uintptr_t(bank.data_ptr()) & 15)) return false;
+  const int64_t x = bank.size(2) / (weight ? 1 : 2), planes = bank.size(0), rows = bank.size(1);
+  constexpr int64_t maximum = std::numeric_limits<int32_t>::max();
+  if (x <= 0 || x > maximum || planes <= 0 || rows <= 0 || planes > maximum / rows
+      || (!weight && bank.size(2) % 2)) return false;
+  const cuuint64_t dims[] = {static_cast<cuuint64_t>(x), static_cast<cuuint64_t>(planes * rows)};
+  const cuuint64_t strides[] = {dims[0] * (weight ? 4u : 2u)};
+  const cuuint32_t box[] = {weight ? 256u : 64u, kKSteps}, elem[] = {1, 1};
+  return encoder()(output, weight ? CU_TENSOR_MAP_DATA_TYPE_UINT32 : CU_TENSOR_MAP_DATA_TYPE_UINT16,
+                   2, bank.data_ptr(), dims, strides, box, elem, CU_TENSOR_MAP_INTERLEAVE_NONE,
+                   CU_TENSOR_MAP_SWIZZLE_NONE, CU_TENSOR_MAP_L2_PROMOTION_NONE,
+                   CU_TENSOR_MAP_FLOAT_OOB_FILL_NONE) == CUDA_SUCCESS;
+}
+
+inline void check_map_storage(tvm::ffi::TensorView maps) {
+  host::TensorMatcher({int64_t(2 * sizeof(BankMaps))}).with_dtype<uint8_t>().with_device<kDLCPU>().verify(maps);
+}
+
+}  // namespace muse_tma_route
+
+struct MuseTmaRoutePair {
+  static bool prepare(tvm::ffi::TensorView gate, tvm::ffi::TensorView gs, tvm::ffi::TensorView down,
+                      tvm::ffi::TensorView ds, tvm::ffi::TensorView maps) {
+    using namespace muse_tma_route;
+    check_map_storage(maps);
+    BankMaps encoded[2]{};
+    if (!encode(gate, true, &encoded[0].weight) || !encode(gs, false, &encoded[0].scale)
+        || !encode(down, true, &encoded[1].weight) || !encode(ds, false, &encoded[1].scale)) return false;
+    std::memcpy(maps.data_ptr(), encoded, sizeof(encoded));
+    return true;
+  }
+
+  static void run(tvm::ffi::TensorView inputs, tvm::ffi::TensorView local_ids,
+                  tvm::ffi::TensorView gate, tvm::ffi::TensorView gs, tvm::ffi::TensorView gscale,
+                  tvm::ffi::TensorView down, tvm::ffi::TensorView ds, tvm::ffi::TensorView dscale,
+                  tvm::ffi::TensorView active, tvm::ffi::TensorView outputs, tvm::ffi::TensorView plan,
+                  int64_t groups, tvm::ffi::TensorView maps) {
+    using namespace muse_tma_route;
+    check_map_storage(maps);
+    BankMaps encoded[2];
+    std::memcpy(encoded, maps.data_ptr(), sizeof(encoded));
+    MuseRoutePair::run_with([&](const auto& up, const auto& out, uint32_t count, DLDevice dev) {
+      if (aligned_packed_projection(up) && aligned_packed_projection(out)) {
+        host::LaunchKernel(dim3(up.output_width / 128, count), 256, dev)(tensor_projection<true>, up, encoded[0]);
+        host::LaunchKernel(dim3(out.output_width / 128, count), 256, dev)(tensor_projection<false>, out, encoded[1]);
+      } else {
+        launch_projection<true>(up, count, dev);
+        launch_projection<false>(out, count, dev);
+      }
+    }, inputs, local_ids, gate, gs, gscale, down, ds, dscale, active, outputs, plan, groups);
+  }
+};
+}  // namespace sglang
