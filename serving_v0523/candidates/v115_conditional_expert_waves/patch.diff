+"""Graph-replayable grouped expert prefill with bounded BF16 workspace."""
+
+import torch
+import triton
+import triton.language as tl
+
+
+def wave_capacity(tokens, topk, experts, hidden, intermediate):
+    # Whole tokens stay together. The last token that starts in a wave can
+    # extend up to topk - 1 rows past its nominal route limit.
+    stage_width = max(hidden, intermediate)
+    output_width = max(hidden, 2 * intermediate)
+    max_rows = (384 << 20) // (2 * (stage_width + output_width))
+    if not 1 <= topk <= 8 or tokens < 1:
+        return 0
+    slots = tokens * topk
+    capacity = slots if slots <= max_rows else min(tokens, max_rows - topk + 1)
+    if capacity < 1:
+        return 0
+    key_span = triton.next_power_of_2(max(slots, capacity + topk - 1))
+    if triton.cdiv(slots, capacity) > 16 or (experts + 1) * key_span >= 2**31:
+        return 0
+    return capacity
+
+
+def plan_waves(local_ids, experts, capacity):
+    tokens, topk = local_ids.shape
+    waves = triton.cdiv(tokens * topk, capacity)
+    live = (local_ids >= 0) & (local_ids < experts)
+    counts = live.sum(1, dtype=torch.int32)
+    starts = torch.cumsum(counts, 0, dtype=torch.int32) - counts
+    wave = torch.div(starts, capacity, rounding_mode="floor").clamp_max(waves - 1)
+    bins = torch.where(live, wave[:, None] * experts + local_ids, waves * experts)
+    sorted_bins, sorted_slots = bins.flatten().sort(stable=True)
+    cutoffs = torch.arange(waves * experts + 1, device=local_ids.device, dtype=torch.int32)
+    edges = torch.searchsorted(sorted_bins, cutoffs, out_int32=True)
+    wave_starts = torch.arange(waves, device=local_ids.device, dtype=torch.int32) * capacity
+    token_bounds = torch.searchsorted(starts, wave_starts, out_int32=True)
+    token_bounds = torch.cat((token_bounds, token_bounds.new_full((1,), tokens)))
+    return sorted_bins, sorted_slots, edges, token_bounds
+
+
+@triton.jit
+def _pack_wave(
+    Inputs, SortedBins, SortedSlots, Edges, Packed, RowKeys, RowMap,
+    ROWS: tl.constexpr, EXPERTS: tl.constexpr, TOPK: tl.constexpr,
+    HIDDEN: tl.constexpr, WIDTH: tl.constexpr, SPAN: tl.constexpr,
+):
+    first = tl.load(Edges)
+    end = tl.load(Edges + EXPERTS)
+    col = tl.arange(0, WIDTH)
+    for pos in range(first + tl.program_id(0), end, tl.num_programs(0)):
+        slot = tl.load(SortedSlots + pos).to(tl.int32)
+        expert = tl.load(SortedBins + pos) % EXPERTS
+        row = ROWS - (end - pos)
+        tl.store(RowKeys + row, (expert + 1) * SPAN + slot)
+        tl.store(RowMap + slot, row)
+        src = (slot // TOPK).to(tl.int64) * HIDDEN + col
+        vals = tl.load(Inputs + src, mask=col < HIDDEN, other=0)
+        tl.store(Packed + row.to(tl.int64) * HIDDEN + col, vals, mask=col < HIDDEN)
+
+
+@triton.jit
+def _load_wave(
+    Edges, TokenBounds, Cursor, Bounds, Offsets, Interval, Active,
+    TOKENS: tl.constexpr, ROWS: tl.constexpr, EXPERTS: tl.constexpr,
+    WAVES: tl.constexpr, BLOCK: tl.constexpr, FIRST: tl.constexpr,
+):
+    if FIRST:
+        wave = 0
+    else:
+        wave = tl.load(Cursor) + 1
+    # Clamp every pointer even on the final WHILE condition update.
+    index = tl.minimum(wave, WAVES - 1)
+    col = tl.arange(0, BLOCK)
+    base = index * EXPERTS
+    bound = tl.load(Edges + base + col, mask=col <= EXPERTS, other=0)
+    last = tl.load(Edges + base + EXPERTS)
+    first_token = tl.load(TokenBounds + index)
+    end_token = tl.load(TokenBounds + index + 1)
+    tl.store(Bounds + col, bound, mask=col <= EXPERTS)
+    tl.store(Offsets + col, bound + (ROWS - last), mask=col <= EXPERTS)
+    tl.store(Interval, first_token)
+    tl.store(Interval + 1, end_token)
+    tl.store(Cursor, wave)
+    # Trailing tokens may own zero local routes and must still write their outputs.
+    tl.store(Active, (wave < WAVES) & (first_token < TOKENS))
+
+
+def grouped_prefill_waves(layer, hidden_states, scores, local_ids, capacity):
+    from humming.layer import HummingMethod
+
+    from sglang.kernels.ops.moe.muse_spark_post_expert_finalize_triton import (
+        fused_post_expert_norm_weighted_sum,
+    )
+    from sglang.srt.layers.muse_spark.muse_spark_humming_moe import (
+        _GROUPED_COMPUTE,
+        _expert_scaled_silu_module,
+    )
+
+    tokens, hidden = hidden_states.shape
+    topk = local_ids.shape[1]
+    experts = layer.num_local_experts
+    intermediate = layer.intermediate_size_per_partition
+    rows = min(tokens * topk, capacity + topk - 1)
+    span = triton.next_power_of_2(max(tokens * topk, rows))
+    sorted_bins, sorted_slots, edges, token_bounds = plan_waves(local_ids, experts, capacity)
+    # Humming infers the end of its last expert from the physical row count.
+    # Each wave occupies a suffix of that capacity, including empty waves.
+    stage = hidden_states.new_empty(rows * max(hidden, intermediate))
+    arena = hidden_states.new_empty(rows * max(hidden, 2 * intermediate))
+    packed = stage[: rows * hidden].view(rows, hidden)
+    gate_up = arena[: rows * 2 * intermediate].view(rows, 2 * intermediate)
+    activation = stage[: rows * intermediate].view(rows, intermediate)
+    projected = arena[: rows * hidden].view(rows, hidden)
+    row_keys = local_ids.new_empty(rows)
+    row_map = torch.full_like(local_ids, -1)
+    output = torch.empty_like(hidden_states)
+
+    def run_wave(bounds, offsets, interval):
+        _pack_wave[(min(rows, 256),)](
+            hidden_states, sorted_bins, sorted_slots, bounds, packed, row_keys, row_map,
+            ROWS=rows, EXPERTS=experts, TOPK=topk, HIDDEN=hidden,
+            WIDTH=triton.next_power_of_2(hidden), SPAN=span, num_warps=8,
+        )
+        HummingMethod.forward_layer(
+            layer, inputs=packed, outputs=gate_up, expert_layout=offsets,
+            compute_config=_GROUPED_COMPUTE, tuning_config=layer.humming_grouped_tunings["w13"],
+            sublayer_name="w13",
+        )
+        _expert_scaled_silu_module().run(
+            gate_up, activation, row_keys, offsets, layer.w13_global_scale, span
+        )
+        HummingMethod.forward_layer(
+            layer, inputs=activation, outputs=projected, expert_layout=offsets,
+            compute_config=_GROUPED_COMPUTE, tuning_config=layer.humming_grouped_tunings["w2"],
+            sublayer_name="w2",
+        )
+        fused_post_expert_norm_weighted_sum(
+            projected, scores, norm_weight=layer._post_expert_norm_weight,
+            eps=layer._post_expert_norm_eps, weight_first=layer._post_expert_norm_weight_first,
+            slot_row_indices=row_map, slot_expert_ids=local_ids,
+            expert_output_scales=layer.w2_global_scale, out=output,
+            token_bounds=interval,
+        )
+    waves = token_bounds.numel() - 1
+    if waves < 4 or not getattr(layer, "humming_conditional_waves", False):
+        for wave in range(waves):
+            bounds = edges[wave * experts : (wave + 1) * experts + 1]
+            run_wave(bounds, bounds + (rows - bounds[-1:]), token_bounds[wave : wave + 2])
+        return output
+
+    # Allocate the loop-carried metadata in the parent graph. Only single-device
+    # kernels enter the body. Tensor-parallel collectives stay in the parent.
+    bounds = edges.new_empty(experts + 1)
+    offsets = torch.empty_like(bounds)
+    interval = edges.new_empty(2)
+    cursor = edges.new_empty(())
+    active = torch.empty((), dtype=torch.bool, device=edges.device)
+
+    def load_wave(first):
+        _load_wave[(1,)](
+            edges, token_bounds, cursor, bounds, offsets, interval, active,
+            TOKENS=tokens, ROWS=rows, EXPERTS=experts, WAVES=waves,
+            BLOCK=triton.next_power_of_2(experts + 1), FIRST=first, num_warps=1,
+        )
+
+    load_wave(True)
+    if torch.cuda.is_current_stream_capturing():
+        graph = torch.cuda.CUDAGraph.get_currently_capturing_graph()
+        graph.begin_capture_to_while_node(active)
+        try:
+            run_wave(bounds, offsets, interval)
+            load_wave(False)
+            graph.set_conditional_handle_for_current_node(active)
+        finally:
+            graph.end_capture_to_conditional_node()
+    else:
+        # Warm up both metadata kernels. Eager mode never reads a count back.
+        for wave in range(waves):
+            if wave:
+                load_wave(False)
+            run_wave(bounds, offsets, interval)
+    return output
