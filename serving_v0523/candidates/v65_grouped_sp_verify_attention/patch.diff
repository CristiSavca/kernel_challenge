+"""Humming W4A16 experts for Muse's per-route finalization."""
+
+from __future__ import annotations
+
+import json
+from typing import TYPE_CHECKING
+
+import torch
+import triton
+import triton.language as tl
+
+if TYPE_CHECKING:
+    from sglang.srt.layers.muse_spark.muse_spark_fp4_moe import MuseSpark1xFp4Experts
+
+
+_GROUPED_COMPUTE = json.dumps(
+    {"gemm_type": "grouped_contiguous", "use_f16_accum": False}
+)
+
+
+def prepare_humming_nvfp4(layer: MuseSpark1xFp4Experts) -> None:
+    """Replace the local checkpoint bank with packed Humming weights."""
+    from humming import dtypes
+    from humming.config import GemmType
+    from humming.kernel.humming import HummingKernel
+    from humming.layer import HummingMethod
+    from humming.schema.humming import HummingInputSchema, HummingWeightSchema
+    from humming.transform import transform_humming_tensors
+
+    if layer.quant_config.group_size != 16:
+        raise ValueError("Muse Humming NVFP4 requires groups of 16 weight elements")
+
+    input_schema = HummingInputSchema(a_dtype=dtypes.bfloat16)
+    weight_schema = HummingWeightSchema(
+        b_dtype=dtypes.float4e2m1,
+        bs_dtype=dtypes.float8e4m3,
+        weight_scale_group_size=16,
+    )
+    params = {}
+    tunings = {}
+    grouped_tunings = {}
+    for name, checkpoint_name in (("w13", "gate_up_proj"), ("w2", "down_proj")):
+        packed = getattr(layer, checkpoint_name)
+        scales = getattr(layer, f"{checkpoint_name}_weight_scale")
+        global_scale = getattr(layer, f"{checkpoint_name}_weight_scale_2")
+        experts, n, packed_k = packed.shape
+        k = packed_k * 2
+        if n % 256 or k % 128 or experts != layer.num_local_experts:
+            raise ValueError("Muse Humming requires aligned local expert matrices")
+        if packed.dtype != torch.uint8 or scales.dtype != torch.float8_e4m3fn:
+            raise ValueError("Muse Humming requires packed E2M1 and E4M3 scales")
+        if scales.shape != (experts, n, k // 16):
+            raise ValueError("Muse Humming received an incompatible scale shape")
+
+        # Reproduce Marlin's NVFP4 BF16 operand. Its E4M3 unpack maps all
+        # subnormal scales to zero and assumes non-negative finite scales.
+        scale_bytes = scales.view(torch.uint8)
+        if (scale_bytes > 0x7E).any().item():
+            raise ValueError("Muse Humming requires non-negative finite block scales")
+        scale_bytes = scale_bytes.masked_fill(scale_bytes < 8, 0)
+
+        meta = HummingMethod.prepare_layer_meta(
+            layer,
+            shape_n=n,
+            shape_k=k,
+            weight_schema=weight_schema,
+            input_schema=input_schema,
+            num_experts=experts,
+            torch_dtype=torch.bfloat16,
+            sublayer_name=name,
+        )
+        tensors = transform_humming_tensors(
+            meta,
+            {
+                "weight": packed.view(torch.int32),
+                "weight_scale": scale_bytes.view(torch.float8_e4m3fn),
+            },
+            already_padded=True,
+        )
+        params[meta.weight_name] = tensors["weight"]
+        params[meta.weight_scale_name] = tensors["weight_scale"]
+        # Stock Marlin collapses the gate/up global scales to the gate value
+        # and multiplies after the BF16 output cast. Preserve both boundaries.
+        if name == "w13" and global_scale.ndim == 2:
+            global_scale = global_scale[:, 0]
+        if global_scale.shape != (experts,):
+            raise ValueError("Muse Humming requires one global scale per expert")
+        params[f"{name}_global_scale"] = global_scale.to(torch.bfloat16).contiguous()
+
+        # Each Stream-K slice would be rounded to BF16 before its output
+        # reduction. Keep a complete FP32 accumulation in each output tile.
+        tunings[name] = tuple(
+            (maximum, config | {"use_stream_k": False})
+            for _, maximum, config in HummingMethod.get_default_tuning_configs(
+                layer, gemm_type=GemmType.INDEXED, sublayer_name=name
+            )
+        )
+
+        grouped = HummingMethod.get_default_tuning_configs(
+            layer, gemm_type=GemmType.GROUPED_CONTIGUOUS, sublayer_name=name
+        )[-1][2]
+        grouped_tunings[name] = json.dumps(
+            grouped | {"use_stream_k": False, "use_tma_c": False}
+        )
+        # Dummy graph routes can be empty or concentrated on one EP rank.
+        # Compile the large-batch kernels while the model loads on every rank.
+        HummingKernel.prepare_kernels(
+            meta.to_str(), _GROUPED_COMPUTE, grouped_tunings[name]
+        )
+
+    for name, tensor in params.items():
+        setattr(layer, name, torch.nn.Parameter(tensor, requires_grad=False))
+    for name in ("gate_up_proj", "down_proj"):
+        delattr(layer, name)
+        delattr(layer, f"{name}_weight_scale")
+        delattr(layer, f"{name}_weight_scale_2")
+    layer.humming_indexed_tunings = tunings
+    layer.humming_grouped_tunings = grouped_tunings
+
+
+@triton.jit
+def _scale_live_routes(
+    values,
+    scales,
+    flat_ids,
+    sorted_ids,
+    padded,
+    slots,
+    WIDTH: tl.constexpr,
+    BLOCK: tl.constexpr,
+):
+    column = tl.arange(0, BLOCK)
+    count = tl.load(padded)
+    for position in range(tl.program_id(0), count, tl.num_programs(0)):
+        slot = tl.load(sorted_ids + position)
+        if 0 <= slot and slot < slots:
+            expert = tl.load(flat_ids + slot)
+            scale = tl.load(scales + expert).to(tl.float32)
+            offset = slot.to(tl.int64) * WIDTH + column
+            value = tl.load(values + offset, mask=column < WIDTH, other=0)
+            rounded = (value.to(tl.float32) * scale).to(tl.bfloat16)
+            tl.store(values + offset, rounded, mask=column < WIDTH)
+
+
+def local_humming_expert_ids(
+    layer: MuseSpark1xFp4Experts, topk_ids: torch.Tensor
+) -> torch.Tensor:
+    from sglang.srt.layers.moe.token_dispatcher.standard import (
+        _map_topk_ids_to_local_experts,
+    )
+
+    local_ids = topk_ids.to(torch.int32)
+    if layer._expert_map is not None:
+        local_ids = _map_topk_ids_to_local_experts(local_ids, layer._expert_map)
+    return local_ids.contiguous()
+
+
+def humming_expert_outputs(
+    layer: MuseSpark1xFp4Experts,
+    hidden_states: torch.Tensor,
+    local_ids: torch.Tensor,
+) -> tuple[torch.Tensor, torch.Tensor]:
+    """Produce BF16 outputs for local expert slots in original route order."""
+    from humming.layer import HummingMethod
+
+    from sglang.kernels.ops.activation.activation import silu_and_mul
+    from sglang.srt.layers.moe.fused_moe_triton import moe_align_block_size
+
+    num_tokens, hidden_size = hidden_states.shape
+    topk = local_ids.shape[1]
+    if num_tokens == 0:
+        return hidden_states.new_empty((0, topk, hidden_size)), local_ids
+    if hidden_states.dtype != torch.bfloat16:
+        raise ValueError("Muse Humming NVFP4 expects BF16 activations")
+    flat_ids = local_ids.flatten()
+    num_slots = flat_ids.numel()
+    estimated_local_routes = max(
+        1, num_slots * layer.num_local_experts // layer.global_num_experts
+    )
+    intermediate = layer.intermediate_size_per_partition
+    activations = hidden_states.new_empty((num_slots, intermediate))
+    cache = hidden_states.new_empty((num_slots * max(2 * intermediate, hidden_size),))
+    gate_up = cache[: num_slots * 2 * intermediate].view(num_slots, 2 * intermediate)
+    outputs = cache[: num_slots * hidden_size].view(num_slots, hidden_size)
+
+    alignments = {}
+    for name, inputs, result, route_width in (
+        ("w13", hidden_states, gate_up, topk),
+        ("w2", activations, outputs, 1),
+    ):
+        tuning = next(
+            config
+            for maximum, config in layer.humming_indexed_tunings[name]
+            if estimated_local_routes <= maximum
+        )
+        block_m = tuning["block_shape"][0]
+        if block_m not in alignments:
+            alignments[block_m] = moe_align_block_size(
+                local_ids, block_m, layer.num_local_experts, ignore_invalid_expert=True
+            )
+        sorted_ids, expert_ids, padded = alignments[block_m]
+        HummingMethod.forward_layer(
+            layer,
+            inputs=inputs,
+            outputs=result,
+            sorted_ids=sorted_ids,
+            expert_ids=expert_ids,
+            num_tokens_padded=padded,
+            top_k=route_width,
+            valid_shape_m=estimated_local_routes,
+            compute_config={"gemm_type": "indexed", "use_f16_accum": False},
+            tuning_config=tuning,
+            sublayer_name=name,
+        )
+        # Indexed alignment omits remote routes. Scale only the GEMM rows that
+        # were written, leaving both remote slots and expert padding untouched.
+        width = result.shape[1]
+        _scale_live_routes[(min(sorted_ids.numel(), 1024),)](
+            result,
+            getattr(layer, f"{name}_global_scale"),
+            flat_ids,
+            sorted_ids,
+            padded,
+            num_slots,
+            WIDTH=width,
+            BLOCK=triton.next_power_of_2(width),
+            num_warps=8 if width >= 4096 else 4,
+        )
+        if name == "w13":
+            silu_and_mul(gate_up, activations, expert_ids=flat_ids, expert_step=1)
+
+    return outputs.view(num_tokens, topk, hidden_size), local_ids
+
+
+def humming_grouped_expert_outputs(
+    layer: MuseSpark1xFp4Experts,
+    hidden_states: torch.Tensor,
+    local_ids: torch.Tensor,
+) -> tuple[torch.Tensor, torch.Tensor]:
+    """Return expert outputs and their original route indices for finalization."""
+    from humming.layer import HummingMethod
+
+    from sglang.kernels.ops.activation.activation import silu_and_mul
+
+    _, hidden_size = hidden_states.shape
+    topk = local_ids.shape[1]
+    route_experts, slots = local_ids.flatten().sort(stable=True)
+    experts = torch.arange(
+        layer.num_local_experts + 1, dtype=local_ids.dtype, device=local_ids.device
+    )
+    offsets = torch.searchsorted(route_experts, experts, out_int32=True)
+    first_local = offsets[0].item()
+    num_routes = slots.numel() - first_local
+    if num_routes == 0:
+        return hidden_states.new_empty((0, hidden_size)), local_ids
+
+    intermediate = layer.intermediate_size_per_partition
+    stage_width = max(hidden_size, intermediate)
+    output_width = max(2 * intermediate, hidden_size)
+    if num_routes * (stage_width + output_width) > slots.numel() * (
+        intermediate + output_width
+    ):
+        return humming_expert_outputs(layer, hidden_states, local_ids)
+
+    slots = slots[first_local:]
+    route_experts = route_experts[first_local:].long()
+    offsets = offsets - first_local
+    staging = hidden_states.new_empty(num_routes * stage_width)
+    arena = hidden_states.new_empty(num_routes * output_width)
+    inputs = staging[: num_routes * hidden_size].view(num_routes, hidden_size)
+    gate_up = arena[: num_routes * 2 * intermediate].view(num_routes, 2 * intermediate)
+    activations = staging[: num_routes * intermediate].view(num_routes, intermediate)
+    outputs = arena[: num_routes * hidden_size].view(num_routes, hidden_size)
+    torch.index_select(
+        hidden_states, 0, torch.div(slots, topk, rounding_mode="floor"), out=inputs
+    )
+
+    for name, source, destination in (
+        ("w13", inputs, gate_up),
+        ("w2", activations, outputs),
+    ):
+        HummingMethod.forward_layer(
+            layer,
+            inputs=source,
+            outputs=destination,
+            expert_layout=offsets,
+            compute_config=_GROUPED_COMPUTE,
+            tuning_config=layer.humming_grouped_tunings[name],
+            sublayer_name=name,
+        )
+        scales = getattr(layer, f"{name}_global_scale").index_select(0, route_experts)
+        destination.mul_(scales.unsqueeze(1))
+        if name == "w13":
+            silu_and_mul(gate_up, activations)
+
+    mapped_rows = torch.full_like(local_ids, -1)
+    mapped_rows.view(-1).index_copy_(
+        0,
+        slots,
+        torch.arange(num_routes, dtype=mapped_rows.dtype, device=mapped_rows.device),
+    )
+    return outputs, mapped_rows
