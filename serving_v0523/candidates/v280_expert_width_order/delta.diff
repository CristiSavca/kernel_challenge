+++ b/python/sglang/kernels/jit/csrc/muse_spark/prompt_width_order.cuh
@@ -0,0 +1,50 @@
+#include <humming/utils/all.cuh>
+
+// One record per lane gives every warp an O(1) lookup for the current tile.
+CUDA_INLINE uint4 *muse_width_intervals() {
+  __shared__ uint4 intervals[32];
+  return intervals;
+}
+
+template <class Ctx>
+CUDA_INLINE void muse_init_width_order(Ctx &ctx) {
+  static_assert(Ctx::kNumExperts <= 32 && Ctx::BlockShape::M == 256);
+  static_assert(Ctx::kIsGroupedContiguousGemm && !Ctx::kUseTmaC && !Ctx::kUseStreamK);
+  const uint32_t lane = threadIdx.x & 31;
+  const uint32_t rows = lane < Ctx::kNumExperts ? ctx.smem.expert_tokens[lane] : 0;
+  const uint32_t remainder = rows % 256;
+  const uint32_t full = rows / 256 + (remainder > 224);
+  const uint32_t tail = remainder == 0 || remainder > 224 ? 0 : (remainder <= 32 ? 1 : (remainder <= 128 ? 2 : 3));
+  const uint32_t count = full + (tail != 0);
+  uint32_t prefix = count;
+  #pragma unroll
+  for (uint32_t step = 1; step < 32; step *= 2) {
+    uint32_t other = __shfl_up_sync(0xffffffff, prefix, step);
+    if (lane >= step) prefix += other;
+  }
+  const uint32_t first = lane & ~3u;
+  const bool ascending = (lane & 4) != 0;
+  const uint32_t base = __shfl_sync(0xffffffff, prefix - count, first);
+  uint32_t first_full = base, tail_id = base;
+  #pragma unroll
+  for (uint32_t j = 0; j < 4; ++j) {
+    const uint32_t peer = first + j;
+    const uint32_t peer_full = __shfl_sync(0xffffffff, full, peer);
+    const uint32_t peer_tail = __shfl_sync(0xffffffff, tail, peer);
+    first_full += (peer < lane ? peer_full : 0) + (ascending && peer_tail != 0);
+    tail_id += ascending ? 0 : peer_full;
+    if (peer_tail && (peer_tail == tail ? peer < lane : (ascending ? peer_tail < tail : peer_tail > tail))) ++tail_id;
+  }
+  muse_width_intervals()[lane] = make_uint4(first_full, first_full + full, tail ? tail_id : ~0u, prefix - count);
+}
+
+template <class Ctx>
+CUDA_INLINE void muse_seek_width(Ctx &ctx, uint32_t &tile, uint32_t &expert, uint32_t &offset, uint32_t &end) {
+  const uint4 interval = muse_width_intervals()[threadIdx.x & 31];
+  const uint32_t owners = __ballot_sync(0xffffffff, (tile >= interval.x && tile < interval.y) || tile == interval.z);
+  expert = __ffs(owners) - 1;
+  const uint32_t local = tile == interval.z ? interval.y - interval.x : tile - interval.x;
+  offset = ctx.smem.expert_offset[expert] + 256 * __shfl_sync(0xffffffff, local, expert);
+  end = ctx.smem.expert_offset[expert] + ctx.smem.expert_tokens[expert];
+  tile = __shfl_sync(0xffffffff, interval.w + local, expert);
+}
