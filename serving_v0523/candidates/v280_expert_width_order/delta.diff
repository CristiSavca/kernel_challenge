diff --git a/python/sglang/srt/layers/muse_spark/prompt_width_order.py b/python/sglang/srt/layers/muse_spark/prompt_width_order.py
new file mode 100644
index 0000000..25897f9
--- /dev/null
+++ b/python/sglang/srt/layers/muse_spark/prompt_width_order.py
@@ -0,0 +1,37 @@
+"""Order grouped prompt W2 residual tiles in bounded expert cohorts."""
+from hashlib import sha256
+from pathlib import Path
+
+
+def adapt_width_order(kernel):
+    import humming
+    from sglang.kernels import jit
+
+    vendor = Path(humming.__path__[0]) / "include/humming/scheduler.cuh"
+    scheduler = vendor.read_text()
+    if sha256(scheduler.encode()).hexdigest() != "24443b74d10ac799d805d2ffc840503142696f744a1b3882379c55a6efc1f2e2":
+        raise ValueError("unsupported grouped prompt scheduler")
+    helper = Path(jit.__file__).parent / "csrc/muse_spark/prompt_width_order.cuh"
+    marker = "if (threadIdx.x == 0) ctx.smem.total_m_blocks[0] = m_blocks;"
+    scheduler = scheduler.replace(marker, marker + "\n        muse_init_width_order(ctx);")
+    scheduler = scheduler.replace("if (has_next_block) fetch_moe_group_block();",
+        "if (has_next_block) muse_seek_width(ctx, m_block_id, expert_id, m_offset, current_shape_m);")
+    kernel.code = kernel.code.replace("#include <humming/scheduler.cuh>",
+        helper.read_text() + "\n" + scheduler.replace("#pragma once", "", 1))
+    # The interval table precedes StageStorage, whose A operand declares 1024-byte alignment.
+    kernel.code = kernel.code.replace("extern __shared__ __align__(128)", "extern __shared__ __align__(1024)")
+
+
+def bounded_width_ranges(ranges, pair, ordered):
+    import torch
+
+    choice, upper = ordered
+    result = []
+    for lo, hi, kernel, grid in ranges.reshape(-1, 4).tolist():
+        if [kernel, grid] == pair and lo < upper:
+            stop = min(hi, upper)
+            result.extend((lo, stop, *choice))
+            lo = stop
+        if lo < hi:
+            result.extend((lo, hi, kernel, grid))
+    return torch.tensor(result, dtype=torch.int64, device="cpu")
