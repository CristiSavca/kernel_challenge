+def _return_partials(partials, needs, counts, width, group, output):
+    """Reverse the input exchange and sum each token's partials on its owner."""
+    from sglang.kernels.ops.moe.muse_spark_sparse_return import sum_rank_group
+
+    size, rank = group.world_size, group.rank_in_group
+    rows, hidden = output.shape
+    own_mask = needs[:, rank * rows:(rank + 1) * rows]
+    ends = torch.cumsum(own_mask, dim=1, dtype=torch.int32)
+    lengths = ends[:, -1]
+    bases = torch.cumsum(lengths, dim=0, dtype=torch.int32) - lengths
+    indices = torch.where(own_mask.bool(), ends + bases[:, None] - 1, -1)
+    send_splits = [owner[rank] for owner in counts]
+    capacity = max(sum(counts[rank][first:first + width]) for first in range(0, size, width))
+    # Keep a valid device pointer even on a token owner with no incoming rows.
+    receive_buffer = partials.new_empty((max(capacity, 1), hidden))
+    accumulator = output if width == size else output.new_empty(output.shape, dtype=torch.float32)
+    zeros = [0] * size
+    base = 0
+    for first in range(0, size, width):
+        last = min(first + width, size)
+        splits = [n if first <= source < last else 0 for source, n in enumerate(counts[rank])]
+        length = sum(splits)
+        active = first <= rank < last
+        dist.all_to_all_single(
+            receive_buffer[:length], partials if active else partials[:0],
+            splits, send_splits if active else zeros, group=group.device_group,
+        )
+        destination = output if last == size else accumulator
+        sum_rank_group(indices[first:last], receive_buffer, accumulator, destination, base, first == 0)
+        base += length
 
 
