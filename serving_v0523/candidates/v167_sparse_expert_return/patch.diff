+++ b/python/sglang/kernels/ops/moe/muse_spark_sparse_return.py
@@ -0,0 +1,35 @@
+"""Accumulate received expert partials in source-rank order on the token owner."""
+
+import triton
+import triton.language as tl
+
+
+@triton.jit
+def _sum_rank_group(
+    indices, received, previous, output, rows, hidden, group_base,
+    SOURCES: tl.constexpr, FIRST: tl.constexpr,
+    BLOCK_M: tl.constexpr, BLOCK_N: tl.constexpr,
+):
+    row = tl.program_id(0) * BLOCK_M + tl.arange(0, BLOCK_M)
+    col = tl.program_id(1) * BLOCK_N + tl.arange(0, BLOCK_N)
+    valid = (row[:, None] < rows) & (col[None, :] < hidden)
+    out_idx = row.to(tl.int64)[:, None] * hidden + col[None, :]
+    if FIRST:
+        total = tl.full((BLOCK_M, BLOCK_N), 0, tl.float32)
+    else:
+        total = tl.load(previous + out_idx, valid, other=0).to(tl.float32)
+    for peer in tl.static_range(SOURCES):
+        packed = tl.load(indices + peer * rows + row, row < rows, other=-1)
+        local = tl.maximum(packed - group_base, 0).to(tl.int64)
+        idx = local[:, None] * hidden + col[None, :]
+        value = tl.load(received + idx, valid & (packed[:, None] >= 0), other=0)
+        total += value.to(tl.float32)
+    tl.store(output + out_idx, total, valid)
+
+
+def sum_rank_group(indices, received, previous, output, group_base, first):
+    rows, hidden = output.shape
+    _sum_rank_group[(triton.cdiv(rows, 4), triton.cdiv(hidden, 256))](
+        indices, received, previous, output, rows, hidden, group_base,
+        SOURCES=indices.shape[0], FIRST=first, BLOCK_M=4, BLOCK_N=256,
+    )
