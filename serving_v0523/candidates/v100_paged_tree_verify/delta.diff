diff --git a/python/sglang/srt/speculative/dflash_tree_kv.py b/python/sglang/srt/speculative/dflash_tree_kv.py
new file mode 100644
index 0000000..4b1d7c3
--- /dev/null
+++ b/python/sglang/srt/speculative/dflash_tree_kv.py
@@ -0,0 +1,123 @@
+"""Compact accepted DFLASH target KV in the request's original paged slots."""
+
+import torch
+import triton
+import triton.language as tl
+
+
+@triton.jit
+def _compact_tree_rows(
+    Pointers, Strides, Mapping, Slots, Order, Lengths,
+    WIDTH: tl.constexpr, ROWS: tl.constexpr, WORDS: tl.constexpr,
+    TRANSLATE: tl.constexpr,
+):
+    request = tl.program_id(0)
+    buffer = tl.program_id(1)
+    tile = tl.program_id(2)
+    length = tl.load(Lengths + request)
+    if length > 1:
+        nodes = tl.arange(0, ROWS)
+        live = (nodes < length) & (nodes < WIDTH)
+        # Each entry in Order names a node of the same physical reservation.
+        order = tl.load(Order + request * WIDTH + nodes, live, other=0)
+        move = live & (nodes != order)
+        if tl.sum(move.to(tl.int32), 0) != 0:
+            source = tl.load(Slots + request * WIDTH + order, move, other=0).to(tl.int64)
+            dest = tl.load(Slots + request * WIDTH + nodes, move, other=0).to(tl.int64)
+            if TRANSLATE:
+                source = tl.load(Mapping + source, move & (source > 0), other=0).to(tl.int64)
+                dest = tl.load(Mapping + dest, move & (dest > 0), other=0).to(tl.int64)
+            move = move & (source > 0) & (dest > 0)
+            base = tl.load(Pointers + buffer).to(tl.pointer_type(tl.uint32))
+            stride = tl.load(Strides + buffer) // 4
+            cols = tile * WORDS + tl.arange(0, WORDS)
+            active = move[:, None] & (cols[None, :] < stride)
+            values = tl.load(base + source[:, None] * stride + cols[None, :], active, other=0)
+            # One CTA owns these columns for every slot in this request. Snapshot
+            # even cycles before any thread overwrites another thread's source.
+            tl.debug_barrier()
+            tl.store(base + dest[:, None] * stride + cols[None, :], values, active)
+
+
+def _supports_mha(pool):
+    from sglang.srt.mem_cache.memory_pool import MHATokenToKVPool
+
+    if type(pool) is not MHATokenToKVPool or pool.kv_cache_layout != "nhd" or pool.is_quantized_kv_cache:
+        return False
+    if pool.layer_num == 0:
+        return True
+    ptrs, strides = pool.data_ptrs, pool.data_strides
+    if not (
+        ptrs.is_cuda and ptrs.device == strides.device
+        and ptrs.dtype == torch.uint64 and strides.dtype == torch.int64
+        and ptrs.shape == strides.shape == (2 * pool.layer_num,)
+        and ptrs.is_contiguous() and strides.is_contiguous()
+    ):
+        return False
+    for buffers, dim in ((pool.k_buffer, pool.head_dim), (pool.v_buffer, pool.v_head_dim)):
+        if len(buffers) != pool.layer_num:
+            return False
+        for tensor in buffers:
+            if not (
+                tensor.device == ptrs.device and tensor.dtype == pool.store_dtype
+                and tensor.ndim == 3 and tensor.shape[1:] == (pool.head_num, dim)
+                and tensor.is_contiguous() and tensor.stride(0) == pool.head_num * dim
+                and tensor.stride(0) * tensor.element_size() % 4 == 0
+                and tensor.data_ptr() % 4 == 0
+            ):
+                return False
+    return True
+
+
+def tree_kv_compaction_supported(pool):
+    """Check fixed NHD layouts and the legacy SWA map on this TP rank at startup."""
+    from sglang.srt.mem_cache.swa_memory_pool import SWAKVPool
+
+    if type(pool) is not SWAKVPool:
+        return _supports_mha(pool) and pool.layer_num > 0
+    full, swa = pool.full_kv_pool, pool.swa_kv_pool
+    if not (_supports_mha(full) and _supports_mha(swa)):
+        return False
+    if not swa.layer_num:
+        return full.layer_num > 0
+    mapping = pool.full_to_swa_index_mapping
+    return (
+        mapping is not None and mapping.device == swa.data_ptrs.device
+        and mapping.dtype in (torch.int32, torch.int64) and mapping.ndim == 1
+        and mapping.is_contiguous()
+        and (not full.layer_num or full.data_ptrs.device == mapping.device)
+    )
+
+
+def _compact_mha(pool, slots, order, lengths, mapping):
+    if not pool.layer_num:
+        return
+    batch, width = slots.shape
+    max_bytes = pool.head_num * max(pool.head_dim, pool.v_head_dim) * pool.store_dtype.itemsize
+    words = 32
+    grid = (batch, pool.data_ptrs.numel(), triton.cdiv(max_bytes, 4 * words))
+    _compact_tree_rows[grid](
+        pool.data_ptrs, pool.data_strides, mapping, slots, order, lengths,
+        width, triton.next_power_of_2(width), words, mapping is not None,
+        num_warps=1,
+    )
+
+
+def compact_tree_kv(pool, slots, order, lengths):
+    """Use the live pool arrays to move only accepted rows, including the identity root."""
+    from sglang.srt.mem_cache.swa_memory_pool import SWAKVPool
+
+    batch, width = order.shape
+    slots = slots.view(batch, width)
+    if not (
+        1 <= width <= 8 and lengths.shape == (batch,)
+        and slots.is_contiguous() and order.is_contiguous() and lengths.is_contiguous()
+    ):
+        raise ValueError("DFLASH KV compaction requires contiguous request rows of width 1 through 8")
+    if not batch:
+        return
+    if type(pool) is SWAKVPool:
+        _compact_mha(pool.full_kv_pool, slots, order, lengths, None)
+        _compact_mha(pool.swa_kv_pool, slots, order, lengths, pool.full_to_swa_index_mapping)
+    else:
+        _compact_mha(pool, slots, order, lengths, None)
