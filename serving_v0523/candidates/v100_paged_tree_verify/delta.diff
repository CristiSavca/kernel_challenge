+                    order = torch.arange(width, dtype=torch.int64, device=self.device)[None, :]
+                    lengths = torch.zeros((1,), dtype=torch.int32, device=self.device)
+                    compact_tree_kv(pool, slots, order, lengths)
+            except Exception as exc:
