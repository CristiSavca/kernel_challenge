+@triton.jit
+def _gated_residual_kernel(
+    Stream, Branch, Alpha, Beta, Output, count, WIDTH: tl.constexpr, BLOCK: tl.constexpr,
+):
+    index = tl.program_id(0).to(tl.int64) * BLOCK + tl.arange(0, BLOCK)
+    live = index < count
+    channel = index % WIDTH
+    stream = tl.load(Stream + index, mask=live, other=0)
+    # Widen BF16 exactly, including subnormal values and signed zero.
+    bits = tl.load(Branch + index, mask=live, other=0).to(tl.uint16, bitcast=True)
+    branch = (bits.to(tl.uint32) << 16).to(tl.float32, bitcast=True)
+    alpha = tl.load(Alpha + channel)
+    beta = tl.load(Beta + channel)
+    tl.store(Output + index, alpha * stream + beta * branch, mask=live)
+
+
+def gated_residual(stream, branch, alpha, beta):
+    output = torch.empty_like(stream)
+    with torch.cuda.device(stream.device):
+        _gated_residual_kernel[(triton.cdiv(stream.numel(), 512),)](
+            stream, branch, alpha, beta, output, stream.numel(), stream.shape[1], 512,
+            # Match eager FP32 multiply, multiply, add rounding.
+            enable_fp_fusion=False,
+        )
+    return output
+
