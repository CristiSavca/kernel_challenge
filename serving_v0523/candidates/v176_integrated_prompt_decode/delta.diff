+
+class _PrefillContext(NamedTuple):
+    draft: nn.Module
+    fc: nn.Linear
+    norm: nn.Module
+    project_target_hidden: object
+    group: object
+    target: nn.Module
+    logits_processor: nn.Module
+
+
+_prefill_context = ContextVar("dflash_sp_prefill_context", default=None)
+
+
+def _agree(ready, group):
+    # Keep device collective shapes uniform even for rank-local instrumentation.
+    status = torch.tensor(int(ready), device="cpu", dtype=torch.int32)
+    torch.distributed.all_reduce(
+        status, op=torch.distributed.ReduceOp.MIN, group=group.cpu_group
+    )
+    return bool(status.item())
+
+
+def _supports_shard_norm(norm, fc):
+    # RMSNorm resolves its platform dispatch lazily on the first input.
+    from sglang.srt.layers.layernorm import RMSNorm
+
+    if type(norm) is not RMSNorm:
+        return False
+    if any(name in vars(norm) for name in ("forward_cuda", "forward_native", "_resolve_forward_method")):
+        return False
+    method = norm._forward_method
+    if method is None:
+        method = norm._resolve_forward_method()
+    return (
+        getattr(method, "__self__", None) is norm
+        and getattr(method, "__func__", None) in (RMSNorm.forward_cuda, RMSNorm.forward_native)
+        and norm._quant_linear is None
+        and norm.override_orig_dtype in (None, torch.bfloat16)
+        and norm.weight.device == fc.weight.device
+        and norm.weight.shape == (fc.out_features,)
+    )
+
+
+def prepare_dflash_sp_prefill(draft, target, logits_processor, group):
+    from sglang.srt.layers.logits_processor import LogitsProcessor
+    from sglang.srt.models.muse_spark import MuseSpark1xLogitsProcessor
+    from sglang.srt.models.dflash import DFlashDraftModel
+
+    fc = getattr(draft, "fc", None)
+    norm = getattr(draft, "hidden_norm", None)
+    compatible = (
+        getattr(type(draft), "project_target_hidden", None)
+        is DFlashDraftModel.project_target_hidden
+        and "project_target_hidden" not in vars(draft)
+        and not draft.quantizable
+        and type(fc) is nn.Linear
+        and fc.bias is None
+        and fc.in_features > fc.out_features
+        and fc.weight.shape == (fc.out_features, fc.in_features)
+        and fc.weight.is_cuda
+        and fc.weight.dtype == torch.bfloat16
+        and fc.weight.is_contiguous()
+        and torch.cuda.get_device_capability(fc.weight.device)[0] == 9
+        and type(logits_processor) in (LogitsProcessor, MuseSpark1xLogitsProcessor)
+        and _supports_shard_norm(norm, fc)
+    )
+    if _agree(compatible, group):
+        return _PrefillContext(
+            draft, fc, norm, draft.project_target_hidden, group, target, logits_processor
+        )
+    return None
+
+
+@contextmanager
+def dflash_sp_prefill_scope(context):
+    token = _prefill_context.set(context)
+    try:
+        yield
+    finally:
+        _prefill_context.reset(token)
+
+
+def project_dflash_prefill_shard(inputs, num_tokens, group, logits_processor, full_capture):
+    """Assign each replicated full-K projection row to its SP owner."""
+    context = _prefill_context.get()
+    # Small shards do not amortize the GEMM and host capability agreement.
+    if context is None or num_tokens < 128 * group.world_size:
+        return None
+    if inputs.is_cuda and torch.cuda.is_current_stream_capturing():
+        return None
+    draft, fc, norm, projector, expected_group, target, expected_logits = context
+    compatible = (
+        group is expected_group
+        and full_capture
+        and logits_processor is expected_logits
+        and not logits_processor.keep_last_hidden_states
+        and logits_processor.expected_aux_hidden_states is None
+        and not draft.quantizable
+        and draft.hidden_norm is norm
+        and not any(name in vars(logits_processor) for name in (
+            "_get_pruned_states", "_get_hidden_states_to_store", "_get_last_hidden_states_to_store",
+        ))
+        and _supports_shard_norm(norm, fc)
+        and draft.fc is fc
+        and draft.project_target_hidden == projector
+        and fc.bias is None
+        and not torch.is_autocast_enabled()
+        and not torch.are_deterministic_algorithms_enabled()
+        and not module_hooks._global_forward_hooks
+        and not module_hooks._global_forward_pre_hooks
+        and all(
+            not mod._forward_hooks
+            and not mod._forward_pre_hooks
+            and getattr(mod, "_compiled_call_impl", None) is None
+            and "forward" not in vars(mod)
+            for mod in (fc, norm, target, logits_processor)
+        )
+        and inputs.ndim == 2
+        and inputs.shape[0] * group.world_size >= num_tokens
+        and inputs.shape[1] == fc.in_features
+        and fc.weight.shape == (fc.out_features, fc.in_features)
+        and fc.weight.is_contiguous()
+        and inputs.device == fc.weight.device
+        and inputs.dtype == fc.weight.dtype == torch.bfloat16
+    )
+    if _agree(compatible, group):
+        return norm(fc(inputs))
+    return None
