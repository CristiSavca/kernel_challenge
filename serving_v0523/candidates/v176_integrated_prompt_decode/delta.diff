+def sp_gather_selected_rows(shard: torch.Tensor, positions: torch.Tensor, num_tokens: int) -> torch.Tensor:
+    """Gather replicated selections from row-sharded states, preserving order and bits."""
+    group = get_parallel().tp_group
+    span = shard.shape[0]
+    # Match indexing on the original unpadded global tensor, including -1.
+    valid = (positions >= -num_tokens) & (positions < num_tokens)
+    absolute = torch.where(positions < 0, positions + num_tokens, positions)
+    owner = torch.div(absolute, span, rounding_mode="floor")
+    owner = torch.where(valid, owner, group.world_size)
+    local = shard.index_select(0, absolute.remainder(span))
+    count = positions.numel()
+    gathered = shard.new_empty((group.world_size * count, shard.shape[1]))
+    group.all_gather_into_tensor(gathered, local)
+    request = torch.arange(count, device=shard.device)
+    return gathered.index_select(0, owner * count + request)
+
