+@lru_cache(maxsize=128)
+def _prepare_cohort_variant(context, meta, compute, tuning):
+    # The vendor stores successful kernels per CUDA context. Also cache a
+    # failed optional build so later layers can immediately use their parent.
+    from humming.kernel.humming import HummingKernel
+
+    try:
+        HummingKernel.prepare_kernels(meta, compute, tuning)
+    except (ValueError, AssertionError, RuntimeError, OSError, subprocess.SubprocessError) as exc:
+        logging.getLogger(__name__).warning("Grouped prefill tile unavailable: %s", exc)
+        return False
+    return True
+
+
+def prepare_tile_widths(metas, tunings, compute, hidden, intermediate, device):
+    from humming.kernel.humming import HummingKernel
+
+    configs = {name: json.loads(value) for name, value in tunings.items()}
+    base = configs["w13"]["block_shape"][0]
+    if any(
+        config["block_shape"][0] != base or config["warp_shape"][0] != base
+        or not config.get("use_warp_spec") or not config.get("use_tma")
+        or config.get("num_ctas_per_sm", 1) != 1 or config.get("num_sms", 0)
+        for config in configs.values()
+    ):
+        return None
+    bands = (2 * intermediate // configs["w13"]["block_shape"][1], hidden // configs["w2"]["block_shape"][1])
+    sms = torch.cuda.get_device_properties(device).multi_processor_count
+    widths = {base: tunings}
+    context = HummingKernel.current_context()
+    # Keep N/K, stages, warp count, accumulation and epilogue unchanged.
+    for width in sorted({8 * ((3 * base + 16) // 32), 8 * ((7 * base + 32) // 64)}):
+        if not 64 <= width < base or width % 8:
+            continue
+        variants = {}
+        for name, config in configs.items():
+            updated = config.copy()
+            for key in ("block_shape", "warp_shape"):
+                updated[key] = [width, *config[key][1:]]
+            variants[name] = json.dumps(updated)
+        if all(_prepare_cohort_variant(context, metas[name], compute, tuning) for name, tuning in variants.items()):
+            widths[width] = variants
+    return (widths, bands, sms) if len(widths) > 1 else None
+
+
+def choose_tiles(state, counts):
+    if not state or not counts or not any(counts):
+        return None
+    widths, bands, sms = state
+    base = max(widths)
+    tiles = [(n + base - 1) // base for n in counts]
+    total = sum(tiles)
+
+    def waves(n):
+        return sum((n * bands_per_projection + sms - 1) // sms for bands_per_projection in bands)
+
+    best = base * waves(total)
+    choice = None
+    for width in sorted(widths):
+        if width == base:
+            continue
+        # Preserve the number of packed weight-tile reads for every expert.
+        narrow = [n <= t * width for n, t in zip(counts, tiles)]
+        first = sum(t for t, use in zip(tiles, narrow) if use)
+        cost = width * waves(first) + base * waves(total - first)
+        if first and first != total:
+            # Price one extra resident wave per projection for a second launch.
+            cost += width * len(bands)
+        if cost < best:
+            best, choice = cost, (width, narrow)
+    if choice is None:
+        return None
+    width, narrow = choice
+    narrow_rows = sum(n for n, use in zip(counts, narrow) if use)
+    groups = [(width, 0, narrow_rows)]
+    if narrow_rows == sum(counts):
+        return groups, [list(accumulate(counts, initial=0))]
+    groups.append((base, narrow_rows, sum(counts)))
+    experts = len(counts)
+    keys = [-1, *(i if use else experts + i for i, use in enumerate(narrow))]
+    offsets = [
+        list(accumulate((n if use == selected else 0 for n, use in zip(counts, narrow)), initial=0))
+        for selected in (True, False)
+    ]
+    return groups, [keys, *offsets]
+
+
+def sort_tile_cohorts(ids, plan, state):
+    groups, table = plan
+    meta = torch.tensor(table, device="cpu", dtype=torch.int32).to(ids.device, non_blocking=True)
+    keys = ids.reshape(-1)
+    if len(groups) > 1:
+        keys = meta[0].index_select(0, keys.long() + 1)
+    sorted_keys, slots = keys.sort(stable=True)
+    offsets = meta[-len(groups):]
+    runs = [
+        (begin, end, offsets[index], state[0][width])
+        for index, (width, begin, end) in enumerate(groups)
+    ]
+    return sorted_keys, slots, runs
