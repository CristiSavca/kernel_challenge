--- /dev/null
+++ b/python/sglang/srt/layers/muse_spark/decode_gate_up.py
@@ -0,0 +1,150 @@
+"""Run the native grouped expert WGMMA with a paired gate/up epilogue."""
+
+import json
+import logging
+import subprocess
+from functools import lru_cache
+from importlib.metadata import PackageNotFoundError, version
+from pathlib import Path
+
+import torch
+
+from sglang.kernels.jit.utils import load_jit
+
+
+@lru_cache(maxsize=1)
+def _launcher():
+    try:
+        return load_jit(
+            "muse_decode_gate_up", cuda_files=["muse_spark/decode_gate_up_launch.cuh"],
+            cuda_wrappers=[(name, f"MuseDecodeGateUp::{name}") for name in ("prepare", "configure", "run")],
+            extra_ldflags=["-lcuda"],
+        )
+    except (ImportError, RuntimeError, OSError, subprocess.SubprocessError) as exc:
+        logging.getLogger(__name__).warning("Using ordinary grouped projection because the launcher is unavailable: %s", exc)
+        return None
+
+
+@lru_cache(maxsize=128)
+def _compile(context, meta, compute, tuning):
+    from humming.jit.compiler import NVCCCompiler
+    from humming.jit.runtime import KernelRuntime
+    from humming.kernel.humming import HummingKernel
+
+    # The complete generated kernel and these specializations share Humming's
+    # normal code cache key. Load the CUfunction directly for the compact ABI.
+    class GroupedDecodeGateUpKernel(HummingKernel):
+        @staticmethod
+        def _get_compiler():
+            return NVCCCompiler
+
+        def load_cubin(self):
+            if self.cubin_loaded:
+                return
+            # Some compiler/toolkit combinations can eliminate the math path
+            # despite compiling the persistent producer. Check this module once.
+            binary = NVCCCompiler._get_env()["binaries"].get("cuobjdump")
+            if not binary:
+                raise RuntimeError("CUDA disassembler unavailable for the grouped gate/up kernel")
+            assembly = subprocess.check_output([binary, "-sass", self.kernel_filename], text=True)
+            opcode = f"HGMMA.64x{self.block_shape[0]}x16.F32.BF16"
+            if assembly.count(opcode) != 32 or assembly.count("WARPGROUP.DEPBAR.LE") != 12 or "UTMALDG.4D" not in assembly:
+                raise RuntimeError("grouped gate/up kernel lacks its Hopper matrix or paired tensor instruction")
+            KernelRuntime.load_cubin(self)
+
+        def prepare(self):
+            if (self.sm_version != 90 or self.num_stages != 4 or tuple(self.block_shape[1:]) != (256, 128)
+                    or tuple(self.warp_shape) != (self.block_shape[0], 32, 64)
+                    or self.num_threads != 640 or self.num_math_threads != 512
+                    or not (self.use_tma_a and self.use_tma_b and self.use_tma_bs)
+                    or self.use_tma_as or self.use_tma_bzp or self.use_tma_bias or self.use_tma_bs2
+                    or not self.use_warp_spec or self.use_tma_c or self.use_stream_k):
+                raise ValueError("unsupported grouped gate/up launch layout")
+            from sglang.kernels import jit
+
+            header = Path(jit.__file__).parent / "csrc/muse_spark/decode_gate_up.cuh"
+            self.code += f"\n#define MUSE_GATE_M {self.block_shape[0]}\n" + header.read_text()
+            pair = header.with_name("grouped_decode_mma_pair.cuh")
+            self.code += "\n#define MUSE_OVERLAP_CONTEXT MuseGateCtx\n" + pair.read_text()
+            KernelRuntime.prepare(self)
+
+    config = json.loads(meta) | json.loads(compute) | json.loads(tuning)
+    config.pop("sublayer_name", None)
+    required = {
+        "gemm_type": "grouped_contiguous", "mma_type": "wgmma", "use_f16_accum": False,
+        "a_dtype": "bfloat16", "b_dtype": "float4e2m1", "c_dtype": "bfloat16", "bs_dtype": "float8e4m3",
+        "weight_scale_group_size": 16, "weight_scale_type": "group", "weight_scale_2_type": "none",
+    }
+    if (config.pop("num_sms", 0) or any(config.get(k) != v for k, v in required.items())
+            or any(config.get(k) for k in ("has_bias", "has_zero_point", "use_packed_k_layout",
+                                           "use_fused_e8m0_scale", "input_scale_group_size",
+                                           "weight_scale_group_size_n", "pad_shape_n", "pad_shape_k"))):
+        return None
+    try:
+        kernel = GroupedDecodeGateUpKernel(**config)
+        kernel.check_context()
+        handle, shared = int(kernel.func), kernel.estimated_smem_size
+        if _launcher().configure(handle, shared):
+            return kernel, handle, shared, int(kernel.block_shape[0])
+    except (AssertionError, ValueError, TypeError, ImportError, RuntimeError, OSError, subprocess.SubprocessError) as exc:
+        logging.getLogger(__name__).warning("Using ordinary grouped gate/up projection: %s", exc)
+    return None
+
+
+def prepare_gate_up(layer, meta, compute, tunings):
+    from humming.kernel.humming import HummingKernel
+
+    try:
+        if version("humming-kernels") != "0.1.12":
+            return None
+    except PackageNotFoundError:
+        return None
+    bank, scales = layer.w13_weight, layer.w13_weight_scale
+    experts, hidden, intermediate = layer.num_local_experts, layer.hidden_size, layer.intermediate_size_per_partition
+    if (hidden % 128 or intermediate % 128 or hidden > intermediate
+            or bank.shape != (experts, hidden // 16, 4 * intermediate) or bank.dtype != torch.int32
+            or scales.shape != (experts, hidden // 16, 2 * intermediate) or scales.dtype != torch.float8_e4m3fn
+            or layer.w13_global_scale.shape != (experts,) or layer.w13_global_scale.dtype != torch.bfloat16
+            or not all(t.is_contiguous() for t in (bank, scales, layer.w13_global_scale))
+            or any(bank.device != t.device for t in (scales, layer.w13_global_scale))):
+        return None
+    config = json.loads(meta)
+    if (config.get("mma_type") != "wgmma" or config.get("use_packed_k_layout")
+            or config.get("weight_scale_group_size") != 16):
+        return None
+    widths = {t for _, t in tunings}
+    try:
+        launcher = _launcher()
+        if launcher is None:
+            return None
+        maps = torch.empty(256, dtype=torch.uint8, device="cpu")
+        if not launcher.prepare(bank, scales.view(torch.uint8), maps):
+            return None
+        ctx = HummingKernel.current_context()
+        kernels = {t: _compile(ctx, meta, compute, t) for t in sorted(widths)}
+    except (RuntimeError, OSError, subprocess.SubprocessError) as exc:
+        logging.getLogger(__name__).warning("Using ordinary grouped decode: %s", exc)
+        return None
+    if not any(kernels.values()):
+        return None
+    sms = torch.cuda.get_device_properties(bank.device).multi_processor_count
+    bindings = tuple((t.data_ptr(), t.shape) for t in (bank, scales))
+    return launcher, maps, bindings, kernels, sms
+
+
+def run_gate_up(layer, inputs, keys, offsets, tuning):
+    """Return compact BF16 activations, or decline before issuing the projection."""
+    state = getattr(layer, "humming_decode_gate_up", None)
+    if not state:
+        return None
+    launcher, maps, addresses, kernels, sms = state
+    kernel = kernels.get(tuning)
+    if kernel is None or addresses != tuple(
+        (t.data_ptr(), t.shape) for t in (layer.w13_weight, layer.w13_weight_scale)
+    ):
+        return None
+    _, handle, shared, width = kernel
+    active = inputs.new_empty((inputs.shape[0], layer.intermediate_size_per_partition))
+    if launcher.run(inputs, active, keys, offsets, layer.w13_global_scale, maps, handle, shared, width, sms):
+        return active
+    return None
