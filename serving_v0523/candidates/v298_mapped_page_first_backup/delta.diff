@@ -421,6 +421,32 @@ def _resolve_device_accessible_ptr_fn():
     return get_device_accessible_ptr
 
 
+def has_linear_host_mapping(buffer: torch.Tensor, device: torch.device) -> bool:
+    """Can one device address and a byte stride cover every host registration?"""
+    ranges = getattr(buffer, _CUDA_HOST_REGISTERED_RANGES_ATTR, ())
+    if not ranges or not buffer.is_contiguous() or buffer.device.type != "cpu":
+        return False
+    resolve = _resolve_device_accessible_ptr_fn()
+    if resolve is None:
+        return False
+    device_index = device.index if device.index is not None else torch.cuda.current_device()
+    flat = buffer.view(-1)
+    base = flat.data_ptr()
+    covered = 0
+    try:
+        mapped_base = resolve(flat, device_index)
+        for ptr, size in ranges:
+            if ptr != base + covered or covered % flat.element_size() or size <= 0:
+                return False
+            offset = covered // flat.element_size()
+            if mapped_base + covered != resolve(flat[offset : offset + 1], device_index):
+                return False
+            covered += size
+    except RuntimeError:
+        return False
+    return covered == buffer.nbytes
+
+
