diff --git a/python/sglang/kernels/jit/csrc/muse_spark/prompt_weight_pipeline.cuh b/python/sglang/kernels/jit/csrc/muse_spark/prompt_weight_pipeline.cuh
new file mode 100644
index 0000000..ea45d1b
--- /dev/null
+++ b/python/sglang/kernels/jit/csrc/muse_spark/prompt_weight_pipeline.cuh
@@ -0,0 +1,103 @@
+// Each stored uint2 holds four group-of-16 scales for one K16/N4 sector.
+template <class Ctx>
+struct alignas(128) MusePromptScaleStages {
+  alignas(128) uint2 scales[Ctx::kNumStages][4][64];
+};
+
+template <class Ctx>
+CUDA_INLINE MusePromptScaleStages<Ctx>& muse_prompt_scales(Ctx& ctx) {
+  auto* end = reinterpret_cast<char*>(&ctx.smem) + ((sizeof(typename Ctx::SharedStorage) + 127) & ~size_t(127));
+  return *reinterpret_cast<MusePromptScaleStages<Ctx>*>(end);
+}
+
+CUDA_INLINE uint32_t muse_scale_bits(uint32_t byte) {
+  return byte ? (byte << 4) + (120u << 7) : 0;
+}
+
+// Execute behind the original activation and weight TMA requests. Humming's
+// non-async scale path accounts for one release arrival per loader thread.
+template <bool Advance, class Ctx, class Loader>
+CUDA_INLINE void muse_load_scales(Ctx& ctx, Loader& loader, uint32_t stage) {
+  static_assert(Ctx::kNumMathThreads == 256 && Ctx::kNumLoadThreads == 128 && Ctx::kWarpIters == 4);
+  static_assert(Ctx::N_WARPS == 8 && Ctx::M_WARPS == 1 && Ctx::K_WARPS == 1 && Ctx::kMultiCastSize == 1);
+  static_assert(!Ctx::kUseTmaBS && !Ctx::kUseCpAsync && Ctx::kUseTmaA && Ctx::kUseTmaB);
+  constexpr uint32_t row_stride = Ctx::ProblemShape::N / 4;
+  const auto* packed = reinterpret_cast<const uint32_t*>(loader.gmem_ptr);
+  auto* dst = reinterpret_cast<uint2*>(&muse_prompt_scales(ctx).scales[stage]);
+  PRAGMA_UNROLL
+  for (uint32_t j = 0; j < 2; ++j) {
+    uint32_t id = ctx.load_thread_id() + 128 * j;
+    uint32_t w = packed[(id / 64) * row_stride + id % 64];
+    dst[id] = make_uint2(muse_scale_bits(w & 255) | (muse_scale_bits((w >> 8) & 255) << 16),
+                         muse_scale_bits((w >> 16) & 255) | (muse_scale_bits(w >> 24) << 16));
+  }
+  if constexpr (Advance) loader.advance();
+}
+
+template <class Ctx, class Arith>
+struct MusePromptMma : Mma<Ctx, Arith> {
+  using Mma<Ctx, Arith>::Mma;
+  uint2 scales[2];
+  using Base = Mma<Ctx, Arith>;
+  using Op = typename Ctx::MmaOpClass;
+  using Storage = typename Ctx::SharedStorage;
+
+  CUDA_INLINE void run(uint32_t stage, uint32_t iteration) {
+    static_assert(Base::kWarpIters == 4 && !Base::kUsePackedKLayout && Base::kPackedKFactor == 1 &&
+                  Base::kRegsBKDim == 1 && Base::final_regs_c_index() == 0 && Base::kSwizzleBytes == 128);
+    uint32_t address = cast_smem_ptr_to_uint(&this->ctx.smem) + offsetof(Storage, stages) +
+        stage * sizeof(typename Storage::StageStorage) + iteration * 2 * sizeof(int4) + this->smem_offset;
+    uint64_t desc = make_wgmma_smem_desc<128>(address);
+    wgmma_fence();
+    PRAGMA_UNROLL
+    for (uint32_t j = 0; j < 2; ++j)
+      Op::fma(desc, this->regs_b[iteration % 2][j][0], this->regs_c[0][j][0], true);
+    if (iteration % 2) {
+      wgmma_commit();
+      wgmma_wait<0>();
+      // Keep both K16 register-source fragments readable until the group drains.
+      PRAGMA_UNROLL
+      for (uint32_t b = 0; b < 2; ++b) {
+        auto* values = reinterpret_cast<uint32_t*>(&this->regs_b[b]);
+        PRAGMA_UNROLL
+        for (uint32_t i = 0; i < 8; ++i) warpgroup_fence_operand(values[i]);
+      }
+    }
+  }
+
+  CUDA_INLINE void transform_b(uint32_t buffer, uint32_t) {
+    static_assert(sizeof(this->regs_b[0]) == 2 * sizeof(uint4));
+    auto* dst = reinterpret_cast<uint32_t*>(&this->regs_b[buffer]);
+    uint4 zero{};
+    PRAGMA_UNROLL
+    for (uint32_t j = 0; j < 2; ++j) {
+      dequant<typename Ctx::ElementB, typename Ctx::ElementA>(
+          this->regs_qb[buffer], dst + j * 4, j, reinterpret_cast<uint32_t*>(&zero));
+      uint32_t pair = j ? scales[buffer].y : scales[buffer].x;
+      uint32_t even = __byte_perm(pair, pair, 0x1010);
+      uint32_t odd = __byte_perm(pair, pair, 0x3232);
+      PRAGMA_UNROLL
+      for (uint32_t i = 0; i < 4; ++i) {
+        uint32_t temp, value = dst[j * 4 + i];
+        asm("mul.rn.bf16x2 %0, %1, %2;" : "=r"(temp) : "r"(value), "r"(0x7d807d80u));
+        asm("mul.rn.bf16x2 %0, %1, %2;" : "=r"(value) : "r"(temp), "r"(i % 2 ? odd : even));
+        dst[j * 4 + i] = value;
+      }
+    }
+  }
+};
+
+template <class Ctx, class MMA, class Epilogue>
+struct MusePromptReader : S2RMemoryPipeline<Ctx, MMA, Epilogue> {
+  using Base = S2RMemoryPipeline<Ctx, MMA, Epilogue>;
+  using Base::Base;
+  template <bool First = false>
+  CUDA_INLINE void load_stage_iter(uint32_t stage, uint32_t iter) {
+    uint32_t ring = (stage + iter / 4) % Ctx::kNumStages;
+    uint32_t k = iter % 4;
+    this->loader_b.load(this->ctx.smem.stages[ring].b, this->mma.template regs_qb_as_ptr<>(k % 2), k);
+    uint32_t warp = this->ctx.n_warp_id();
+    uint32_t index = (this->ctx.lane_id() / 4) * 2 + warp % 2 + (warp / 2) * 16;
+    this->mma.scales[k % 2] = muse_prompt_scales(this->ctx).scales[ring][k][index];
+  }
+};
diff --git a/python/sglang/kernels/jit/csrc/muse_spark/ranked_pool_norm.cuh b/python/sglang/kernels/jit/csrc/muse_spark/ranked_pool_norm.cuh
new file mode 100644
index 0000000..628f484
--- /dev/null
+++ b/python/sglang/kernels/jit/csrc/muse_spark/ranked_pool_norm.cuh
@@ -0,0 +1,119 @@
+#include <sgl_kernel/tensor.h>
+#include <sgl_kernel/utils.h>
+#include <sgl_kernel/runtime.cuh>
+#include <sgl_kernel/type.cuh>
+#include <sgl_kernel/vec.cuh>
+#include <bit>
+#include <cstdint>
+
+namespace sglang {
+namespace ranked_pool {
+
+using namespace device;
+using Vec = AlignedVector<bf16_t, 4>;
+constexpr int kThreads = 128;
+
+struct Params {
+  const bf16_t* packed;
+  const bf16_t* gain;
+  const int32_t* row_map;
+  bf16_t* staging;
+  int rows;
+  int vectors;
+  int shard_vectors;
+  int shard_shift;
+  int topk;
+  float epsilon;
+};
+
+SGL_DEVICE Vec read_vector(const Params& p, int token, int column) {
+  const int rank = column >> p.shard_shift;
+  const int offset = ((rank * p.rows + token) << p.shard_shift) + (column & (p.shard_vectors - 1));
+  return load_as<Vec>(p.packed, offset);
+}
+
+__global__ __launch_bounds__(kThreads) void normalize_to_routes(const __grid_constant__ Params p) {
+  const int token = blockIdx.x;
+  const int tid = threadIdx.x;
+  const int lane = tid % 32;
+  const int warp = tid / 32;
+
+  // Keep ATen's vectorized BF16 RMS order: four channels per lane,
+  // four warps per token, then a descending tree across lanes and warps.
+  float sum = 0.0f;
+  for (int column = tid; column < p.vectors; column += kThreads) {
+    const Vec x = read_vector(p, token, column);
+#pragma unroll
+    for (int j = 0; j < 4; ++j) {
+      const float value = cast<float>(x[j]);
+      sum = __fmaf_rn(value, value, sum);
+    }
+  }
+#pragma unroll
+  for (int step = 16; step > 0; step /= 2) {
+    sum = __fadd_rn(sum, __shfl_down_sync(0xffffffff, sum, step));
+  }
+
+  __shared__ float warp_sums[4];
+  if (lane == 0) warp_sums[warp] = sum;
+  __syncthreads();
+  if (tid == 0) {
+    const float even = __fadd_rn(warp_sums[0], warp_sums[2]);
+    const float odd = __fadd_rn(warp_sums[1], warp_sums[3]);
+    const float mean = __fdiv_rn(__fadd_rn(even, odd), float(4 * p.vectors));
+    warp_sums[0] = rsqrtf(__fadd_rn(mean, p.epsilon));
+  }
+  __syncthreads();
+  const float rstd = warp_sums[0];
+  for (int column = tid; column < p.vectors; column += kThreads) {
+    const Vec x = read_vector(p, token, column);
+    const Vec gain = load_as<Vec>(p.gain, column);
+    Vec y;
+#pragma unroll
+    for (int j = 0; j < 4; ++j) {
+      const float normalized = __fmul_rn(rstd, cast<float>(x[j]));
+      y[j] = cast<bf16_t>(__fmul_rn(cast<float>(gain[j]), normalized));
+    }
+    for (int slot = 0; slot < p.topk; ++slot) {
+      const int row = p.row_map[token * p.topk + slot];
+      if (row >= 0) store_as<Vec>(p.staging, y, row * p.vectors + column);
+    }
+  }
+}
+
+}  // namespace ranked_pool
+
+struct MuseRankedPoolNorm {
+  static void run(tvm::ffi::TensorView packed, tvm::ffi::TensorView gain, tvm::ffi::TensorView row_map,
+                  tvm::ffi::TensorView staging, double epsilon) {
+    using namespace host;
+    using namespace ranked_pool;
+    auto ranks = SymbolicSize{"ranks"};
+    auto rows = SymbolicSize{"rows"};
+    auto stripe = SymbolicSize{"stripe"};
+    auto width = SymbolicSize{"width"};
+    auto topk = SymbolicSize{"topk"};
+    auto slots = SymbolicSize{"slots"};
+    auto device = SymbolicDevice{};
+    device.set_options<kDLCUDA>();
+    TensorMatcher({ranks, rows, stripe}).with_dtype<bf16_t>().with_device(device).verify(packed);
+    TensorMatcher({width}).with_dtype<bf16_t>().with_device(device).verify(gain);
+    TensorMatcher({rows, topk}).with_dtype<int32_t>().with_device(device).verify(row_map);
+    TensorMatcher({slots, width}).with_dtype<bf16_t>().with_device(device).verify(staging);
+    const int64_t hidden = width.unwrap(), tokens = rows.unwrap(), routes = topk.unwrap();
+    RuntimeCheck(hidden == ranks.unwrap() * stripe.unwrap() && stripe.unwrap() % 4 == 0, "invalid column partition");
+    const auto shard_vectors = static_cast<uint32_t>(stripe.unwrap() / 4);
+    RuntimeCheck(std::has_single_bit(shard_vectors), "unsupported ranked column width");
+    RuntimeCheck(tokens * routes == slots.unwrap() && tokens > 0 && routes > 0, "invalid expert row map");
+    RuntimeCheck(hidden <= (1 << 24) && hidden * slots.unwrap() < INT32_MAX, "unsupported pool size");
+    RuntimeCheck(reinterpret_cast<uintptr_t>(packed.data_ptr()) % alignof(Vec) == 0 &&
+                     reinterpret_cast<uintptr_t>(gain.data_ptr()) % alignof(Vec) == 0 &&
+                     reinterpret_cast<uintptr_t>(staging.data_ptr()) % alignof(Vec) == 0,
+                 "ranked normalization requires aligned feature vectors");
+    const Params p{static_cast<const bf16_t*>(packed.data_ptr()), static_cast<const bf16_t*>(gain.data_ptr()),
+                   static_cast<const int32_t*>(row_map.data_ptr()), static_cast<bf16_t*>(staging.data_ptr()),
+                   int(tokens), int(hidden / 4), int(shard_vectors), std::countr_zero(shard_vectors), int(routes), float(epsilon)};
+    LaunchKernel(static_cast<uint32_t>(tokens), kThreads, device.unwrap())(normalize_to_routes, p);
+  }
+};
+}  // namespace sglang
