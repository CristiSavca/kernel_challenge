+def try_decode_column_gather(group, x, weight, *, rank_major=False):
+    """Project full K over disjoint output columns, then concatenate in TP rank order."""
+    from sglang.srt.layers.quantization.unquant import bf16_gemm_dispatch
+
+    rows, features = x.shape
+    # The saved weight reads trade K elements for M replicated output elements.
+    # Leave bandwidth margin for NVLink and the rank-major to row-major copy.
+    if rows == 0 or 16 * rows > features:
+        return None
+    columns = weight.shape[0] // group.world_size
+    local_weight = weight.narrow(0, group.rank_in_group * columns, columns)
+    local = bf16_gemm_dispatch(x, local_weight, None)
+    local = local.contiguous()
+    if rank_major:
+        return group.all_gather(local, dim=0).view(group.world_size, *local.shape)
+    return group.all_gather(local, dim=-1)
diff --git a/python/sglang/srt/layers/dflash_context_projection.py b/python/sglang/srt/layers/dflash_context_projection.py
new file mode 100644
index 0000000..ee1f97e
--- /dev/null
+++ b/python/sglang/srt/layers/dflash_context_projection.py
@@ -0,0 +1,392 @@
+"""DFLASH context projection on sequence-parallel token rows."""
+
+from contextlib import contextmanager
+from contextvars import ContextVar
+from typing import NamedTuple
+
+import torch
+from torch import nn
+from torch.nn.modules import module as module_hooks
+
+
+class _PrefillContext(NamedTuple):
+    draft: nn.Module
+    fc: nn.Linear
+    norm: nn.Module
+    project_target_hidden: object
+    group: object
+    target: nn.Module
+    logits_processor: nn.Module
+
+
+class DFlashVerifyFCGraph:
+    """Share raw verify taps across graph sizes and project a full-K FC shard."""
+
+    def __init__(self, context):
+        self.context = context
+        self.weight = context.fc.weight
+        self.weight_ptr = self.weight.data_ptr()
+        self.version = None if torch.is_inference(self.weight) else self.weight._version
+        self.active = True
+        self.local_weight = None
+        self.raw = None
+
+    def ready(self):
+        draft, fc, _, projector, _, _, _ = self.context
+        return (
+            self.active
+            and draft.fc is fc
+            and fc.weight is self.weight
+            and fc.weight.data_ptr() == self.weight_ptr
+            and (self.version is None or fc.weight._version == self.version)
+            and fc.weight.shape == (fc.out_features, fc.in_features)
+            and fc.weight.is_contiguous()
+            and fc.bias is None
+            and draft.project_target_hidden == projector
+            and not draft.quantizable
+            and not torch.is_autocast_enabled(fc.weight.device.type)
+            and not torch.are_deterministic_algorithms_enabled()
+            and not module_hooks._global_forward_hooks
+            and not module_hooks._global_forward_pre_hooks
+            and not fc._forward_hooks
+            and not fc._forward_pre_hooks
+            and "forward" not in vars(fc)
+            and getattr(fc, "_compiled_call_impl", None) is None
+        )
+
+    def prepare_capture(self, runner):
+        from sglang.srt.batch_invariant_ops import is_batch_invariant_mode_enabled
+        from sglang.srt.model_executor.runner_backend.full_cuda_graph_backend import FullCudaGraphBackend
+
+        context = self.context
+        eligible = (
+            self.ready()
+            and type(runner.backend) is FullCudaGraphBackend
+            and not runner.ragged_verify_mode
+            and not runner.enable_pdmux
+            and not runner.enable_two_batch_overlap
+            and not runner.enable_torch_compile
+            and not runner.model_runner.capture_head_hooks
+            and not runner.model_runner.capture_tail_hooks
+            and not is_batch_invariant_mode_enabled()
+            and not any(mod._forward_hooks or mod._forward_pre_hooks for mod in context.target.modules())
+            and all(
+                getattr(mod, "_compiled_call_impl", None) is None and "forward" not in vars(mod)
+                for mod in (context.target, context.target.model, context.target.model.language_model, context.logits_processor)
+            )
+        )
+        if not _agree(eligible, context.group):
+            return None
+        local_weight, raw = self.local_weight, self.raw
+        try:
+            if local_weight is None:
+                # Isolate peers from source changes, including partial draft loads.
+                width = context.fc.out_features // context.group.world_size
+                first = width * context.group.rank_in_group
+                with torch.inference_mode(False), torch.no_grad():
+                    local_weight = self.weight.narrow(0, first, width).clone()
+            if raw is None or raw.shape[0] < runner.max_num_token:
+                raw = self.weight.new_empty((runner.max_num_token, context.fc.in_features))
+            allocated = True
+        except torch.OutOfMemoryError:
+            allocated = False
+        if not _agree(allocated, context.group):
+            # Keep older graph storage valid. New local allocations made during
+            # this attempt have no published references and are released on exit.
+            return None
+        self.local_weight, self.raw = local_weight, raw
+        return self
+
+    def capture(self, output, batch):
+        # A precise raw-workspace alias also verifies that the native Muse body
+        # reached its direct writer. A wrapper replacing the taps cannot qualify.
+        raw = output.hidden_states
+        workspace = batch.dflash_verify_raw_buffer
+        if raw is workspace and raw is not None:
+            output.dflash_verify_fc_shard = torch.nn.functional.linear(raw, self.local_weight)
+
+    def complete_capture(self, output):
+        # Capture-time CPU consensus covers rank-local changes in returned shape
+        # or ownership. FullCudaGraphBackend retains this exact output object.
+        if not _agree(output.dflash_verify_fc_shard is not None, self.context.group):
+            output.dflash_verify_fc_shard = None
+
+    def finish(self, local, raw):
+        # Every rank must issue the same gather before consulting rank-local draft
+        # hooks or mutations. Clean peers' channel shards always use private weights.
+        full = self.context.group.all_gather(local, dim=-1)
+        if not self.ready():
+            return self.context.draft.project_target_hidden(raw)
+        return self.context.draft.hidden_norm(full)
+
+
+class _PeerKVWeight(NamedTuple):
+    group: object
+    local_weight: torch.Tensor
+    version: int
+    remote_weight: torch.Tensor
+    ready_event: object
+
+
+_draft_kv_helper = ContextVar("dflash_prefill_kv_helper", default=None)
+_prefill_context = ContextVar("dflash_sp_prefill_context", default=None)
+
+
+def _agree(ready, group):
+    # Keep device collective shapes uniform even for rank-local instrumentation.
+    status = torch.tensor(int(ready), device="cpu", dtype=torch.int32)
+    torch.distributed.all_reduce(
+        status, op=torch.distributed.ReduceOp.MIN, group=group.cpu_group
+    )
+    return bool(status.item())
+
+
+def _supports_shard_norm(norm, fc):
+    # RMSNorm resolves its platform dispatch lazily on the first input.
+    from sglang.srt.layers.layernorm import RMSNorm
+
+    if type(norm) is not RMSNorm:
+        return False
+    if any(name in vars(norm) for name in ("forward_cuda", "forward_native", "_resolve_forward_method")):
+        return False
+    method = norm._forward_method
+    if method is None:
+        method = norm._resolve_forward_method()
+    return (
+        getattr(method, "__self__", None) is norm
+        and getattr(method, "__func__", None) in (RMSNorm.forward_cuda, RMSNorm.forward_native)
+        and norm._quant_linear is None
+        and norm.override_orig_dtype in (None, torch.bfloat16)
+        and norm.weight.device == fc.weight.device
+        and norm.weight.shape == (fc.out_features,)
+    )
+
+
+def prepare_dflash_sp_prefill(draft, target, logits_processor, group):
+    from sglang.srt.layers.logits_processor import LogitsProcessor
+    from sglang.srt.models.muse_spark import MuseSpark1xLogitsProcessor
+    from sglang.srt.models.dflash import DFlashDraftModel
+
+    fc = getattr(draft, "fc", None)
+    norm = getattr(draft, "hidden_norm", None)
+    compatible = (
+        getattr(type(draft), "project_target_hidden", None)
+        is DFlashDraftModel.project_target_hidden
+        and "project_target_hidden" not in vars(draft)
+        and not draft.quantizable
+        and type(fc) is nn.Linear
+        and fc.bias is None
+        and fc.in_features > fc.out_features
+        and fc.weight.shape == (fc.out_features, fc.in_features)
+        and fc.weight.is_cuda
+        and fc.weight.dtype == torch.bfloat16
+        and fc.weight.is_contiguous()
+        and torch.cuda.get_device_capability(fc.weight.device)[0] == 9
+        and type(logits_processor) in (LogitsProcessor, MuseSpark1xLogitsProcessor)
+        and _supports_shard_norm(norm, fc)
+    )
+    if _agree(compatible, group):
+        return _PrefillContext(
+            draft, fc, norm, draft.project_target_hidden, group, target, logits_processor
+        )
+    return None
+
+
+@contextmanager
+def dflash_sp_prefill_scope(context, kv_helper=None):
+    token = _prefill_context.set(context)
+    kv_token = _draft_kv_helper.set(kv_helper)
+    try:
+        yield
+    finally:
+        _draft_kv_helper.reset(kv_token)
+        _prefill_context.reset(token)
+
+
+def project_dflash_prefill_shard(inputs, num_tokens, group, logits_processor, full_capture):
+    """Assign each replicated full-K projection row to its SP owner."""
+    context = _prefill_context.get()
+    # Small shards do not amortize the GEMM and host capability agreement.
+    if context is None or num_tokens < 128 * group.world_size:
+        return None
+    if inputs.is_cuda and torch.cuda.is_current_stream_capturing():
+        return None
+    draft, fc, norm, projector, expected_group, target, expected_logits = context
+    compatible = (
+        group is expected_group
+        and full_capture
+        and logits_processor is expected_logits
+        and not logits_processor.keep_last_hidden_states
+        and logits_processor.expected_aux_hidden_states is None
+        and not draft.quantizable
+        and draft.hidden_norm is norm
+        and not any(name in vars(logits_processor) for name in (
+            "_get_pruned_states", "_get_hidden_states_to_store", "_get_last_hidden_states_to_store",
+        ))
+        and _supports_shard_norm(norm, fc)
+        and draft.fc is fc
+        and draft.project_target_hidden == projector
+        and fc.bias is None
+        and not torch.is_autocast_enabled()
+        and not torch.are_deterministic_algorithms_enabled()
+        and not module_hooks._global_forward_hooks
+        and not module_hooks._global_forward_pre_hooks
+        and all(
+            not mod._forward_hooks
+            and not mod._forward_pre_hooks
+            and getattr(mod, "_compiled_call_impl", None) is None
+            and "forward" not in vars(mod)
+            for mod in (fc, norm, target, logits_processor)
+        )
+        and inputs.ndim == 2
+        and inputs.shape[0] * group.world_size >= num_tokens
+        and inputs.shape[1] == fc.in_features
+        and fc.weight.shape == (fc.out_features, fc.in_features)
+        and fc.weight.is_contiguous()
+        and inputs.device == fc.weight.device
+        and inputs.dtype == fc.weight.dtype == torch.bfloat16
+    )
+    if _agree(compatible, group):
+        return norm(fc(inputs))
+    return None
+
+
+def project_paired_draft_kv(shard, num_tokens, group):
+    """Gather token cohorts and exchange each rank's projected draft K/V rows."""
+    from sglang.srt.batch_invariant_ops import is_batch_invariant_mode_enabled
+
+    size = group.world_size
+    if size not in (4, 8):
+        return None
+    helper = _draft_kv_helper.get()
+    comm = getattr(group, "pynccl_comm", None)
+    rows, hidden = shard.shape
+    weight = getattr(helper, "flat_kv_weight_t", None)
+    channels = 0 if weight is None or weight.ndim != 2 else weight.shape[1]
+    # The rank halfway around this TP group is a peer for both cohort widths.
+    # Retain only its prepared weight. Each request still projects fresh rows.
+    cached = getattr(helper, "_paired_kv_peer", None)
+    version = weight._version if weight is not None and not torch.is_inference(weight) else None
+    reuse = (
+        cached is not None and cached.group is group and cached.local_weight is weight
+        and cached.version == version and version is not None
+    )
+    if cached is not None and not reuse:
+        helper._paired_kv_peer = None
+        cached = None
+
+    # Minimize the per-rank wire volume. A token cohort shares its inputs.
+    # Every other cohort exchanges one weight bank and one projected block.
+    def volume(width):
+        peers = size // width - 1
+        return (width - 1) * rows * hidden + (peers - int(reuse)) * hidden * channels + peers * width * rows * channels
+
+    width = min((n for n in (2, 4) if n < size), key=volume)
+    full = (size - 1) * rows * hidden
+    ready = (
+        comm is not None and comm.available and weight is not None
+        and 0 < num_tokens <= rows * size
+        and shard.is_contiguous() and shard.dtype == torch.bfloat16
+        and weight.is_contiguous() and weight.shape == (hidden, channels) and channels > 0
+        and weight.device == shard.device == comm.device and weight.dtype == shard.dtype
+        and channels == helper.n_layers * helper.layer_out_dim
+        and not shard.requires_grad and not weight.requires_grad and not is_batch_invariant_mode_enabled()
+        and 8 * volume(width) <= 7 * full
+    )
+    cohort, lane = divmod(group.rank_in_group, width)
+    cohorts = size // width
+    base = cohort * width
+    peers = [c for c in range(cohorts) if c != cohort]
+    opposite = (cohort + cohorts // 2) % cohorts
+    if ready:
+        try:
+            gathered = shard.new_empty((width, rows, hidden))
+            # Separate allocations let just the opposite rank's bank outlive
+            # this call, including when the selected cohort has three peers.
+            remote_weights = {
+                other: cached.remote_weight if reuse and other == opposite else torch.empty_like(weight)
+                for other in peers
+            }
+            projected = shard.new_empty((cohorts, width * rows, channels))
+            outgoing = shard.new_empty((len(peers), width * rows, channels))
+        except torch.OutOfMemoryError:
+            ready = False
+
+    # The signatures cover both capability and preallocation. A rank may have
+    # retired its fused helper or failed to reserve staging storage.
+    # Gloo may finish CPU tensor copies on a thread outside inference mode.
+    with torch.inference_mode(False):
+        signature = torch.tensor([int(ready), rows, hidden, channels, num_tokens, int(reuse)], dtype=torch.int64, device="cpu")
+        signatures = [torch.empty_like(signature) for _ in range(size)]
+        torch.distributed.all_gather(signatures, signature, group=group.cpu_group)
+    if any(s[-1].item() != int(reuse) for s in signatures):
+        # One rank retired its helper or changed its packed weight. Invalidate
+        # every partner before using any retained weight or issuing a send.
+        if helper is not None:
+            helper._paired_kv_peer = None
+        return None
+    if not ready or any(not torch.equal(s, signature) for s in signatures):
+        return None
+
+    stream = torch.cuda.current_stream(weight.device) if weight.is_cuda else None
+    if stream is not None:
+        weight.record_stream(stream)
+        if reuse:
+            stream.wait_event(cached.ready_event)
+            cached.remote_weight.record_stream(stream)
+    # SP splits one padded sequence into contiguous rank-major pieces. A
+    # captured bucket can leave the last owners partially or entirely empty.
+    def live_rows(first_rank, rank_count=1):
+        return max(0, min(rank_count * rows, num_tokens - first_rank * rows))
+
+    local_rows = live_rows(group.rank_in_group)
+    cohort_rows = live_rows(base, width)
+    gathered[lane, :local_rows].copy_(shard[:local_rows])
+    with comm.change_state(enable=True):
+        if cohort_rows or len(peers) > int(reuse):
+            comm.group_start()
+            try:
+                for other in range(width):
+                    if other != lane:
+                        if local_rows:
+                            comm.send(shard[:local_rows], base + other)
+                        peer_rows = live_rows(base + other)
+                        if peer_rows:
+                            comm.recv(gathered[other, :peer_rows], base + other)
+                for other in peers:
+                    if not reuse or other != opposite:
+                        peer = other * width + lane
+                        comm.send(weight, peer)
+                        comm.recv(remote_weights[other], peer)
+            finally:
+                comm.group_end()
+
+        x = gathered.view(-1, hidden)[:cohort_rows]
+        try:
+            if cohort_rows:
+                torch.mm(x, weight, out=projected[cohort, :cohort_rows])
+                for idx, other in enumerate(peers):
+                    torch.mm(x, remote_weights[other], out=outgoing[idx, :cohort_rows])
+        except torch.OutOfMemoryError:
+            computed = False
+        else:
+            computed = True
+        # No cache has been written. If one GEMM could not obtain workspace,
+        # the existing feature gather is still valid on every rank.
+        if not _agree(computed, group):
+            return None
+        comm.group_start()
+        try:
+            for idx, other in enumerate(peers):
+                peer = other * width + lane
+                if cohort_rows:
+                    comm.send(outgoing[idx, :cohort_rows], peer)
+                peer_rows = live_rows(other * width, width)
+                if peer_rows:
+                    comm.recv(projected[other, :peer_rows], peer)
+        finally:
+            comm.group_end()
+    if not reuse and version is not None and weight._version == version:
+        event = stream.record_event() if stream is not None else None
+        helper._paired_kv_peer = _PeerKVWeight(group, weight, version, remote_weights[opposite], event)
+    return projected.view(-1, channels)[:num_tokens]
