+
+@dataclass(frozen=True)
+class DFlashMixedGraphPlan:
+    prompt_rows: int
+    verify_rows: int
+    mixed_rows: int
+
+
+def _has_live_extent(batch, rows, device):
+    return all(
+        t is not None and t.shape == (rows,) and t.device == device
+        for t in (batch.input_ids, batch.positions, batch.out_cache_loc)
+    )
+
+
+def plan_mixed_dflash_target(model_runner, prompt, verify, mixed, tail_reqs):
+    """Compare one combined target graph with the two original target graphs.
+
+    Call on the TP worker after native page-one reservation, overlap resolution and
+    construction of all three ForwardBatch views. The caller owns the mapping
+    from resolved positions to physical slots, prefix attention metadata and the
+    lifetime of the reservation. This method reads only host metadata and tensor
+    shapes. None preserves the caller's separated schedule.
+    """
+    prefill = model_runner.prefill_cuda_graph_runner
+    decode = model_runner.decode_cuda_graph_runner
+    parallel = get_parallel()
+    if (
+        not isinstance(prefill, PrefillCudaGraphRunner)
+        or not isinstance(decode, DecodeCudaGraphRunner)
+        or prefill.model_runner is not model_runner
+        or decode.model_runner is not model_runner
+        or model_runner.is_draft_worker
+        or not model_runner.spec_algorithm.is_dflash()
+        or model_runner.page_size != 1
+        or (parallel.dp_size, parallel.pp_size, parallel.attn_cp_size, parallel.attn_dcp_size) != (1, 1, 1, 1)
+        or not prefill._uses_eager_prefill_tail()
+        or prefill.enable_cp_bcg_capture
+        or decode.ragged_verify_mode
+        or decode.enable_pdmux
+        or decode.require_mlp_tp_gather
+        or decode.is_encoder_decoder
+        or decode.enable_two_batch_overlap
+    ):
+        return None
+
+    p, b, width = prompt.batch_size, verify.batch_size, decode.captured_req_width
+    info = verify.spec_info
+    if (
+        p < 1 or b < 1 or width < 2 or len(tail_reqs) != b
+        or mixed.batch_size != p + b or mixed.batch_size > prefill.max_bs
+        or prompt.forward_mode != ForwardMode.EXTEND or mixed.forward_mode != ForwardMode.EXTEND
+        or verify.forward_mode != ForwardMode.TARGET_VERIFY
+        or not isinstance(info, DFlashVerifyInput) or info.num_tokens_per_req != width
+        or info.draft_token_num != width or info.topk != 1 or info.custom_mask is not None
+        or info.ragged_verify_layout is not None
+        or prompt.spec_info is not None or mixed.spec_info is not None
+        or any(f.capture_hidden_mode != CaptureHiddenMode.FULL or f.return_logprob or f.is_prefill_only
+               or f.token_indices_to_pool is not None or f.contains_mm_inputs() for f in (prompt, verify, mixed))
+        or decode.capture_hidden_mode < verify.capture_hidden_mode
+        or prompt.extend_seq_lens_cpu is None or mixed.extend_seq_lens_cpu is None
+        or len(prompt.extend_seq_lens_cpu) != p
+        or any(type(n) is not int or n < 1 for n in prompt.extend_seq_lens_cpu)
+        or list(mixed.extend_seq_lens_cpu) != [*prompt.extend_seq_lens_cpu, *([width] * b)]
+        or prompt.extend_prefix_lens_cpu is None or mixed.extend_prefix_lens_cpu is None
+        or len(prompt.extend_prefix_lens_cpu) != p or len(mixed.extend_prefix_lens_cpu) != p + b
+        or list(mixed.extend_prefix_lens_cpu[:p]) != list(prompt.extend_prefix_lens_cpu)
+        or any(type(n) is not int or n < 0 for n in mixed.extend_prefix_lens_cpu)
