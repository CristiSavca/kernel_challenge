+"""Scatter one peer read per needed source token directly into Humming input order."""
+
+import torch
+import triton
+import triton.language as tl
+
+
+@triton.jit(do_not_specialize=["shard_rows"], do_not_specialize_on_alignment=["shard_rows"])
+def _peer_pack(peers, row_map, inputs, shard_rows, TOPK: tl.constexpr,
+               H: tl.constexpr, WIDTH: tl.constexpr, ROUTES: tl.constexpr):
+    token = tl.program_id(0)
+    slot = tl.arange(0, ROUTES)
+    rows = tl.load(row_map + token.to(tl.int64) * TOPK + slot, slot < TOPK, other=-1)
+    if tl.sum((rows >= 0).to(tl.int32), axis=0) > 0:
+        owner = token // shard_rows
+        local = token % shard_rows
+        src = tl.load(peers + owner).to(tl.pointer_type(tl.int16))
+        col = tl.program_id(1) * WIDTH + tl.arange(0, WIDTH)
+        value = tl.load(src + local.to(tl.int64) * H + col, col < H, other=0)
+        for k in tl.static_range(TOPK):
+            row = tl.sum(tl.where(slot == k, rows, 0), axis=0)
+            if row >= 0:
+                tl.store(inputs + row.to(tl.int64) * H + col, value, col < H)
+
+
+def pack_peer_rows(peers, row_map, inputs, shard_rows):
+    tokens, topk = row_map.shape
+    hidden = inputs.shape[1]
+    width = min(1024, triton.next_power_of_2(hidden))
+    _peer_pack[(tokens, triton.cdiv(hidden, width))](
+        peers, row_map, inputs.view(torch.int16), shard_rows, TOPK=topk,
+        H=hidden, WIDTH=width, ROUTES=triton.next_power_of_2(topk),
+    )
