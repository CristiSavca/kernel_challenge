diff --git a/python/sglang/srt/layers/muse_spark/decode_gate_up.py b/python/sglang/srt/layers/muse_spark/decode_gate_up.py
new file mode 100644
index 0000000..23e2a0b
--- /dev/null
+++ b/python/sglang/srt/layers/muse_spark/decode_gate_up.py
@@ -0,0 +1,208 @@
+"""Run the native grouped expert WGMMA with a paired gate/up epilogue."""
+
+import json
+import logging
+import subprocess
+from functools import lru_cache
+from importlib.metadata import PackageNotFoundError, version
+from pathlib import Path
+
+import torch
+
+from sglang.kernels.jit.utils import load_jit
+
+
+@lru_cache(maxsize=1)
+def _launcher():
+    try:
+        return load_jit(
+            "muse_decode_gate_up", cuda_files=["muse_spark/decode_gate_up_launch.cuh"],
+            cuda_wrappers=[
+                ("prepare", "MuseDecodeGateUp::prepare<false>"), ("run", "MuseDecodeGateUp::run<false>"),
+                ("prepare_prompt", "MuseDecodeGateUp::prepare<true>"), ("run_prompt", "MuseDecodeGateUp::run<true>"),
+                ("configure", "MuseDecodeGateUp::configure"),
+            ],
+            extra_ldflags=["-lcuda"],
+        )
+    except (ImportError, RuntimeError, OSError, subprocess.SubprocessError) as exc:
+        logging.getLogger(__name__).warning("Using ordinary grouped projection because the launcher is unavailable: %s", exc)
+        return None
+
+
+@lru_cache(maxsize=128)
+def _compile(context, meta, compute, tuning, prompt=False):
+    from humming.jit.compiler import NVCCCompiler
+    from humming.jit.runtime import KernelRuntime
+    from humming.kernel.humming import HummingKernel
+
+    # The complete generated kernel and these specializations share Humming's
+    # normal code cache key. Load the CUfunction directly for the compact ABI.
+    class GroupedDecodeGateUpKernel(HummingKernel):
+        live_reduction = False
+        both_pairs = False
+        residual_tiles = False
+
+        @staticmethod
+        def _get_compiler():
+            return NVCCCompiler
+
+        def load_cubin(self):
+            if self.cubin_loaded:
+                return
+            # Some compiler/toolkit combinations can eliminate the math path
+            # despite compiling the persistent producer. Check this module once.
+            binary = NVCCCompiler._get_env()["binaries"].get("cuobjdump")
+            if not binary:
+                raise RuntimeError("CUDA disassembler unavailable for the grouped gate/up kernel")
+            assembly = subprocess.check_output([binary, "-sass", self.kernel_filename], text=True)
+            opcode = f"HGMMA.64x{self.block_shape[0]}x16.F32.BF16"
+            drains = 8 if self.both_pairs else (16 if prompt else 12)
+            valid = assembly.count(opcode) == 32 and assembly.count("WARPGROUP.DEPBAR.LE") == drains
+            if self.live_reduction:
+                from sglang.srt.layers.muse_spark.live_decode_reduce import has_live_decode_isa
+
+                valid = has_live_decode_isa(assembly, self.block_shape[0])
+            if self.residual_tiles:
+                from sglang.srt.layers.muse_spark.residual_prompt_mma import has_residual_isa
+
+                valid = has_residual_isa(assembly, drains)
+            if not valid or "UTMALDG.4D" not in assembly:
+                raise RuntimeError("grouped gate/up kernel lacks its Hopper matrix or paired tensor instruction")
+            KernelRuntime.load_cubin(self)
+
+        def prepare(self):
+            block_k, threads, math_threads = (64, 384, 256) if prompt else (128, 640, 512)
+            if (self.sm_version != 90 or self.num_stages != 4 or tuple(self.block_shape[1:]) != (256, block_k)
+                    or tuple(self.warp_shape) != (self.block_shape[0], 32, 64)
+                    or self.num_threads != threads or self.num_math_threads != math_threads
+                    or not (self.use_tma_a and self.use_tma_b and self.use_tma_bs)
+                    or self.use_tma_as or self.use_tma_bzp or self.use_tma_bias or self.use_tma_bs2
+                    or not self.use_warp_spec or self.use_tma_c or self.use_stream_k):
+                raise ValueError("unsupported grouped gate/up launch layout")
+            from sglang.kernels import jit
+
+            header = Path(jit.__file__).parent / "csrc/muse_spark/decode_gate_up.cuh"
+            if self.both_pairs:
+                from sglang.srt.layers.muse_spark.decode_mma_pair import enable_full_pair
+
+                enable_full_pair(self)
+            if prompt:
+                self.code += "\n#define MUSE_GATE_PROMPT\n"
+            self.code += f"\n#define MUSE_GATE_M {self.block_shape[0]}\n" + header.read_text()
+            if not prompt:
+                pair = header.with_name("grouped_decode_mma_pair.cuh")
+                self.code += "\n#define MUSE_OVERLAP_CONTEXT MuseGateCtx\n" + pair.read_text()
+            if self.live_reduction:
+                from sglang.srt.layers.muse_spark.live_decode_reduce import bind_live_decode_reduce
+
+                bind_live_decode_reduce(self)
+            if self.residual_tiles:
+                from sglang.srt.layers.muse_spark.residual_prompt_mma import adapt_residual_tiles
+
+                adapt_residual_tiles(self, paired=False)
+            KernelRuntime.prepare(self)
+
+    class GroupedResidualPromptGateUpKernel(GroupedDecodeGateUpKernel):
+        residual_tiles = True
+
+    class GroupedDecodeFullPairGateUpKernel(GroupedDecodeGateUpKernel):
+        both_pairs = True
+
+    class LiveDecodeGateUpKernel(GroupedDecodeFullPairGateUpKernel):
+        live_reduction = True
+
+    config = json.loads(meta) | json.loads(compute) | json.loads(tuning)
+    config.pop("sublayer_name", None)
+    required = {
+        "gemm_type": "grouped_contiguous", "mma_type": "wgmma", "use_f16_accum": False,
+        "a_dtype": "bfloat16", "b_dtype": "float4e2m1", "c_dtype": "bfloat16", "bs_dtype": "float8e4m3",
+        "weight_scale_group_size": 16, "weight_scale_type": "group", "weight_scale_2_type": "none",
+    }
+    # Humming shares initialized instances by class name, context and tuner arguments.
+    # Reject the other ABI before constructing a possibly cached instance.
+    expected_block = (256, 64 if prompt else 128)
+    if (tuple(config.get("block_shape", ()))[1:] != expected_block
+            or config.pop("num_sms", 0) or any(config.get(k) != v for k, v in required.items())
+            or any(config.get(k) for k in ("has_bias", "has_zero_point", "use_packed_k_layout",
+                                           "use_fused_e8m0_scale", "input_scale_group_size",
+                                           "weight_scale_group_size_n", "pad_shape_n", "pad_shape_k"))):
+        return None
+    if prompt and config["block_shape"][0] == 176:
+        variants = (GroupedResidualPromptGateUpKernel, GroupedDecodeGateUpKernel)
+    elif prompt:
+        variants = (GroupedDecodeGateUpKernel,)
+    else:
+        variants = (LiveDecodeGateUpKernel, GroupedDecodeFullPairGateUpKernel, GroupedDecodeGateUpKernel)
+    for variant in variants:
+        try:
+            kernel = variant(**config)
+            kernel.check_context()
+            handle, shared = int(kernel.func), kernel.estimated_smem_size
+            if _launcher().configure(handle, shared):
+                return kernel, handle, shared, int(kernel.block_shape[0])
+        except (AssertionError, ValueError, TypeError, ImportError, RuntimeError, OSError, subprocess.SubprocessError) as exc:
+            logging.getLogger(__name__).warning("Grouped gate/up projection %s unavailable: %s", variant.__name__, exc)
+    return None
+
+
+def prepare_gate_up(layer, meta, compute, tunings, *, prompt=False):
+    from humming.kernel.humming import HummingKernel
+
+    try:
+        if version("humming-kernels") != "0.1.12":
+            return None
+    except PackageNotFoundError:
+        return None
+    bank, scales = layer.w13_weight, layer.w13_weight_scale
+    experts, hidden, intermediate = layer.num_local_experts, layer.hidden_size, layer.intermediate_size_per_partition
+    if (hidden % 128 or intermediate % 128 or hidden > intermediate
+            or bank.shape != (experts, hidden // 16, 4 * intermediate) or bank.dtype != torch.int32
+            or scales.shape != (experts, hidden // 16, 2 * intermediate) or scales.dtype != torch.float8_e4m3fn
+            or layer.w13_global_scale.shape != (experts,) or layer.w13_global_scale.dtype != torch.bfloat16
+            or not all(t.is_contiguous() for t in (bank, scales, layer.w13_global_scale))
+            or any(bank.device != t.device for t in (scales, layer.w13_global_scale))):
+        return None
+    config = json.loads(meta)
+    if (config.get("mma_type") != "wgmma" or config.get("use_packed_k_layout")
+            or config.get("weight_scale_group_size") != 16):
+        return None
+    widths = {t for _, t in tunings}
+    try:
+        launcher = _launcher()
+        if launcher is None:
+            return None
+        maps = torch.empty(256, dtype=torch.uint8, device="cpu")
+        prepare_maps = launcher.prepare_prompt if prompt else launcher.prepare
+        if not prepare_maps(bank, scales.view(torch.uint8), maps):
+            return None
+        ctx = HummingKernel.current_context()
+        kernels = {t: _compile(ctx, meta, compute, t, prompt) for t in sorted(widths)}
+    except (RuntimeError, OSError, subprocess.SubprocessError) as exc:
+        logging.getLogger(__name__).warning("Using ordinary grouped decode: %s", exc)
+        return None
+    if not any(kernels.values()):
+        return None
+    sms = torch.cuda.get_device_properties(bank.device).multi_processor_count
+    bindings = tuple((t.data_ptr(), t.shape) for t in (bank, scales))
+    return launcher, maps, bindings, kernels, sms
+
+
+def run_gate_up(layer, inputs, keys, offsets, tuning, *, prompt=False):
+    """Return compact BF16 activations, or decline before issuing the projection."""
+    state = getattr(layer, "humming_prompt_gate_up" if prompt else "humming_decode_gate_up", None)
+    if not state:
+        return None
+    launcher, maps, addresses, kernels, sms = state
+    kernel = kernels.get(tuning)
+    if kernel is None or addresses != tuple(
+        (t.data_ptr(), t.shape) for t in (layer.w13_weight, layer.w13_weight_scale)
+    ):
+        return None
+    _, handle, shared, width = kernel
+    active = inputs.new_empty((inputs.shape[0], layer.intermediate_size_per_partition))
+    launch = launcher.run_prompt if prompt else launcher.run
+    if prompt:
+        keys = keys.int()
+    if launch(inputs, active, keys, offsets, layer.w13_global_scale, maps, handle, shared, width, sms):
+        return active
+    return None
diff --git a/python/sglang/srt/layers/muse_spark/decode_mma_pair.py b/python/sglang/srt/layers/muse_spark/decode_mma_pair.py
new file mode 100644
index 0000000..e24a06b
--- /dev/null
+++ b/python/sglang/srt/layers/muse_spark/decode_mma_pair.py
@@ -0,0 +1,145 @@
+"""Group two ordered BF16 WGMMA slices inside the pinned Hopper grouped decode pipeline."""
+
+import hashlib
+import json
+import logging
+import subprocess
+from functools import lru_cache
+from importlib.metadata import PackageNotFoundError, version
+from pathlib import Path
+
+import torch
+
+
+def enable_full_pair(kernel):
+    import humming
+
+    width = kernel.block_shape[0]
+    if (width not in (8, 16, 24) or not (kernel.use_tma_a and kernel.use_tma_b and kernel.use_tma_bs)
+            or not kernel.use_mbarrier or kernel.multi_cast_size_a != 1 or kernel.multi_cast_size_b != 1):
+        raise ValueError("unsupported grouped decode stage protocol")
+    path = Path(humming.__path__[0]) / "include/humming/kernel/humming_ws.cuh"
+    loop = path.read_text()
+    if hashlib.sha256(loop.encode()).hexdigest() != "6a148cc29b81d4009066667c347d9091a8a138009f7884226e9969a6936e2899":
+        raise ValueError("unsupported grouped Humming loop")
+    # Every math worker releases its shared A tile after the last pair drains.
+    # The next-stage wait is safe while this tile is held: the four-stage
+    # producer primes three stages and refills two stages ahead of this wait.
+    loop = loop.replace("              consumer.arrive(stage_id);\n", "")
+    loop = loop.replace("            mma.transform_b(\n",
+                        "            if (warp_iter_id + 1 == Ctx::kWarpIters) consumer.arrive(stage_id);\n"
+                        "            mma.transform_b(\n")
+    prefetch = "s2r_pipe.load_stage_iter(stage_id, warp_iter_id + 1);"
+    loop = loop.replace(prefetch, "if (warp_iter_id + 1 < Ctx::kWarpIters || slice_iters > 1) " + prefetch)
+    include = "#include <humming/kernel/humming_ws.cuh>"
+    if kernel.code.count(include) != 1:
+        raise ValueError("unsupported grouped Humming source include")
+    kernel.code = kernel.code.replace(include, loop.replace("#pragma once", "", 1))
+    kernel.code += "\n#define MUSE_PAIR_LAST_K_SLICES\n"
+
+
+def append_pair(kernel, both_pairs=False):
+    from sglang.kernels import jit
+
+    width = kernel.block_shape[0]
+    if (kernel.sm_version != 90 or tuple(kernel.block_shape[1:]) != (128, 256)
+            or tuple(kernel.warp_shape) != (width, 32, 64) or kernel.num_stages != 4
+            or kernel.num_threads != 640 or kernel.num_math_threads != 512
+            or not kernel.use_warp_spec or kernel.use_stream_k or kernel.use_tma_c):
+        raise ValueError("unsupported grouped matrix pipeline")
+    header = Path(jit.__file__).parent / "csrc/muse_spark/grouped_decode_mma_pair.cuh"
+    if both_pairs:
+        enable_full_pair(kernel)
+    kernel.code += f"\n#define MUSE_OVERLAP_M {width}\n" + header.read_text()
+
+
+def check_pair_code(compiler, kernel, both_pairs=False):
+    tool = compiler._get_env()["binaries"].get("cuobjdump")
+    if not tool:
+        raise RuntimeError("CUDA disassembler unavailable for grouped matrix pipeline")
+    code = subprocess.check_output([tool, "-sass", kernel.kernel_filename], text=True)
+    opcode = f"HGMMA.64x{kernel.block_shape[0]}x16.F32.BF16"
+    drains = 8 if both_pairs else 12
+    valid = code.count(opcode) == 32 and code.count("WARPGROUP.DEPBAR.LE") == drains
+    if getattr(kernel, "live_reduction", False):
+        from sglang.srt.layers.muse_spark.live_decode_reduce import has_live_decode_isa
+
+        valid = has_live_decode_isa(code, kernel.block_shape[0])
+    if not valid or "UTMALDG.3D" not in code:
+        raise RuntimeError("grouped matrix pipeline compiled with unsupported instruction schedule")
+
+
+@lru_cache(maxsize=128)
+def _prepare_down(context, meta, compute, tuning):
+    from humming.jit.compiler import NVCCCompiler
+    from humming.jit.runtime import KernelRuntime
+    from humming.kernel.humming import HummingKernel
+
+    class GroupedDecodePairDownKernel(HummingKernel):
+        live_reduction = False
+        both_pairs = False
+
+        @staticmethod
+        def _get_compiler():
+            return NVCCCompiler
+
+        def prepare(self):
+            append_pair(self, self.both_pairs)
+            if self.live_reduction:
+                from sglang.srt.layers.muse_spark.live_decode_reduce import bind_live_decode_reduce
+
+                bind_live_decode_reduce(self)
+            KernelRuntime.prepare(self)
+
+        def load_cubin(self):
+            if not self.cubin_loaded:
+                check_pair_code(NVCCCompiler, self, self.both_pairs)
+                HummingKernel.load_cubin(self)
+
+    class GroupedDecodeFullPairDownKernel(GroupedDecodePairDownKernel):
+        both_pairs = True
+
+    class LiveDecodeDownKernel(GroupedDecodeFullPairDownKernel):
+        live_reduction = True
+
+    config = json.loads(meta) | json.loads(compute) | json.loads(tuning)
+    config.pop("sublayer_name", None)
+    required = {
+        "gemm_type": "grouped_contiguous", "mma_type": "wgmma", "use_f16_accum": False,
+        "a_dtype": "bfloat16", "b_dtype": "float4e2m1", "c_dtype": "bfloat16", "bs_dtype": "float8e4m3",
+        "weight_scale_group_size": 16, "weight_scale_type": "group", "weight_scale_2_type": "none",
+    }
+    if (config.pop("num_sms", 0) or any(config.get(k) != v for k, v in required.items())
+            or any(config.get(k) for k in ("has_bias", "has_zero_point", "use_packed_k_layout",
+                                           "use_fused_e8m0_scale", "input_scale_group_size",
+                                           "weight_scale_group_size_n", "pad_shape_n", "pad_shape_k"))):
+        return None
+    for variant in (LiveDecodeDownKernel, GroupedDecodeFullPairDownKernel, GroupedDecodePairDownKernel):
+        try:
+            kernel = variant(**config)
+            kernel.check_context()
+            return torch.tensor([0, 1 << 30, kernel.kernel_id, 0], dtype=torch.int64, device="cpu")
+        except (AssertionError, ValueError, TypeError, ImportError, RuntimeError, OSError, subprocess.SubprocessError) as exc:
+            logging.getLogger(__name__).warning("Grouped down projection %s unavailable: %s", variant.__name__, exc)
+    return None
+
+
+def prepare_down(meta, compute, tunings):
+    from humming.kernel.humming import HummingKernel
+
+    try:
+        if version("humming-kernels") != "0.1.12":
+            return {}
+        context = HummingKernel.current_context()
+        return {tuning: _prepare_down(context, meta, compute, tuning) for _, tuning in tunings}
+    except (PackageNotFoundError, AssertionError, RuntimeError, OSError) as exc:
+        logging.getLogger(__name__).warning("Using ordinary grouped decode down projection: %s", exc)
+        return {}
+
+
+def run_down(config, layer, inputs, outputs, offsets):
+    from humming import ops
+
+    ops.launch_kernel(configs=config, inputs=inputs, outputs=outputs, expert_layout=offsets,
+                      weight=layer.w2_weight, weight_scale=layer.w2_weight_scale,
+                      locks=getattr(layer, "locks", None))
diff --git a/python/sglang/srt/layers/muse_spark/live_decode_reduce.py b/python/sglang/srt/layers/muse_spark/live_decode_reduce.py
new file mode 100644
index 0000000..61b45bd
--- /dev/null
+++ b/python/sglang/srt/layers/muse_spark/live_decode_reduce.py
@@ -0,0 +1,33 @@
+"""Bind the live-row K-partial reduction only to the version-pinned paired decode loop."""
+import hashlib
+from pathlib import Path
+
+
+def bind_live_decode_reduce(kernel):
+    import humming
+    from sglang.kernels import jit
+
+    include = Path(humming.__path__[0]) / "include/humming/epilogue/pipeline.cuh"
+    if hashlib.sha256(include.read_bytes()).hexdigest() != "730493c5a7a92176bf3a5d47d54596a663d734018ac02c2b26ebb2da3e292ed3":
+        raise ValueError("unsupported grouped expert epilogue")
+    if kernel.reduce_overlap_last_stage_only or kernel.multi_cast_size_a != 1 or kernel.multi_cast_size_b != 1:
+        raise ValueError("grouped decode staging is shared with another producer")
+    marker = "#include <humming/epilogue/pipeline.cuh>"
+    alias = "using Epilogue = EpiloguePipeline<Ctx, MMA, EpilogueArithmetic>;"
+    if kernel.code.count(marker) != 1 or kernel.code.count(alias) != 1:
+        raise ValueError("unsupported grouped decode source")
+    header = Path(jit.__file__).parent / "csrc/muse_spark/live_decode_reduce.cuh"
+    kernel.code = kernel.code.replace(marker, marker + "\n" + header.read_text()).replace(
+        alias, "using Epilogue = MuseLiveDecodeEpilogue<Ctx, MMA, EpilogueArithmetic>;"
+    )
+
+    if kernel.block_shape[0] > 8:
+        from sglang.srt.layers.muse_spark.residual_prompt_mma import adapt_residual_tiles
+
+        adapt_residual_tiles(kernel, paired=True, decode_width=kernel.block_shape[0])
+
+
+def has_live_decode_isa(assembly, width):
+    widths = range(8, width + 1, 8)
+    return (all(assembly.count(f"HGMMA.64x{w}x16.F32.BF16") == 32 for w in widths)
+            and assembly.count("WARPGROUP.DEPBAR.LE") == 8 * len(widths))
