+        and (runner.capture_forward_mode.is_decode() or runner.capture_forward_mode.is_target_verify())
+        and not runner.enable_pdmux and not runner.enable_two_batch_overlap and not runner.ragged_verify_mode
+        and not runner.enable_torch_compile and not runner.model_runner.is_draft_worker
+        and runner.model_runner.lora_manager is None
+        and not runner.model_runner.capture_head_hooks and not runner.model_runner.capture_tail_hooks
+        and parallel.tp_size == parallel.moe_ep_size == parallel.attn_tp_size == group.world_size
+        and parallel.moe_tp_size == parallel.attn_cp_size == parallel.attn_dcp_size == 1
