diff --git a/python/sglang/srt/layers/muse_spark/peer_prompt_pack.py b/python/sglang/srt/layers/muse_spark/peer_prompt_pack.py
new file mode 100644
index 0000000..fddd6d6
--- /dev/null
+++ b/python/sglang/srt/layers/muse_spark/peer_prompt_pack.py
@@ -0,0 +1,189 @@
+"""Model-owned NVLink input buffer shared by successive sparse prompt layers."""
+
+import logging
+import threading
+
+import torch
+import torch.distributed as dist
+from torch import nn
+from triton.errors import TritonError
+
+from sglang.kernels.ops.moe.muse_spark_peer_pack import pack_peer_rows
+
+from sglang.srt.layers import layernorm_sp
+from sglang.srt.model_executor.runner_backend_utils.breakable_cuda_graph import eager_on_graph
+
+logger = logging.getLogger(__name__)
+
+
+class PeerPromptInputs:
+    def __init__(self, storage, handle, group, banks=1):
+        self.storage = storage[:storage.shape[0] // banks]
+        self.handle = handle
+        self.group = group
+        # Keep the remote views and rendezvous handle alive for the model's lifetime.
+        self.peers = [handle.get_buffer(i, list(storage.shape), storage.dtype) for i in range(group.world_size)]
+        if storage.storage_offset() != 0 or self.peers[group.rank_in_group].data_ptr() != storage.data_ptr():
+            raise ValueError("Sparse prompt publication requires its own symmetric allocation")
+        rows = self.storage.shape[0]
+        self.banks = [
+            (storage.narrow(0, i * rows, rows), torch.tensor(
+                [p.narrow(0, i * rows, rows).data_ptr() for p in self.peers], device=storage.device, dtype=torch.int64
+            ))
+            for i in range(banks)
+        ]
+        self.next_bank = 0
+        self.stream = torch.cuda.Stream(device=storage.device)
+        self.lock = threading.Lock()
+
+    def supports(self, shard, group):
+        return (
+            group is self.group and shard.device == self.storage.device and shard.dtype == self.storage.dtype
+            and 0 < shard.shape[0] <= self.storage.shape[0] and shard.shape[1] == self.storage.shape[1]
+        )
+
+    def pack(self, shard, row_map, result):
+        # Even an empty local bank publishes its shard for the other ranks.
+        caller = torch.cuda.current_stream(shard.device)
+        with self.lock:
+            self.stream.wait_stream(caller)
+            with torch.cuda.stream(self.stream):
+                storage, addresses = self.banks[self.next_bank]
+                storage[:shard.shape[0]].copy_(shard)
+                self.handle.barrier(channel=0)
+                if result is not None:
+                    pack_peer_rows(addresses, row_map, result, shard.shape[0])
+                    result.record_stream(self.stream)
+                    row_map.record_stream(self.stream)
+                if len(self.banks) == 1:
+                    self.handle.barrier(channel=0)
+                else:
+                    # Each rank reaches the next publication after all its prior reads.
+                    # That barrier retires this bank before the following call reuses it.
+                    self.next_bank ^= 1
+                shard.record_stream(self.stream)
+            caller.wait_stream(self.stream)
+
+
+def peer_storage_rows(hidden, world, chunk_rows, capture_rows, graph_max, scheduler_max):
+    # A runner can add a backed graph key after model construction. Reserve for
+    # the shared configured limit, even if that key is absent from the base grid.
+    backed = min(graph_max, scheduler_max) if all(
+        isinstance(limit, int) and limit > 0 for limit in (graph_max, scheduler_max)
+    ) else 0
+    extent = max(chunk_rows, max(capture_rows or (), default=0), backed)
+    return min((extent + world - 1) // world, (17 * 1024 * 1024) // (2 * hidden))
+
+
+def prepare_peer_prompt_inputs(group, hidden, topk, chunk_rows, capture_rows, graph_max, scheduler_max):
+    from sglang.srt.distributed.device_communicators.custom_all_reduce_v2 import CustomAllReduceV2
+
+    if group.world_size < 2 or dist.get_backend(group.cpu_group) != "gloo":
+        return None
+
+    def agree(value):
+        values = [None] * group.world_size
+        dist.all_gather_object(values, value, group=group.cpu_group)
+        return values
+
+    comm = group.ca_comm
+    rows = 0
+    if (
+        isinstance(comm, CustomAllReduceV2) and not comm.disabled and comm.has_multicast and comm.pull_enabled
+        and comm._is_graph_mode_supported and comm.rank == group.rank_in_group and comm.world_size == group.world_size
+        and torch.cuda.get_device_capability(comm.device)[0] == 9 and hidden > 0
+        and isinstance(chunk_rows, int) and chunk_rows > 0 and 0 < topk <= 16
+    ):
+        rows = peer_storage_rows(hidden, group.world_size, chunk_rows, capture_rows, graph_max, scheduler_max)
+    proposals = agree((hidden, topk, rows))
+    rows = min(capacity for _, _, capacity in proposals)
+    if rows <= 0 or any((width, routes) != (hidden, topk) for width, routes, _ in proposals):
+        return None
+    # A local allocation failure must be visible to all ranks before entering rendezvous.
+    def setup(banks):
+        storage = None
+        try:
+            from torch._C._distributed_c10d import _SymmetricMemory
+
+            with torch.inference_mode(False), torch.no_grad():
+                storage = _SymmetricMemory.empty_strided_p2p(
+                    (banks * rows, hidden), (hidden, 1), torch.bfloat16, comm.device, group.device_group.group_name
+                )
+        except (AttributeError, ImportError, OSError, RuntimeError, TypeError) as exc:
+            logger.warning("Sparse prompt peer allocation unavailable: %s", exc)
+        if not all(agree(storage is not None)):
+            return None
+        workspace = None
+        try:
+            handle = _SymmetricMemory.rendezvous(storage)
+            if handle is not None and handle.rank == group.rank_in_group and handle.world_size == group.world_size:
+                workspace = PeerPromptInputs(storage, handle, group, banks)
+                # Compile before accepting collective work. Read only this rank's own row.
+                probe_shard_rows = 2
+                row_map = torch.full((handle.rank * probe_shard_rows + 1, topk), -1,
+                                     dtype=torch.int32, device=comm.device)
+                row_map[-1, 0] = 0
+                output = torch.empty_like(storage[:1])
+                for bank, addresses in workspace.banks:
+                    bank[:1].zero_()
+                    pack_peer_rows(addresses, row_map, output, probe_shard_rows)
+                torch.cuda.current_stream(comm.device).synchronize()
+        except (AttributeError, ImportError, OSError, RuntimeError, TypeError, ValueError, TritonError) as exc:
+            logger.warning("Sparse prompt peer reads unavailable: %s", exc)
+            workspace = None
+        return workspace if all(agree(workspace is not None)) else None
+
+    return setup(2) or setup(1)
+
+
+
+def _local_grouped_eligible(experts, shard):
+    from sglang.srt.layers.muse_spark.muse_spark_fp4_moe import MuseSpark1xFp4Experts
+
+    return (
+        type(experts) is MuseSpark1xFp4Experts
+        and experts.use_w4a16 and experts.use_humming
+        and experts._post_expert_norm_weight is not None
+        and experts._post_expert_norm is experts.post_expert_norm
+        and 0 < shard.shape[1] <= experts.intermediate_size_per_partition
+        and shard.dtype == torch.bfloat16 and shard.is_cuda and not torch.is_grad_enabled()
+        and torch.cuda.get_device_capability(shard.device)[0] == 9
+        and "forward" not in vars(experts)
+        and getattr(experts, "_compiled_call_impl", None) is None
+        and not (experts._forward_hooks or experts._forward_pre_hooks)
+        and not (nn.modules.module._global_forward_hooks or nn.modules.module._global_forward_pre_hooks)
+    )
+
+
+
+def _peer_experts_into(workspace, experts, shard, scores, ids, group, output):
+    from sglang.srt.layers.muse_spark.muse_spark_humming_moe import (
+        local_humming_expert_ids, prompt_route_order,
+    )
+
+    eligible = workspace.supports(shard, group) and _local_grouped_eligible(experts, shard)
+    # Use the parent's scalar synchronization for both the live count and the
+    # collective decision. A rank with a newly installed hook vetoes all peers.
+    vote = torch.full((1,), int(eligible), dtype=torch.int32, device=shard.device)
+    votes = vote.new_empty(group.world_size)
+    group.all_gather_into_tensor(votes, vote)
+    if eligible:
+        local_ids = local_humming_expert_ids(experts, ids)
+        sorted_experts, slots, offsets = prompt_route_order(local_ids, experts.num_local_experts)
+        first_local = offsets[:1]
+    else:
+        first_local = vote
+    decision = torch.cat((votes, first_local)).tolist()
+    if all(decision[:-1]):
+        plan = workspace, sorted_experts, slots, offsets, decision[-1]
+        experts._grouped_humming_and_combine_impl(shard, local_ids, scores, output, peer_plan=plan)
+    else:
+        inputs = layernorm_sp.sp_exit_gather(shard, ids.shape[0])
+        output.copy_(experts(inputs, scores, ids, experts.post_expert_norm))
+
+
+def _capture_stub(workspace, experts, shard, scores, ids, group, output):
+    output.zero_()
+
+
+peer_experts_into = eager_on_graph(True, capture_stub=_capture_stub)(_peer_experts_into)
diff --git a/python/sglang/srt/layers/muse_spark/prompt_weight_pipeline.py b/python/sglang/srt/layers/muse_spark/prompt_weight_pipeline.py
new file mode 100644
index 0000000..fc5a4a6
--- /dev/null
+++ b/python/sglang/srt/layers/muse_spark/prompt_weight_pipeline.py
@@ -0,0 +1,148 @@
+"""Decode packed Hopper W2 weight fragments on Humming's loader warps."""
+import hashlib
+import json
+import logging
+import subprocess
+from functools import lru_cache
+from importlib.metadata import PackageNotFoundError, version
+from pathlib import Path
+
+import torch
+
+
+def adapt_prompt_weights(kernel):
+    import humming
+    from sglang.kernels import jit
+
+    source = Path(humming.__path__[0]) / "include/humming/kernel/humming_ws.cuh"
+    src = source.read_text()
+    if hashlib.sha256(src.encode()).hexdigest() != "6a148cc29b81d4009066667c347d9091a8a138009f7884226e9969a6936e2899":
+        raise ValueError("unsupported grouped Humming loop")
+    header = Path(jit.__file__).parent / "csrc/muse_spark/prompt_weight_pipeline.cuh"
+    pipeline = source.parents[1] / "memory/g2s_pipeline.cuh"
+    transfers = pipeline.read_text()
+    if hashlib.sha256(transfers.encode()).hexdigest() != "479ff827ecf40b82d4685b3a104d796ef41bb643a1d9cc398feabcc77ccbd43b":
+        raise ValueError("unsupported grouped Humming transfer pipeline")
+    transfers = transfers.replace("#pragma once", "", 1)
+    transfer = "loader_bs.template load<kShouldAdvance>(smem.stages[stage_id].bs, mbar_ptr);"
+    transfers = transfers.replace(transfer, "muse_load_scales<kShouldAdvance>(ctx, loader_bs, stage_id);")
+    marker = "#include <humming/memory/g2s_pipeline.cuh>"
+    for name, replacement in (("Mma", "MusePromptMma"), ("S2RMemoryPipeline", "MusePromptReader")):
+        src = src.replace("= " + name + "<Ctx", "= " + replacement + "<Ctx")
+    # The loader now converts contiguous E4M3 words while the two TMA transfers run.
+    src = src.replace("? 40 : 24;", "? 32 : 32;")
+    src = src.replace("extern __shared__ int4 shared_memory[];", "extern __shared__ __align__(128) int4 shared_memory[];")
+    prefetch = "s2r_pipe.load_stage_iter(stage_id, warp_iter_id + 1);"
+    if src.count(prefetch) != 1:
+        raise ValueError("unsupported grouped Humming prefetch")
+    # The second pair still addresses the current shared A tile. Publish reuse
+    # only after its final K16 operation drains, and keep the next-stage wait
+    # before that next stage supplies the following iteration's first fragment.
+    src = src.replace("              consumer.arrive(stage_id);\n", "")
+    src = src.replace("            mma.transform_b(\n",
+                      "            if (warp_iter_id + 1 == Ctx::kWarpIters) consumer.arrive(stage_id);\n"
+                      "            mma.transform_b(\n")
+    src = src.replace(prefetch, "if (warp_iter_id + 1 < Ctx::kWarpIters || slice_iters > 1) " + prefetch)
+    common = "#include <humming/mma/all.cuh>\n#include <humming/memory/s2r_pipeline.cuh>\n"
+    src = src.replace(marker, common + header.read_text() + "\n" + transfers)
+    src = src.replace("#pragma once", "", 1)
+    kernel.code = kernel.code.replace("#include <humming/kernel/humming_ws.cuh>", src)
+    kernel.code = kernel.code.replace("SMEM_SIZE = sizeof(SharedStorageType);",
+        "SMEM_SIZE = ((sizeof(SharedStorageType) + 127) / 128 * 128) + 2048 * TuningConfig::kNumStages;")
+
+
+@lru_cache(maxsize=64)
+def _prepare(context, meta, compute, tuning):
+    from humming.jit.compiler import NVCCCompiler
+    from humming.jit.runtime import KernelRuntime
+    from humming.kernel.humming import HummingKernel
+
+    class PromptWeightPipeline(HummingKernel):
+        residual_tiles = False
+
+        @staticmethod
+        def _get_compiler():
+            return NVCCCompiler
+
+        def prepare(self):
+            adapt_prompt_weights(self)
+            if self.residual_tiles:
+                from sglang.srt.layers.muse_spark.residual_prompt_mma import adapt_residual_tiles
+
+                adapt_residual_tiles(self, paired=True)
+            KernelRuntime.prepare(self)
+
+        def load_cubin(self):
+            if not self.cubin_loaded:
+                tool = NVCCCompiler._get_env()["binaries"].get("cuobjdump")
+                if not tool:
+                    raise RuntimeError("CUDA disassembler unavailable")
+                isa = subprocess.check_output([tool, "-sass", self.kernel_filename], text=True)
+                valid = isa.count("HGMMA.64x176x16.F32.BF16") == 32 and isa.count("WARPGROUP.DEPBAR.LE") == 8
+                if self.residual_tiles:
+                    from sglang.srt.layers.muse_spark.residual_prompt_mma import has_residual_isa
+
+                    valid = has_residual_isa(isa, 8)
+                if not valid or "UTMALDG.2D" not in isa or "UTMALDG.3D" not in isa:
+                    raise RuntimeError("grouped prompt Hopper instructions unavailable")
+                HummingKernel.load_cubin(self)
+
+    class ResidualPromptWeightPipeline(PromptWeightPipeline):
+        residual_tiles = True
+
+    cfg = json.loads(meta) | json.loads(compute) | json.loads(tuning)
+    cfg.pop("sublayer_name", None)
+    required = {"gemm_type": "grouped_contiguous", "mma_type": "wgmma", "use_f16_accum": False,
+                "a_dtype": "bfloat16", "b_dtype": "float4e2m1", "c_dtype": "bfloat16", "bs_dtype": "float8e4m3",
+                "weight_scale_group_size": 16, "weight_scale_type": "group", "weight_scale_2_type": "none",
+                "block_shape": [176, 256, 64], "warp_shape": [176, 32, 64],
+                "num_stages": 4, "use_warp_spec": True, "use_tma": True, "use_mbarrier": True,
+                "use_tma_c": False, "use_stream_k": False}
+    if (cfg.pop("num_sms", 0) or any(cfg.get(k) != v for k, v in required.items())
+            or any(cfg.get(k) for k in ("has_bias", "has_zero_point", "use_packed_k_layout",
+                                        "use_fused_e8m0_scale", "input_scale_group_size",
+                                        "weight_scale_group_size_n", "pad_shape_n", "pad_shape_k"))
+            or any(cfg.get(k, 1) != 1 for k in ("multi_cast_size_a", "multi_cast_size_b"))):
+        return None
+    cfg.update(use_tma_bs=False, use_cp_async=False)
+    for variant in (ResidualPromptWeightPipeline, PromptWeightPipeline):
+        try:
+            kernel = variant(**cfg)
+            kernel.check_context()
+            return torch.tensor([0, 1 << 30, kernel.kernel_id, 0], dtype=torch.int64, device="cpu")
+        except (AssertionError, ValueError, TypeError, ImportError, RuntimeError, OSError, subprocess.SubprocessError) as exc:
+            logging.getLogger(__name__).warning("Grouped prompt down projection %s unavailable: %s", variant.__name__, exc)
+    return None
+
+
+def _binding(tensor):
+    return tensor.device, tensor.dtype, tensor.shape, tensor.stride(), tensor.data_ptr()
+
+
+def prepare_prompt_down(layer, meta, compute, tuning):
+    from humming.kernel.humming import HummingKernel
+
+    try:
