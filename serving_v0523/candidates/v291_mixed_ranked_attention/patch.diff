+               for f in (prompt, verify, mixed))
+    ):
+        return None
+
+    for view in (prompt, mixed):
+        mirror = view.req_pool_indices_cpu
+        if (not isinstance(mirror, torch.Tensor) or mirror.device.type != "cpu"
+                or mirror.dtype not in (torch.int32, torch.int64) or mirror.shape != (view.batch_size,)):
+            return None
+        # _batch_max_context_len otherwise falls back to a device scalar read.
+        if prefill.max_context_size is not None or prefill.max_seq_len is not None:
+            lengths_cpu = view.seq_lens_cpu
+            if not isinstance(lengths_cpu, torch.Tensor) or lengths_cpu.device.type != "cpu":
+                return None
