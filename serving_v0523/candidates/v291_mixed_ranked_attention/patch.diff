+def mixed_prefill_ceiling(chunk_rows, max_prefill_rows, graph_rows):
+    """Physical row limit for a prompt and an already reserved verify cohort."""
+    if not chunk_rows or chunk_rows <= 0:
+        return 0
+    return max(chunk_rows, min(max_prefill_rows or 0, graph_rows or 0))
+
+
+def mixed_prefill_graph_fits(prompt_rows, verify_rows, mixed_rows, live_rows, chunk_rows, buffer_rows):
+    """Bound extra padding of a combined graph with an intact prompt."""
+    separate_rows = prompt_rows + verify_rows
+    if chunk_rows and chunk_rows > 0 and live_rows > chunk_rows:
+        if mixed_rows > buffer_rows:
+            return False
+        # Overflow graphs double in size *above* the chunk. Their extra work
+        # may cost at most one verification body, independent of prompt length.
+        separate_rows += verify_rows
+    return mixed_rows <= separate_rows
+
+
+def mixed_prefill_graph_sizes(chunk, ceiling, width, verify_batches):
+    """Geometrically spaced tail capacities, all backed by native verify shapes."""
+    eligible = sorted({n for n in verify_batches if n > 0 and chunk + n * width <= ceiling})
+    if not eligible:
+        return set()
+    selected = [eligible[0]]
+    for count in eligible[1:]:
+        if count >= 2 * selected[-1]:
+            selected.append(count)
+    return {chunk + width * n for n in (*selected, eligible[-1])}
