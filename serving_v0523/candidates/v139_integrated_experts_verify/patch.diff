+def humming_grouped_expert_outputs(
+    layer: MuseSpark1xFp4Experts,
+    hidden_states: torch.Tensor,
+    local_ids: torch.Tensor,
+    live_routes: int | None = None,
+) -> tuple[torch.Tensor, torch.Tensor]:
+    """Return mapped BF16 rows; known live counts defer the W2 scale to finalization."""
+    from humming.layer import HummingMethod
+
+    from sglang.kernels.ops.activation.activation import silu_and_mul
+
+    _, hidden_size = hidden_states.shape
+    topk = local_ids.shape[1]
+    route_experts, slots = local_ids.flatten().sort(stable=True)
+    experts = torch.arange(
+        layer.num_local_experts + 1, dtype=local_ids.dtype, device=local_ids.device
+    )
+    offsets = torch.searchsorted(route_experts, experts, out_int32=True)
+    first_local = (
+        offsets[0].item() if live_routes is None else slots.numel() - live_routes
+    )
+    num_routes = slots.numel() - first_local
+    if num_routes == 0:
+        return hidden_states.new_empty((0, hidden_size)), local_ids
+
+    intermediate = layer.intermediate_size_per_partition
+    stage_width = max(hidden_size, intermediate)
+    output_width = max(2 * intermediate, hidden_size)
+    if num_routes * (stage_width + output_width) > slots.numel() * (
+        intermediate + output_width
+    ):
+        return humming_expert_outputs(layer, hidden_states, local_ids)
+
+    slots = slots[first_local:]
+    route_experts = route_experts[first_local:]
+    if live_routes is None:
+        route_experts = route_experts.long()
+    offsets = offsets - first_local
+    staging = hidden_states.new_empty(num_routes * stage_width)
+    arena = hidden_states.new_empty(num_routes * output_width)
+    inputs = staging[: num_routes * hidden_size].view(num_routes, hidden_size)
+    gate_up = arena[: num_routes * 2 * intermediate].view(num_routes, 2 * intermediate)
+    activations = staging[: num_routes * intermediate].view(num_routes, intermediate)
+    outputs = arena[: num_routes * hidden_size].view(num_routes, hidden_size)
+    torch.index_select(
+        hidden_states, 0, torch.div(slots, topk, rounding_mode="floor"), out=inputs
+    )
+
+    for name, source, destination in (
+        ("w13", inputs, gate_up),
+        ("w2", activations, outputs),
+    ):
+        HummingMethod.forward_layer(
+            layer,
+            inputs=source,
+            outputs=destination,
+            expert_layout=offsets,
+            compute_config=_GROUPED_COMPUTE,
+            tuning_config=layer.humming_grouped_tunings[name],
+            sublayer_name=name,
+        )
+        if live_routes is not None:
+            if name == "w13":
+                layer.humming_prefill_silu.run(
+                    gate_up, activations, route_experts, layer.w13_global_scale
+                )
+            continue  # The finalizer applies the W2 scale before RMSNorm.
+        scales = getattr(layer, f"{name}_global_scale").index_select(0, route_experts)
+        destination.mul_(scales.unsqueeze(1))
+        if name == "w13":
+            silu_and_mul(gate_up, activations)
+
+    mapped_rows = torch.full_like(local_ids, -1)
+    mapped_rows.view(-1).index_copy_(
+        0,
+        slots,
+        torch.arange(num_routes, dtype=mapped_rows.dtype, device=mapped_rows.device),
+    )
+    return outputs, mapped_rows
+
+
+def _compact_prefill_windows(local_ids, local_experts, global_experts):
+    # Take one eager host snapshot, as in the grouped path's offsets[0].item().
+    # The bound admits any single tile; uneven rank loads need no device retries.
+    tokens, topk = local_ids.shape
+    tile_tokens = 128
+    slots_per_tile = tile_tokens * topk
+    slots = tokens * topk
+    expected = (slots * local_experts + global_experts - 1) // global_experts
+    capacity = expected + max(slots_per_tile, (expected + 7) // 8)
+    mask = local_ids.reshape(-1) >= 0
+    if slots % slots_per_tile:
+        mask = torch.nn.functional.pad(mask, (0, slots_per_tile - slots % slots_per_tile))
+    counts = mask.view(-1, slots_per_tile).sum(dim=1, dtype=torch.int32).tolist()
+    start, live = 0, 0
+    for tile, count in enumerate(counts):
+        if live + count > capacity:
+            yield start, tile * tile_tokens, live
+            start, live = tile * tile_tokens, 0
+        live += count
+    if tokens:
+        yield start, tokens, live
+
+
+def compact_prefill_and_combine(layer, hidden_states, local_ids, scores, output):
+    from sglang.kernels.ops.moe.muse_spark_post_expert_finalize_triton import (
+        fused_post_expert_norm_weighted_sum,
+    )
+
+    for begin, end, live in _compact_prefill_windows(
+        local_ids, layer.num_local_experts, layer.global_num_experts
+    ):
+        if live == 0:
+            output[begin:end].zero_()
+            continue
+        ids = local_ids[begin:end]
+        values, mapped = humming_grouped_expert_outputs(
+            layer, hidden_states[begin:end], ids, live
+        )
+        fused_post_expert_norm_weighted_sum(
+            values,
+            scores[begin:end],
+            norm_weight=layer._post_expert_norm_weight,
+            eps=layer._post_expert_norm_eps,
+            weight_first=layer._post_expert_norm_weight_first,
+            slot_expert_ids=ids,
+            slot_row_indices=mapped,
+            expert_output_scales=layer.w2_global_scale,
+            out=output[begin:end],
+        )
+        # Release the arena before sizing the next rank-local window.
+        del values, mapped
