+@torch.compile(dynamic=True, backend=get_compiler_backend(), disable=_is_npu)
+def _rank_major_grouped_conv(hidden, bank, base, block_size, groups, group_size, taps, side):
+    # A tap occupies one rank slice or a row of adjacent rank slices. Keep the
+    # rank axis explicit so these views address the NCCL output directly.
+    parts = max(1, bank.shape[0] // (2 * taps))
+    per_part = groups // parts
+    blocks = hidden.unflatten(-1, (parts, per_part, group_size))
+    position = torch.arange(hidden.shape[0], device=hidden.device) % block_size
+    for tap in range(taps):
+        start = (side * taps + tap) * groups
+        rank, offset = start // bank.shape[2], start % bank.shape[2]
+        delta = bank[rank : rank + parts, :, offset : offset + per_part].permute(1, 0, 2)
+        coeff = base[tap].view(1, parts, per_part, group_size) + delta.unsqueeze(-1)
+        if tap == 0:
+            out = coeff * blocks
+        else:
+            shifted = F.pad(blocks[:-tap], (0, 0, 0, 0, 0, 0, tap, 0))
+            shifted = torch.where((position >= tap).view(-1, 1, 1, 1), shifted, 0)
+            out = out + coeff * shifted
+    return out.flatten(1)
+
