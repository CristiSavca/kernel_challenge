+def try_decode_column_gather(group, x, weight):
+    """Project full K over disjoint output columns, then concatenate in TP rank order."""
+    from sglang.srt.layers.quantization.unquant import bf16_gemm_dispatch
+
+    rows, features = x.shape
+    # The saved weight reads trade K elements for M replicated output elements.
+    # Leave bandwidth margin for NVLink and the rank-major to row-major copy.
+    if rows == 0 or 16 * rows > features:
+        return None
+    columns = weight.shape[0] // group.world_size
+    local_weight = weight.narrow(0, group.rank_in_group * columns, columns)
+    local = bf16_gemm_dispatch(x, local_weight, None)
+    return group.all_gather(local.contiguous(), dim=-1)
