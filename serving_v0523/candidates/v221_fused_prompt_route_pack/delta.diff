+@triton.jit
+def _pack_prompt_routes(
+    Hidden, Slots, Inputs, RowMap,
+    first_local, num_routes, num_slots, hidden_row_stride, hidden_col_stride,
+    TOPK: tl.constexpr, HIDDEN: tl.constexpr, BLOCK_H: tl.constexpr, BLOCK_MAP: tl.constexpr,
+):
+    program = tl.program_id(0)
+    if program < num_routes:
+        slot = tl.load(Slots + first_local + program)
+        token = slot.to(tl.int64) // TOPK
+        row = program.to(tl.int64)
+        for start in range(0, HIDDEN, BLOCK_H):
+            cols = start + tl.arange(0, BLOCK_H)
+            values = tl.load(Hidden + token * hidden_row_stride + cols.to(tl.int64) * hidden_col_stride,
+                             mask=cols < HIDDEN, other=0)
+            tl.store(Inputs + row * HIDDEN + cols, values, mask=cols < HIDDEN)
+    else:
+        # Argsort is a permutation of all original slots. Each map entry has exactly one writer.
+        positions = (program - num_routes).to(tl.int64) * BLOCK_MAP + tl.arange(0, BLOCK_MAP)
+        valid = positions < num_slots
+        slots = tl.load(Slots + positions, mask=valid, other=0)
+        rows = tl.where(positions < first_local, -1, positions - first_local)
+        tl.store(RowMap + slots, rows, mask=valid)
+
