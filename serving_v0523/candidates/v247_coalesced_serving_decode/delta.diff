+def allocate_mixed_prompt_storage(backend, layout, tail, k, layer, batch_size):
+    """Let the physical writer and a single dense prompt share the same new FP8 rows."""
+    if tail is None or layout[1].shape[0] != 1:
+        return None
+    from sglang.kernels.ops.attention.paged_verify_attention import verify_partition_workspace
+
+    cut, _, tail_width, _, _ = tail
+    n, heads, dim = k.shape
+    prefix = layout[3] - cut
+    capacity = max(layout[2], prefix + n)
+    scratch = 0
+    if backend._hopper_verify_sms:
+        tile_m = 1 << (tail_width * layer.tp_q_head_num // heads - 1).bit_length()
+        _, scratch = verify_partition_workspace(batch_size - 1, heads, tile_m, dim, -1, backend._hopper_verify_sms)
+    if capacity * 2 * heads * dim + scratch > 32 * 1024 * 1024:
+        return None
+    return torch.empty((2, capacity, heads, dim), dtype=backend.kv_cache_dtype, device=k.device)
