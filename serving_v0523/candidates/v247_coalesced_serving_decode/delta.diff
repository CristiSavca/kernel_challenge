+def _gather_prompt_routes(group, scores, ids, eligible):
+    # Preserve both native dtypes, including every FP32 routing-score bit. Route
+    # shards always have the same padded row count as the sequence-parallel input.
+    score_bytes = scores.contiguous().view(torch.uint8).reshape(-1)
+    id_bytes = ids.contiguous().view(torch.uint8).reshape(-1)
+    flag = score_bytes.new_full((16,), int(eligible))
+    packet = torch.cat((score_bytes, id_bytes, flag))
+    received = packet.new_empty((group.world_size, packet.numel()))
+    group.all_gather_into_tensor(received.view(-1), packet)
+    offset = score_bytes.numel()
+    # FP32 scores and int32 IDs have equal byte widths. One transpose restores
+    # both contiguous token-major tensors before the expert kernels or hooks run.
+    if score_bytes.numel() == id_bytes.numel():
+        fields = received[:, :2 * offset].view(group.world_size, 2, offset).transpose(0, 1).contiguous()
+        full_scores = fields[0].view(scores.dtype).reshape(-1, scores.shape[1])
+        full_ids = fields[1].view(ids.dtype).reshape(-1, ids.shape[1])
+        return full_scores, full_ids, received[:, -1]
+
+    def unpack(source, like):
+        full = like.new_empty((group.world_size, *like.shape))
+        full.view(torch.uint8).view(group.world_size, -1).copy_(source)
+        return full.flatten(0, 1)
+
+    return (unpack(received[:, :offset], scores),
+            unpack(received[:, offset:offset + id_bytes.numel()], ids),
+            received[:, -1])
+
