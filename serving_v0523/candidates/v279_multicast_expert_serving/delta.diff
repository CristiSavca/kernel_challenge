+"""Protect the shared reduction buffer between persistent grouped multicast jobs."""
+import hashlib
+from pathlib import Path
+
+
+def fence_cluster_epilogue(header):
+    # Root waits for one ACK from each peer after that peer has fenced its
+    # final epilogue reads. The first job uses the same barrier protocol.
+    header = header.replace("kNumMathThreads * factor);",
+        "kNumMathThreads * factor + (cluster_rank == 0 && thread_id == kNumStages ? kMultiCastSize - 1 : 0));")
+    end = header.index("    phases[kNumStages] ^= 1;", header.index("void wait_math_epilogue()"))
+    header = header[:end] + """
+    if (ctx.cluster_rank() && ctx.load_thread_id() == 0) {
+      void *ready = __cluster_map_shared_rank(&ctx.smem.math_mbar[kNumStages], 0);
+      mbarrier_arrive<true>(ready);
+    }
+""" + header[end:]
+    return header
+
+
+def protect_cluster_epilogue(kernel):
+    import humming
+
+    source = Path(humming.__path__[0]) / "include/humming/memory/g2s_pipeline.cuh"
+    header = source.read_text()
+    if hashlib.sha256(header.encode()).hexdigest() != "479ff827ecf40b82d4685b3a104d796ef41bb643a1d9cc398feabcc77ccbd43b":
+        raise ValueError("unsupported Humming multicast pipeline")
+    header = fence_cluster_epilogue(header)
+    include = "#include <humming/memory/g2s_pipeline.cuh>"
+    if kernel.code.count(include) != 1:
+        raise ValueError("missing persistent multicast pipeline")
+    kernel.code = kernel.code.replace(include, header.replace("#pragma once", "", 1))
