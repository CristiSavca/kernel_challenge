+def prepare_batched_prompt_kv(backend, q, k, v, layer, batch, write):
+    """Check ordinary ragged EXTEND geometry before converting the writer's operands."""
+    metadata = backend.forward_metadata
+    count = batch.batch_size
+    if (
+        count < 2 or batch.forward_mode != ForwardMode.EXTEND or batch.dcp_kv_mask is not None
+        or metadata is backend.full_cg_prefill_metadata or metadata.image_token_ranges is not None
+        or metadata.swa_spec_metadata is not None or layer.is_cross_attention
+        or layer.attn_type in (AttentionType.ENCODER_ONLY, AttentionType.DECODER_BIDIRECTIONAL)
+        or getattr(batch, "mixed_verify_logits_indices", None) is not None
+        or torch.compiler.is_compiling() or not k.is_cuda or torch.cuda.is_current_stream_capturing()
+        or torch.are_deterministic_algorithms_enabled() or torch.is_grad_enabled()
+    ):
+        return None
+    n = k.shape[0]
+    if is_in_prefill_graph_scope():
+        if is_in_full_prefill_graph() or get_prefill_raw_num_tokens() != n:
+            return None
+    elif batch.req_pool_indices_cpu is None:
+        return None
+    pool = backend.token_to_kv_pool
+    table, slots, owner = metadata.page_table, write.loc, pool
+    if type(pool) is SWAKVPool:
+        _, sliding = pool.layers_mapping[layer.layer_id]
+        owner = pool.swa_kv_pool if sliding else pool.full_kv_pool
+        if sliding:
+            table, slots = metadata.swa_page_table, write.swa_loc
+    h, d = layer.tp_k_head_num, layer.head_dim
+    lengths, cuq = metadata.cache_seqlens_int32, metadata.cu_seqlens_q
+    if (
+        n < 4096 or q.shape[0] != n or q.numel() != n * layer.tp_q_head_num * d
+        or d != layer.v_head_dim or h != layer.tp_v_head_num or d > 256 or d % 16
+        or not 16 <= h * d <= 1024 or (h * d) & (h * d - 1)
+        or k.shape != (n, h, d) or v.shape != k.shape or q.dtype != torch.bfloat16
+        or k.dtype != q.dtype or v.dtype != q.dtype or slots is None or slots.shape != (n,)
+        or table is None or table.ndim != 2 or table.shape[0] != count or table.stride(1) != 1
+        or table.shape[1] < metadata.max_seq_len_k or table.dtype not in (torch.int32, torch.int64)
+        or lengths is None or lengths.shape != (count,) or cuq is None or cuq.shape != (count + 1,)
+        or any(t.device != k.device for t in (v, q, slots, table, lengths, cuq))
+        or any(t.dtype != torch.int32 or not t.is_contiguous() for t in (lengths, cuq))
+        or "set_kv_buffer" in vars(pool) or "set_kv_buffer" in vars(owner) or "_store_kv_layer" in vars(owner)
+    ):
+        return None
+    window = layer.sliding_window_size
+    left = -1 if window is None or window < 0 else window
+    layouts = getattr(metadata, "_batched_prompt_layouts", None)
+    if layouts is None:
+        metadata._batched_prompt_layouts = layouts = {}
+    # Ordinary eager/Breakable metadata is created anew for each live forward.
+    # The cached entries contain only offsets and lengths for this forward.
+    identity = (left, h, d, n, id(lengths), id(cuq))
+    if identity in layouts:
+        return layouts[identity]
+    rows, prefixes, host = batch.extend_seq_lens_cpu, batch.extend_prefix_lens_cpu, batch.seq_lens_cpu
+    if (not all(isinstance(x, (list, tuple)) and len(x) == count for x in (rows, prefixes))
+            or any(type(x) is not int or x < 0 for x in (*rows, *prefixes))
+            or min(rows) < 1 or sum(rows) != n or max(rows) != metadata.max_seq_len_q
+            or not isinstance(host, torch.Tensor) or host.device.type != "cpu" or host.shape != (count,)):
+        return None
+    totals = [p + r for p, r in zip(prefixes, rows)]
+    if totals != host.tolist() or max(totals) != metadata.max_seq_len_k:
+        return None
+    visible = [r + (p if left < 0 else min(p, left)) for r, p in zip(rows, prefixes)]
+    capacity = sum(visible) + 256 * count
+    # Bound both the packed allocation and the contiguous FP8 operands held for the writer.
+    if 2 * (capacity + n) * h * d > 32 * 1024 * 1024:
+        layouts[identity] = None
+        return None
+    if left < 0:
+        used = lengths
+    else:
+        qlens = cuq[1:] - cuq[:-1]
+        used = qlens + (lengths - qlens).clamp(max=left)
+    starts = torch.nn.functional.pad(torch.cumsum(used + 256, 0, dtype=torch.int32), (1, 0))
+    layout = starts, used, capacity, max(visible)
+    layouts[identity] = layout
+    return layout
