+            or "forward_split2" in vars(self.gate) or "_build_split2" in vars(self.gate)
+            or not experts.use_humming
+            or not experts.humming_decode_tunings
+            or experts._post_expert_norm_weight is None
+            or experts._post_expert_norm is not experts.post_expert_norm
+            or hidden_states.shape[0] * self.top_k > _MAX_DECODE_SLOTS
+            or get_global_experts_capturer() is not None
+            or torch.is_grad_enabled() or torch.is_autocast_enabled("cuda")
+            or torch._C._is_torch_function_mode_enabled() or torch._C._len_torch_dispatch_stack()
+            or hooks._global_forward_pre_hooks or hooks._global_forward_hooks
+            or any(has_custom_call(mod) for mod in (experts, norm, self.gate, routing))
+        ):
+            return None
+        return allocate_decode_plan(hidden_states, hidden_states.shape[0], self.top_k, experts.num_local_experts)
