+
+        def has_custom_call(module):
+            forward = module.forward
+            return (
+                getattr(forward, "__self__", None) is not module
+                or getattr(forward, "__func__", None) is not type(module).forward
+                or module._forward_pre_hooks or module._forward_hooks
+                or getattr(module, "_compiled_call_impl", None) is not None
+            )
+
+        if (
+            type(experts) is not MuseSpark1xFp4Experts
