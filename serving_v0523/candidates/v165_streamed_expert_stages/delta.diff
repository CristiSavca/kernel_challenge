+template <bool Gate>
+inline uint32_t resident_stream_blocks(int device) {
+  int current = -1, sms = 0, blocks = 0;
+  if (cudaGetDevice(&current) != cudaSuccess || current != device
+      || cudaDeviceGetAttribute(&sms, cudaDevAttrMultiProcessorCount, device) != cudaSuccess
+      || cudaOccupancyMaxActiveBlocksPerMultiprocessor(&blocks, streamed_projection<Gate>,
+                                                     32 * (kChannelWarps + 1), 0) != cudaSuccess) return 0u;
+  return static_cast<uint32_t>(sms * blocks);
+}
+
+template <bool Gate>
+inline void launch_stream(const Projection& p, const BankMaps& maps, uint32_t groups, uint32_t bound, uint32_t resident, DLDevice dev) {
+  const uint32_t columns = p.output_width / 128;
+  const uint32_t lanes = resident / columns;
+  if (groups < lanes) {
+    host::LaunchKernel(dim3(columns, std::min(bound, lanes)), 32 * (kChannelWarps + 1), dev)(streamed_projection<Gate>, p, maps);
+  } else {
+    host::LaunchKernel(dim3(columns, groups), 32 * kChannelWarps, dev)(tensor_projection<Gate>, p, maps);
+  }
+}
