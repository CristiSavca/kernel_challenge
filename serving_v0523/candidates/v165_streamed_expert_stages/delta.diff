+// The producer copies each live 128-feature row contiguously. A four-word
+// inter-row pad keeps the consuming warp's eight row groups on separate banks.
+template <bool Gate>
+struct alignas(128) StreamTile {
+  uint32_t weights[Gate ? 2 : 1][kKSteps][256];
+  uint16_t scales[Gate ? 2 : 1][kKSteps][64];
+  uint32_t inputs[kRows][8 * kKSteps + 4];
+};
+
+SGL_DEVICE uint32_t shared_addr(const void* ptr) {
+  return static_cast<uint32_t>(__cvta_generic_to_shared(ptr));
+}
+
+SGL_DEVICE void wait_phase(uint64_t* barrier, uint32_t parity) {
+  uint32_t complete;
+  do {
+    asm volatile("{ .reg .pred p; mbarrier.try_wait.parity.shared::cta.b64 p,[%1],%2; "
+                 "selp.b32 %0,1,0,p; }" : "=r"(complete) : "r"(shared_addr(barrier)), "r"(parity) : "memory");
+  } while (!complete);
+}
+
+template <bool Gate>
+SGL_DEVICE void produce(const Projection& p, const BankMaps& maps, StreamTile<Gate>& tile, uint64_t* full,
+                        uint32_t expert, uint32_t column, uint32_t chunk, int32_t slot, uint32_t live) {
+  constexpr uint32_t bytes = kKSteps * 16 * sizeof(bf16_t);
+  const uint32_t lane = threadIdx.x % 32, bar = shared_addr(full);
+  if (lane == 0) {
+    const uint32_t total = sizeof(tile.weights) + sizeof(tile.scales) + live * bytes;
+    asm volatile("mbarrier.arrive.expect_tx.shared::cta.b64 _, [%0], %1;" :: "r"(bar), "r"(total) : "memory");
+    const uint32_t y = expert * (p.input_width / 16) + chunk * kKSteps;
+#pragma unroll
+    for (uint32_t plane = 0; plane < (Gate ? 2u : 1u); ++plane) {
+      const uint32_t x = column + plane * p.output_width;
+      issue_tensor(&tile.weights[plane][0][0], &maps.weight, 2 * x, y, bar);
+      issue_tensor(&tile.scales[plane][0][0], &maps.scale, x / 2, y, bar);
+    }
+  }
+  __syncwarp();
+  if (slot >= 0) {
+    const uint32_t row = uint32_t(slot) / p.top_k;
+    const auto* src = p.inputs + size_t(row) * p.input_width + chunk * (16 * kKSteps);
+    asm volatile("cp.async.bulk.shared::cluster.global.mbarrier::complete_tx::bytes [%0], [%1], %2, [%3];"
+                 :: "r"(shared_addr(&tile.inputs[lane][0])), "l"(src), "n"(bytes), "r"(bar) : "memory");
+  }
+}
+
+template <bool Gate>
+__global__ __launch_bounds__(32 * (kChannelWarps + 1)) void streamed_projection(
+    const __grid_constant__ Projection p, const __grid_constant__ BankMaps maps) {
+  constexpr uint32_t stages = Gate ? 2 : 3;
+  __shared__ StreamTile<Gate> ring[stages];
+  __shared__ uint64_t full[stages], empty[stages];
+  const uint32_t jobs = p.plan[0];
+  if (blockIdx.y >= jobs) return;
+  const uint32_t lane = threadIdx.x % 32, warp = threadIdx.x / 32;
+  if (threadIdx.x < stages) {
+    asm volatile("mbarrier.init.shared::cta.b64 [%0], 1;\n"
+                 "mbarrier.init.shared::cta.b64 [%1], %2;\n"
+                 "fence.proxy.async.shared::cta;"
+                 :: "r"(shared_addr(full + lane)), "r"(shared_addr(empty + lane)), "n"(kChannelWarps) : "memory");
+  }
+  __syncthreads();
+  const uint32_t column = blockIdx.x * 128, chunks = p.input_width / (16 * kKSteps);
+  uint32_t sequence = 0;
+  for (uint32_t j = blockIdx.y; j < jobs; j += gridDim.y) {
+    const int32_t* job = p.plan + 1 + j * (kRows + 1);
+    const uint32_t expert = job[0];
+    if (warp == kChannelWarps) {
+      const int32_t slot = lane < kRows ? job[1 + lane] : -1;
+      const uint32_t live = __popc(__ballot_sync(0xffffffffu, slot >= 0));
+      for (uint32_t chunk = 0; chunk < chunks; ++chunk, ++sequence) {
+        const uint32_t index = sequence % stages;
+        if (sequence >= stages) wait_phase(empty + index, ((sequence / stages) - 1) & 1);
+        produce<Gate>(p, maps, ring[index], full + index, expert, column, chunk, slot, live);
+      }
+    } else {
+      const uint32_t band = warp / 4, part = (warp + lane / 8) % 4;
+      const uint32_t wi = 128 * band + 4 * lane + part, si = 32 * band + 4 * (lane / 4) + part;
+      const bool live = job[1 + lane / 4] >= 0;
+      float4 gate{}, up{};
+      for (uint32_t chunk = 0; chunk < chunks; ++chunk, ++sequence) {
+        const uint32_t index = sequence % stages;
+        wait_phase(full + index, (sequence / stages) & 1);
+        const auto& tile = ring[index];
+#pragma unroll
+        for (uint32_t s = 0; s < kKSteps; ++s) {
+          const auto* x = &tile.inputs[lane / 4][s * 8 + lane % 4];
+          const uint32_t lo = live ? x[0] : 0u, hi = live ? x[4] : 0u;
+          contract_fragment(gate, tile.weights[0][s][wi], tile.scales[0][s][si], lo, hi);
+          if constexpr (Gate) contract_fragment(up, tile.weights[1][s][wi], tile.scales[1][s][si], lo, hi);
+        }
+        __syncwarp();
+        if (lane == 0) {
+          asm volatile("mbarrier.arrive.shared::cta.b64 _, [%0];" :: "r"(shared_addr(empty + index)) : "memory");
+        }
+      }
+      finish_channels<Gate>(p, job, column, expert, lane, band, part, gate, up);
+    }
+  }
+}
