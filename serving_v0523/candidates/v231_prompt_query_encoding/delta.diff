+            table is None or type(self) is not FlashAttentionBackend or not self._direct_fp8_prompt
+            or self.fa_skip_kv_cache or self.kv_cache_is_mxfp8 or is_in_full_prefill_graph()
+            or type(layer) is not RadixAttention or type(norm) is not FusedQKNorm
