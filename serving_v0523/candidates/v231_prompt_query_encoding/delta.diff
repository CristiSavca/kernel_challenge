+            or torch.is_grad_enabled() or torch.are_deterministic_algorithms_enabled()
+            or _trace_enabled or get_fused_op_backend() is not None or norm.is_torch_compile
+            or getattr(norm._forward_method, "__func__", None) is not BaseFusedOp._forward_backend_dynamic
+            or norm._dynamic_backend_candidates[:1] != (KernelBackend.TRITON,)
+            or {"backend_eligible", "forward_triton", "_forward_triton"} & vars(norm).keys()
