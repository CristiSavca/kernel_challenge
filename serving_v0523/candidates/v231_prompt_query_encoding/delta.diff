+            or is_cp_active(batch) or batch.mha_return_lse
+            or layer.is_cross_attention or layer.head_dim != 64 or layer.head_dim != layer.v_head_dim
+            or norm._head_dim != layer.head_dim or norm._num_q_heads != layer.tp_q_head_num
+            or norm._num_kv_heads != layer.tp_k_head_num
+            or not layer.use_prefill_attention_wrapper or layer.attn_type != AttentionType.DECODER
+            or qkv.dtype != torch.bfloat16 or qkv.device != table.device
+            or qkv.ndim != 2 or qkv.stride(1) != 1 or qkv.shape[0] < 4096
+            or qkv.shape[1] < (norm._num_q_heads + 2 * norm._num_kv_heads) * norm._head_dim
