+// Each consumer owns sixteen output channels and one MMA accumulator per
+// eight route rows. All groups reuse the same packed operand from shared memory.
+template <bool Gate, uint32_t Groups, uint32_t Rows>
+SGL_DEVICE void consume_multirow(const Projection& p, const int32_t* job, uint32_t live, uint32_t expert,
+                                 uint32_t column, StreamTile<Gate, Rows> (&ring)[2], uint64_t* full,
+                                 uint64_t* empty, uint32_t& sequence) {
+  const uint32_t lane = threadIdx.x % 32, warp = threadIdx.x / 32;
+  const uint32_t band = warp / 4, part = (warp + lane / 8) % 4;
+  const uint32_t wi = 128 * band + 4 * lane + part, si = 32 * band + 4 * (lane / 4) + part;
+  const uint32_t chunks = p.input_width / (16 * kKSteps);
+  float4 a[Groups]{}, b[Groups]{};
+  for (uint32_t chunk = 0; chunk < chunks; ++chunk, ++sequence) {
+    const uint32_t index = sequence % 2;
+    wait_phase(full + index, (sequence / 2) & 1);
+    const auto& tile = ring[index];
+#pragma unroll
+    for (uint32_t s = 0; s < kKSteps; ++s) {
+      const uint32_t w = tile.weights[0][s][wi], scale = tile.scales[0][s][si];
+      uint32_t w_up = 0, scale_up = 0;
+      if constexpr (Gate) {
+        w_up = tile.weights[1][s][wi];
+        scale_up = tile.scales[1][s][si];
+      }
+#pragma unroll
+      for (uint32_t g = 0; g < Groups; ++g) {
+        const uint32_t row = g * kRows + lane / 4;
+        const auto* x = &tile.inputs[row][s * 8 + lane % 4];
+        const uint32_t lo = row < live ? x[0] : 0u, hi = row < live ? x[4] : 0u;
+        contract_fragment(a[g], w, scale, lo, hi);
+        if constexpr (Gate) contract_fragment(b[g], w_up, scale_up, lo, hi);
+      }
+    }
+    __syncwarp();
+    if (lane == 0) {
+      asm volatile("mbarrier.arrive.shared::cta.b64 _, [%0];" :: "r"(shared_addr(empty + index)) : "memory");
+    }
+  }
+#pragma unroll
+  for (uint32_t g = 0; g < Groups; ++g) {
+    finish_channels<Gate>(p, job + g * kRows, column, expert, lane, band, part, a[g], b[g], live - g * kRows);
+  }
