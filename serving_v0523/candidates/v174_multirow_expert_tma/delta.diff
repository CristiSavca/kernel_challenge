+template <bool Gate>
+__global__ __launch_bounds__(32 * (kChannelWarps + 1)) void multirow_projection(
+    const __grid_constant__ Projection p, const __grid_constant__ BankMaps maps, uint32_t stride) {
+  constexpr uint32_t rows_per_tile = Gate ? 2 * kRows : 4 * kRows;
+  __shared__ StreamTile<Gate, rows_per_tile> ring[2];
+  __shared__ uint64_t full[2], empty[2];
+  const uint32_t expert = blockIdx.y, column = 128 * blockIdx.x;
+  const int32_t* list = p.plan + size_t(expert) * stride;
+  const uint32_t rows = list[0];
+  if (rows == 0) return;
+  if (threadIdx.x < 2) {
+    const uint32_t index = threadIdx.x;
+    asm volatile("mbarrier.init.shared::cta.b64 [%0], 1;\n"
+                 "mbarrier.init.shared::cta.b64 [%1], %2;\n"
+                 "fence.proxy.async.shared::cta;"
+                 :: "r"(shared_addr(full + index)), "r"(shared_addr(empty + index)), "n"(kChannelWarps) : "memory");
+  }
+  __syncthreads();
+  const uint32_t lane = threadIdx.x % 32, warp = threadIdx.x / 32;
+  const uint32_t chunks = p.input_width / (16 * kKSteps);
+  uint32_t sequence = 0;
+  for (uint32_t first = 0; first < rows; first += rows_per_tile) {
+    const uint32_t live = min(rows_per_tile, rows - first);
+    const int32_t* job = list + first;
+    if (warp == kChannelWarps) {
+      const int32_t slot = lane < live ? job[1 + lane] : -1;
+      for (uint32_t chunk = 0; chunk < chunks; ++chunk, ++sequence) {
+        const uint32_t index = sequence % 2;
+        if (sequence >= 2) wait_phase(empty + index, ((sequence / 2) - 1) & 1);
+        produce<Gate>(p, maps, ring[index], full + index, expert, column, chunk, slot, live);
+      }
+    } else if (live <= kRows) {
+      consume_multirow<Gate, 1>(p, job, live, expert, column, ring, full, empty, sequence);
+    } else if constexpr (Gate) {
+      consume_multirow<true, 2>(p, job, live, expert, column, ring, full, empty, sequence);
+    } else if (live <= 2 * kRows) {
+      consume_multirow<false, 2>(p, job, live, expert, column, ring, full, empty, sequence);
+    } else if (live <= 3 * kRows) {
+      consume_multirow<false, 3>(p, job, live, expert, column, ring, full, empty, sequence);
+    } else {
+      consume_multirow<false, 4>(p, job, live, expert, column, ring, full, empty, sequence);
+    }
+  }
+}
