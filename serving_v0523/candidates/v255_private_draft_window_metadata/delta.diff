+            or not getattr(self.token_to_kv_pool, "dflash_private_swa", False)
+            or self.local_attn_builder is not None or self._kv_shard_pool is not None
+            or self.is_encoder_decoder or self.is_prefill_aware_swa or self.use_mla or self.topk > 1
+            or get_parallel().attn_dp_enabled or get_parallel().attn_dcp_size != 1
+            or get_parallel().enable_prefill_cp or self.attn_cp_size != 1
+            or get_exec().deterministic.enable_deterministic_inference
+            or envs.SGLANG_ENABLE_DETERMINISTIC_INFERENCE.get()
+            or get_spec().speculative_draft_window_size is not None
+        ):
+            return -1
+        from sglang.srt.models.dflash import DFlash2DraftModel
+
+        model = model_runner.model
+        if type(model) is not DFlash2DraftModel or self.speculative_num_draft_tokens != model.block_size:
+            return -1
+        hooks = torch.nn.modules.module
+        if hooks._global_forward_pre_hooks or hooks._global_forward_hooks:
+            return -1
+        if any(
+            module._forward_pre_hooks or module._forward_hooks or "forward" in vars(module)
+            or getattr(module, "_compiled_call_impl", None) is not None
+            for module in model.modules()
+        ):
