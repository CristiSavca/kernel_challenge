+    def _draft_graph_window(self, model_runner) -> int:
+        # At head dimension 128 the SM90 FA4 paged local attention uses 128-key tiles.
+        if (
+            not self.is_draft_runner or self.fa_impl_ver != 4 or not get_platform().is_sm90
