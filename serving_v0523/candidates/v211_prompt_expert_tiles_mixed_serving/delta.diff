diff --git a/python/sglang/srt/layers/muse_spark/residual_prompt_mma.py b/python/sglang/srt/layers/muse_spark/residual_prompt_mma.py
new file mode 100644
index 0000000000000000000000000000000000000000..8be1b212f30ddc4ae149c36ad951c2ed40ccbbd0
--- /dev/null
+++ b/python/sglang/srt/layers/muse_spark/residual_prompt_mma.py
@@ -0,0 +1,66 @@
+"""Specialize the tensor instruction width on the final tile of each grouped expert."""
+import hashlib
+from pathlib import Path
+
+
+_WIDTHS = (32, 96)
+
+
+def has_residual_isa(assembly, drains):
+    return (
+        all(assembly.count(f"HGMMA.64x{width}x16.F32.BF16") == 32 for width in (*_WIDTHS, 176))
+        and assembly.count("WARPGROUP.DEPBAR.LE") == drains * (len(_WIDTHS) + 1)
+    )
+
+
+def _replace_once(text, old, new):
+    if text.count(old) != 1:
+        raise ValueError("unsupported Humming residual-tile loop")
+    return text.replace(old, new)
+
+
+def adapt_residual_tiles(kernel, paired):
+    import humming
+    from humming.config.mma import WgmmaOpClassImpl
+    from sglang.kernels import jit
+
+    header = Path(humming.__path__[0]) / "include/humming/kernel/humming_ws.cuh"
+    source = header.read_text()
+    if hashlib.sha256(source.encode()).hexdigest() != "6a148cc29b81d4009066667c347d9091a8a138009f7884226e9969a6936e2899":
+        raise ValueError("unsupported Humming scheduler")
+    code = kernel.code
+    if not paired:
+        code = _replace_once(code, "#include <humming/kernel/humming_ws.cuh>", source.replace("#pragma once", "", 1))
+    location = "template <bool kUseTma>\nclass KernelTensorParamType"
+    operations = []
+    for width in _WIDTHS:
+        op = WgmmaOpClassImpl(width, 64, 16, "bf16", "bf16", "f32")
+        operations.append(f"struct MuseResidual{width} {{\n" + op.to_cpp_str() + "\n};\n")
+    template = Path(jit.__file__).parent / "csrc/muse_spark/residual_prompt_mma.cuh"
+    operations.append(template.read_text())
+    code = _replace_once(code, location, "".join(operations) + location)
+    # Keep the entire accumulator lifetime in one width-specialized branch.
+    # Joining those arrays before the epilogue spills the full-width hot loop.
+    mma = "    auto mma = MMA(ctx, mainloop_arith);"
+    reader = "    auto s2r_pipe = S2RMemoryPipeline(ctx, mma, epilogue);"
+    code = _replace_once(code, mma, "")
+    code = _replace_once(code, reader, "")
+    start = code.index("      mma.zero_accum();")
+    last = "      if constexpr (!kReduceOverlapLastStageOnly) consumer.arrive(kNumStages);"
+    end = code.index(last, start) + len(last)
+    body = mma + "\n" + reader + "\n" + code[start:end]
+    op = "mma.run(stage_id, warp_iter_id);"
+    paired_arg = "true" if paired else "false"
+    run = (
+        "if constexpr (std::is_same_v<Op, MuseFullWidth>) " + op +
+        f" else muse_residual_mma<Op, {paired_arg}, Ctx>(mma, stage_id, warp_iter_id);"
+    )
+    body = _replace_once(body, op, run)
+    # Both offsets are absolute rows at the current expert's end and tile start.
+    # Every math warp observes this decision once before traversing K.
+    dispatch = "      const auto live = scheduler.current_shape_m - scheduler.m_offset;\n"
+    for i, width in enumerate(_WIDTHS):
+        dispatch += f"      {'else ' if i else ''}if (live <= {width}) compute(MuseResidual{width}{{}});\n"
+    dispatch += "      else compute(MuseFullWidth{});\n"
+    begin = "      auto compute = [&](auto op) {\n        using Op = decltype(op);\n"
+    kernel.code = code[:start] + begin + body + "      };\n" + dispatch + code[end:]
