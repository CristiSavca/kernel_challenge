+@triton.jit
+def _count_route_tiles(Ids, ExpertMap, Local, Counts, slots, tiles, GLOBAL: tl.constexpr,
+                       MAP: tl.constexpr, EXPERTS: tl.constexpr, BINS: tl.constexpr, TILE: tl.constexpr):
+    tile = tl.program_id(0)
+    slot = tile * TILE + tl.arange(0, TILE)
+    expert = tl.load(Ids + slot, slot < slots, other=-1)
+    if MAP:
+        expert = tl.load(ExpertMap + expert, (expert >= 0) & (expert < GLOBAL), other=-1)
+        tl.store(Local + slot, expert, slot < slots)
+    bucket = tl.where((expert >= 0) & (expert < EXPERTS), expert, EXPERTS)
+    counts = tl.histogram(bucket, BINS)
+    index = tl.arange(0, BINS)
+    # The final bin counts all live routes and supplies the existing CPU vote.
+    tl.store(Counts + index * tiles + tile, tl.where(index == EXPERTS, TILE - counts, counts), index <= EXPERTS)
+
+
+@triton.jit
+def _scan_route_tiles(Counts, Totals, tiles, SPAN: tl.constexpr):
+    expert = tl.program_id(0)
+    tile = tl.arange(0, SPAN)
+    ptr = Counts + expert * tiles + tile
+    count = tl.load(ptr, tile < tiles, other=0)
+    tl.store(ptr, tl.cumsum(count, 0) - count, tile < tiles)
+    tl.store(Totals + expert, tl.sum(count, 0))
+
+
+@triton.jit
+def _place_routes(Ids, Prefix, Totals, SortedExperts, RowMap, Offsets, slots, tiles,
+                  EXPERTS: tl.constexpr, BINS: tl.constexpr, TILE: tl.constexpr):
+    tile = tl.program_id(0)
+    lane = tl.arange(0, TILE)
+    slot = tile * TILE + lane
+    expert = tl.load(Ids + slot, slot < slots, other=-1)
+    bucket = tl.where((expert >= 0) & (expert < EXPERTS), expert, EXPERTS)
+    # Use original lane as a tie breaker so equal experts retain token/slot order.
+    key = tl.sort(bucket * TILE + lane, descending=False)
+    bucket = key // TILE
+    local_counts = tl.histogram(bucket, BINS)
+    local_start = tl.cumsum(local_counts, 0) - local_counts
+    bins = tl.arange(0, BINS)
+    sizes = tl.load(Totals + bins, bins < EXPERTS, other=0)
+    start = tl.cumsum(sizes, 0) - sizes
+    before = tl.load(Prefix + bucket * tiles + tile, bucket < EXPERTS, other=0)
+    row = tl.gather(start, bucket, 0) + before + lane - tl.gather(local_start, bucket, 0)
+    original = tile * TILE + key % TILE
+    tl.store(RowMap + original, tl.where(bucket < EXPERTS, row, -1), original < slots)
+    tl.store(SortedExperts + row, bucket, bucket < EXPERTS)
+    if tile == 0:
+        tl.store(Offsets + bins, start, bins < EXPERTS)
+        tl.store(Offsets + EXPERTS, tl.sum(sizes, 0))
+
+
+def count_peer_routes(ids, layer):
+    slots = ids.numel()
+    experts = layer.num_local_experts
+    mapping = layer._expert_map
+    tile = 256
+    tiles = triton.cdiv(slots, tile)
+    if ids.dtype != torch.int32 or not ids.is_contiguous() or not 0 < experts <= 64 or not 32 <= tiles <= 2048:
+        return None
+    if mapping is None:
+        if layer.global_num_experts != experts:
+            return None
+        local_ids = ids
+    else:
+        if (mapping.dtype != torch.int32 or mapping.device != ids.device or not mapping.is_contiguous()
+                or mapping.shape != (layer.global_num_experts,)):
+            return None
+        local_ids = torch.empty_like(ids)
+    prefix = ids.new_empty((experts + 1, tiles))
+    totals = ids.new_empty(experts + 1)
+    bins = triton.next_power_of_2(experts + 1)
+    _count_route_tiles[(tiles,)](ids, mapping if mapping is not None else ids, local_ids, prefix, slots, tiles,
+                                 layer.global_num_experts, mapping is not None, experts, bins, tile)
+    _scan_route_tiles[(experts + 1,)](prefix, totals, tiles, triton.next_power_of_2(tiles))
+    return local_ids, prefix, totals
+
+
+def place_peer_routes(ids, plan, routes):
+    _, prefix, totals = plan
+    experts, tiles = totals.numel() - 1, prefix.shape[1]
+    sorted_experts = ids.new_empty(routes)
+    if not routes:
+        return sorted_experts, ids, totals
+    row_map = torch.empty_like(ids)
+    offsets = ids.new_empty(experts + 1)
+    _place_routes[(tiles,)](ids, prefix, totals, sorted_experts, row_map, offsets, ids.numel(), tiles,
+                            experts, triton.next_power_of_2(experts + 1), 256)
+    return sorted_experts, row_map, offsets
