+    def shard_for_gather(self, hidden_states, router_input, use_split2, rank, world_size):
+        width = self.weight.shape[0] // world_size
+        experts = slice(rank * width, (rank + 1) * width)
+        # Rank-local hooks and precision settings must not change the collective
+        # sequence or modify the FP32 logits consumed by other ranks.
+        with torch.autocast("cuda", enabled=False):
+            shard = (
+                self.forward_split2(hidden_states, experts) if use_split2
+                else F.linear(router_input, self.weight[experts])
+            )
+        override = None
+        if self.needs_local_router_result():
+            override = self.forward_split2(hidden_states) if use_split2 else self(router_input)
+        return shard, override
