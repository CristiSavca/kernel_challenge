@@ -0,0 +1,208 @@
+"""Debug aid: per-stage wall time of eager forwards.
+
+Run the server with --disable-prefill-cuda-graph so that real requests take the
+eager path. Forwards are grouped by size: large (a full 16,384-token chunk), mid
+(8,192 and up) and tiny (256 and up, a later turn of a conversation). The first
+large and tiny forwards are skipped because they carry one-time kernel builds.
+Each profiled forward logs one line with the time per stage, the positions it
+covers and a few routing counts. Every lap synchronizes the device, so a
+forward inside a CUDA graph is never profiled.
+
+Profiled large forwards cycle through four modes: Marlin experts, the default
+path, Marlin again, and the default path with a lap around every expert step.
+One log therefore compares the two expert paths on the same traffic and splits
+the dense path, while the extra synchronizations stay out of the comparison.
+Large forwards also alternate, four at a time, between NCCL and the default
+all-reduce dispatch, which compares the two on the same traffic as well.
+
+With --disable-decode-cuda-graph as well, speculative verify forwards run eager
+and are profiled too, one in four after a warm-up, grouped by how many tokens
+the step verifies. Eager launch latency is part of each stage there, so read
+the shares rather than the totals.
+"""
+
+from __future__ import annotations
+
+import logging
+import time
+from typing import Optional
+
+import torch
+
+logger = logging.getLogger(__name__)
+
+_MIN_TOKENS = {"large": 16384, "mid": 8192, "tiny": 256}
+_SKIP = {"large": 2, "mid": 0, "tiny": 2}
+_MAX = {"large": 40, "mid": 16, "tiny": 40}
+# Verify steps by token count (requests x draft block): name, largest size.
+_VERIFY = (("verify_le16", 16), ("verify_le64", 64), ("verify_le160", 160), ("verify_gt160", None))
+_VERIFY_SKIP, _VERIFY_EVERY, _VERIFY_MAX = 8, 4, 24
+
+
+class PrefillStageProfile:
+    seen = {"large": 0, "mid": 0, "tiny": 0, **{name: 0 for name, _ in _VERIFY}}
+    done = {"large": 0, "mid": 0, "tiny": 0, **{name: 0 for name, _ in _VERIFY}}
+    totals: Optional[dict] = None  # stage -> seconds while a forward is profiled
+    notes: Optional[dict] = None  # counter -> value while a forward is profiled
+    kind = "tiny"
+    fine = False  # this forward also laps every step of the dense expert path
+    scope = ""  # set by a caller around a shared module to name its laps
+    span = ""
+    last = 0.0
+    checked_experts = False
+
+    @classmethod
+    def begin(
+        cls,
+        num_tokens: int,
+        is_extend: bool,
+        positions: Optional[torch.Tensor] = None,
+        is_verify: bool = False,
+    ) -> bool:
+        if (
+            not is_extend
+            or not torch.cuda.is_available()
+            or torch.cuda.is_current_stream_capturing()
+        ):
+            return False
+        if is_verify:
+            for kind, largest in _VERIFY:
+                if largest is None or num_tokens <= largest:
+                    break
+            cls.seen[kind] += 1
+            warm = cls.seen[kind] - _VERIFY_SKIP
+            if warm <= 0 or warm % _VERIFY_EVERY or cls.done[kind] >= _VERIFY_MAX:
+                return False
+        else:
+            for kind in ("large", "mid", "tiny"):
+                if num_tokens >= _MIN_TOKENS[kind]:
+                    break
+            else:
+                return False
+            cls.seen[kind] += 1
+            if cls.seen[kind] <= _SKIP[kind] or cls.done[kind] >= _MAX[kind]:
+                return False
+        cls.kind = kind
+        cls.fine = kind == "large" and cls.done[kind] % 4 == 3
+        cls.span = ""
+        if positions is not None and positions.numel() > 0:
+            cls.span = f"{int(positions.min())}..{int(positions.max())}"
+        torch.cuda.synchronize()
+        cls.totals = {}
+        cls.notes = {}
+        cls.last = time.perf_counter()
+        return True
+
+    @classmethod
+    def lap(cls, stage: str) -> None:
+        """Charge the time since the previous lap to ``stage``."""
+        totals = cls.totals
+        if totals is None:
+            return
+        torch.cuda.synchronize()
+        now = time.perf_counter()
+        totals[stage] = totals.get(stage, 0.0) + now - cls.last
+        cls.last = now
+
+    @classmethod
+    def lap_fine(cls, stage: str) -> None:
+        """A lap taken only in the forwards that split the dense expert path."""
+        if cls.fine:
+            cls.lap(stage)
+
+    @classmethod
+    def lap_scoped(cls, part: str) -> None:
+        """A lap inside a shared module, named by the caller's ``scope``."""
+        if cls.scope:
+            cls.lap(f"{cls.scope}_{part}")
+
+    @classmethod
+    def note(cls, key: str, value: int, how: str = "sum") -> None:
+        notes = cls.notes
+        if notes is None:
+            return
+        if key not in notes:
+            notes[key] = value
+        elif how == "sum":
+            notes[key] += value
+        elif how == "max":
+            notes[key] = max(notes[key], value)
+        else:
+            notes[key] = min(notes[key], value)
+
+    @classmethod
+    def end(cls, num_tokens: int, num_layers: int) -> None:
+        if cls.forces_marlin():
+            experts = "marlin (forced)"
+        else:
+            experts = "default (fine laps)" if cls.fine else "default"
+        if cls.kind == "large":
+            experts += " + sums nccl" if cls.forces_nccl() else " + sums default"
+        totals, cls.totals = cls.totals, None
+        notes, cls.notes = cls.notes, None
+        cls.fine = False
+        cls.done[cls.kind] += 1
+        logger.info(
+            "Prefill stage profile: %s #%d, %d tokens, positions %s, %d layers, "
+            "experts=%s, total %.1f ms; %s; notes: %s",
+            cls.kind,
+            cls.done[cls.kind],
+            num_tokens,
+            cls.span,
+            num_layers,
+            experts,
+            1e3 * sum(totals.values()),
+            ", ".join(f"{name} {1e3 * sec:.1f}" for name, sec in totals.items()),
+            ", ".join(f"{name} {value}" for name, value in notes.items()),
+        )
+
+    @classmethod
+    def forces_marlin(cls) -> bool:
+        """Every other large profiled forward keeps the Marlin experts as the baseline."""
+        return (
+            cls.totals is not None
+            and cls.kind == "large"
+            and cls.done["large"] % 2 == 0
+        )
+
+    @classmethod
+    def forces_nccl(cls) -> bool:
+        """Large profiled forwards alternate, four at a time, between NCCL and the default all-reduce."""
+        return (
+            cls.totals is not None
+            and cls.kind == "large"
+            and (cls.done["large"] // 4) % 2 == 0
+        )
+
+    @classmethod
+    def wants_expert_check(cls) -> bool:
+        return not (
+            cls.totals is None
+            or cls.forces_marlin()
+            or cls.fine
+            or cls.checked_experts
+        )
+
+    @classmethod
+    def report_expert_check(
+        cls, marlin: torch.Tensor, dense: torch.Tensor, active: torch.Tensor
+    ) -> None:
+        """Log how the dense expert outputs differ from Marlin's on live routes."""
+        a = marlin[active].float()
+        b = dense[active].float()
+        if a.shape[0] > 0:  # else this rank owns none of the sampled routes; try again later
+            cls.checked_experts = True
+            diff = (a - b).abs()
+            rms = a.pow(2).mean().sqrt()
+            logger.info(
+                "Prefill expert check: %d routes, rms %.4g, max |dense - marlin| / rms "
+                "%.3g, differing values %.4f, finite %s",
+                a.shape[0],
+                rms.item(),
+                (diff.max() / rms).item(),
+                (diff > 0).float().mean().item(),
+                bool(torch.isfinite(b).all().item()),
+            )
+        # The check is not part of any stage.
+        torch.cuda.synchronize()
+        cls.last = time.perf_counter()
