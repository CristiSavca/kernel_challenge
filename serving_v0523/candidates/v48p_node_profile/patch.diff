--- /dev/null
+++ b/python/sglang/kernels/ops/moe/nvfp4_marlin_dequant.py
@@ -0,0 +1,43 @@
+"""Dequantize rows of one Marlin-packed NVFP4 expert matrix to dense BF16."""
+
+from __future__ import annotations
+
+from typing import TYPE_CHECKING
+
+import torch
+
+from sglang.kernels.jit.utils import cache_once, load_jit
+
+if TYPE_CHECKING:
+    from tvm_ffi.module import Module
+
+
+@cache_once
+def _jit_module() -> Module:
+    return load_jit(
+        "nvfp4_marlin_dequant",
+        cuda_files=["gemm/marlin_moe/nvfp4_marlin_dequant.cuh"],
+        cuda_wrappers=[("nvfp4_marlin_dequant", "nvfp4_marlin_dequant")],
+    )
+
+
+def nvfp4_marlin_dequant(
+    qweight: torch.Tensor,
+    scales: torch.Tensor,
+    out: torch.Tensor,
+    row_begin: int = 0,
+) -> torch.Tensor:
+    """Write ``out[n, k] = code(row_begin + n, k) * scale(row_begin + n, k // 16)``.
+
+    ``qweight`` is one expert of a Marlin-repacked NVFP4 weight, int32
+    ``[K / 16, 2 * N]``, and ``scales`` its processed block scales,
+    ``[K / 16, N]`` with one byte per element. ``out`` is BF16 ``[rows, K]``;
+    ``row_begin`` and ``rows`` are multiples of 64. The product is exact in
+    BF16, so ``out`` holds the operand the Marlin kernel forms in registers.
+    The per-expert global scale is left to the caller.
+    """
+    assert out.dtype == torch.bfloat16 and out.is_contiguous()
+    _jit_module().nvfp4_marlin_dequant(
+        qweight.contiguous(), scales.contiguous().view(torch.uint8), out, row_begin
+    )
+    return out
