index 0000000..cbd2635
--- /dev/null
+++ b/python/sglang/kernels/jit/csrc/gemm/marlin_moe/nvfp4_marlin_dequant.cuh
@@ -0,0 +1,168 @@
+// Dequantize rows of one Marlin-packed NVFP4 expert matrix to dense BF16.
+//
+// Input is exactly what the Marlin MoE kernel reads: E2M1 codes repacked by
+// gptq_marlin_repack (16 x 64 tiles of 128 words, see gptq_marlin_repack.cuh)
+// and block scales permuted and re-encoded by nvfp4_marlin_process_scales.
+// Output is out[n - row_begin, k] = code(n, k) * scale(n, k / 16), the value the
+// Marlin kernel forms in registers. A code has at most 2 significant bits and a
+// scale 4, so the product is exact in BF16 and equals the top half of its FP32
+// encoding. The per-expert global scale is not applied here; like Marlin, the
+// caller applies it to the GEMM output.
+//
+// One block handles one 64-row n tile over 64 k tiles. It first builds a table
+// of every code * scale product in shared memory (16 codes for each of the 128
+// scale encodings Marlin keeps, plus a zero row), so the hot loop is a table
+// lookup per value. A warp owns 8 k tiles and walks the 64 rows; its two
+// stores per row together cover 256 contiguous bytes.
+
+#pragma once
+
+#include <sgl_kernel/tensor.h>
+#include <sgl_kernel/utils.h>
+
+#include <sgl_kernel/utils.cuh>
+
+#include <tvm/ffi/container/tensor.h>
+
+#include <cstdint>
+
+namespace sglang {
+
+namespace nvfp4_marlin {
+
+constexpr int kTileK = 16;
+constexpr int kTileN = 64;
+constexpr int kTileWords = kTileK * kTileN / 8;
+constexpr int kWarps = 8;                 // one per group of 8 k tiles
+constexpr int kBlockKTiles = kWarps * 8;  // k tiles per thread block
+constexpr int kThreads = kWarps * 32;
+constexpr int kScaleRows = 129;           // 128 kept scale encodings + a zero row
+constexpr int kTableSize = kScaleRows * 16;
+
+struct DequantParams {
+  const uint32_t* __restrict__ qweight;  // [K / 16, 2 * N]
+  const uint8_t* __restrict__ scales;    // [K / 16, N]
+  uint32_t* __restrict__ out;            // [rows, K] BF16, two values per word
+  int size_n;
+  int size_k;
+  int row_begin;
+};
+
+// Position of row n (within its 64-row tile) in a processed scale row:
+// marlin_permute_scales applies scale_perm, then nvfp4_marlin_process_scales
+// swaps the middle two entries of every group of four.
+__device__ __forceinline__ int scale_position(int n_local) {
+  const int p = (n_local % 8) * 8 + n_local / 8;
+  const int r = p % 4;
+  return p - r + (r == 1 ? 2 : r == 2 ? 1 : r);
+}
+
+// A processed scale byte holds the 5-bit exponent e and top 3 mantissa bits m of
+// half(scale * 128), so scale = (1 + m / 8) * 2^(e - 22). The Marlin BF16 decode
+// keeps only e >= 16, that is scale >= 2^-6 (E4M3's smallest normal); below
+// that its product underflows to 0. Table row: byte - 128 when kept, else 128.
+__device__ __forceinline__ uint32_t scale_row(uint32_t byte) { return byte >= 128u ? byte - 128u : 128u; }
+
+__device__ __forceinline__ float decode_scale_row(uint32_t row) {
+  const uint32_t byte = row + 128u;
+  const uint32_t bits = row >= 128u ? 0u : (((byte >> 3) + 105u) << 23) | ((byte & 7u) << 20);
+  return __uint_as_float(bits);
+}
+
+// E2M1: sign, 2 exponent bits e, 1 mantissa bit m. Magnitude is m / 2 for e == 0
+// and (1 + m / 2) * 2^(e - 1) otherwise, built directly as FP32 bits.
+__device__ __forceinline__ float decode_code(uint32_t code) {
+  const uint32_t e = (code >> 1) & 3u;
+  const uint32_t m = code & 1u;
+  const uint32_t magnitude = e == 0 ? m * 0x3F000000u : ((e + 126u) << 23) | (m << 22);
+  return __uint_as_float(((code & 8u) << 28) | magnitude);
+}
+
+__launch_bounds__(kThreads) __global__ void dequant_kernel(const DequantParams __grid_constant__ params) {
+  // BF16 is the top half of FP32, and code * scale has no bits below it.
+  __shared__ uint16_t table[kTableSize];
+  for (int i = threadIdx.x; i < kTableSize; i += kThreads) {
+    const float value = decode_code(i & 15) * decode_scale_row(i >> 4);
+    table[i] = static_cast<uint16_t>(__float_as_uint(value) >> 16);
+  }
+  __syncthreads();
+
+  const int n_tiles = params.size_n / kTileN;
+  const int n_tile = params.row_begin / kTileN + blockIdx.x;
+  const int lane = threadIdx.x % 32;
+  const int k_tile = (blockIdx.y * kWarps + threadIdx.x / 32) * 8 + lane / 4;
+  if (k_tile >= params.size_k / kTileK) return;
+  // Each lane owns one mma row pair of its k tile: tile columns 2 * pair + {0, 1}
+  // and 2 * pair + {8, 9}.
+  const int pair = lane % 4;
+
+  const uint32_t* __restrict__ tile =
+      params.qweight + (static_cast<int64_t>(k_tile) * n_tiles + n_tile) * kTileWords;
+  const uint8_t* __restrict__ tile_scales =
+      params.scales + static_cast<int64_t>(k_tile) * params.size_n + n_tile * kTileN;
+  uint32_t* __restrict__ dst =
+      params.out + (static_cast<int64_t>(blockIdx.x) * kTileN * params.size_k + k_tile * kTileK) / 2 + pair;
+
+  // gptq_marlin_repack: word th * 4 + warp of a tile holds, for mma thread th
+  // (column th / 4, row pair th % 4) of warp `warp`, the codes of matrix rows
+  // warp * 16 + th / 4 and + 8 at tile columns 2 * (th % 4) + {0, 1, 8, 9}, in
+  // nibble order {b1 c0, b1 c8, b2 c0, b2 c8, b1 c1, b1 c9, b2 c1, b2 c9}.
+  for (int n_local = 0; n_local < kTileN; ++n_local) {
+    const uint32_t word = tile[((n_local % 8) * 4 + pair) * 4 + n_local / 16] >> (((n_local % 16) / 8) * 8);
+    const uint16_t* __restrict__ row = table + scale_row(tile_scales[scale_position(n_local)]) * 16;
+    uint32_t* __restrict__ out = dst + static_cast<int64_t>(n_local) * params.size_k / 2;
+    out[0] = row[word & 15u] | (static_cast<uint32_t>(row[(word >> 16) & 15u]) << 16);
+    out[4] = row[(word >> 4) & 15u] | (static_cast<uint32_t>(row[(word >> 20) & 15u]) << 16);
+  }
+}
+
+}  // namespace nvfp4_marlin
+
+void nvfp4_marlin_dequant(
+    tvm::ffi::TensorView qweight,  // [K / 16, 2 * N] int32
+    tvm::ffi::TensorView scales,   // [K / 16, N] uint8
+    tvm::ffi::TensorView out,      // [rows, K] bf16
+    int64_t row_begin) {
+  using namespace host;
+
+  SymbolicSize KT{"k_tiles"};
+  SymbolicSize N2{"packed_n"};
+  SymbolicSize N{"size_n"};
+  SymbolicSize R{"rows"};
+  SymbolicSize K{"size_k"};
+  SymbolicDevice device_;
+  device_.set_options<kDLCUDA>();
+
+  TensorMatcher({KT, N2}).with_dtype<int32_t>().with_device(device_).verify(qweight);
+  TensorMatcher({KT, N}).with_dtype<uint8_t>().with_device(device_).verify(scales);
+  TensorMatcher({R, K}).with_dtype<bf16_t>().with_device(device_).verify(out);
+
+  const int size_n = static_cast<int>(N.unwrap());
+  const int size_k = static_cast<int>(K.unwrap());
+  const int rows = static_cast<int>(R.unwrap());
+  RuntimeCheck(size_k % nvfp4_marlin::kTileK == 0 && size_n % nvfp4_marlin::kTileN == 0, "unsupported shape");
+  RuntimeCheck(KT.unwrap() * nvfp4_marlin::kTileK == size_k, "qweight rows do not match size_k");
+  RuntimeCheck(N2.unwrap() == 2 * static_cast<int64_t>(size_n), "qweight columns do not match size_n");
+  RuntimeCheck(
+      row_begin >= 0 && row_begin % nvfp4_marlin::kTileN == 0 && rows % nvfp4_marlin::kTileN == 0 &&
+          row_begin + rows <= size_n,
+      "rows must be whole 64-row tiles inside the matrix");
+  RuntimeCheck(reinterpret_cast<uintptr_t>(out.data_ptr()) % 4 == 0, "out must be 4-byte aligned");
+  if (rows == 0) return;
+
+  const nvfp4_marlin::DequantParams params{
+      .qweight = static_cast<const uint32_t*>(qweight.data_ptr()),
+      .scales = static_cast<const uint8_t*>(scales.data_ptr()),
+      .out = static_cast<uint32_t*>(out.data_ptr()),
+      .size_n = size_n,
+      .size_k = size_k,
+      .row_begin = static_cast<int>(row_begin),
+  };
+
+  const int k_tiles = size_k / nvfp4_marlin::kTileK;
+  const dim3 grid(
+      rows / nvfp4_marlin::kTileN, (k_tiles + nvfp4_marlin::kBlockKTiles - 1) / nvfp4_marlin::kBlockKTiles);
+  LaunchKernel(grid, nvfp4_marlin::kThreads, device_.unwrap(), 0)(nvfp4_marlin::dequant_kernel, params);
+}
+
+}  // namespace sglang
