+"""Pack the visible sliding-window suffix for one dense variable-length FA3 call."""
+
+import torch
+import triton
+import triton.language as tl
+
+
+@triton.jit
+def _pack_swa_suffix(
+    K, V, Table, Lengths, CuQ, DenseK, DenseV, PackedCuQ, PackedCuK, UsedK,
+    k_stride, v_stride, table_stride, q_capacity, batch,
+    LEFT: tl.constexpr, ROW_WIDTH: tl.constexpr, BLOCK_ROWS: tl.constexpr,
+):
+    seq = tl.program_id(1)
+    block = tl.program_id(0)
+    # The extra sequence owns any graph-bucket query padding. Its one key
+    # and value are zero so every padded output is finite and isolated.
+    dummy = seq == batch
+    q_begin = tl.load(CuQ + seq)
+    q_end = tl.load(CuQ + seq + 1, mask=~dummy, other=0)
+    q_len = q_end - q_begin
+    k_len = tl.load(Lengths + seq, mask=~dummy, other=0)
+    live = tl.where(q_len > 0, tl.minimum(k_len, q_len + LEFT), 0)
+    live = tl.where(dummy, 1, live)
+    start = k_len - live
+    # Reserve a zero guard after each live suffix for unpredicated lanes
+    # in the final dense FA3 K/V tile. Prefix space is independent of k_len.
+    guard: tl.constexpr = 256
+    dst_begin = q_begin.to(tl.int64) + seq.to(tl.int64) * (LEFT + guard)
+    if block == 0:
+        tl.store(PackedCuQ + seq, q_begin)
+        tl.store(PackedCuK + seq, dst_begin)
+        tl.store(UsedK + seq, live)
+        if dummy:
+            tl.store(PackedCuQ + seq + 1, q_capacity)
+            tl.store(PackedCuK + seq + 1, q_capacity + batch * (LEFT + guard) + guard)
+
+    cols = tl.arange(0, ROW_WIDTH)
+    extent = tl.where(dummy, guard, live + guard)
+    for tile in range(block, tl.cdiv(extent, BLOCK_ROWS), tl.num_programs(0)):
+        row = tile * BLOCK_ROWS + tl.arange(0, BLOCK_ROWS)
+        read = (row < live) & ~dummy
+        page = tl.load(Table + seq.to(tl.int64) * table_stride + start + row, mask=read, other=0).to(tl.int64)
+        dst = (dst_begin + row)[:, None] * ROW_WIDTH + cols[None, :]
+        keys = tl.load(K + page[:, None] * k_stride + cols[None, :], read[:, None], other=0)
+        tl.store(DenseK + dst, keys, mask=row[:, None] < extent)
+        values = tl.load(V + page[:, None] * v_stride + cols[None, :], read[:, None], other=0)
+        tl.store(DenseV + dst, values, mask=row[:, None] < extent)
+
+
+def can_pack_swa_prefill(key, value, table, lengths, cu_q, q_capacity, left):
+    if table is None or table.ndim != 2 or key.ndim != 4 or cu_q is None:
+        return False
+    batch, columns = table.shape
+    _, page_size, heads, dim = key.shape
+    row_bytes = heads * dim
+    capacity = q_capacity + batch * (left + 256) + 256
+    return (
+        batch > 0 and columns > 0 and page_size == 1 and left >= 0
+        and value.shape == key.shape and value.dtype == key.dtype == torch.float8_e4m3fn
+        and 16 <= row_bytes <= 1024 and row_bytes & (row_bytes - 1) == 0
+        and key.stride()[-2:] == value.stride()[-2:] == (dim, 1)
+        and table.stride(1) == 1 and table.dtype in (torch.int32, torch.int64)
+        and lengths.shape == (batch,) and cu_q.shape == (batch + 1,)
+        and lengths.dtype == cu_q.dtype == torch.int32
+        and lengths.is_contiguous() and cu_q.is_contiguous()
+        and 2 * capacity * row_bytes <= 48 * 1024 * 1024
+    )
+
+
+def pack_swa_prefill(key, value, table, lengths, cu_q, q_capacity, max_q, left):
+    batch, columns = table.shape
+    _, _, heads, dim = key.shape
+    capacity = q_capacity + batch * (left + 256) + 256
+    packed = key.new_empty((2, capacity, heads, dim))
+    dense_k, dense_v = packed.unbind()
+    q_bounds = cu_q.new_empty(batch + 2)
+    k_bounds = cu_q.new_empty(batch + 2)
+    used_k = lengths.new_empty(batch + 1)
+    row_bytes = heads * dim
+    # Dense FP8 cache rows can usually move four bytes per lane. The byte
+    # path also accepts views with storage offsets or strides between words.
+    word_aligned = dim % 4 == 0 and all(
+        tensor.storage_offset() % 4 == 0 and tensor.data_ptr() % 4 == 0
+        and all(stride % 4 == 0 for stride in tensor.stride()[:-1])
+        for tensor in (key, value)
+    )
+    dtype = torch.int32 if word_aligned else torch.uint8
+    source_k, source_v = key.view(dtype), value.view(dtype)
+    row_width = row_bytes // source_k.element_size()
+    block_rows = min(32, (4096 if word_aligned else 2048) // row_bytes)
+    max_k = min(columns, max_q + left)
+    # Independent blocks stream the rows of a request. Bound idle work for
+    # a long chunk batched with short chunks or empty graph rows.
+    blocks = min(triton.cdiv(max_k + 256, block_rows), triton.cdiv(1024, batch + 1))
+    _pack_swa_suffix[(blocks, batch + 1)](
+        source_k, source_v, table, lengths, cu_q,
+        dense_k.view(dtype), dense_v.view(dtype), q_bounds, k_bounds, used_k,
+        source_k.stride(0), source_v.stride(0), table.stride(0), q_capacity, batch,
+        LEFT=left, ROW_WIDTH=row_width, BLOCK_ROWS=block_rows,
+    )
+    return dense_k, dense_v, q_bounds, k_bounds, used_k, max_k
+
+
+def with_padding_descale(scale):
+    if scale.shape[0] == 1 or scale.stride(0) == 0:
+        return scale[:1].expand(scale.shape[0] + 1, -1)
+    return torch.cat((scale, scale[:1]), dim=0)
