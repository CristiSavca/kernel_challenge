+"""Build private guarded FP8 sequences from cached prefixes and contiguous new rows."""
+import torch
+import triton
+import triton.language as tl
+
+
+@triton.jit
+def _pack_prompt_rows(
+    CacheK, CacheV, NewK, NewV, Slots, Lengths, CuQ, Starts, Used,
+    OutK, OutV, key_pitch, value_pitch, table_pitch,
+    ROW: tl.constexpr, BLOCK: tl.constexpr, GUARD: tl.constexpr,
+):
+    seq = tl.program_id(1)
+    q0 = tl.load(CuQ + seq)
+    queries = tl.load(CuQ + seq + 1) - q0
+    length = tl.load(Lengths + seq)
+    used = tl.load(Used + seq)
+    halo = used - queries
+    begin = tl.load(Starts + seq).to(tl.int64)
+    cols = tl.arange(0, ROW)
+    for tile in range(tl.program_id(0), tl.cdiv(used + GUARD, BLOCK), tl.num_programs(0)):
+        row = tile * BLOCK + tl.arange(0, BLOCK)
+        old = row < halo
+        new = (row >= halo) & (row < used)
+        slot = tl.load(Slots + seq.to(tl.int64) * table_pitch + (length - used + row), old, 0).to(tl.int64)
+        src = (q0 + row - halo).to(tl.int64)[:, None] * ROW + cols[None, :]
+        dst = (begin + row)[:, None] * ROW + cols[None, :]
+        key = tl.load(CacheK + slot[:, None] * key_pitch + cols[None, :], old[:, None], 0)
+        value = tl.load(CacheV + slot[:, None] * value_pitch + cols[None, :], old[:, None], 0)
+        key = key | tl.load(NewK + src, new[:, None], 0)
+        value = value | tl.load(NewV + src, new[:, None], 0)
+        valid = row[:, None] < used + GUARD
+        tl.store(OutK + dst, key, valid)
+        tl.store(OutV + dst, value, valid)
+
+
+def pack_prompt_rows(key_cache, value_cache, key, value, table, lengths, cuq, layout):
+    starts, used, capacity, max_used = layout
+    _, heads, dim = key.shape
+    width = heads * dim
+    block = min(32, 4096 // width)
+    count = table.shape[0]
+    blocks = min(triton.cdiv(max_used + 256, block), triton.cdiv(1024, count))
+    packed = key.new_empty((2, capacity, heads, dim))
+    out_k, out_v = packed.unbind()
+    _pack_prompt_rows[(blocks, count)](
+        key_cache.view(torch.uint8), value_cache.view(torch.uint8),
+        key.view(torch.uint8), value.view(torch.uint8), table, lengths, cuq,
+        starts, used, out_k.view(torch.uint8), out_v.view(torch.uint8),
+        key_cache.stride(0), value_cache.stride(0), table.stride(0),
+        ROW=width, BLOCK=block, GUARD=256,
+    )
+    return out_k, out_v
