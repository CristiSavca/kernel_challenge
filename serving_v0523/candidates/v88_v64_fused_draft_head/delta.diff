+"""Select draft candidates while projecting each vocabulary tile."""
+
+import torch
+import triton
+import triton.language as tl
+
+
+@triton.jit
+def _ordered_keys(logits, tokens):
+    # Retain the BF16 result of the original dense projection. Order NaNs
+    # ahead of finite scores and prefer the smaller local ID on equal bits.
+    bits = logits.to(tl.bfloat16).to(tl.uint16, bitcast=True).to(tl.uint32)
+    bits = tl.where((bits & 32767) > 32640, 32704, bits)
+    ordered = bits ^ tl.where((bits & 32768) != 0, 65535, 32768).to(tl.uint32)
+    return (ordered << 16) | (65535 - tokens.to(tl.uint32))
+
+
+@triton.jit
+def _project_tiles(
+    Hidden, Weight, Partial, M: tl.constexpr, N: tl.constexpr,
+    H: tl.constexpr, HS: tl.constexpr, WS: tl.constexpr, TOP: tl.constexpr,
+    BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr,
+):
+    tile = tl.program_id(0)
+    row = tl.program_id(1) * BM + tl.arange(0, BM)
+    # Shift the last tile back so all its weight rows are readable. Only the
+    # new suffix can contribute winners; overlapping rows belong to the prior tile.
+    start_col = tl.minimum(tile * BN, N - BN) if N % BN else tile * BN
+    col = start_col + tl.arange(0, BN)
+    inner = tl.arange(0, BK)
+    acc = tl.full((BM, BN), 0, tl.float32)
+    a_ptr = Hidden + row[:, None] * HS + inner[None, :]
+    b_ptr = Weight + col[:, None] * WS + inner[None, :]
+    for start in range(0, H, BK):
+        a = tl.load(a_ptr + start, row[:, None] < M, 0)
+        b = tl.load(b_ptr + start)
+        acc = tl.dot(a, tl.trans(b), acc)
+    keys = tl.where(col[None, :] >= tile * BN, _ordered_keys(acc, col[None, :]), 0)
+    best = tl.topk(keys, TOP, dim=1)
+    slots = (row[:, None] * tl.cdiv(N, BN) + tile) * TOP + tl.arange(0, TOP)[None, :]
+    tl.store(Partial + slots, best, row[:, None] < M)
+
+
+@triton.jit
+def _merge_tiles(
+    Partial, Pairs, OFFSET: tl.constexpr, COUNT: tl.constexpr,
+    TOP: tl.constexpr, BLOCK: tl.constexpr,
+):
+    row = tl.program_id(0)
+    index = tl.arange(0, BLOCK)
+    keys = tl.load(Partial + row * COUNT + index, index < COUNT, 0).to(tl.uint32)
+    best = tl.sort(tl.topk(keys, TOP), descending=True)
+    ordered = best >> 16
+    bits = ordered ^ tl.where((ordered & 32768) != 0, 32768, 65535).to(tl.uint32)
+    values = bits.to(tl.uint16).to(tl.bfloat16, bitcast=True).to(tl.float32)
+    ids = OFFSET + 65535 - (best & 65535).to(tl.int32)
+    dst = Pairs + 2 * (row * TOP + tl.arange(0, TOP))
+    tl.store(dst, values.to(tl.int32, bitcast=True))
+    tl.store(dst + 1, ids)
+
+
+def fused_local_candidate_pairs(hidden, weight, num_org, offset, k):
+    """Return contiguous (FP32 score bits, global id) pairs or request the dense path."""
+    if (
+        hidden.ndim != 2
+        or weight.ndim != 2
+        or hidden.device != weight.device
+        or hidden.dtype != torch.bfloat16
+        or weight.dtype != torch.bfloat16
+        or hidden.stride(1) != 1
+        or weight.stride(1) != 1
+        or hidden.shape[1] != weight.shape[1]
+        or hidden.shape[1] % 64 != 0
+        or hidden.shape[1] == 0
+        or hidden.shape[0] == 0
+        or k not in (4, 8, 16, 32)
+        or not 1024 <= num_org <= min(weight.shape[0], 65536)
+        or not hidden.is_cuda
+        or torch.are_deterministic_algorithms_enabled()
+        or torch.cuda.get_device_capability(hidden.device)[0] != 9
+    ):
+        return None
+    rows, width = hidden.shape
+    bm, bn, bk = 16, 128, 64
+    tiles = triton.cdiv(num_org, bn)
+    # Tensor-core tiles use signed 32-bit element offsets for the dot loads.
+    # Reject strided views or oversized workspaces outside that address range.
+    limit = 2**31 - 1
+    if (
+        triton.cdiv(rows, bm) > 65535
+        or (rows - 1) * hidden.stride(0) + width > limit
+        or (num_org - 1) * weight.stride(0) + width > limit
+        or rows * max(tiles * k, 2 * k) > limit
+    ):
+        return None
+    partial = torch.empty((rows, tiles, k), dtype=torch.int32, device=hidden.device)
+    pairs = torch.empty((rows, k * 2), dtype=torch.int32, device=hidden.device)
+    _project_tiles[(tiles, triton.cdiv(rows, bm))](
+        hidden, weight, partial, rows, num_org, width, hidden.stride(0),
+        weight.stride(0), k, bm, bn, bk, num_warps=4, num_stages=3,
+    )
+    _merge_tiles[(rows,)](
+        partial, pairs, offset, tiles * k, k, triton.next_power_of_2(tiles * k),
+        num_warps=8,
+    )
+    return pairs
