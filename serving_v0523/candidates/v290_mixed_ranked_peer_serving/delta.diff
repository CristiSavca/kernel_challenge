diff --git a/python/sglang/srt/layers/muse_spark/peer_prompt_pack.py b/python/sglang/srt/layers/muse_spark/peer_prompt_pack.py
new file mode 100644
index 0000000..fddd6d6
--- /dev/null
+++ b/python/sglang/srt/layers/muse_spark/peer_prompt_pack.py
@@ -0,0 +1,189 @@
+"""Model-owned NVLink input buffer shared by successive sparse prompt layers."""
+
+import logging
+import threading
+
+import torch
+import torch.distributed as dist
+from torch import nn
+from triton.errors import TritonError
+
+from sglang.kernels.ops.moe.muse_spark_peer_pack import pack_peer_rows
+
+from sglang.srt.layers import layernorm_sp
+from sglang.srt.model_executor.runner_backend_utils.breakable_cuda_graph import eager_on_graph
+
+logger = logging.getLogger(__name__)
+
+
+class PeerPromptInputs:
+    def __init__(self, storage, handle, group, banks=1):
+        self.storage = storage[:storage.shape[0] // banks]
+        self.handle = handle
+        self.group = group
+        # Keep the remote views and rendezvous handle alive for the model's lifetime.
+        self.peers = [handle.get_buffer(i, list(storage.shape), storage.dtype) for i in range(group.world_size)]
+        if storage.storage_offset() != 0 or self.peers[group.rank_in_group].data_ptr() != storage.data_ptr():
+            raise ValueError("Sparse prompt publication requires its own symmetric allocation")
+        rows = self.storage.shape[0]
+        self.banks = [
+            (storage.narrow(0, i * rows, rows), torch.tensor(
+                [p.narrow(0, i * rows, rows).data_ptr() for p in self.peers], device=storage.device, dtype=torch.int64
+            ))
+            for i in range(banks)
+        ]
+        self.next_bank = 0
+        self.stream = torch.cuda.Stream(device=storage.device)
+        self.lock = threading.Lock()
+
+    def supports(self, shard, group):
+        return (
+            group is self.group and shard.device == self.storage.device and shard.dtype == self.storage.dtype
+            and 0 < shard.shape[0] <= self.storage.shape[0] and shard.shape[1] == self.storage.shape[1]
+        )
+
+    def pack(self, shard, row_map, result):
+        # Even an empty local bank publishes its shard for the other ranks.
+        caller = torch.cuda.current_stream(shard.device)
+        with self.lock:
+            self.stream.wait_stream(caller)
+            with torch.cuda.stream(self.stream):
+                storage, addresses = self.banks[self.next_bank]
+                storage[:shard.shape[0]].copy_(shard)
+                self.handle.barrier(channel=0)
+                if result is not None:
+                    pack_peer_rows(addresses, row_map, result, shard.shape[0])
+                    result.record_stream(self.stream)
+                    row_map.record_stream(self.stream)
+                if len(self.banks) == 1:
+                    self.handle.barrier(channel=0)
+                else:
+                    # Each rank reaches the next publication after all its prior reads.
+                    # That barrier retires this bank before the following call reuses it.
+                    self.next_bank ^= 1
+                shard.record_stream(self.stream)
+            caller.wait_stream(self.stream)
+
+
+def peer_storage_rows(hidden, world, chunk_rows, capture_rows, graph_max, scheduler_max):
+    # A runner can add a backed graph key after model construction. Reserve for
+    # the shared configured limit, even if that key is absent from the base grid.
+    backed = min(graph_max, scheduler_max) if all(
+        isinstance(limit, int) and limit > 0 for limit in (graph_max, scheduler_max)
+    ) else 0
+    extent = max(chunk_rows, max(capture_rows or (), default=0), backed)
+    return min((extent + world - 1) // world, (17 * 1024 * 1024) // (2 * hidden))
+
+
+def prepare_peer_prompt_inputs(group, hidden, topk, chunk_rows, capture_rows, graph_max, scheduler_max):
+    from sglang.srt.distributed.device_communicators.custom_all_reduce_v2 import CustomAllReduceV2
+
+    if group.world_size < 2 or dist.get_backend(group.cpu_group) != "gloo":
+        return None
+
+    def agree(value):
+        values = [None] * group.world_size
+        dist.all_gather_object(values, value, group=group.cpu_group)
+        return values
+
+    comm = group.ca_comm
+    rows = 0
+    if (
+        isinstance(comm, CustomAllReduceV2) and not comm.disabled and comm.has_multicast and comm.pull_enabled
+        and comm._is_graph_mode_supported and comm.rank == group.rank_in_group and comm.world_size == group.world_size
+        and torch.cuda.get_device_capability(comm.device)[0] == 9 and hidden > 0
+        and isinstance(chunk_rows, int) and chunk_rows > 0 and 0 < topk <= 16
+    ):
+        rows = peer_storage_rows(hidden, group.world_size, chunk_rows, capture_rows, graph_max, scheduler_max)
+    proposals = agree((hidden, topk, rows))
+    rows = min(capacity for _, _, capacity in proposals)
+    if rows <= 0 or any((width, routes) != (hidden, topk) for width, routes, _ in proposals):
+        return None
+    # A local allocation failure must be visible to all ranks before entering rendezvous.
+    def setup(banks):
+        storage = None
+        try:
+            from torch._C._distributed_c10d import _SymmetricMemory
+
+            with torch.inference_mode(False), torch.no_grad():
+                storage = _SymmetricMemory.empty_strided_p2p(
+                    (banks * rows, hidden), (hidden, 1), torch.bfloat16, comm.device, group.device_group.group_name
+                )
+        except (AttributeError, ImportError, OSError, RuntimeError, TypeError) as exc:
+            logger.warning("Sparse prompt peer allocation unavailable: %s", exc)
+        if not all(agree(storage is not None)):
+            return None
+        workspace = None
+        try:
+            handle = _SymmetricMemory.rendezvous(storage)
+            if handle is not None and handle.rank == group.rank_in_group and handle.world_size == group.world_size:
+                workspace = PeerPromptInputs(storage, handle, group, banks)
+                # Compile before accepting collective work. Read only this rank's own row.
+                probe_shard_rows = 2
+                row_map = torch.full((handle.rank * probe_shard_rows + 1, topk), -1,
+                                     dtype=torch.int32, device=comm.device)
+                row_map[-1, 0] = 0
+                output = torch.empty_like(storage[:1])
+                for bank, addresses in workspace.banks:
+                    bank[:1].zero_()
+                    pack_peer_rows(addresses, row_map, output, probe_shard_rows)
+                torch.cuda.current_stream(comm.device).synchronize()
+        except (AttributeError, ImportError, OSError, RuntimeError, TypeError, ValueError, TritonError) as exc:
+            logger.warning("Sparse prompt peer reads unavailable: %s", exc)
+            workspace = None
+        return workspace if all(agree(workspace is not None)) else None
+
+    return setup(2) or setup(1)
+
+
+
+def _local_grouped_eligible(experts, shard):
