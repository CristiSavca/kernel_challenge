+#pragma unroll
+    for (uint32_t plane = 0; plane < (Gate ? 2u : 1u); ++plane) {
+      const uint32_t x = column + plane * p.output_width;
+      issue_tensor(&tile.weights[plane][0][0], &maps.weight, 2 * x, y, bar);
+      issue_tensor(&tile.scales[plane][0][0], &maps.scale, x / 2, y, bar);
