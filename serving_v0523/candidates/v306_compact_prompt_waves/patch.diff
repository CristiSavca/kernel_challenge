+                attn.attn, KVWriteLoc(cache_loc, physical=True),
+                k.view(-1, attn.num_kv_heads, attn.head_dim),
+                v.view(-1, attn.num_kv_heads, attn.head_dim),
+                attn.attn.k_scale, attn.attn.v_scale,
+            )
