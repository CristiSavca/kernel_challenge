+"""Humming W4A16 experts for Muse's per-route finalization."""
+
+from __future__ import annotations
+
+import json
+import logging
+import subprocess
+from typing import TYPE_CHECKING
+
+import torch
+import triton
+import triton.language as tl
+
+from sglang.kernels.jit.utils import cache_once, get_activation_cuda_cflags, load_jit
+from sglang.srt.environ import envs
+from sglang.srt.runtime_context import get_exec, get_parallel
+
+if TYPE_CHECKING:
+    from sglang.srt.layers.muse_spark.muse_spark_fp4_moe import MuseSpark1xFp4Experts
+
+
+_GROUPED_COMPUTE = json.dumps(
+    {"gemm_type": "grouped_contiguous", "use_f16_accum": False}
+)
+_MAX_DECODE_SLOTS = 2048
+_MAX_DECODE_EXPERTS = 64
+
+
+@cache_once
+def _expert_scaled_silu_module():
+    return load_jit(
+        "muse_expert_scaled_silu",
+        cuda_files=["muse_spark/expert_scaled_silu.cuh"],
+        cuda_wrappers=[("run", "MuseExpertScaledSilu::run")],
+        extra_cuda_cflags=get_activation_cuda_cflags(),
+    )
+
+
+@cache_once
+def _graph_prefill_ready(device, tp_group):
+    supported = (
+        envs.SGLANG_ENABLE_MUSE_SPARK_HUMMING_GRAPH_PREFILL.get()
+        and torch.version.cuda is not None
+        and not get_exec().deterministic.enable_deterministic_inference
+        and not envs.SGLANG_ENABLE_DETERMINISTIC_INFERENCE.get()
+        and torch.cuda.get_device_capability(device) == (9, 0)
+    )
+    if supported:
+        try:
+            _expert_scaled_silu_module()
+        except (OSError, RuntimeError, subprocess.SubprocessError) as exc:
+            logging.getLogger(__name__).warning("Disabling graph-local grouped prefill: %s", exc)
+            supported = False
+    # Breakable graph capture puts a TP barrier at each eager boundary.
+    # All ranks must choose the same graph structure, even after a JIT failure.
+    if tp_group.world_size > 1:
+        ready = torch.tensor(int(supported), device="cpu", dtype=torch.int32)
+        torch.distributed.all_reduce(ready, op=torch.distributed.ReduceOp.MIN, group=tp_group.cpu_group)
+        supported = bool(ready.item())
+    return supported
+
+
+@cache_once
+def _conditional_waves_ready(device):
+    graph_type = torch.cuda.CUDAGraph
+    methods = (
+        "get_currently_capturing_graph", "begin_capture_to_while_node",
+        "set_conditional_handle_for_current_node", "end_capture_to_conditional_node",
+    )
+    if not all(hasattr(graph_type, name) for name in methods):
+        return False
+    if torch.cuda.get_allocator_backend() != "native":
+        return False
+    version = tuple(int(part) for part in torch.version.cuda.split(".")[:2])
+    if version < (12, 4):
+        return False
+    # Exercise the device predicate once before model capture. Use an isolated
+    # stream and pool so the feature check cannot clear the model's allocator cache.
+    try:
+        with torch.cuda.device(device), torch.cuda.stream(torch.cuda.Stream(device=device)):
+            count = torch.empty((), dtype=torch.int32, device=device)
+            active = torch.empty((), dtype=torch.bool, device=device)
+            count.fill_(2)
+            torch.gt(count, 0, out=active)
+            graph = graph_type()
+            graph.capture_begin(capture_error_mode="thread_local")
+            try:
+                torch.gt(count, 0, out=active)
+                current = graph_type.get_currently_capturing_graph()
+                current.begin_capture_to_while_node(active)
+                try:
+                    count.sub_(1)
+                    torch.gt(count, 0, out=active)
+                    current.set_conditional_handle_for_current_node(active)
+                finally:
+                    current.end_capture_to_conditional_node()
+            finally:
+                graph.capture_end()
+            graph.replay()
+            if count.item() != 0:
+                return False
+            count.fill_(-1)
+            graph.replay()
+            return count.item() == -1
+    except (RuntimeError, NotImplementedError) as exc:
+        logging.getLogger(__name__).info("Using unrolled grouped expert waves: %s", exc)
+        return False
+
+
+def prepare_humming_nvfp4(layer: MuseSpark1xFp4Experts) -> None:
+    """Replace the local checkpoint bank with packed Humming weights."""
+    from humming import dtypes
+    from humming.config import GemmType
+    from humming.kernel.humming import HummingKernel
+    from humming.layer import HummingMethod
+    from humming.schema.humming import HummingInputSchema, HummingWeightSchema
+    from humming.transform import transform_humming_tensors
+
+    if layer.quant_config.group_size != 16:
+        raise ValueError("Muse Humming NVFP4 requires groups of 16 weight elements")
+
+    layer.humming_graph_prefill = (
+        _graph_prefill_ready(layer.gate_up_proj.device, get_parallel().tp_group)
+        and layer.intermediate_size_per_partition % 8 == 0
+    )
+    layer.humming_conditional_waves = (
+        layer.humming_graph_prefill and _conditional_waves_ready(layer.gate_up_proj.device)
+    )
+    input_schema = HummingInputSchema(a_dtype=dtypes.bfloat16)
+    weight_schema = HummingWeightSchema(
+        b_dtype=dtypes.float4e2m1,
+        bs_dtype=dtypes.float8e4m3,
+        weight_scale_group_size=16,
+    )
+    params = {}
+    tunings = {}
+    grouped_tunings = {}
+    decode_tunings = {}
+    layer.humming_decode_down = {}
+    gate_meta = None
+    for name, checkpoint_name in (("w13", "gate_up_proj"), ("w2", "down_proj")):
+        packed = getattr(layer, checkpoint_name)
+        scales = getattr(layer, f"{checkpoint_name}_weight_scale")
+        global_scale = getattr(layer, f"{checkpoint_name}_weight_scale_2")
+        experts, n, packed_k = packed.shape
+        k = packed_k * 2
+        if n % 256 or k % 128 or experts != layer.num_local_experts:
+            raise ValueError("Muse Humming requires aligned local expert matrices")
+        if packed.dtype != torch.uint8 or scales.dtype != torch.float8_e4m3fn:
+            raise ValueError("Muse Humming requires packed E2M1 and E4M3 scales")
+        if scales.shape != (experts, n, k // 16):
+            raise ValueError("Muse Humming received an incompatible scale shape")
+
+        # Reproduce Marlin's NVFP4 BF16 operand. Its E4M3 unpack maps all
+        # subnormal scales to zero and assumes non-negative finite scales.
+        scale_bytes = scales.view(torch.uint8)
+        if (scale_bytes > 0x7E).any().item():
+            raise ValueError("Muse Humming requires non-negative finite block scales")
+        scale_bytes = scale_bytes.masked_fill(scale_bytes < 8, 0)
+
+        meta = HummingMethod.prepare_layer_meta(
+            layer,
+            shape_n=n,
+            shape_k=k,
+            weight_schema=weight_schema,
+            input_schema=input_schema,
+            num_experts=experts,
+            torch_dtype=torch.bfloat16,
+            sublayer_name=name,
+        )
+        tensors = transform_humming_tensors(
+            meta,
+            {
+                "weight": packed.view(torch.int32),
+                "weight_scale": scale_bytes.view(torch.float8_e4m3fn),
+            },
+            already_padded=True,
+        )
+        params[meta.weight_name] = tensors["weight"]
+        params[meta.weight_scale_name] = tensors["weight_scale"]
+        # Stock Marlin collapses the gate/up global scales to the gate value
+        # and multiplies after the BF16 output cast. Preserve both boundaries.
+        if name == "w13" and global_scale.ndim == 2:
+            global_scale = global_scale[:, 0]
+        if global_scale.shape != (experts,):
+            raise ValueError("Muse Humming requires one global scale per expert")
+        params[f"{name}_global_scale"] = global_scale.to(torch.bfloat16).contiguous()
+
+        # Each Stream-K slice would be rounded to BF16 before its output
+        # reduction. Keep a complete FP32 accumulation in each output tile.
+        tunings[name] = tuple(
+            (maximum, config | {"use_stream_k": False})
+            for _, maximum, config in HummingMethod.get_default_tuning_configs(
+                layer, gemm_type=GemmType.INDEXED, sublayer_name=name
+            )
+        )
+
+        grouped = HummingMethod.get_default_tuning_configs(
+            layer, gemm_type=GemmType.GROUPED_CONTIGUOUS, sublayer_name=name
+        )
+        grouped_tunings[name] = json.dumps(
+            grouped[-1][2] | {"use_stream_k": False, "use_tma_c": False}
+        )
+        # Dummy graph routes can be empty or concentrated on one EP rank.
+        # Compile the large-batch kernels while the model loads on every rank.
+        HummingKernel.prepare_kernels(
+            meta.to_str(), _GROUPED_COMPUTE, grouped_tunings[name]
+        )
+        if (name == "w13" and torch.cuda.get_device_capability(packed.device) == (9, 0)
+                and not envs.SGLANG_ENABLE_DETERMINISTIC_INFERENCE.get()):
+            gate_meta = meta.to_str()
+        if (
+            experts <= _MAX_DECODE_EXPERTS
+            and envs.SGLANG_ENABLE_MUSE_SPARK_HUMMING_GROUPED_DECODE.get()
+            and not envs.SGLANG_ENABLE_DETERMINISTIC_INFERENCE.get()
+        ):
+            max_local_routes = max(
+                1, _MAX_DECODE_SLOTS * experts // layer.global_num_experts
+            )
+            decode_tunings[name] = tuple(
+                (
+                    maximum,
+                    json.dumps(config | {"use_stream_k": False, "use_tma_c": False}),
+                )
+                for minimum, maximum, config in grouped
+                if minimum < max_local_routes
+            )
+            for _, tuning in decode_tunings[name]:
+                HummingKernel.prepare_kernels(meta.to_str(), _GROUPED_COMPUTE, tuning)
+            if name == "w2" and torch.cuda.get_device_capability(packed.device) == (9, 0):
+                from sglang.srt.layers.muse_spark.decode_mma_pair import prepare_down
+
+                layer.humming_decode_down = prepare_down(meta.to_str(), _GROUPED_COMPUTE, decode_tunings[name])
+
+    for name, tensor in params.items():
+        setattr(layer, name, torch.nn.Parameter(tensor, requires_grad=False))
+    for name in ("gate_up_proj", "down_proj"):
+        delattr(layer, name)
+        delattr(layer, f"{name}_weight_scale")
+        delattr(layer, f"{name}_weight_scale_2")
+    layer.humming_indexed_tunings = tunings
+    layer.humming_grouped_tunings = grouped_tunings
+    layer.humming_decode_tunings = decode_tunings
+    layer.humming_decode_gate_up = None
+    layer.humming_prompt_gate_up = None
+    if gate_meta is not None:
+        from sglang.srt.layers.muse_spark.decode_gate_up import prepare_gate_up
+
+        if "w13" in decode_tunings:
+            layer.humming_decode_gate_up = prepare_gate_up(layer, gate_meta, _GROUPED_COMPUTE, decode_tunings["w13"])
+        layer.humming_prompt_gate_up = prepare_gate_up(
+            layer, gate_meta, _GROUPED_COMPUTE, ((None, grouped_tunings["w13"]),), prompt=True,
+        )
+
+
+@triton.jit
+def _plan_grouped_decode(
+    global_ids,
+    expert_map,
+    local_ids,
+    offsets,
+    row_keys,
+    row_map,
+    slots,
+    EXPERTS: tl.constexpr,
+    GLOBAL_EXPERTS: tl.constexpr,
+    HAS_EXPERT_MAP: tl.constexpr,
+    SLOT_SPAN: tl.constexpr,
+    EXPERT_SPAN: tl.constexpr,
+):
+    slot = tl.arange(0, SLOT_SPAN)
+    expert = tl.load(global_ids + slot, mask=slot < slots, other=-1)
+    in_range = (expert >= 0) & (expert < GLOBAL_EXPERTS)
+    if HAS_EXPERT_MAP:
+        expert = tl.load(expert_map + expert, mask=in_range, other=-1)
+    else:
+        expert = tl.where(in_range, expert, -1)
+    expert = expert.to(tl.int32)
+    tl.store(local_ids + slot, expert, mask=slot < slots)
+    bucket = tl.where((expert >= 0) & (expert < EXPERTS), expert + 1, 0)
+    buckets = tl.arange(0, EXPERT_SPAN)
+    # Bucket zero contains remote routes and masked lanes. Put real routes at
+    # the end of the static arena so the last expert always ends at shape_m.
+    padding = SLOT_SPAN - slots
+    ends = tl.cumsum(tl.histogram(bucket, EXPERT_SPAN), 0) - padding
+    tl.store(offsets + buckets, ends, mask=buckets <= EXPERTS)
+    key = tl.sort(bucket * SLOT_SPAN + slot, descending=False)
+    row = slot - padding
+    tl.store(row_keys + row, key, mask=row >= 0)
+    original_slot = key % SLOT_SPAN
+    tl.store(
+        row_map + original_slot,
+        tl.where(key >= SLOT_SPAN, row, -1),
+        mask=original_slot < slots,
+    )
+
+
+@triton.jit
+def _gather_grouped_decode(
+    hidden_states,
+    row_keys,
+    offsets,
+    output,
+    slots,
+    TOPK: tl.constexpr,
+    HIDDEN: tl.constexpr,
+    SLOT_SPAN: tl.constexpr,
+    BLOCK: tl.constexpr,
+):
+    first = tl.load(offsets)
+    width = tl.arange(0, BLOCK)
+    for row in range(first + tl.program_id(0), slots, tl.num_programs(0)):
+        slot = tl.load(row_keys + row) % SLOT_SPAN
+        token = slot // TOPK
+        values = tl.load(
+            hidden_states + token * HIDDEN + width, mask=width < HIDDEN, other=0
+        )
+        tl.store(output + row * HIDDEN + width, values, mask=width < HIDDEN)
+
+
+def humming_decode_eligible(
+    layer: MuseSpark1xFp4Experts,
+    hidden_states: torch.Tensor,
+    topk_ids: torch.Tensor,
+) -> bool:
+    return (
+        bool(layer.humming_decode_tunings)
+        and hidden_states.dtype == torch.bfloat16
+        and hidden_states.is_contiguous()
+        and hidden_states.shape[1] <= layer.intermediate_size_per_partition
+        and topk_ids.is_contiguous()
+        and topk_ids.dtype in (torch.int32, torch.int64)
+        and 0 < topk_ids.numel() <= _MAX_DECODE_SLOTS
+        and not torch.compiler.is_compiling()
+    )
+
+
+def humming_grouped_decode_outputs(
+    layer: MuseSpark1xFp4Experts,
+    hidden_states: torch.Tensor,
+    topk_ids: torch.Tensor,
+) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor]:
+    """Run local grouped GEMMs with a device-built suffix and static addresses."""
+    from humming.layer import HummingMethod
+
+    hidden_size = hidden_states.shape[1]
+    intermediate = layer.intermediate_size_per_partition
+    topk = topk_ids.shape[1]
+    slots = topk_ids.numel()
+    span = triton.next_power_of_2(slots)
+    experts = layer.num_local_experts
+    local_ids = torch.empty_like(topk_ids, dtype=torch.int32)
+    offsets = local_ids.new_empty(experts + 1)
+    row_keys = local_ids.new_empty(slots)
+    row_map = torch.empty_like(local_ids)
+    expert_map = layer._expert_map
+    _plan_grouped_decode[(1,)](
+        topk_ids,
+        expert_map if expert_map is not None else topk_ids,
+        local_ids,
+        offsets,
+        row_keys,
+        row_map,
+        slots,
+        EXPERTS=experts,
+        GLOBAL_EXPERTS=layer.global_num_experts,
+        HAS_EXPERT_MAP=expert_map is not None,
+        SLOT_SPAN=span,
+        EXPERT_SPAN=triton.next_power_of_2(experts + 1),
+        num_warps=4 if span <= 256 else 8,
+    )
+    staging = hidden_states.new_empty(slots * intermediate)
+    inputs = staging[: slots * hidden_size].view(slots, hidden_size)
+    _gather_grouped_decode[(min(slots, 128),)](
+        hidden_states,
+        row_keys,
+        offsets,
+        inputs,
+        slots,
+        TOPK=topk,
+        HIDDEN=hidden_size,
+        SLOT_SPAN=span,
+        BLOCK=triton.next_power_of_2(hidden_size),
+        num_warps=8 if hidden_size >= 4096 else 4,
+    )
+
+    estimated_local_routes = max(1, slots * experts // layer.global_num_experts)
+    def select(name):
+        return next(config for maximum, config in layer.humming_decode_tunings[name]
+                    if estimated_local_routes <= maximum)
+
+    gate_tuning = select("w13")
+    activations = None
+    if getattr(layer, "humming_decode_gate_up", None) is not None:
+        from sglang.srt.layers.muse_spark.decode_gate_up import run_gate_up
+
+        activations = run_gate_up(layer, inputs, row_keys, offsets, gate_tuning)
+    if activations is None:
+        arena = hidden_states.new_empty(slots * max(2 * intermediate, hidden_size))
+        gate_up = arena[: slots * 2 * intermediate].view(slots, 2 * intermediate)
+        activations = staging.view(slots, intermediate)
+        outputs = arena[: slots * hidden_size].view(slots, hidden_size)
+        phases = (("w13", inputs, gate_up, gate_tuning), ("w2", activations, outputs, select("w2")))
+    else:
+        # The new W13 output is separate. Once it finishes, W2 may reuse W13's input.
+        outputs = inputs
+        phases = (("w2", activations, outputs, select("w2")),)
+    for name, source, destination, tuning in phases:
+        down = getattr(layer, "humming_decode_down", {}).get(tuning) if name == "w2" else None
+        if down is not None:
+            from sglang.srt.layers.muse_spark.decode_mma_pair import run_down
+            run_down(down, layer, source, destination, offsets)
+            continue
+        HummingMethod.forward_layer(
+            layer,
+            inputs=source,
+            outputs=destination,
+            expert_layout=offsets,
+            compute_config=_GROUPED_COMPUTE,
+            tuning_config=tuning,
+            sublayer_name=name,
+        )
+        if name == "w13":
+            _expert_scaled_silu_module().run(
+                gate_up, activations, row_keys, offsets, layer.w13_global_scale, span
+            )
+    return outputs, row_map, local_ids
+
+
+@triton.jit
+def _scale_live_routes(
+    values,
+    scales,
+    flat_ids,
+    sorted_ids,
+    padded,
+    slots,
+    WIDTH: tl.constexpr,
+    BLOCK: tl.constexpr,
+):
+    column = tl.arange(0, BLOCK)
+    count = tl.load(padded)
+    for position in range(tl.program_id(0), count, tl.num_programs(0)):
+        slot = tl.load(sorted_ids + position)
+        if 0 <= slot and slot < slots:
+            expert = tl.load(flat_ids + slot)
+            scale = tl.load(scales + expert).to(tl.float32)
+            offset = slot.to(tl.int64) * WIDTH + column
+            value = tl.load(values + offset, mask=column < WIDTH, other=0)
+            rounded = (value.to(tl.float32) * scale).to(tl.bfloat16)
+            tl.store(values + offset, rounded, mask=column < WIDTH)
+
+
+def local_humming_expert_ids(
+    layer: MuseSpark1xFp4Experts, topk_ids: torch.Tensor
+) -> torch.Tensor:
+    from sglang.srt.layers.moe.token_dispatcher.standard import (
+        _map_topk_ids_to_local_experts,
+    )
+
+    local_ids = topk_ids.to(torch.int32)
+    if layer._expert_map is not None:
+        local_ids = _map_topk_ids_to_local_experts(local_ids, layer._expert_map)
+    return local_ids.contiguous()
+
+
+def humming_expert_outputs(
+    layer: MuseSpark1xFp4Experts,
+    hidden_states: torch.Tensor,
+    local_ids: torch.Tensor,
+) -> tuple[torch.Tensor, torch.Tensor]:
+    """Produce BF16 outputs for local expert slots in original route order."""
+    from humming.layer import HummingMethod
+
+    from sglang.kernels.ops.activation.activation import silu_and_mul
+    from sglang.srt.layers.moe.fused_moe_triton import moe_align_block_size
+
+    num_tokens, hidden_size = hidden_states.shape
+    topk = local_ids.shape[1]
+    if num_tokens == 0:
+        return hidden_states.new_empty((0, topk, hidden_size)), local_ids
+    if hidden_states.dtype != torch.bfloat16:
+        raise ValueError("Muse Humming NVFP4 expects BF16 activations")
+    flat_ids = local_ids.flatten()
+    num_slots = flat_ids.numel()
+    estimated_local_routes = max(
+        1, num_slots * layer.num_local_experts // layer.global_num_experts
+    )
+    intermediate = layer.intermediate_size_per_partition
+    activations = hidden_states.new_empty((num_slots, intermediate))
+    cache = hidden_states.new_empty((num_slots * max(2 * intermediate, hidden_size),))
+    gate_up = cache[: num_slots * 2 * intermediate].view(num_slots, 2 * intermediate)
+    outputs = cache[: num_slots * hidden_size].view(num_slots, hidden_size)
+
+    alignments = {}
+    for name, inputs, result, route_width in (
+        ("w13", hidden_states, gate_up, topk),
+        ("w2", activations, outputs, 1),
+    ):
+        tuning = next(
+            config
+            for maximum, config in layer.humming_indexed_tunings[name]
+            if estimated_local_routes <= maximum
+        )
+        block_m = tuning["block_shape"][0]
+        if block_m not in alignments:
+            alignments[block_m] = moe_align_block_size(
+                local_ids, block_m, layer.num_local_experts, ignore_invalid_expert=True
+            )
+        sorted_ids, expert_ids, padded = alignments[block_m]
+        HummingMethod.forward_layer(
+            layer,
+            inputs=inputs,
+            outputs=result,
+            sorted_ids=sorted_ids,
+            expert_ids=expert_ids,
+            num_tokens_padded=padded,
+            top_k=route_width,
+            valid_shape_m=estimated_local_routes,
+            compute_config={"gemm_type": "indexed", "use_f16_accum": False},
+            tuning_config=tuning,
+            sublayer_name=name,
+        )
+        # Indexed alignment omits remote routes. Scale only the GEMM rows that
+        # were written, leaving both remote slots and expert padding untouched.
+        width = result.shape[1]
+        _scale_live_routes[(min(sorted_ids.numel(), 1024),)](
+            result,
+            getattr(layer, f"{name}_global_scale"),
+            flat_ids,
+            sorted_ids,
+            padded,
+            num_slots,
+            WIDTH=width,
+            BLOCK=triton.next_power_of_2(width),
+            num_warps=8 if width >= 4096 else 4,
+        )
+        if name == "w13":
+            silu_and_mul(gate_up, activations, expert_ids=flat_ids, expert_step=1)
+
+    return outputs.view(num_tokens, topk, hidden_size), local_ids
+
+
+def humming_grouped_expert_outputs(
+    layer: MuseSpark1xFp4Experts,
+    hidden_states: torch.Tensor,
+    local_ids: torch.Tensor,
+) -> tuple[torch.Tensor, torch.Tensor]:
+    """Return expert outputs and their original route indices for finalization."""
+    from humming.layer import HummingMethod
+
+    from sglang.kernels.ops.activation.activation import silu_and_mul
+
+    _, hidden_size = hidden_states.shape
+    topk = local_ids.shape[1]
+    route_experts, slots = local_ids.flatten().sort(stable=True)
+    experts = torch.arange(
+        layer.num_local_experts + 1, dtype=local_ids.dtype, device=local_ids.device
+    )
+    offsets = torch.searchsorted(route_experts, experts, out_int32=True)
+    first_local = offsets[0].item()
+    num_routes = slots.numel() - first_local
+    if num_routes == 0:
+        return hidden_states.new_empty((0, hidden_size)), local_ids
+
+    intermediate = layer.intermediate_size_per_partition
+    stage_width = max(hidden_size, intermediate)
+    output_width = max(2 * intermediate, hidden_size)
+    if num_routes * (stage_width + output_width) > slots.numel() * (
+        intermediate + output_width
+    ):
+        return humming_expert_outputs(layer, hidden_states, local_ids)
+
+    slots = slots[first_local:]
+    route_experts = route_experts[first_local:]
+    offsets = offsets - first_local
+    staging = hidden_states.new_empty(num_routes * stage_width)
+    inputs = staging[: num_routes * hidden_size].view(num_routes, hidden_size)
+    torch.index_select(
+        hidden_states, 0, torch.div(slots, topk, rounding_mode="floor"), out=inputs
+    )
+    activations = None
+    if getattr(layer, "humming_prompt_gate_up", None) is not None:
+        from sglang.srt.layers.muse_spark.decode_gate_up import run_gate_up
+
+        activations = run_gate_up(layer, inputs, route_experts, offsets, layer.humming_grouped_tunings["w13"], prompt=True)
+    if activations is None:
+        arena = hidden_states.new_empty(num_routes * output_width)
+        gate_up = arena[: num_routes * 2 * intermediate].view(num_routes, 2 * intermediate)
+        activations = staging[: num_routes * intermediate].view(num_routes, intermediate)
+        outputs = arena[: num_routes * hidden_size].view(num_routes, hidden_size)
+        phases = (("w13", inputs, gate_up), ("w2", activations, outputs))
+    else:
+        outputs = inputs
+        phases = (("w2", activations, outputs),)
+    route_experts = route_experts.long()
+    for name, source, destination in phases:
+        HummingMethod.forward_layer(
+            layer,
+            inputs=source,
+            outputs=destination,
+            expert_layout=offsets,
+            compute_config=_GROUPED_COMPUTE,
+            tuning_config=layer.humming_grouped_tunings[name],
+            sublayer_name=name,
+        )
+        scales = getattr(layer, f"{name}_global_scale").index_select(0, route_experts)
+        destination.mul_(scales.unsqueeze(1))
+        if name == "w13":
+            silu_and_mul(gate_up, activations)
+
+    mapped_rows = torch.full_like(local_ids, -1)
+    mapped_rows.view(-1).index_copy_(
+        0,
+        slots,
+        torch.arange(num_routes, dtype=mapped_rows.dtype, device=mapped_rows.device),
+    )
+    return outputs, mapped_rows
