+"""Read long FP8 causal prompts from the exact values the physical cache writer receives."""
+import torch
+
+from sglang.srt.layers.radix_attention import AttentionType
+from sglang.srt.mem_cache.memory_pool import MHATokenToKVPool
+from sglang.srt.mem_cache.swa_memory_pool import SWAKVPool
+from sglang.srt.model_executor.forward_batch_info import ForwardMode
+from sglang.srt.model_executor.runner_utils.prefill_graph import (
+    get_prefill_raw_num_tokens,
+    is_in_full_prefill_graph,
+    is_in_prefill_graph_scope,
+)
+
+
+def supports_direct_prompt_pool(pool, dtype):
+    if type(pool) is SWAKVPool and pool.swa_req_ring_size is not None:
+        return False
+    owners = (pool.full_kv_pool, pool.swa_kv_pool) if type(pool) is SWAKVPool else (pool,)
+    return all(type(o) is MHATokenToKVPool and o.dtype == dtype and o.kv_cache_layout == "nhd"
+               and not o.is_quantized_kv_cache and not o.requires_physical_write_loc for o in owners)
+
+
+def prepare_direct_prompt_kv(backend, q, k, v, layer, batch, write, k_scale, v_scale):
+    metadata = backend.forward_metadata
+    if (
+        batch.forward_mode != ForwardMode.EXTEND or batch.batch_size != 1 or batch.dcp_kv_mask is not None
+        or metadata is backend.full_cg_prefill_metadata or metadata.image_token_ranges is not None
+        or metadata.swa_spec_metadata is not None or layer.is_cross_attention
+        or layer.attn_type in (AttentionType.ENCODER_ONLY, AttentionType.DECODER_BIDIRECTIONAL)
+        or torch.compiler.is_compiling() or not k.is_cuda or torch.cuda.is_current_stream_capturing()
+        or torch.are_deterministic_algorithms_enabled() or torch.is_grad_enabled()
+    ):
+        return None
+    rows, prefixes = batch.extend_seq_lens_cpu, batch.extend_prefix_lens_cpu
+    if (not isinstance(rows, (list, tuple)) or not isinstance(prefixes, (list, tuple))
+            or len(rows) != 1 or len(prefixes) != 1
+            or type(rows[0]) is not int or type(prefixes[0]) is not int):
+        return None
+    n, prefix = rows[0], prefixes[0]
+    if is_in_prefill_graph_scope():
+        # Warmup and capture construct synthetic rows at slot zero. Live Breakable replay
+        # supplies the current request's raw row count before narrowing the captured operands.
+        if is_in_full_prefill_graph() or get_prefill_raw_num_tokens() != n:
+            return None
+    elif batch.req_pool_indices_cpu is None:
+        # Ordinary scheduling publishes this CPU mirror when allocating and mapping request slots.
+        return None
+    width = layer.sliding_window_size
+    halo = min(prefix, width) if width is not None and width >= 0 else prefix
+    pool = backend.token_to_kv_pool
+    table, slots, owner = metadata.page_table, write.loc, pool
+    if type(pool) is SWAKVPool:
+        _, sliding = pool.layers_mapping[layer.layer_id]
+        owner = pool.swa_kv_pool if sliding else pool.full_kv_pool
+        if sliding:
+            table, slots = metadata.swa_page_table, write.swa_loc
+    h, d = layer.tp_k_head_num, layer.head_dim
+    lengths, cuq = metadata.cache_seqlens_int32, metadata.cu_seqlens_q
+    if (
+        n < 4096 or prefix < 0 or n != metadata.max_seq_len_q or n != q.shape[0]
+        or batch.seq_lens_cpu is None or n + prefix != metadata.max_seq_len_k or (n + halo) * h * d * 2 > 32 * 1024 * 1024
