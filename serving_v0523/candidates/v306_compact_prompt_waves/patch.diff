index 0000000..a49e4fc
--- /dev/null
+++ b/python/sglang/kernels/ops/attention/paged_verify_attention.py
@@ -0,0 +1,434 @@
+"""Split-KV causal verification with a tile partition shared across requests."""
+
+import math
+
+import torch
+import triton
+import triton.language as tl
+
+try:
+    from triton.tools.tensor_descriptor import TensorDescriptor
+except ImportError:
+    TensorDescriptor = None
+
+
+@triton.jit
+def _tile_geometry(length, q_length, WINDOW_LEFT: tl.constexpr, TILE_N: tl.constexpr):
+    first_tile = tl.full((), 0, tl.int32)
+    if WINDOW_LEFT >= 0:
+        first_tile = tl.maximum(length - q_length - WINDOW_LEFT, 0) // TILE_N
+    count = tl.where(q_length > 0, tl.cdiv(length, TILE_N) - first_tile, 0)
+    return first_tile, count
+
+
+@triton.jit
+def _plan(
+    Lengths,
+    CuQ,
+    B: tl.constexpr,
+    PARTITIONS: tl.constexpr,
+    WINDOW_LEFT: tl.constexpr,
+    TILE_N: tl.constexpr,
+    BLOCK_B: tl.constexpr,
+):
+    row = tl.arange(0, BLOCK_B)
+    length = tl.load(Lengths + row, row < B, other=0)
+    q_start = tl.load(CuQ + row, row < B, other=0)
+    q_end = tl.load(CuQ + row + 1, row < B, other=0)
+    _, counts = _tile_geometry(length, q_end - q_start, WINDOW_LEFT, TILE_N)
+    ends = tl.cumsum(counts)
+    total_tiles = tl.sum(counts)
+    tiles_per_partition = tl.maximum(1, tl.cdiv(total_tiles, PARTITIONS))
+    return row, ends, total_tiles, tiles_per_partition
+
+
+@triton.jit
+def _indexed_tile(
+    K, V, Pages, request, tokens, dims, live, kv_head,
+    PAGE_ROW_STRIDE: tl.constexpr, PAGE_SIZE: tl.constexpr,
+    K_PAGE: tl.constexpr, K_TOKEN: tl.constexpr, K_HEAD: tl.constexpr,
+    V_PAGE: tl.constexpr, V_TOKEN: tl.constexpr, V_HEAD: tl.constexpr,
+):
+    page = tl.load(
+        Pages + request * PAGE_ROW_STRIDE + tokens // PAGE_SIZE,
+        live,
+        other=0,
+    ).to(tl.int64)
+    within_page = tokens % PAGE_SIZE
+    k_rows = page * K_PAGE + within_page * K_TOKEN + kv_head * K_HEAD
+    v_rows = page * V_PAGE + within_page * V_TOKEN + kv_head * V_HEAD
+    keys = tl.load(
+        K + k_rows[None, :] + dims[:, None], live[None, :], other=0.0
+    )
+    values = tl.load(
+        V + v_rows[:, None] + dims[None, :], live[:, None], other=0.0
+    ).to(tl.bfloat16)
+    return keys, values
+
+
+@triton.jit
+def _accumulate_tiles(
+    K, V, Pages, Origins, KDesc, VDesc, request, kv_head, tile_start, tile_end,
+    length, q_length, q_positions, q_live, query, dims, scale,
+    PAGE_ROW_STRIDE: tl.constexpr, PAGE_SIZE: tl.constexpr,
+    K_PAGE: tl.constexpr, K_TOKEN: tl.constexpr, K_HEAD: tl.constexpr,
+    V_PAGE: tl.constexpr, V_TOKEN: tl.constexpr, V_HEAD: tl.constexpr,
+    WINDOW_LEFT: tl.constexpr, TILE_N: tl.constexpr, TILE_M: tl.constexpr,
+    D: tl.constexpr, ORIGIN_STRIDE: tl.constexpr, DIRECT: tl.constexpr,
+):
+    row_max = tl.full((TILE_M,), float("-inf"), tl.float32)
+    row_sum = tl.zeros((TILE_M,), tl.float32)
+    acc = tl.zeros((TILE_M, D), tl.float32)
+    for tile in tl.range(tile_start, tile_end, num_stages=2):
+        tokens = tile * TILE_N + tl.arange(0, TILE_N)
+        live = tokens < length
+        if WINDOW_LEFT >= 0:
+            # The first tile can straddle already freed SWA rows.
+            live &= tokens >= tl.maximum(length - q_length - WINDOW_LEFT, 0)
+        if DIRECT:
+            origin = tl.load(Origins + request * ORIGIN_STRIDE + tile)
+            keys = tl.trans(KDesc.load([origin, kv_head * D]))
+            values = VDesc.load([origin, kv_head * D]).to(tl.bfloat16)
+        else:
+            keys, values = _indexed_tile(
+                K, V, Pages, request, tokens, dims, live, kv_head,
+                PAGE_ROW_STRIDE, PAGE_SIZE, K_PAGE, K_TOKEN, K_HEAD,
+                V_PAGE, V_TOKEN, V_HEAD,
+            )
+        scores = tl.dot(query, keys, max_num_imprecise_acc=0) * scale
+        visible = q_live[:, None] & live[None, :]
+        visible &= tokens[None, :] <= q_positions[:, None]
+        if WINDOW_LEFT >= 0:
+            visible &= tokens[None, :] >= (q_positions - WINDOW_LEFT)[:, None]
+        scores = tl.where(visible, scores, float("-inf"))
+        next_max = tl.maximum(row_max, tl.max(scores, axis=1))
+        base = tl.where(next_max == float("-inf"), 0.0, next_max)
+        old_weight = tl.exp2(row_max - base)
+        probabilities = tl.exp2(scores - base[:, None])
+        acc = tl.dot(
+            probabilities.to(tl.bfloat16), values, acc * old_weight[:, None]
+        )
+        row_sum = row_sum * old_weight + tl.sum(probabilities, axis=1)
+        row_max = next_max
+    return row_max, row_sum, acc
+
+
+@triton.jit
+def _partition_attention(
+    Q,
+    K,
+    V,
+    Pages,
+    Lengths,
+    CuQ,
+    KScale,
+    Partial,
+    LSE,
+    PAGE_ROW_STRIDE: tl.constexpr,
+    PAGE_SIZE: tl.constexpr,
+    K_PAGE: tl.constexpr,
+    K_TOKEN: tl.constexpr,
+    K_HEAD: tl.constexpr,
+    V_PAGE: tl.constexpr,
+    V_TOKEN: tl.constexpr,
+    V_HEAD: tl.constexpr,
+    KS_ROW: tl.constexpr,
+    KS_HEAD: tl.constexpr,
+    B: tl.constexpr,
+    H_KV: tl.constexpr,
+    GQA: tl.constexpr,
+    D: tl.constexpr,
+    SCALE_LOG2: tl.constexpr,
+    WINDOW_LEFT: tl.constexpr,
+    MAX_Q: tl.constexpr,
+    TILE_M: tl.constexpr,
+    TILE_N: tl.constexpr,
+    PARTITIONS: tl.constexpr,
+    BLOCK_B: tl.constexpr,
+    Origins=None,
+    KDesc=None,
+    VDesc=None,
+    ORIGIN_STRIDE: tl.constexpr = 0,
+    CAPACITY: tl.constexpr = 0,
+):
+    partition = tl.program_id(0)
+    kv_head = tl.program_id(1)
+    requests, ends, total, partition_width = _plan(
+        Lengths, CuQ, B, PARTITIONS, WINDOW_LEFT, TILE_N, BLOCK_B
+    )
+    current = partition * partition_width
+    partition_end = tl.minimum(current + partition_width, total)
+    request = tl.sum(((ends <= current) & (requests < B)).to(tl.int32))
+    packed_row = tl.arange(0, TILE_M)
+    dims = tl.arange(0, D)
+    q_token = packed_row // GQA
+    q_head = kv_head * GQA + packed_row % GQA
+    while current < partition_end:
+        req_start = tl.sum(tl.where(requests == request - 1, ends, 0))
+        req_end = tl.sum(tl.where(requests == request, ends, 0))
+        if current < req_end:
+            segment_end = tl.minimum(req_end, partition_end)
+            length = tl.load(Lengths + request)
+            q_start = tl.load(CuQ + request)
+            q_length = tl.load(CuQ + request + 1) - q_start
+            first_tile, _ = _tile_geometry(length, q_length, WINDOW_LEFT, TILE_N)
+            tile_start = first_tile + current - req_start
+            tile_end = first_tile + segment_end - req_start
+            q_live = (q_token < q_length) & (q_token < MAX_Q)
+            q_positions = length - q_length + q_token
+            q_ids = (q_start + q_token) * (H_KV * GQA) + q_head
+            query = tl.load(
+                Q + q_ids[:, None] * D + dims[None, :], q_live[:, None], other=0.0
+            )
+            scale = SCALE_LOG2
+            if KScale is not None:
+                scale *= tl.load(KScale + request * KS_ROW + kv_head * KS_HEAD)
+            if Origins is None:
+                row_max, row_sum, acc = _accumulate_tiles(
+                    K, V, Pages, Origins, KDesc, VDesc, request, kv_head, tile_start, tile_end,
+                    length, q_length, q_positions, q_live, query, dims, scale,
+                    PAGE_ROW_STRIDE, PAGE_SIZE, K_PAGE, K_TOKEN, K_HEAD, V_PAGE, V_TOKEN, V_HEAD,
+                    WINDOW_LEFT, TILE_N, TILE_M, D, ORIGIN_STRIDE, False,
+                )
+            else:
+                # Keep the load pipelines separate. One fragment selects the indexed loop for this segment.
+                direct = tl.full((), True, tl.int1)
+                for i in range(tile_start, tile_end, 32):
+                    group = i + tl.arange(0, 32)
+                    valid = group < tile_end
+                    origins = tl.load(Origins + request * ORIGIN_STRIDE + group, valid, other=1)
+                    fits = (origins > 0) & (origins <= CAPACITY - TILE_N)
+                    direct &= tl.min((~valid | fits).to(tl.int32), 0) != 0
+                if direct:
+                    row_max, row_sum, acc = _accumulate_tiles(
+                        K, V, Pages, Origins, KDesc, VDesc, request, kv_head, tile_start, tile_end,
+                        length, q_length, q_positions, q_live, query, dims, scale,
+                        PAGE_ROW_STRIDE, PAGE_SIZE, K_PAGE, K_TOKEN, K_HEAD, V_PAGE, V_TOKEN, V_HEAD,
+                        WINDOW_LEFT, TILE_N, TILE_M, D, ORIGIN_STRIDE, True,
+                    )
+                else:
+                    row_max, row_sum, acc = _accumulate_tiles(
+                        K, V, Pages, Origins, KDesc, VDesc, request, kv_head, tile_start, tile_end,
+                        length, q_length, q_positions, q_live, query, dims, scale,
+                        PAGE_ROW_STRIDE, PAGE_SIZE, K_PAGE, K_TOKEN, K_HEAD, V_PAGE, V_TOKEN, V_HEAD,
+                        WINDOW_LEFT, TILE_N, TILE_M, D, ORIGIN_STRIDE, False,
+                    )
+            # Intersections of two sorted interval partitions fit in P+B-1
+            # slots. Along the key stream, partition+request strictly increases
+            # at each distinct nonempty intersection.
+            slot = ((partition + request) * H_KV + kv_head) * TILE_M + packed_row
+            row_lse = row_max + tl.log2(tl.where(row_sum > 0, row_sum, 1.0))
+            tl.store(LSE + slot, row_lse)
+            tl.store(
+                Partial + slot[:, None] * D + dims[None, :],
+                acc / tl.where(row_sum > 0, row_sum, 1.0)[:, None],
+            )
+            current = segment_end
+        request += 1
+
+
+@triton.jit
+def _merge_partitions(
+    Partial,
+    LSE,
+    Lengths,
+    CuQ,
+    VScale,
+    Out,
+    VS_ROW: tl.constexpr,
+    VS_HEAD: tl.constexpr,
+    B: tl.constexpr,
+    H_KV: tl.constexpr,
+    GQA: tl.constexpr,
+    D: tl.constexpr,
+    WINDOW_LEFT: tl.constexpr,
+    TILE_M: tl.constexpr,
+    TILE_N: tl.constexpr,
+    PARTITIONS: tl.constexpr,
+    BLOCK_B: tl.constexpr,
+    BLOCK_SPLITS: tl.constexpr,
+):
+    request = tl.program_id(0)
+    kv_head = tl.program_id(1)
+    packed_row = tl.program_id(2)
+    q_start = tl.load(CuQ + request)
+    q_length = tl.load(CuQ + request + 1) - q_start
+    q_token = packed_row // GQA
+    if q_token >= q_length:
+        return
+
+    requests, ends, _, width = _plan(
+        Lengths, CuQ, B, PARTITIONS, WINDOW_LEFT, TILE_N, BLOCK_B
+    )
+    req_start = tl.sum(tl.where(requests == request - 1, ends, 0))
+    req_end = tl.sum(tl.where(requests == request, ends, 0))
+    split_begin = req_start // width
+    split_end = (req_end - 1) // width + 1
+    dims = tl.arange(0, D)
+    max_lse = tl.full((), float("-inf"), tl.float32)
+    den = tl.full((), 0.0, tl.float32)
+    output = tl.zeros((D,), tl.float32)
+    if req_start < req_end:
+        for start in range(split_begin, split_end, BLOCK_SPLITS):
+            parts = start + tl.arange(0, BLOCK_SPLITS)
+            live = parts < split_end
+            slots = ((parts + request) * H_KV + kv_head) * TILE_M + packed_row
+            lse = tl.load(LSE + slots, live, other=float("-inf"))
+            partial = tl.load(
+                Partial + slots[:, None] * D + dims[None, :],
+                live[:, None],
+                other=0.0,
+            )
+            next_max = tl.maximum(max_lse, tl.max(lse, axis=0))
+            base = tl.where(next_max == float("-inf"), 0.0, next_max)
+            weights = tl.exp2(lse - base)
+            old_weight = tl.exp2(max_lse - base)
+            output = output * old_weight + tl.sum(weights[:, None] * partial, axis=0)
+            den = den * old_weight + tl.sum(weights, axis=0)
+            max_lse = next_max
+    output /= tl.where(den > 0, den, 1.0)
+    if VScale is not None:
+        output *= tl.load(VScale + request * VS_ROW + kv_head * VS_HEAD)
+    q_head = kv_head * GQA + packed_row % GQA
+    q_row = (q_start + q_token) * (H_KV * GQA) + q_head
+    tl.store(Out + q_row * D + dims, output)
+
+
+def _direct_tile_args(k, v, page_table, origins, window_left, tile_n):
+    if origins is None or TensorDescriptor is None or window_left >= 0 or tile_n != 128:
+        return {}
+    slots, page_size, heads, dim = k.shape
+    if (
+        page_size != 1 or dim != 64 or k.dtype != torch.float8_e4m3fn
+        or not 128 <= slots < 2 ** 31 or heads * dim >= 2 ** 31
+        or origins.shape != (page_table.shape[0], triton.cdiv(page_table.shape[1], 128))
+        or origins.dtype != torch.int32 or origins.stride(1) != 1 or origins.device != k.device
+        or not k.is_cuda or v.device != k.device or v.dtype != k.dtype or v.shape != k.shape
+        or torch.compiler.is_compiling()
+    ):
+        return {}
+    for bank in (k, v):
+        if (
+            bank.stride(2) != dim or bank.stride(3) != 1 or bank.data_ptr() % 16
+            or not heads * dim <= bank.stride(0) < 2 ** 40 or bank.stride(0) % 16
+        ):
+            return {}
+    shape = [slots, heads * dim]
+    return dict(
+        Origins=origins, ORIGIN_STRIDE=origins.stride(0), CAPACITY=slots,
+        KDesc=TensorDescriptor(k, shape, [k.stride(0), 1], [tile_n, dim]),
+        VDesc=TensorDescriptor(v, shape, [v.stride(0), 1], [tile_n, dim]),
+    )
+
+
+def paged_verify_attention(
+    q,
+    k,
+    v,
+    page_table,
+    cache_seqlens,
+    cu_seqlens_q,
+    *,
