diff --git a/python/sglang/kernels/jit/csrc/muse_spark/decode_gate_up.cuh b/python/sglang/kernels/jit/csrc/muse_spark/decode_gate_up.cuh
new file mode 100644
index 0000000..1278068
--- /dev/null
+++ b/python/sglang/kernels/jit/csrc/muse_spark/decode_gate_up.cuh
@@ -0,0 +1,103 @@
+// Appended to Humming's generated, uninstantiated grouped WGMMA translation unit.
+// The scheduler, mainloop, dequantization and BF16 shared epilogue are the vendor's.
+#ifdef MUSE_GATE_PROMPT
+constexpr uint32_t kMuseGateK = 64;
+#else
+constexpr uint32_t kMuseGateK = 128;
+#endif
+using MuseGateCtx = KernelContext<
+    MmaOpClass, Shape<0, HUMMING_SHAPE_N, HUMMING_SHAPE_K>, Shape<MUSE_GATE_M, 256, kMuseGateK>,
+    Shape<MUSE_GATE_M, 32, 64>, Shape<0, 0, 0>, FloatingPointType<16, 8, 7>,
+    FloatingPointType<4, 2, 1>, FloatingPointType<16, 8, 7>, FloatingPointType<8, 4, 3>,
+    LayerConfig, ComputeConfig, TuningConfig>;
+
+static_assert(MuseGateCtx::kNumWriteSplits == 1 && !MuseGateCtx::kUseStreamK && !MuseGateCtx::kUseTmaC);
+static_assert(MuseGateCtx::kMultiCastSize == 1 && MuseGateCtx::kWeightScaleGroupSize == 16);
+static_assert(MuseGateCtx::kIsGroupedContiguousGemm && MuseGateCtx::kUseTmaB && MuseGateCtx::kUseTmaBS);
+
+template <bool Weight>
+struct MusePackedGateLoader {
+  MuseGateCtx& ctx;
+  const void* map;
+  uint32_t col, row;
+  CUDA_INLINE MusePackedGateLoader(MuseGateCtx& ctx) : ctx(ctx), map(Weight ? ctx.params.b : ctx.params.bs) {}
+
+  CUDA_INLINE void seek(uint32_t expert, uint32_t n_tile, uint32_t k_tile) {
+    col = n_tile * (Weight ? 16 : 8);
+    row = expert * (HUMMING_SHAPE_K / 16) + k_tile * (kMuseGateK / 16);
+  }
+
+  template <bool Advance = true>
+  CUDA_INLINE void load(int4* dest, void* bar) {
+    if (ctx.load_thread_id() == 0) {
+      const auto dst = cast_smem_ptr_to_uint(dest);
+      const auto mbar = cast_smem_ptr_to_uint(bar);
+      // Physical gate/up halves are distinct planes. The TMA box packs two
+      // matching 128-channel bands consecutively in each native 256-wide row.
+      asm volatile("cp.async.bulk.tensor.4d.shared::cta.global.mbarrier::complete_tx::bytes "
+                   "[%0], [%1, {0, %2, 0, %3}], [%4];"
+                   :: "r"(dst), "l"(map), "r"(col), "r"(row), "r"(mbar) : "memory");
+    }
+    if constexpr (Advance) row += kMuseGateK / 16;
+  }
+};
+
+template <> class G2SMemoryLoaderB<MuseGateCtx> : public MusePackedGateLoader<true> {
+ public: using MusePackedGateLoader<true>::MusePackedGateLoader;
+};
+template <> class G2SMemoryLoaderBS<MuseGateCtx> : public MusePackedGateLoader<false> {
+ public: using MusePackedGateLoader<false>::MusePackedGateLoader;
+};
+
+template <> class EpilogueGmemWriter<MuseGateCtx, EpilogueArithmetic<MuseGateCtx>> {
+  MuseGateCtx& ctx;
+  int4* output;
+  uint32_t start, live, band;
+  float scale;
+
+  CUDA_INLINE int4 fragment(uint32_t row, uint32_t col) {
+    const uint32_t base = offsetof(SharedStorageType, reduce) / 128;
+    return ctx.smem.reduce[row * 8 + (col ^ ((row + base) % 8))];
+  }
+
+  CUDA_INLINE static float scaled(__nv_bfloat16 value, float scale) {
+    float product;
+    asm("mul.rn.f32 %0, %1, %2;" : "=f"(product) : "f"(__bfloat162float(value)), "f"(scale));
+    return __bfloat162float(__float2bfloat16_rn(product));
+  }
+
+ public:
+  CUDA_INLINE EpilogueGmemWriter(MuseGateCtx& ctx, EpilogueArithmetic<MuseGateCtx>&)
+      : ctx(ctx), output(reinterpret_cast<int4*>(const_cast<void*>(ctx.params.c))) {}
+
+  CUDA_INLINE void seek(uint32_t, uint32_t n_tile, uint32_t expert_end, uint32_t row_start) {
+    start = row_start;
+    live = min(static_cast<uint32_t>(MUSE_GATE_M), expert_end - start);
+    band = n_tile * 16;
+    const auto* scales = static_cast<const __nv_bfloat16*>(ctx.params.bs2);
+#ifdef MUSE_GATE_PROMPT
+    scale = __bfloat162float(scales[ctx.params.expert_ids_ptr[start]]);
+#else
+    // The grouped ABI has no indexed top-k. Its scalar parameter carries the packed-key shift.
+    scale = __bfloat162float(scales[(uint32_t(ctx.params.expert_ids_ptr[start]) >> ctx.params.top_k) - 1]);
+#endif
+  }
+
+  CUDA_INLINE void write(uint32_t, uint32_t, uint32_t) {
+    constexpr uint32_t pitch = HUMMING_SHAPE_N / 2 / 8;
+    for (uint32_t i = threadIdx.x; i < MUSE_GATE_M * 16; i += MuseGateCtx::kNumMathThreads) {
+      const uint32_t s = i / 8, col = i % 8, row = s % MUSE_GATE_M;
+      if (row >= live) continue;
+      auto gate = fragment(s, col);
+      auto up = fragment(s + 2 * MUSE_GATE_M, col);
+      auto* g = reinterpret_cast<__nv_bfloat16*>(&gate);
+      auto* u = reinterpret_cast<__nv_bfloat16*>(&up);
+      PRAGMA_UNROLL
+      for (int j = 0; j < 8; ++j) {
+        const float x = scaled(g[j], scale), y = scaled(u[j], scale);
+        g[j] = __float2bfloat16_rn((x / (1.0f + expf(-x))) * y);
+      }
+      output[static_cast<uint64_t>(start + row) * pitch + band + s / MUSE_GATE_M * 8 + col] = gate;
+    }
+  }
+};
diff --git a/python/sglang/kernels/jit/csrc/muse_spark/decode_gate_up_launch.cuh b/python/sglang/kernels/jit/csrc/muse_spark/decode_gate_up_launch.cuh
new file mode 100644
index 0000000..9f5d236
--- /dev/null
+++ b/python/sglang/kernels/jit/csrc/muse_spark/decode_gate_up_launch.cuh
@@ -0,0 +1,112 @@
+#include <sgl_kernel/tensor.h>
+#include <sgl_kernel/utils.cuh>
+#include <cuda.h>
+#include <cstring>
+#include <limits>
+
+namespace sglang {
+struct MuseDecodeGateUp {
+  using Tensor = tvm::ffi::TensorView;
+  struct Maps { CUtensorMap weight, scale; };
+
+  template <bool Prompt>
+  static bool bank_map(Tensor bank, uint64_t inner, bool weight, CUtensorMap* out) {
+    const cuuint64_t x = weight ? inner / 8 : inner / 16;
+    const cuuint64_t dims[] = {16, x, 2, uint64_t(bank.size(0)) * bank.size(1)};
+    const cuuint64_t stride[] = {weight ? 64u : 16u, (weight ? 64u : 16u) * x, (weight ? 128u : 32u) * x};
+    const cuuint32_t box[] = {16, weight ? 16u : 8u, 2, Prompt ? 4u : 8u}, step[] = {1, 1, 1, 1};
+    return cuTensorMapEncodeTiled(out, weight ? CU_TENSOR_MAP_DATA_TYPE_UINT32 : CU_TENSOR_MAP_DATA_TYPE_UINT8,
+        4, bank.data_ptr(), dims, stride, box, step, CU_TENSOR_MAP_INTERLEAVE_NONE, CU_TENSOR_MAP_SWIZZLE_NONE,
+        CU_TENSOR_MAP_L2_PROMOTION_NONE, CU_TENSOR_MAP_FLOAT_OOB_FILL_NONE) == CUDA_SUCCESS;
+  }
+
+  static void check_storage(Tensor storage) {
+    host::TensorMatcher({int64_t(sizeof(Maps))}).with_dtype<uint8_t>().with_device<kDLCPU>().verify(storage);
+  }
+
+  template <bool Prompt>
+  static bool prepare(Tensor bank, Tensor scales, Tensor storage) {
+    check_storage(storage);
+    if (!bank.IsContiguous() || !scales.IsContiguous() || bank.ndim() != 3 || scales.ndim() != 3
+        || bank.device().device_type != kDLCUDA || scales.device().device_type != kDLCUDA
+        || scales.device().device_id != bank.device().device_id || bank.size(0) != scales.size(0)
+        || bank.size(1) != scales.size(1) || bank.size(2) != 2 * scales.size(2)
+        || bank.dtype().code != kDLInt || bank.dtype().bits != 32 || scales.dtype().code != kDLUInt || scales.dtype().bits != 8
+        || scales.size(2) % 256 || scales.size(2) < 256 || bank.size(0) <= 0 || bank.size(1) <= 0
+        || bank.size(0) > INT32_MAX / bank.size(1)) return false;
+    Maps maps{};
+    const auto inner = scales.size(2) / 2;
+    if (!bank_map<Prompt>(bank, inner, true, &maps.weight) || !bank_map<Prompt>(scales, inner, false, &maps.scale)) return false;
+    std::memcpy(storage.data_ptr(), &maps, sizeof(maps));
+    return true;
+  }
+
+  static bool configure(int64_t function, int64_t shared) {
+    return function && shared > 0 && shared < INT32_MAX && cuFuncSetAttribute(reinterpret_cast<CUfunction>(function),
+        CU_FUNC_ATTRIBUTE_MAX_DYNAMIC_SHARED_SIZE_BYTES, static_cast<int>(shared)) == CUDA_SUCCESS;
+  }
+
+  static bool input_map(Tensor input, int64_t tile, CUtensorMap* map) {
+    if (input.ndim() != 2 || !input.IsContiguous() || tile <= 0 || tile > 256) return false;
+    const cuuint64_t dims[] = {uint64_t(input.size(1)), uint64_t(input.size(0))}, stride[] = {2 * dims[0]};
+    const cuuint32_t box[] = {64, uint32_t(tile)}, step[] = {1, 1};
+    return cuTensorMapEncodeTiled(map, CU_TENSOR_MAP_DATA_TYPE_BFLOAT16, 2, input.data_ptr(), dims, stride, box, step,
+        CU_TENSOR_MAP_INTERLEAVE_NONE, CU_TENSOR_MAP_SWIZZLE_128B, CU_TENSOR_MAP_L2_PROMOTION_NONE,
+        CU_TENSOR_MAP_FLOAT_OOB_FILL_NONE) == CUDA_SUCCESS;
+  }
+
+  // The graph reuses the same packed input allocation in every iteration.
+  static bool prepare_wave(Tensor input, Tensor banks, Tensor wave, int64_t tile) {
+    check_storage(banks);
+    host::TensorMatcher({int64_t(sizeof(Maps) + sizeof(CUtensorMap))}).with_dtype<uint8_t>().with_device<kDLCPU>().verify(wave);
+    CUtensorMap map{};
+    if (!input_map(input, tile, &map)) return false;
+    std::memcpy(wave.data_ptr(), banks.data_ptr(), sizeof(Maps));
+    std::memcpy(static_cast<char*>(wave.data_ptr()) + sizeof(Maps), &map, sizeof(map));
+    return true;
+  }
+
+  template <bool Prompt, bool Wave = false>
+  static bool run(Tensor input, Tensor output, Tensor ids, Tensor offsets, Tensor scales, Tensor storage,
+                  int64_t function, int64_t shared, int64_t tile, int64_t sms) {
+    using namespace host;
+    if constexpr (Wave) {
+      TensorMatcher({int64_t(sizeof(Maps) + sizeof(CUtensorMap))}).with_dtype<uint8_t>().with_device<kDLCPU>().verify(storage);
+    } else {
+      check_storage(storage);
+    }
+    auto rows = SymbolicSize{"rows"}, k = SymbolicSize{"K"}, i = SymbolicSize{"intermediate"}, e = SymbolicSize{"experts"};
+    auto dev = SymbolicDevice{};
+    dev.set_options<kDLCUDA>();
+    TensorMatcher({rows, k}).with_dtype<bf16_t>().with_device(dev).verify(input);
+    TensorMatcher({rows, i}).with_dtype<bf16_t>().with_device(dev).verify(output);
+    TensorMatcher({rows}).with_dtype<int32_t>().with_device(dev).verify(ids);
+    TensorMatcher({e}).with_dtype<bf16_t>().with_device(dev).verify(scales);
+    TensorMatcher({e.unwrap() + 1}).with_dtype<int32_t>().with_device(dev).verify(offsets);
+    if (i.unwrap() < 128 || i.unwrap() % 128 || k.unwrap() % 128 || rows.unwrap() <= 0
+        || rows.unwrap() > INT32_MAX / (i.unwrap() / 128)
+        || tile <= 0 || tile > 256 || sms <= 0 || sms > INT32_MAX) return false;
+
+    CUtensorMap a{};
+    if constexpr (Wave) {
+      std::memcpy(&a, static_cast<const char*>(storage.data_ptr()) + sizeof(Maps), sizeof(a));
+    } else if (!input_map(input, tile, &a)) {
+      return false;
+    }
+    Maps maps{};
+    std::memcpy(&maps, storage.data_ptr(), sizeof(maps));
+    void* c = output.data_ptr(), *factor = scales.data_ptr(), *experts = ids.data_ptr(), *layout = offsets.data_ptr();
+    void* none = nullptr;
+    uint32_t m = rows.unwrap(), key_shift = 0;
+    // _plan_grouped_decode packs (local_expert + 1) above ceil(log2(slots)) bits.
+    for (uint32_t bits = m - 1; bits; bits >>= 1) ++key_shift;
+    bool int64_layout = false;
+    void* args[] = {&a, &maps.weight, &c, &none, &maps.scale, &none, &none, &factor, &none,
+                    &experts, &none, &layout, &none, &none, &m, &key_shift, &int64_layout};
+    auto stream = static_cast<CUstream>(::TVMFFIEnvGetStream(kDLCUDA, dev.unwrap().device_id));
+    const auto status = cuLaunchKernel(reinterpret_cast<CUfunction>(function), sms, 1, 1, Prompt ? 384 : 640, 1, 1, shared, stream, args, nullptr);
+    RuntimeCheck(status == CUDA_SUCCESS, "grouped gate/up launch failed: ", static_cast<int>(status));
+    return true;
+  }
+};
+}  // namespace sglang
diff --git a/python/sglang/kernels/jit/csrc/muse_spark/expert_scaled_silu.cuh b/python/sglang/kernels/jit/csrc/muse_spark/expert_scaled_silu.cuh
new file mode 100644
index 0000000..d0dffa7
--- /dev/null
+++ b/python/sglang/kernels/jit/csrc/muse_spark/expert_scaled_silu.cuh
@@ -0,0 +1,101 @@
+#include "../elementwise/activation.cuh"
+#include <algorithm>
+
+namespace sglang {
+namespace muse_expert_scaled_silu {
+
+using namespace device;
+constexpr uint32_t kThreads = 256;
+constexpr uint32_t kVecSize = kMaxVecBytes / sizeof(bf16_t);
+using Vec = AlignedVector<bf16_t, kVecSize>;
+
+struct Params {
+  const bf16_t* gate_up;
+  bf16_t* output;
+  const int32_t* row_keys;
+  const int32_t* offsets;
+  const bf16_t* scales;
+  uint32_t slots;
+  uint32_t slot_span;
+  uint32_t row_vecs;
+};
+
+SGL_DEVICE float scale_and_round(bf16_t x, float scale) {
+  const float value = cast<float>(x);
+  // The separate BF16 scale multiply preserves subnormals. The existing SiLU
+  // fast-math options below must not change this preceding rounding boundary.
+#if defined(__CUDA_ARCH__)
+  float product;
+  asm("mul.rn.f32 %0, %1, %2;" : "=f"(product) : "f"(value), "f"(scale));
+#else
+  const float product = value * scale;
+#endif
+  return cast<float>(cast<bf16_t>(product));
+}
+
+__global__ __launch_bounds__(kThreads) void run_kernel(const __grid_constant__ Params params) {
+  for (uint32_t row = params.offsets[0] + blockIdx.x; row < params.slots; row += gridDim.x) {
+    const uint32_t expert = params.row_keys[row] / params.slot_span - 1;
+    const float scale = cast<float>(params.scales[expert]);
+    const uint32_t input_base = row * 2 * params.row_vecs;
+    const uint32_t output_base = row * params.row_vecs;
+    for (uint32_t i = threadIdx.x; i < params.row_vecs; i += blockDim.x) {
+      const auto gate = load_as<Vec>(params.gate_up, input_base + i);
+      const auto up = load_as<Vec>(params.gate_up, input_base + params.row_vecs + i);
+      Vec output;
+#pragma unroll
+      for (uint32_t j = 0; j < kVecSize; ++j) {
+        const float gate_f32 = scale_and_round(gate[j], scale);
+        const float up_f32 = scale_and_round(up[j], scale);
+        output[j] = cast<bf16_t>(apply_activation_f32<ActivationKind::kSiLU>(gate_f32) * up_f32);
+      }
+      store_as<Vec>(params.output, output, output_base + i);
+    }
+  }
+}
+
+}  // namespace muse_expert_scaled_silu
+
+struct MuseExpertScaledSilu {
+  static void run(
+      tvm::ffi::TensorView gate_up,
+      tvm::ffi::TensorView output,
+      tvm::ffi::TensorView row_keys,
+      tvm::ffi::TensorView offsets,
+      tvm::ffi::TensorView scales,
+      int64_t slot_span) {
+    using namespace host;
+    using namespace muse_expert_scaled_silu;
+    auto rows = SymbolicSize{"routes"};
+    auto width = SymbolicSize{"width"};
+    auto double_width = SymbolicSize{"double_width"};
+    auto experts = SymbolicSize{"experts"};
+    auto offsets_size = SymbolicSize{"offsets_size"};
+    auto dev = SymbolicDevice{};
+    dev.set_options<kDLCUDA>();
+    TensorMatcher({rows, double_width}).with_dtype<bf16_t>().with_device(dev).verify(gate_up);
+    TensorMatcher({rows, width}).with_dtype<bf16_t>().with_device(dev).verify(output);
+    TensorMatcher({rows}).with_dtype<int32_t>().with_device(dev).verify(row_keys);
+    TensorMatcher({offsets_size}).with_dtype<int32_t>().with_device(dev).verify(offsets);
+    TensorMatcher({experts}).with_dtype<bf16_t>().with_device(dev).verify(scales);
+    RuntimeCheck(2 * width.unwrap() == double_width.unwrap(), "invalid gate/up width");
+    RuntimeCheck(width.unwrap() % kVecSize == 0, "activation width must be vector aligned");
+    RuntimeCheck(offsets_size.unwrap() == experts.unwrap() + 1, "invalid grouped offsets shape");
+    RuntimeCheck(0 < rows.unwrap() && rows.unwrap() <= slot_span, "invalid route count");
+    RuntimeCheck(slot_span <= 2048 && (slot_span & (slot_span - 1)) == 0, "invalid slot key span");
+    const auto num_rows = static_cast<uint32_t>(rows.unwrap());
+    const Params params{
+        .gate_up = static_cast<const bf16_t*>(gate_up.data_ptr()),
+        .output = static_cast<bf16_t*>(output.data_ptr()),
+        .row_keys = static_cast<const int32_t*>(row_keys.data_ptr()),
+        .offsets = static_cast<const int32_t*>(offsets.data_ptr()),
+        .scales = static_cast<const bf16_t*>(scales.data_ptr()),
+        .slots = num_rows,
+        .slot_span = static_cast<uint32_t>(slot_span),
+        .row_vecs = static_cast<uint32_t>(width.unwrap() / kVecSize),
+    };
+    LaunchKernel(std::min(num_rows, 128u), kThreads, dev.unwrap())(run_kernel, params);
+  }
+};
+
+}  // namespace sglang
diff --git a/python/sglang/kernels/jit/csrc/muse_spark/grouped_decode_mma_pair.cuh b/python/sglang/kernels/jit/csrc/muse_spark/grouped_decode_mma_pair.cuh
new file mode 100644
index 0000000..a893ad7
--- /dev/null
+++ b/python/sglang/kernels/jit/csrc/muse_spark/grouped_decode_mma_pair.cuh
@@ -0,0 +1,47 @@
+#ifdef MUSE_OVERLAP_CONTEXT
+using MuseOverlapCtx = MUSE_OVERLAP_CONTEXT;
+#else
+using MuseOverlapCtx = KernelContext<MmaOpClass, Shape<0, HUMMING_SHAPE_N, HUMMING_SHAPE_K>,
+    Shape<MUSE_OVERLAP_M, 128, 256>, Shape<MUSE_OVERLAP_M, 32, 64>, Shape<0, 0, 0>,
+    BFloat16, Float4E2M1, BFloat16, Float8E4M3, LayerConfig, ComputeConfig, TuningConfig>;
+#endif
+
+// Humming 0.1.12's BF16 grouped geometry has two independent output bands
+// per warpgroup and four K16 slices per shared stage. Consecutive operations
+// on the same FP32 accumulators retain their HGMMA program order.
+struct MuseOverlapMma : WGMMA<MuseOverlapCtx, MainloopArithmetic<MuseOverlapCtx>> {
+  using Base = WGMMA<MuseOverlapCtx, MainloopArithmetic<MuseOverlapCtx>>;
+  using Base::Base;
+  static_assert(kWarpIters == 4 && !kUsePackedKLayout && kPackedKFactor == 1 &&
+                kRegsBKDim == 1 && final_regs_c_index() == 0 && kSwizzleBytes == 128);
+  static_assert(sizeof(regs_b[0]) == 8 * sizeof(uint32_t));
+  CUDA_INLINE void run(uint32_t stage, uint32_t iteration) {
+    // The last two iterations retain the vendor's ordering at shared-stage release.
+    if (iteration >= 2) {
+      Base::run(stage, iteration);
+      return;
+    }
+    const uint32_t address = cast_smem_ptr_to_uint(&ctx.smem) + offsetof(SharedStorage, stages)
+        + stage * sizeof(typename SharedStorage::StageStorage) + iteration * 2 * sizeof(int4) + smem_offset;
+    auto desc = make_wgmma_smem_desc<kSwizzleBytes>(address);
+    wgmma_fence();
+    PRAGMA_UNROLL
+    for (int j = 0; j < 2; ++j)
+      MmaOpClass::fma(desc, regs_b[iteration][j][0], regs_c[0][j][0], true);
+    if (iteration == 1) {
+      wgmma_commit();
+      wgmma_wait<0>();
+      // Keep both register-source fragments alive through the async group's
+      // completion, including the first fragment's four-word halves.
+      PRAGMA_UNROLL
+      for (uint32_t b = 0; b < 2; ++b) {
+        auto* values = reinterpret_cast<uint32_t*>(&regs_b[b]);
+        PRAGMA_UNROLL
+        for (uint32_t i = 0; i < 8; ++i) warpgroup_fence_operand(values[i]);
+      }
+    }
+  }
+};
+template <> struct MmaSelector<MmaType::WGMMA, MuseOverlapCtx, MainloopArithmetic<MuseOverlapCtx>> {
+  using Type = MuseOverlapMma;
+};
