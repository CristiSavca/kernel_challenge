@@ -57,6 +57,40 @@ struct MuseOverlapMma : WGMMA<MuseOverlapCtx, MainloopArithmetic<MuseOverlapCtx>
     }
   }
 };
+#ifdef MUSE_FULL_K_STAGE
+// Hold all four K16 operands until the last tensor operation completes.
+struct MuseFullStageMma : MuseOverlapMma {
+  using MuseOverlapMma::MuseOverlapMma;
+  static_assert(bands == 2 && MuseOverlapCtx::BlockShape::M == 8);
+  typename MmaOpClass::BRegisters held[4][2];
+  CUDA_INLINE void run(uint32_t stage_id, uint32_t iteration) {
+    const uint32_t address = cast_smem_ptr_to_uint(&ctx.smem) + offsetof(SharedStorage, stages)
+        + stage_id * sizeof(typename SharedStorage::StageStorage) + iteration * 2 * sizeof(int4) + smem_offset;
+    auto desc = make_wgmma_smem_desc<kSwizzleBytes>(address);
+    PRAGMA_UNROLL
+    for (unsigned j = 0; j < 2; ++j)
+      PRAGMA_UNROLL
+      for (unsigned i = 0; i < 4; ++i) held[iteration][j][i] = regs_b[iteration % 2][j][0][i];
+    wgmma_fence();
+    PRAGMA_UNROLL
+    for (unsigned j = 0; j < 2; ++j)
+      MmaOpClass::fma(desc, held[iteration][j], regs_c[0][j][0], true);
+    if (iteration == 3) {
+      wgmma_commit();
+      wgmma_wait<0>();
+      PRAGMA_UNROLL
+      for (unsigned k = 0; k < 4; ++k)
+        PRAGMA_UNROLL
+        for (unsigned j = 0; j < 2; ++j)
+          PRAGMA_UNROLL
+          for (unsigned i = 0; i < 4; ++i) warpgroup_fence_operand(held[k][j][i]);
+    }
+  }
+};
+using MuseSelectedMma = MuseFullStageMma;
+#else
+using MuseSelectedMma = MuseOverlapMma;
+#endif
 template <> struct MmaSelector<MmaType::WGMMA, MuseOverlapCtx, MainloopArithmetic<MuseOverlapCtx>> {
-  using Type = MuseOverlapMma;
+  using Type = MuseSelectedMma;
 };
