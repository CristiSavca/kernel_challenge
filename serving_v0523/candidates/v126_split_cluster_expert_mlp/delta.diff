+@cache_once
+def _split_mlp_module():
+    try:
+        return load_jit(
+            "muse_split_mlp",
+            cuda_files=["muse_spark/expert_split_mlp.cuh"],
+            cuda_wrappers=[("run", "MuseSplitMLP::run"), ("supported", "MuseSplitMLP::supported")],
+            extra_cuda_cflags=get_activation_cuda_cflags(),
+        )
+    except (OSError, RuntimeError, subprocess.SubprocessError) as exc:
+        logging.getLogger(__name__).warning("Falling back to grouped Humming sparse experts: %s", exc)
+        return None
+
+
+def _sparse_cluster_grid(tokens, topk, global_experts, local_experts, sms, available):
+    if not available or tokens * topk > global_experts:
+        return 0, 0
+    p = 1.0 - (1.0 - min(1.0, topk / global_experts)) ** tokens
+    active = local_experts * p
+    # Aim for two resident blocks per SM. Splitting disjoint intermediate
+    # bands increases concurrent weight loads without replicating either bank.
+    target = 2 * sms
+    if active * 8 >= target:
+        return 0, 0
+    splits = 4 if available & 4 and (active * 16 < target or not (available & 2)) else 2
+    if not (available & splits):
+        return 0, 0
+    # Keep one standard deviation of spare clusters. Any real excess or skew
+    # consumes another grid-stride tile on the device.
+    groups = min(local_experts, max(1, math.ceil(active + math.sqrt(active * (1.0 - p)))))
+    return splits, groups
+
