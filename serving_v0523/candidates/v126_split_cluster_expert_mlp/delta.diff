+#include "expert_cluster_mlp.cuh"
+
+namespace sglang {
+namespace muse_split_mlp {
+
+using namespace device;
+using namespace muse_cluster_mlp;
+using Stripes = float4[kWarps][2][4][32];
+
+// Each warp owns one K stripe and four 16-column output fragments. Adjacent
+// stripes join in FP32 before the original projection, scale and SiLU rounds.
+template <uint32_t Splits>
+SGL_DEVICE void gate_split(const Params& p, Tile tile, uint32_t split, uint32_t rank,
+                           Stripes& partial, bf16_t* active) {
+  const uint32_t width = p.intermediate / (kCluster * Splits);
+  const uint32_t stride = width + 8;
+  const uint32_t lane = threadIdx.x % 32, warp = threadIdx.x / 32, stripe = warp % Splits;
+  const uint32_t group = warp / Splits;
+  const uint32_t gate_base = (split * kCluster + rank) * width;
+  const float scale = cast<float>(p.gate_scale[tile.expert]);
+  const bf16_t* input = p.rows + size_t(tile.first) * p.hidden;
+  for (uint32_t start = 0; start < width; start += 64 * (kWarps / Splits)) {
+    uint32_t band = start + group * 64;
+    float4 gate[4][1] = {}, up[4][1] = {};
+    if (band < width) {
+      for (uint32_t k = stripe * 16; k < p.hidden; k += Splits * 16) {
+        auto x = load_rows<1>(input, p.hidden, tile.count, k);
+        size_t base = (size_t(tile.expert) * (p.hidden / 16) + k / 16) * (2 * p.intermediate) + gate_base + band;
+        contract(gate, p.gate_up, base, x);
+        contract(up, p.gate_up, base + p.intermediate, x);
+      }
+#pragma unroll
+      for (uint32_t part = 0; part < 4; ++part) {
+        partial[warp][0][part][lane] = gate[part][0];
+        partial[warp][1][part][lane] = up[part][0];
+      }
+    }
+    __syncthreads();
+    if (band < width) {
+#pragma unroll
+      for (uint32_t part = stripe; part < 4; part += Splits) {
+        float4 g{}, u{};
+#pragma unroll
+        for (uint32_t s = 0; s < Splits; ++s) {
+          float4 a = partial[group * Splits + s][0][part][lane];
+          float4 b = partial[group * Splits + s][1][part][lane];
+          g.x += a.x; g.y += a.y; g.z += a.z; g.w += a.w;
+          u.x += b.x; u.y += b.y; u.z += b.z; u.w += b.w;
+        }
+        float gs[] = {g.x, g.y, g.z, g.w}, us[] = {u.x, u.y, u.z, u.w};
+#pragma unroll
+        for (uint32_t i = 0; i < 4; ++i) {
+          uint32_t row = (lane % 4) * 2 + i % 2;
+          uint32_t col = band + part * 16 + lane / 4 + (i / 2) * 8;
+          if (row < tile.count) {
+            float gval = muse_expert_scaled_silu::scale_and_round(cast<bf16_t>(gs[i]), scale);
+            float uval = muse_expert_scaled_silu::scale_and_round(cast<bf16_t>(us[i]), scale);
+            active[row * stride + col] = cast<bf16_t>(apply_activation_f32<ActivationKind::kSiLU>(gval) * uval);
+          }
+        }
+      }
+    }
+    __syncthreads();
+  }
+}
+
+template <uint32_t Splits>
+SGL_DEVICE void down_split(const Params& p, Tile tile, uint32_t split, uint32_t rank,
+                           bf16_t* active, float* partial_rows) {
+  auto cluster = cooperative_groups::this_cluster();
+  const uint32_t width = p.hidden / kCluster;
+  const uint32_t inner = p.intermediate / (Splits * kCluster);
+  const uint32_t lane = threadIdx.x % 32;
+  for (uint32_t band = threadIdx.x / 32 * 64; band < width; band += kWarps * 64) {
+    const uint32_t column = rank * width + band;
+    float4 down[4][1] = {};
+    for (uint32_t peer = 0; peer < kCluster; ++peer) {
+      const bf16_t* values = cluster.map_shared_rank(active, peer);
+      const uint32_t part_k = (split * kCluster + peer) * inner;
+      for (uint32_t k = 0; k < inner; k += 16) {
+        auto x = load_rows<1>(values, inner + 8, tile.count, k);
+        size_t base = (size_t(tile.expert) * (p.intermediate / 16) + (part_k + k) / 16) * p.hidden + column;
+        contract(down, p.down, base, x);
+      }
+    }
+#pragma unroll
+    for (uint32_t part = 0; part < 4; ++part) {
+      const auto d = down[part][0];
+      float results[] = {d.x, d.y, d.z, d.w};
+#pragma unroll
+      for (uint32_t i = 0; i < 4; ++i) {
+        uint32_t row = (lane % 4) * 2 + i % 2;
+        uint32_t col = column + part * 16 + lane / 4 + (i / 2) * 8;
+        if (row < tile.count) partial_rows[size_t(tile.first + row) * p.hidden + col] = results[i];
+      }
+    }
+  }
+}
+
+template <uint32_t Splits>
+__global__ __launch_bounds__(32 * kWarps) void split_kernel(
+    const __grid_constant__ Params p, float* partials, uint32_t slots) {
+  __shared__ Stripes stripes;
+  extern __shared__ __align__(16) unsigned char storage[];
+  auto* active = reinterpret_cast<bf16_t*>(storage);
+  auto cluster = cooperative_groups::this_cluster();
+  uint32_t rank = cluster.block_rank(), split = blockIdx.z;
+  float* out = partials + size_t(split) * slots * p.hidden;
+  for (uint32_t job = blockIdx.y;; job += gridDim.y) {
+    Tile tile = locate(p, job);
+    if (!tile.count) return;
+    for (uint32_t i = 0; i < tile.count; i += 8) {
+      Tile rows{tile.expert, tile.first + i, min(8u, tile.count - i)};
+      gate_split<Splits>(p, rows, split, rank, stripes, active);
+      cluster.sync();
+      down_split<Splits>(p, rows, split, rank, active, out);
+      cluster.sync();
+    }
+  }
+}
+}  // namespace muse_split_mlp
+
+struct MuseSplitMLP {
+  template <uint32_t Splits>
+  static bool fits(int64_t hidden, int64_t inner, int64_t experts, int sms, int shared_limit) {
+    using namespace muse_split_mlp;
+    if (hidden % (kCluster * 64) || inner % (kCluster * Splits * 64)) return false;
+    size_t bytes = 8 * (inner / (kCluster * Splits) + 8) * sizeof(bf16_t);
+    if (sizeof(Stripes) + bytes > static_cast<size_t>(shared_limit) || experts * Splits * kCluster < sms) return false;
+    cudaLaunchAttribute attr{};
+    attr.id = cudaLaunchAttributeClusterDimension;
+    attr.val.clusterDim = {kCluster, 1, 1};
+    cudaLaunchConfig_t cfg{};
+    cfg.gridDim = dim3(kCluster, static_cast<uint32_t>(experts), Splits);
+    cfg.blockDim = dim3(32 * kWarps, 1, 1);
+    cfg.dynamicSmemBytes = bytes;
+    cfg.attrs = &attr;
+    cfg.numAttrs = 1;
+    int resident = 0;
+    auto status = cudaOccupancyMaxActiveClusters(&resident, split_kernel<Splits>, &cfg);
+    if (status == cudaErrorInvalidValue || status == cudaErrorInvalidConfiguration ||
+        status == cudaErrorInvalidClusterSize || status == cudaErrorLaunchOutOfResources || status == cudaErrorNotSupported) {
+      (void)cudaGetLastError();
+      return false;
+    }
+    CHECK_CUDA(status);
+    return resident > 0;
+  }
+
+  static int64_t supported(int64_t device, int64_t hidden, int64_t inner, int64_t experts) {
+    int current = -1, capable = 0, sms = 0, shared_limit = 0;
+    CHECK_CUDA(cudaGetDevice(&current));
+    if (current != device || hidden <= 0 || inner <= 0 || experts <= 0) return 0;
+    CHECK_CUDA(cudaDeviceGetAttribute(&capable, cudaDevAttrClusterLaunch, current));
+    if (!capable) return 0;
+    CHECK_CUDA(cudaDeviceGetAttribute(&sms, cudaDevAttrMultiProcessorCount, current));
+    CHECK_CUDA(cudaDeviceGetAttribute(&shared_limit, cudaDevAttrMaxSharedMemoryPerBlock, current));
+    return (fits<2>(hidden, inner, experts, sms, shared_limit) ? 2 : 0) |
+           (fits<4>(hidden, inner, experts, sms, shared_limit) ? 4 : 0);
+  }
+
+  static void run(tvm::ffi::TensorView rows, tvm::ffi::TensorView gate, tvm::ffi::TensorView gs,
+                  tvm::ffi::TensorView down, tvm::ffi::TensorView ds, tvm::ffi::TensorView global,
+                  tvm::ffi::TensorView offsets, tvm::ffi::TensorView partials, int64_t workgroups) {
+    using namespace host;
+    using namespace muse_split_mlp;
+    auto m = SymbolicSize{"rows"}, h = SymbolicSize{"hidden"}, e = SymbolicSize{"experts"}, s = SymbolicSize{"splits"};
+    auto kg = SymbolicSize{"gate groups"}, wg = SymbolicSize{"gate words"}, ng = SymbolicSize{"gate width"};
+    auto kd = SymbolicSize{"down groups"}, wd = SymbolicSize{"down words"}, ends = SymbolicSize{"offsets"};
+    auto dev = SymbolicDevice{};
+    dev.set_options<kDLCUDA>();
+    TensorMatcher({m, h}).with_dtype<bf16_t>().with_device(dev).verify(rows);
+    TensorMatcher({s, m, h}).with_dtype<float>().with_device(dev).verify(partials);
+    TensorMatcher({e, kg, wg}).with_dtype<int32_t>().with_device(dev).verify(gate);
+    TensorMatcher({e, kd, wd}).with_dtype<int32_t>().with_device(dev).verify(down);
+    TensorMatcher({e, kg, ng}).with_dtype<uint8_t>().with_device(dev).verify(gs);
+    TensorMatcher({e, kd, h}).with_dtype<uint8_t>().with_device(dev).verify(ds);
+    TensorMatcher({e}).with_dtype<bf16_t>().with_device(dev).verify(global);
+    TensorMatcher({ends}).with_dtype<int32_t>().with_device(dev).verify(offsets);
+    const auto inner = kd.unwrap() * 16, splits = s.unwrap();
+    RuntimeCheck(kg.unwrap() * 16 == h.unwrap() && wd.unwrap() == 2 * h.unwrap() &&
+                 ng.unwrap() == 2 * inner && wg.unwrap() == 4 * inner, "incompatible expert banks");
+    RuntimeCheck((splits == 2 || splits == 4) && h.unwrap() % (64 * kCluster) == 0 &&
+                 inner % (64 * kCluster * splits) == 0 && m.unwrap() > 0 &&
+                 workgroups > 0 && workgroups <= e.unwrap() && ends.unwrap() == e.unwrap() + 1,
+                 "invalid split expert geometry");
+    const Params p{
+        static_cast<bf16_t*>(rows.data_ptr()),
+        {static_cast<const uint32_t*>(gate.data_ptr()), static_cast<const uint8_t*>(gs.data_ptr())},
+        {static_cast<const uint32_t*>(down.data_ptr()), static_cast<const uint8_t*>(ds.data_ptr())},
+        static_cast<const bf16_t*>(global.data_ptr()), static_cast<const int32_t*>(offsets.data_ptr()),
+        static_cast<uint32_t>(h.unwrap()), static_cast<uint32_t>(inner), static_cast<uint32_t>(e.unwrap())};
+    const size_t bytes = 8 * (inner / (splits * kCluster) + 8) * sizeof(bf16_t);
+    auto launch = LaunchKernel(dim3(kCluster, static_cast<uint32_t>(workgroups), splits), 32 * kWarps, dev.unwrap(), bytes);
+    launch.enable_cluster(dim3(kCluster, 1, 1));
+    auto* dst = static_cast<float*>(partials.data_ptr());
+    uint32_t slots = static_cast<uint32_t>(m.unwrap());
+    if (splits == 2) launch(split_kernel<2>, p, dst, slots);
+    else launch(split_kernel<4>, p, dst, slots);
+  }
+};
+}  // namespace sglang
