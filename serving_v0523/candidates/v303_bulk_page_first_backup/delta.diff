+def registered_kv_row_ends(buffer: torch.Tensor, rows: int, row_bytes: int) -> tuple[int, ...]:
+    """Cut page-first K and V copies at the union of both planes' host registrations."""
+    ranges = getattr(buffer, _CUDA_HOST_REGISTERED_RANGES_ATTR, ())
+    if not ranges or not buffer.is_contiguous() or buffer.device.type != "cpu" or rows <= 0 or row_bytes <= 0:
+        return ()
+    plane = rows * row_bytes
+    if buffer.nbytes != 2 * plane:
+        return ()
+    base = buffer.data_ptr()
+    covered = 0
+    ends = {rows}
+    for ptr, size in ranges:
+        if ptr != base + covered or size <= 0 or size % row_bytes:
+            return ()
+        covered += size
+        row = (covered % plane) // row_bytes
+        if row:
+            ends.add(row)
+    return tuple(sorted(ends)) if covered == buffer.nbytes else ()
+
+
 def has_linear_host_mapping(buffer: torch.Tensor, device: torch.device) -> bool:
     """Can one device address and a byte stride cover every host registration?"""
