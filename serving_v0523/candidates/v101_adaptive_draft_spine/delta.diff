+@triton.jit
+def _native_prefix_nodes(tokens, parents, Chain, offset, nodes, WIDTH: tl.constexpr):
+    # Use the same earliest-child rule as the real verifier.
+    leader = tl.full((), 0, tl.int32)
+    spine = nodes == 0
+    for depth in range(1, WIDTH):
+        token = tl.load(Chain + offset + depth)
+        child = tl.min(tl.where((nodes < WIDTH) & (parents == leader) & (tokens == token), nodes, WIDTH))
+        found = (leader >= 0) & (child < WIDTH)
+        spine = spine | (found & (nodes == child))
+        leader = tl.where(found, child, -1)
+    return spine
+
+
+@triton.jit
+def _select_spine_tree(
+    Original, Chain, Advantage, Selected, PLANE, WIDTH: tl.constexpr, BLOCK: tl.constexpr
+):
+    request = tl.program_id(0)
+    nodes = tl.arange(0, BLOCK)
+    offset = request * WIDTH
+    offsets = offset + nodes
+    active = nodes < WIDTH
+    tokens = tl.load(Original + offsets, active, other=0)
+    depths = tl.load(Original + PLANE + offsets, active, other=0)
+    parents = tl.load(Original + 2 * PLANE + offsets, active, other=-2)
+    ancestors = tl.load(Original + 3 * PLANE + offsets, active, other=0)
+    margins = tl.load(Advantage + offsets, active, other=0)
+    utilities = tl.cumsum(margins)
+    length = tl.argmax(tl.where(active, utilities, -2147483647), axis=0, tie_break_left=True)
+    spine = _native_prefix_nodes(tokens, parents, Chain, offset, nodes, WIDTH)
+    common = tl.sum(spine.to(tl.int32)) - 1
+    # Preserve the incumbent's actual row ordering whenever the topology agrees.
+    length = tl.where(length <= common, 0, length)
+    forced = spine & (depths <= length)
+    extras = active & ~forced
+    extra_rank = tl.cumsum(extras.to(tl.int32))
+    kept = extras & (extra_rank <= WIDTH - 1 - length)
+    mapped = tl.where(forced, depths.to(tl.int32), length + extra_rank)
+    parent = tl.gather(mapped, tl.maximum(parents, 0).to(tl.int32), axis=0)
+    masks = tl.full((BLOCK,), 0, tl.int32)
+    for old in range(WIDTH):
+        new = tl.sum(tl.where(nodes == old, mapped, 0))
+        masks = masks | tl.where((ancestors & (1 << old)) != 0, 1 << new, 0)
+
+    prefix = nodes <= length
+    native = tl.load(Chain + offsets, prefix, other=0)
+    tl.store(Selected + offsets, native, prefix)
+    tl.store(Selected + PLANE + offsets, nodes, prefix)
+    tl.store(Selected + 2 * PLANE + offsets, nodes - 1, prefix)
+    tl.store(Selected + 3 * PLANE + offsets, (1 << (nodes + 1)) - 1, prefix)
+    dest = offset + mapped
+    tl.store(Selected + dest, tokens, kept)
+    tl.store(Selected + PLANE + dest, depths, kept)
+    tl.store(Selected + 2 * PLANE + dest, parent, kept)
+    tl.store(Selected + 3 * PLANE + dest, masks, kept)
+
+
+@triton.jit
+def _update_spine_margins(
+    TreeTokens, Parents, Chain, Committed, Lengths, Advantage, Next,
+    WIDTH: tl.constexpr, BLOCK: tl.constexpr,
+):
+    request = tl.program_id(0)
+    nodes = tl.arange(0, BLOCK)
+    offset = request * WIDTH
+    active = nodes < WIDTH
+    observed = tl.load(Lengths + request)
+    tokens = tl.load(TreeTokens + offset + nodes, active, other=0)
+    parents = tl.load(Parents + offset + nodes, active, other=-2)
+    spine = _native_prefix_nodes(tokens, parents, Chain, offset, nodes, WIDTH)
+    prefix_counts = tl.cumsum((spine & (nodes > 0)).to(tl.int32))
+    common = tl.sum(spine.to(tl.int32)) - 1
+    target = tl.load(Committed + offset + nodes, active & (nodes < observed), other=0)
+    chain = tl.load(Chain + offset + nodes + 1, nodes < WIDTH - 1, other=0)
+    mismatch = (nodes < observed) & (nodes < WIDTH - 1) & (target != chain)
+    native_matches = tl.minimum(observed, tl.min(tl.where(mismatch, nodes, WIDTH - 1)))
+    # Each lane is a different minimum-spine policy.
+    matches = tl.minimum(nodes, native_matches)
+    leader = tl.full((), 0, tl.int32)
+    for i in range(WIDTH - 1):
+        token = tl.load(Committed + offset + i, i < observed, other=0)
+        child = tl.min(tl.where(active & (parents == leader) & (tokens == token), nodes, WIDTH))
+        found = (i < observed) & (leader >= 0) & (child < WIDTH)
+        count = tl.sum(tl.where(nodes == child, prefix_counts, 0))
+        on_spine = tl.sum(tl.where(nodes == child, spine.to(tl.int32), 0)) != 0
+        # The original order ranks all optional nodes by prefix probability.
+        rank = child - tl.minimum(nodes, count)
+        kept = (on_spine & (i + 1 <= nodes)) | (rank <= WIDTH - 1 - nodes)
+        matches = tl.maximum(matches, tl.where(found & kept, i + 1, 0))
+        leader = tl.where(found, child, -1)
+    reward = tl.minimum(WIDTH, matches + 1)
+    previous = tl.gather(reward, tl.maximum(nodes - 1, 0), axis=0)
+    # Adjacent policies exchange at most one leaf, so a difference of one
+    # identifies the full signed advantage. Equal lower bounds can be censored.
+    uncertain = (nodes > common) & (observed + 1 < WIDTH) & (previous == observed + 1) & (reward == previous)
+    prior = tl.load(Advantage + offset + nodes, active, other=0)
+    magnitude = tl.maximum(prior, -prior) * 3 // 4
+    decayed = tl.where(prior < 0, -magnitude, magnitude)
+    updated = tl.where(uncertain, prior, decayed + 4 * (reward - previous))
+    tl.store(Next + offset + nodes, tl.where(nodes == 0, 0, updated), active)
