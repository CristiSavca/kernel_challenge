     return out
+
+
+@triton.jit
+def _softcap_tile_keys(
+    Logits, Keys, row_stride, valid_width, col_offset, softcap,
+    TILES: tl.constexpr, BLOCK: tl.constexpr,
+):
+    row = tl.program_id(0).to(tl.int64)
+    tile = tl.program_id(1)
+    cols = tile * BLOCK + tl.arange(0, BLOCK)
+    live = cols < valid_width
+    x = tl.load(Logits + row * row_stride + cols, mask=live, other=0.0)
+    x = libdevice.tanh(x / softcap) * softcap
+    x = tl.where(live, x, -float("inf"))
+    value, index = tl.max(x, axis=0, return_indices=True, return_indices_tie_break_left=True)
+    # The serial kernel starts with (-inf, 0) and only takes a strictly
+    # greater tile value. Reproduce its behavior for NaN and -inf tiles.
+    take = value > -float("inf")
+    value = tl.where(take, value, -float("inf"))
+    token = col_offset + tl.where(take, tile * BLOCK + index, 0)
+    bits = value.to(tl.int32, bitcast=True)
+    bits = tl.where((bits & 0x7fffffff) == 0, 0, bits)
+    # Invert the fractional/exponent bits of negative floats, leaving the
+    # sign bit in place. Signed integer order now agrees with FP32 order.
+    score = bits ^ ((bits >> 31) & 0x7fffffff)
+    key = (score.to(tl.int64) << 32) | (~token.to(tl.uint32)).to(tl.int64)
+    tl.store(Keys + row * TILES + tile, key)
+
+
+@triton.jit
+def _unpack_winner_ids(Keys, IDs, rows, BLOCK: tl.constexpr):
+    row = tl.program_id(0) * BLOCK + tl.arange(0, BLOCK)
+    keys = tl.load(Keys + row, row < rows, other=0)
+    ids = ~keys.to(tl.uint32)
+    tl.store(IDs + row, ids.to(tl.int64), row < rows)
+
+
+def reduced_softcap_argmax(logits, softcap, valid_width, col_offset, group):
+    """Reduce one signed (score, inverse global ID) key per row over the TP group."""
+    rows, width = logits.shape
+    block = 4096  # Keep the same per-tile reduction as softcap_row_argmax.
+    tiles = triton.cdiv(width, block)
+    partial = torch.empty((rows, tiles), dtype=torch.int64, device=logits.device)
+    _softcap_tile_keys[(rows, tiles)](
+        logits, partial, logits.stride(0), valid_width, col_offset,
+        softcap, tiles, block, num_warps=8,
+    )
+    keys = partial.reshape(rows) if tiles == 1 else torch.amax(partial, dim=1)
+    torch.distributed.all_reduce(keys, op=torch.distributed.ReduceOp.MAX, group=group)
+    ids = torch.empty(rows, dtype=torch.int64, device=logits.device)
+    _unpack_winner_ids[(triton.cdiv(rows, 128),)](keys, ids, rows, 128)
+    return ids
