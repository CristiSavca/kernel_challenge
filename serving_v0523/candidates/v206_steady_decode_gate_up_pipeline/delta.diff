 import torch
 
 
+def enable_full_pair(kernel):
+    import humming
+
+    width = kernel.block_shape[0]
+    if (width not in (8, 16, 24) or not (kernel.use_tma_a and kernel.use_tma_b and kernel.use_tma_bs)
+            or not kernel.use_mbarrier or kernel.multi_cast_size_a != 1 or kernel.multi_cast_size_b != 1):
+        raise ValueError("unsupported grouped decode stage protocol")
+    path = Path(humming.__path__[0]) / "include/humming/kernel/humming_ws.cuh"
+    loop = path.read_text()
+    if hashlib.sha256(loop.encode()).hexdigest() != "6a148cc29b81d4009066667c347d9091a8a138009f7884226e9969a6936e2899":
+        raise ValueError("unsupported grouped Humming loop")
+    # Every math worker releases its shared A tile after the last pair drains.
+    # The next-stage wait is safe while this tile is held: the four-stage
+    # producer primes three stages and refills two stages ahead of this wait.
+    loop = loop.replace("              consumer.arrive(stage_id);\n", "")
+    loop = loop.replace("            mma.transform_b(\n",
+                        "            if (warp_iter_id + 1 == Ctx::kWarpIters) consumer.arrive(stage_id);\n"
+                        "            mma.transform_b(\n")
+    prefetch = "s2r_pipe.load_stage_iter(stage_id, warp_iter_id + 1);"
+    loop = loop.replace(prefetch, "if (warp_iter_id + 1 < Ctx::kWarpIters || slice_iters > 1) " + prefetch)
+    include = "#include <humming/kernel/humming_ws.cuh>"
+    if kernel.code.count(include) != 1:
+        raise ValueError("unsupported grouped Humming source include")
+    kernel.code = kernel.code.replace(include, loop.replace("#pragma once", "", 1))
+    kernel.code += "\n#define MUSE_PAIR_LAST_K_SLICES\n"
+
