+class DFlashVerifyFCGraph:
+    """Share raw verify taps across graph sizes and project a full-K FC shard."""
+
+    def __init__(self, context):
+        self.context = context
+        self.weight = context.fc.weight
+        self.weight_ptr = self.weight.data_ptr()
+        self.version = None if torch.is_inference(self.weight) else self.weight._version
+        self.active = True
+        self.local_weight = None
+        self.raw = None
+
+    def ready(self):
+        draft, fc, _, projector, _, _, _ = self.context
+        return (
+            self.active
+            and draft.fc is fc
+            and fc.weight is self.weight
+            and fc.weight.data_ptr() == self.weight_ptr
+            and (self.version is None or fc.weight._version == self.version)
+            and fc.weight.shape == (fc.out_features, fc.in_features)
+            and fc.weight.is_contiguous()
+            and fc.bias is None
+            and draft.project_target_hidden == projector
+            and not draft.quantizable
+            and not torch.is_autocast_enabled(fc.weight.device.type)
+            and not torch.are_deterministic_algorithms_enabled()
+            and not module_hooks._global_forward_hooks
+            and not module_hooks._global_forward_pre_hooks
+            and not fc._forward_hooks
+            and not fc._forward_pre_hooks
+            and "forward" not in vars(fc)
+            and getattr(fc, "_compiled_call_impl", None) is None
+        )
+
+    def prepare_capture(self, runner):
+        from sglang.srt.batch_invariant_ops import is_batch_invariant_mode_enabled
+        from sglang.srt.model_executor.runner_backend.full_cuda_graph_backend import FullCudaGraphBackend
+
+        context = self.context
+        eligible = (
+            self.ready()
+            and type(runner.backend) is FullCudaGraphBackend
+            and not runner.ragged_verify_mode
+            and not runner.enable_pdmux
+            and not runner.enable_two_batch_overlap
+            and not runner.enable_torch_compile
+            and not runner.model_runner.capture_head_hooks
+            and not runner.model_runner.capture_tail_hooks
+            and not is_batch_invariant_mode_enabled()
+            and not any(mod._forward_hooks or mod._forward_pre_hooks for mod in context.target.modules())
+            and all(
+                getattr(mod, "_compiled_call_impl", None) is None and "forward" not in vars(mod)
+                for mod in (context.target, context.target.model, context.target.model.language_model, context.logits_processor)
+            )
+        )
+        if not _agree(eligible, context.group):
+            return None
+        local_weight, raw = self.local_weight, self.raw
+        try:
+            if local_weight is None:
+                # Isolate peers from source changes, including partial draft loads.
+                width = context.fc.out_features // context.group.world_size
+                first = width * context.group.rank_in_group
+                with torch.inference_mode(False), torch.no_grad():
+                    local_weight = self.weight.narrow(0, first, width).clone()
+            if raw is None or raw.shape[0] < runner.max_num_token:
+                raw = self.weight.new_empty((runner.max_num_token, context.fc.in_features))
+            allocated = True
+        except torch.OutOfMemoryError:
+            allocated = False
+        if not _agree(allocated, context.group):
+            # Keep older graph storage valid. New local allocations made during
+            # this attempt have no published references and are released on exit.
+            return None
+        self.local_weight, self.raw = local_weight, raw
+        return self
+
+    def capture(self, output, batch):
+        # A precise raw-workspace alias also verifies that the native Muse body
+        # reached its direct writer. A wrapper replacing the taps cannot qualify.
+        raw = output.hidden_states
+        workspace = batch.dflash_verify_raw_buffer
+        if raw is workspace and raw is not None:
+            output.dflash_verify_fc_shard = torch.nn.functional.linear(raw, self.local_weight)
+
+    def complete_capture(self, output):
+        # Capture-time CPU consensus covers rank-local changes in returned shape
+        # or ownership. FullCudaGraphBackend retains this exact output object.
+        if not _agree(output.dflash_verify_fc_shard is not None, self.context.group):
+            output.dflash_verify_fc_shard = None
+
+    def finish(self, local, raw):
+        # Every rank must issue the same gather before consulting rank-local draft
+        # hooks or mutations. Clean peers' channel shards always use private weights.
+        full = self.context.group.all_gather(local, dim=-1)
+        if not self.ready():
+            return self.context.draft.project_target_hidden(raw)
+        return self.context.draft.hidden_norm(full)
+
+
 class _PeerKVWeight(NamedTuple):
     group: object
     local_weight: torch.Tensor
