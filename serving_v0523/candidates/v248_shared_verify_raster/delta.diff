+@triton.jit
+def _build_verify_raster(Lengths, CuQ, Plan, B: tl.constexpr, PARTITIONS: tl.constexpr,
+                         WINDOW_LEFT: tl.constexpr, TILE_N: tl.constexpr,
+                         BLOCK_B: tl.constexpr, BLOCK_P: tl.constexpr):
+    # [B+1 cumulative offsets, B first physical tiles, partition width, P first requests]
+    row = tl.arange(0, BLOCK_B)
+    length = tl.load(Lengths + row, row < B, other=0)
+    start = tl.load(CuQ + row, row < B, other=0)
+    stop = tl.load(CuQ + row + 1, row < B, other=0)
+    first, counts = _tile_geometry(length, stop - start, WINDOW_LEFT, TILE_N)
+    ends = tl.cumsum(counts)
+    width = tl.maximum(1, tl.cdiv(tl.sum(counts), PARTITIONS))
+    chunk = tl.program_id(0)
+    if chunk == 0:
+        tl.store(Plan, 0)
+        tl.store(Plan + 1 + row, ends, row < B)
+        tl.store(Plan + B + 1 + row, first, row < B)
+        tl.store(Plan + 2 * B + 1, width)
+    part = chunk * BLOCK_P + tl.arange(0, BLOCK_P)
+    preceding = (ends[None, :] <= part[:, None] * width) & (row[None, :] < B)
+    owner = tl.sum(preceding.to(tl.int32), 1)
+    tl.store(Plan + 2 * B + 2 + part, owner, part < PARTITIONS)
+
+
+def refresh_verify_rasters(metadata, window_left, kv_heads, num_sms):
+    previous = metadata.verify_raster_storage
+    metadata.verify_rasters = None
+    lengths, cu_q = metadata.cache_seqlens_int32, metadata.cu_seqlens_q
+    if lengths is None or cu_q is None:
+        return
+    batch = lengths.numel()
+    if not (1 < batch <= 64 and lengths.shape == (batch,) and cu_q.shape == (batch + 1,)
+            and lengths.is_cuda and lengths.device == cu_q.device and lengths.dtype == cu_q.dtype == torch.int32
+            and lengths.is_contiguous() and cu_q.is_contiguous()):
+        return
+    # Rebinding a capture variant can construct new views of the same bucket.
+    # Retain allocations only for that exact pair of native metadata spans.
+    reusable = {}
+    if previous is not None and all(old is new or (
+            old.device == new.device and old.dtype == new.dtype and old.shape == new.shape
+            and old.is_contiguous() and old.data_ptr() == new.data_ptr()
+    ) for old, new in zip(previous[:2], (lengths, cu_q))):
+        reusable = previous[2]
+    buffers = {}
+    windows = (-1, window_left) if isinstance(window_left, int) and window_left >= 0 else (-1,)
+    active = [(w, verify_partition_workspace(batch, kv_heads, 1, 1, w, num_sms)[0])
+              for w in windows if kv_heads > 0 and num_sms > 0]
+    # Captured consumers retain raw pointers. Refill their original geometries
+    # even if a later caller selects another window, and let that caller fall back.
+    for key in reusable or active:
+        window, partitions = key
+        size = 2 * batch + 2 + partitions
+        plan = reusable.get(key)
+        if (plan is None or plan.shape != (size,) or plan.device != lengths.device
+                or plan.dtype != torch.int32 or not plan.is_contiguous()):
+            plan = torch.empty(size, dtype=torch.int32, device=lengths.device)
+        buffers[key] = plan
+        _build_verify_raster[(triton.cdiv(partitions, 16),)](
+            lengths, cu_q, plan, batch, partitions, window, 64 if window >= 0 else 128,
+            triton.next_power_of_2(batch), 16, num_warps=4,
+        )
+    metadata.verify_raster_storage = (lengths, cu_q, buffers)
+    metadata.verify_rasters = (lengths, cu_q, {key: buf for key, buf in buffers.items() if key in active})
+
